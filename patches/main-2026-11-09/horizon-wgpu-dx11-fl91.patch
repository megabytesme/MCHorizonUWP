+                    let (page, start) = s.translucent_at;
+                    shadow_translucent.push((
+                        distance,
+                        [
+                            s.translucent * 6,
+                            1,
+                            index_start as u32,
+                            start as u32,
+                            instance,
+                        ],
+                        (page, Some(index_page)),
+                    ));
+                }
+            }
+        }
