diff --git a/crates/horizon-client-render/src/gfx/stars_fl91.wgsl b/crates/horizon-client-render/src/gfx/stars_fl91.wgsl
new file mode 100644
index 0000000..70e475e
--- /dev/null
+++ b/crates/horizon-client-render/src/gfx/stars_fl91.wgsl
@@ -0,0 +1,18 @@
+// Pure-float FL9_1 stars shader.
+struct Stars {
+    clip_from_sky: mat4x4<f32>,
+    color: vec4<f32>,
+    hdr_settings: vec4<f32>,
+    hdr_shares: vec4<f32>,
+    hdr_light: vec4<f32>,
+}
+@group(0) @binding(0) var<uniform> stars: Stars;
+
+@vertex fn vs_stars(@location(0) position: vec3<f32>) -> @builtin(position) vec4<f32> {
+    return stars.clip_from_sky * vec4(position, 1.0);
+}
+
+@fragment fn fs_stars() -> @location(0) vec4<f32> {
+    let b = stars.color.a;
+    return vec4(stars.color.rgb * b, 0.175);
+}
