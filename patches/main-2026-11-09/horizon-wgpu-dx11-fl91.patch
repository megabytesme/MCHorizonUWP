+                                let code = fade_code(section, &v.key);
+                                Some((
+                                    section.flat_id?,
+                                    section_instance(v.origin, code, visibility(v.key)),
+                                ))
+                            })
+                            .chain(visible_lods.iter().filter_map(|v| {
