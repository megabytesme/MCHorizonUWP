diff --git a/crates/horizon-client-render/src/gfx/panorama_fl91.wgsl b/crates/horizon-client-render/src/gfx/panorama_fl91.wgsl
new file mode 100644
index 0000000..e44833a
--- /dev/null
+++ b/crates/horizon-client-render/src/gfx/panorama_fl91.wgsl
@@ -0,0 +1,24 @@
+// Pure-float FL9_1 title panorama cubemap shader reading positions from a static vertex buffer.
+struct Projection {
+    view_proj: mat4x4<f32>,
+}
+@group(0) @binding(0) var<uniform> projection: Projection;
+@group(0) @binding(1) var panorama: texture_cube<f32>;
+@group(0) @binding(2) var panorama_sampler: sampler;
+
+struct Out {
+    @builtin(position) clip: vec4<f32>,
+    @location(0) direction: vec3<f32>,
+}
+
+@vertex fn vs_panorama(@location(0) position: vec3<f32>) -> Out {
+    var out: Out;
+    out.clip = projection.view_proj * vec4(position, 1.0);
+    out.direction = position;
+    return out;
+}
+
+@fragment fn fs_panorama(in: Out) -> @location(0) vec4<f32> {
+    let color = textureSample(panorama, panorama_sampler, in.direction);
+    return vec4(color.rgb, 1.0);
+}
