+    }
+    let f = entity_fog_factor(in.fog_flags) * globals.fog_color.a;
+    let rgb = texel.rgb * (128.0 / 255.0);
+    return vec4(mix(rgb, globals.fog_color.rgb, f), texel.a);
+}
+
+@fragment fn fs_water_mask(_in: EntityOut) -> @location(0) vec4<f32> {
+    return vec4(0.0);
+}
+
+@fragment fn fs_hdr_mark(_in: EntityOut) -> @location(0) vec4<f32> {
+    return vec4(0.0, 0.0, 0.0, 1.0);
+}
+
+@fragment fn fs_hdr_hand_unmark(_in: EntityOut) -> @location(0) vec4<f32> {
+    return vec4(0.0, 0.0, 0.0, 1.0);
+}
+
+@fragment fn fs_hdr_cloud_mark(_in: EntityOut) -> @location(0) vec4<f32> {
+    return vec4(0.0, 0.0, 0.0, 1.0);
+}
+
+@fragment fn fs_weather(in: EntityOut) -> @location(0) vec4<f32> {
+    let uv = in.aux.xy + fract(in.uv_glint.xy) * in.aux.zw;
+    let texel = sample_tiled_atlas(uv);
+    let alpha = texel.a * in.color.a;
+    if alpha < 0.1 {
+        discard;
+    }
+    let lm = textureSample(lightmap, lightmap_sampler, in.lm_wrap.xy).rgb;
+    let rgb = texel.rgb * in.color.rgb * lm;
+    let f = entity_fog_factor(in.fog_flags) * globals.fog_color.a;
+    return vec4(mix(rgb, globals.fog_color.rgb, f), alpha);
+}
