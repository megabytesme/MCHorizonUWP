-struct ShrinkGate(Option<Instant>);
-impl ShrinkGate {
-    /// Not before `wait` from `now`, nor before an earlier wait is over.
-    fn wait(&mut self, now: Instant, wait: std::time::Duration) {
-        self.0 = self.0.max(Some(now + wait));
