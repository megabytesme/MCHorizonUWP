+                &mut encoder,
+                &self.debug_line_buffer,
+                0,
+                bytemuck::cast_slice(lines),
+            );
+        }
+        self.weather.prepare(
+            &self.device,
+            &mut encoder,
+            &mut self.uploads,
+            frame.weather,
+            frame.weather_time,
+        );
