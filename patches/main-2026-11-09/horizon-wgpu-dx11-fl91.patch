+/// The graphics API the renderer runs on. Windows picks Vulkan, DirectX 12 or
+/// OpenGL; Linux picks Vulkan or OpenGL; macOS always uses its one backend
+/// (Metal). Applies at the next start.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Default)]
+pub enum GraphicsApi {
+    /// Vulkan, then DirectX 12 (Windows), then OpenGL when neither has a surface, adapter or device.
+    #[default]
+    Auto,
+    Vulkan,
+    Dx12,
+    /// Experimental DirectX 11 (Feature Level 9_1 hardware path, Windows).
+    Dx11,
+    /// OpenGL, for GPUs with no Vulkan or DirectX 12 driver (Windows and Linux).
+    OpenGl,
+}
+impl GraphicsApi {
+    pub const ALL: [GraphicsApi; 5] = [
+        GraphicsApi::Auto,
+        GraphicsApi::Vulkan,
+        GraphicsApi::Dx12,
+        GraphicsApi::Dx11,
+        GraphicsApi::OpenGl,
+    ];
+    /// The APIs this system offers, in the order the setting cycles through
+    /// them: DirectX 12 and DirectX 11 are Windows-only backends, and macOS has no choice.
+    pub fn choices() -> &'static [GraphicsApi] {
+        const WINDOWS: [GraphicsApi; 5] = [
+            GraphicsApi::Auto,
+            GraphicsApi::Vulkan,
+            GraphicsApi::Dx12,
+            GraphicsApi::Dx11,
+            GraphicsApi::OpenGl,
+        ];
+        const LINUX: [GraphicsApi; 3] =
+            [GraphicsApi::Auto, GraphicsApi::Vulkan, GraphicsApi::OpenGl];
+        const MACOS: [GraphicsApi; 1] = [GraphicsApi::Auto];
+        if cfg!(windows) {
+            &WINDOWS
+        } else if cfg!(target_os = "macos") {
+            &MACOS
+        } else {
+            &LINUX
+        }
+    }
+    pub fn name(self) -> &'static str {
+        match self {
+            GraphicsApi::Auto => "auto",
+            GraphicsApi::Vulkan => "vulkan",
+            GraphicsApi::Dx12 => "dx12",
+            GraphicsApi::Dx11 => "dx11",
+            GraphicsApi::OpenGl => "opengl",
+        }
+    }
+    pub fn label(self) -> &'static str {
+        match self {
+            GraphicsApi::Auto => "Auto",
+            GraphicsApi::Vulkan => "Vulkan",
+            GraphicsApi::Dx12 => "DirectX 12",
+            GraphicsApi::Dx11 => "DirectX 11",
+            GraphicsApi::OpenGl => "OpenGL",
+        }
+    }
+    /// The API a name stands for, ignoring case; `None` for anything else.
+    pub fn from_name(s: &str) -> Option<Self> {
+        let trimmed = s.trim();
+        if trimmed.eq_ignore_ascii_case("d3d11") {
+            return Some(GraphicsApi::Dx11);
+        }
+        Self::ALL
+            .into_iter()
+            .find(|api| api.name().eq_ignore_ascii_case(trimmed))
+    }
+    /// `HORIZON_GRAPHICS_API` (auto, vulkan, dx12, dx11 or opengl) if set, else the setting.
+    pub fn with_env(self) -> Self {
+        std::env::var("HORIZON_GRAPHICS_API")
+            .ok()
+            .and_then(|v| Self::from_name(&v))
+            .unwrap_or(self)
+    }
+}
