new file mode 100644
index 0000000..4e384aa
--- /dev/null
+++ b/crates/horizon-client-render/src/gfx/world_primitives_fl91.wgsl
@@ -0,0 +1,103 @@
+// Pure-float FL9_1 native world primitives shader.
+
+struct Globals {
+    view_proj: mat4x4<f32>,
+    viewport: vec4<f32>,
+    atlas_grid: vec4<f32>,
+}
+
+@group(0) @binding(0) var<uniform> globals: Globals;
+@group(0) @binding(1) var atlas_0: texture_2d<f32>;
+@group(0) @binding(2) var atlas_1: texture_2d<f32>;
+@group(0) @binding(3) var atlas_2: texture_2d<f32>;
+@group(0) @binding(4) var atlas_3: texture_2d<f32>;
+@group(0) @binding(5) var atlas_4: texture_2d<f32>;
+@group(0) @binding(6) var atlas_5: texture_2d<f32>;
+@group(0) @binding(7) var atlas_sampler: sampler;
+
+struct QuadOut {
+    @builtin(position) clip: vec4<f32>,
+    @location(0) uv: vec2<f32>,
+    @location(1) color: vec4<f32>,
+    @location(2) wrap: vec2<f32>,
+}
+
+@vertex fn vs_quad(
+    @location(0) pos: vec3<f32>,
+    @location(1) uv: vec2<f32>,
+    @location(2) layer_bytes: vec4<f32>,
+    @location(3) color: vec4<f32>,
+    @location(4) light_bytes: vec4<f32>,
+) -> QuadOut {
+    let lb = floor(layer_bytes * 255.0 + 0.5);
+    let layer = lb.x + lb.y * 256.0;
+    let light = floor(light_bytes * 255.0 + 0.5);
+    let is_beam = layer > 5.5 && layer < 6.5;
+    var out: QuadOut;
+    out.clip = globals.view_proj * vec4(pos, 1.0);
+    out.uv = uv;
+    out.color = color;
+    out.wrap = select(
+        vec2(0.0),
+        vec2(light.x + light.y * 256.0, light.z + light.w * 256.0) / 65535.0,
+        is_beam,
+    );
+    return out;
+}
+
+@fragment fn fs_quad(in: QuadOut) -> @location(0) vec4<f32> {
+    let wrapped_y = in.wrap.x + fract(in.uv.y) * in.wrap.y;
+    let uv = vec2(in.uv.x, select(in.uv.y, wrapped_y, in.wrap.y > 0.0));
+    let t = uv * globals.atlas_grid.xy;
+    let c = select(0.0, 1.0, t.x >= 1.0);
+    let r = select(select(0.0, 1.0, t.y >= 1.0), 2.0, t.y >= 2.0);
+    let luv = clamp(vec2(t.x - c, t.y - r), vec2(0.0), vec2(1.0));
+    let s0 = textureSample(atlas_0, atlas_sampler, luv);
+    let s1 = textureSample(atlas_1, atlas_sampler, luv);
+    let s2 = textureSample(atlas_2, atlas_sampler, luv);
+    let s3 = textureSample(atlas_3, atlas_sampler, luv);
+    let s4 = textureSample(atlas_4, atlas_sampler, luv);
+    let s5 = textureSample(atlas_5, atlas_sampler, luv);
+    let col = select(select(mix(s0, s1, c), mix(s2, s3, c), r > 0.5), mix(s4, s5, c), r > 1.5) * in.color;
+    if col.a <= 0.0 {
+        discard;
+    }
+    return col;
+}
+
+struct LineOut {
+    @builtin(position) clip: vec4<f32>,
+    @location(0) color: vec4<f32>,
+}
+
+@vertex fn vs_line(
+    @location(4) corner: vec2<f32>,
+    @location(0) start: vec3<f32>,
+    @location(1) end_p: vec3<f32>,
+    @location(2) argb: vec4<f32>,
+    @location(3) width: f32,
+) -> LineOut {
+    let position = mix(start, end_p, corner.x);
+    let view_shrink = 1.0 - 1.0 / 256.0;
+    let line_start = globals.view_proj * vec4(position * view_shrink, 1.0);
+    let line_end = globals.view_proj * vec4((position + (end_p - start)) * view_shrink, 1.0);
+    let ndc1 = line_start.xyz / line_start.w;
+    let ndc2 = line_end.xyz / line_end.w;
+    let screen = globals.viewport.xy;
+    let delta_screen = (ndc2.xy - ndc1.xy) * screen;
+    let len_sq = dot(delta_screen, delta_screen);
+    let dir_s = delta_screen * inverseSqrt(max(len_sq, 1e-8));
+    var offset = vec2(-dir_s.y, dir_s.x) * width / screen;
+    if offset.x < 0.0 {
+        offset = -offset;
+    }
+    offset *= corner.y;
+    var out: LineOut;
+    out.clip = vec4((ndc1 + vec3(offset, 0.0)) * line_start.w, line_start.w);
+    out.color = argb.zyxw;
+    return out;
