+        }
+        let view_target = target_texture.create_view(&wgpu::TextureViewDescriptor {
+            format: Some(self.frame_format),
+            ..Default::default()
+        });
+        if let Some(timer) = &mut self.gpu_timer {
+            timer.begin(&mut encoder);
+        }
