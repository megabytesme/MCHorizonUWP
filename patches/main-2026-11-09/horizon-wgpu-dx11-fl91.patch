+    let cf = clamp(in.fog_flags.x, 0.0, 1.0);
+    return vec4(texel.rgb * in.color.rgb, texel.a * in.color.a * (1.0 - cf));
+}
+
+@fragment fn fs_entity_unmarked(in: EntityOut) -> @location(0) vec4<f32> {
+    return entity_color(in);
+}
+
+@fragment fn fs_entity(in: EntityOut) -> @location(0) vec4<f32> {
+    return entity_color(in);
+}
+
+@fragment fn fs_entity_shadow(in: EntityOut) -> @location(0) vec4<f32> {
+    let texel = sample_tiled_atlas(in.uv_glint.xy);
+    let lm = textureSample(lightmap, lightmap_sampler, in.lm_wrap.xy).rgb;
+    let rgb = texel.rgb * in.color.rgb * lm;
+    let f = entity_fog_factor(in.fog_flags) * globals.fog_color.a;
+    return vec4(mix(rgb, globals.fog_color.rgb, f), texel.a * in.color.a);
+}
+
+fn celestial_color(in: EntityOut) -> vec4<f32> {
+    let texel = sample_tiled_atlas(in.uv_glint.xy);
+    let lm = mix(textureSample(lightmap, lightmap_sampler, in.lm_wrap.xy).rgb, vec3(1.0), in.fog_flags.z);
+    let fog = entity_fog_factor(in.fog_flags);
+    let rays = in.color * (1.0 - fog);
+    let c = vec4(texel.rgb * in.color.rgb * lm, texel.a * in.color.a);
+    let poly = vec4(mix(c.rgb, globals.fog_color.rgb, fog * globals.fog_color.a), c.a);
+    let textured = select(c, poly, in.mode.z > 0.5);
+    return select(textured, rays, in.mode.y > 0.5);
+}
+
+@fragment fn fs_celestial(in: EntityOut) -> @location(0) vec4<f32> {
+    return celestial_color(in);
+}
+
+@fragment fn fs_sky_celestial(in: EntityOut) -> @location(0) vec4<f32> {
+    let c = celestial_color(in);
+    return vec4(c.rgb * c.a, c.a);
+}
+
+@fragment fn fs_energy_swirl(in: EntityOut) -> @location(0) vec4<f32> {
+    let uv = in.lm_wrap.zw + fract(in.uv_glint.xy) * in.color.rg;
+    let texel = sample_tiled_atlas(uv);
