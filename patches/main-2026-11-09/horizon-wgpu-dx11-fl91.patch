+        }
+        if flat_frame {
+            section_draw_calls = self.flat.as_ref().map_or(0, |f| f.shadow_calls[0]);
+        } else if self.multi_draw && !self.draws.is_empty() {
+            if self.draws.len() as u64 > self.indirect_capacity {
