+/// Sprite sheet metadata and textures replacing `D2Array` terrain sprites on FL9_1.
+pub struct SpriteSheets {
+    pub textures: [wgpu::Texture; SPRITE_SHEETS],
+    pub views: [wgpu::TextureView; SPRITE_SHEETS],
+    pub cols: u32,
+    pub rows: u32,
+    pub capacity_per_sheet: u32,
+    pub sprite_size: u32,
+}
+
+impl SpriteSheets {
+    /// Packs `layers` contiguous mip-chained sprites of edge `size` into up to
+    /// [`SPRITE_SHEETS`] POT `2D` sheets (`2048 x sheet_height_pot`).
+    pub fn pack(
+        device: &wgpu::Device,
+        queue: &wgpu::Queue,
+        data: &[u8],
+        size: u32,
+        levels: u32,
+        layers: u32,
+        sprite_bytes: usize,
+    ) -> Result<Self> {
+        if size == 0 || !size.is_power_of_two() || size > SPRITE_SHEET_DIM {
+            return Err(format!("FL9_1 sprite size {size} must be a power of 2 <= 2048").into());
+        }
+        let cols = (SPRITE_SHEET_DIM / size).max(1);
+        let max_rows = (SPRITE_SHEET_DIM / size).max(1);
+        let capacity_per_sheet = cols * max_rows;
+        let max_total_layers = capacity_per_sheet * SPRITE_SHEETS as u32;
+        if layers > max_total_layers {
+            return Err(format!(
+                "FL9_1 terrain supports at most {max_total_layers} sprites of {size}x{size}, got {layers}"
+            )
+            .into());
+        }
+
+        // Uniform row count across all active sheets so shader indexing uses one constant divisor.
+        let max_layers_in_sheet = layers.min(capacity_per_sheet);
+        let rows = max_layers_in_sheet
+            .div_ceil(cols)
+            .max(1)
+            .next_power_of_two()
+            .min(max_rows);
+        let sheet_height = rows * size;
+
+        let mut textures_vec = Vec::with_capacity(SPRITE_SHEETS);
+        let mut views_vec = Vec::with_capacity(SPRITE_SHEETS);
+
+        for sheet_idx in 0..SPRITE_SHEETS {
+            let first_layer = sheet_idx as u32 * capacity_per_sheet;
+            let active_layers = layers.saturating_sub(first_layer).min(capacity_per_sheet);
+            if active_layers == 0 {
+                let dummy = device.create_texture(&wgpu::TextureDescriptor {
+                    label: Some("FL9_1 dummy sprite sheet"),
+                    size: wgpu::Extent3d {
+                        width: 1,
+                        height: 1,
+                        depth_or_array_layers: 1,
+                    },
+                    mip_level_count: 1,
+                    sample_count: 1,
+                    dimension: wgpu::TextureDimension::D2,
+                    format: wgpu::TextureFormat::Rgba8Unorm,
+                    usage: wgpu::TextureUsages::TEXTURE_BINDING | wgpu::TextureUsages::COPY_DST,
+                    view_formats: &[],
+                });
+                queue.write_texture(
+                    wgpu::TexelCopyTextureInfo {
+                        texture: &dummy,
+                        mip_level: 0,
+                        origin: wgpu::Origin3d::ZERO,
+                        aspect: wgpu::TextureAspect::All,
+                    },
+                    &[0, 0, 0, 0],
+                    wgpu::TexelCopyBufferLayout {
+                        offset: 0,
+                        bytes_per_row: Some(4),
+                        rows_per_image: Some(1),
+                    },
+                    wgpu::Extent3d {
+                        width: 1,
+                        height: 1,
+                        depth_or_array_layers: 1,
+                    },
+                );
+                views_vec.push(dummy.create_view(&Default::default()));
+                textures_vec.push(dummy);
+                continue;
+            }
+
+            let tex = device.create_texture(&wgpu::TextureDescriptor {
+                label: Some("FL9_1 terrain sprite sheet"),
+                size: wgpu::Extent3d {
+                    width: SPRITE_SHEET_DIM,
+                    height: sheet_height,
+                    depth_or_array_layers: 1,
+                },
+                mip_level_count: levels,
+                sample_count: 1,
+                dimension: wgpu::TextureDimension::D2,
+                format: wgpu::TextureFormat::Rgba8Unorm,
+                usage: wgpu::TextureUsages::TEXTURE_BINDING | wgpu::TextureUsages::COPY_DST,
+                view_formats: &[],
+            });
+
+            // Assemble each mip level cleanly into a sheet buffer so each level uploads once.
+            let mut mip_offset_in_sprite = 0usize;
+            for mip in 0..levels {
+                let mip_edge = (size >> mip).max(1);
+                let sheet_mip_w = (SPRITE_SHEET_DIM >> mip).max(1);
+                let sheet_mip_h = (sheet_height >> mip).max(1);
+                let row_bytes = sheet_mip_w as usize * 4;
+                let mut sheet_buf = vec![0u8; row_bytes * sheet_mip_h as usize];
+                let sprite_mip_row_bytes = mip_edge as usize * 4;
+
+                for local in 0..active_layers {
+                    let global_layer = (first_layer + local) as usize;
+                    let src_start = global_layer * sprite_bytes + mip_offset_in_sprite;
+                    let col = local % cols;
+                    let row = local / cols;
+                    let dst_x = col * mip_edge;
+                    let dst_y = row * mip_edge;
+                    for y in 0..mip_edge {
+                        let s0 = src_start + y as usize * sprite_mip_row_bytes;
+                        let s1 = s0 + sprite_mip_row_bytes;
+                        let d0 = ((dst_y + y) as usize) * row_bytes + (dst_x as usize) * 4;
+                        sheet_buf[d0..d0 + sprite_mip_row_bytes].copy_from_slice(&data[s0..s1]);
+                    }
+                }
+
+                queue.write_texture(
+                    wgpu::TexelCopyTextureInfo {
+                        texture: &tex,
+                        mip_level: mip,
+                        origin: wgpu::Origin3d::ZERO,
+                        aspect: wgpu::TextureAspect::All,
+                    },
+                    &sheet_buf,
+                    wgpu::TexelCopyBufferLayout {
+                        offset: 0,
+                        bytes_per_row: Some(row_bytes as u32),
+                        rows_per_image: Some(sheet_mip_h),
+                    },
+                    wgpu::Extent3d {
+                        width: sheet_mip_w,
+                        height: sheet_mip_h,
+                        depth_or_array_layers: 1,
+                    },
+                );
+
+                mip_offset_in_sprite += sprite_mip_row_bytes * mip_edge as usize;
+            }
+
+            views_vec.push(tex.create_view(&Default::default()));
+            textures_vec.push(tex);
+        }
+
+        Ok(Self {
+            textures: textures_vec.try_into().ok().unwrap(),
+            views: views_vec.try_into().ok().unwrap(),
+            cols,
+            rows,
+            capacity_per_sheet,
+            sprite_size: size,
+        })
+    }
+
+    pub fn uniform_info(&self) -> [f32; 4] {
+        [
+            self.cols as f32,
+            self.rows as f32,
+            self.capacity_per_sheet as f32,
+            self.sprite_size as f32,
+        ]
+    }
+}
+
+/// Virtual 2D atlas backed by up to `6` (`2x3`) POT `2048x2048` textures (`4096x6144` max),
+/// fitting within FL9_1's `2048` 2D limit and `8` sampled textures per fragment stage.
+pub struct TiledAtlas {
+    pub width: u32,
+    pub height: u32,
+    pub src_width: u32,
+    pub src_height: u32,
+    scale_x: u32,
+    scale_y: u32,
+    pub textures: [wgpu::Texture; ATLAS_TILES],
+    pub views: [wgpu::TextureView; ATLAS_TILES],
+    active: [bool; ATLAS_TILES],
+}
+
+impl TiledAtlas {
+    pub const MAX_WIDTH: u32 = ATLAS_COLS * ATLAS_TILE_DIM;
+    pub const MAX_HEIGHT: u32 = ATLAS_ROWS * ATLAS_TILE_DIM;
+
+    pub fn new(
+        device: &wgpu::Device,
+        queue: &wgpu::Queue,
+        src_width: u32,
+        src_height: u32,
+        rgba: &[u8],
+    ) -> Result<Self> {
+        if src_width == 0 || src_height == 0 {
+            return Err(format!("FL9_1 virtual atlas {src_width}x{src_height} is empty").into());
+        }
+        let expected = src_width as usize * src_height as usize * 4;
+        if rgba.len() < expected {
+            return Err(format!(
+                "FL9_1 virtual atlas pixel buffer too small: {} < {expected}",
+                rgba.len()
+            )
+            .into());
+        }
+
+        let scale_x = src_width.div_ceil(Self::MAX_WIDTH).max(1);
+        let scale_y = src_height.div_ceil(Self::MAX_HEIGHT).max(1);
+        let width = src_width.div_ceil(scale_x);
+        let height = src_height.div_ceil(scale_y);
+        if scale_x > 1 || scale_y > 1 {
+            log::warn!(
+                "Horizon: scaling FL9_1 virtual atlas {src_width}x{src_height} -> {width}x{height}"
+            );
+        }
+
+        let mut textures_vec = Vec::with_capacity(ATLAS_TILES);
+        let mut views_vec = Vec::with_capacity(ATLAS_TILES);
+        let mut active = [false; ATLAS_TILES];
+
+        for row in 0..ATLAS_ROWS {
+            for col in 0..ATLAS_COLS {
+                let idx = (row * ATLAS_COLS + col) as usize;
+                let tx0 = col * ATLAS_TILE_DIM;
+                let ty0 = row * ATLAS_TILE_DIM;
+                let used = tx0 < width && ty0 < height;
+                active[idx] = used;
+                let dim = if used { ATLAS_TILE_DIM } else { 1 };
+                let tex = device.create_texture(&wgpu::TextureDescriptor {
+                    label: Some("FL9_1 tiled atlas"),
+                    size: wgpu::Extent3d {
+                        width: dim,
+                        height: dim,
+                        depth_or_array_layers: 1,
+                    },
+                    mip_level_count: 1,
+                    sample_count: 1,
+                    dimension: wgpu::TextureDimension::D2,
+                    format: wgpu::TextureFormat::Rgba8Unorm,
+                    usage: wgpu::TextureUsages::TEXTURE_BINDING | wgpu::TextureUsages::COPY_DST,
+                    view_formats: &[],
+                });
+                if !used {
+                    queue.write_texture(
+                        wgpu::TexelCopyTextureInfo {
+                            texture: &tex,
+                            mip_level: 0,
+                            origin: wgpu::Origin3d::ZERO,
+                            aspect: wgpu::TextureAspect::All,
+                        },
+                        &[0, 0, 0, 0],
+                        wgpu::TexelCopyBufferLayout {
+                            offset: 0,
+                            bytes_per_row: Some(4),
+                            rows_per_image: Some(1),
+                        },
+                        wgpu::Extent3d {
+                            width: 1,
+                            height: 1,
+                            depth_or_array_layers: 1,
+                        },
+                    );
+                }
+                views_vec.push(tex.create_view(&Default::default()));
+                textures_vec.push(tex);
+            }
+        }
+
+        let atlas = Self {
+            width,
+            height,
+            src_width,
+            src_height,
+            scale_x,
+            scale_y,
+            textures: textures_vec.try_into().ok().unwrap(),
+            views: views_vec.try_into().ok().unwrap(),
+            active,
+        };
+        atlas.write_subrect(queue, 0, 0, src_width, src_height, rgba);
+        Ok(atlas)
+    }
+
+    pub fn grid_uniform(&self) -> [f32; 4] {
+        [
+            self.width as f32 / ATLAS_TILE_DIM as f32,
+            self.height as f32 / ATLAS_TILE_DIM as f32,
+            0.5 / ATLAS_TILE_DIM as f32,
+            self.width as f32,
+        ]
+    }
+
+    /// Writes `rgba` (`w * h * 4` tightly packed RGBA8 bytes) at virtual atlas
+    /// coordinates `(x, y)` immediately via [`wgpu::Queue::write_texture`].
+    pub fn write_subrect(&self, queue: &wgpu::Queue, x: u32, y: u32, w: u32, h: u32, rgba: &[u8]) {
+        self.for_each_tile_subrect(x, y, w, h, rgba, |tex, tx, ty, copy_w, copy_h, staging| {
+            queue.write_texture(
+                wgpu::TexelCopyTextureInfo {
+                    texture: tex,
+                    mip_level: 0,
+                    origin: wgpu::Origin3d { x: tx, y: ty, z: 0 },
+                    aspect: wgpu::TextureAspect::All,
+                },
+                staging,
+                wgpu::TexelCopyBufferLayout {
+                    offset: 0,
+                    bytes_per_row: Some(copy_w * 4),
+                    rows_per_image: Some(copy_h),
+                },
+                wgpu::Extent3d {
+                    width: copy_w,
+                    height: copy_h,
+                    depth_or_array_layers: 1,
+                },
+            );
+        });
+    }
+
+    /// Stages `rgba` into command-encoder uploads at virtual atlas coordinates `(x, y)`.
+    pub fn stage_subrect(
+        &self,
+        uploads: &mut super::upload::Uploads,
+        encoder: &mut wgpu::CommandEncoder,
+        x: u32,
+        y: u32,
+        w: u32,
+        h: u32,
+        rgba: &[u8],
+    ) {
+        self.for_each_tile_subrect(x, y, w, h, rgba, |tex, tx, ty, copy_w, copy_h, staging| {
+            uploads.texture(
+                encoder,
+                wgpu::TexelCopyTextureInfo {
+                    texture: tex,
+                    mip_level: 0,
+                    origin: wgpu::Origin3d { x: tx, y: ty, z: 0 },
+                    aspect: wgpu::TextureAspect::All,
+                },
+                copy_w,
+                copy_h,
+                staging,
+            );
+        });
+    }
+
+    fn for_each_tile_subrect(
+        &self,
+        mut x: u32,
+        mut y: u32,
+        mut w: u32,
+        mut h: u32,
+        rgba: &[u8],
+        mut emit: impl FnMut(&wgpu::Texture, u32, u32, u32, u32, &[u8]),
+    ) {
+        if w == 0 || h == 0 {
+            return;
+        }
+        let downsampled;
+        let pixels = if self.scale_x > 1 || self.scale_y > 1 {
+            let sx = self.scale_x;
+            let sy = self.scale_y;
+            let dw = (w / sx).max(1);
+            let dh = (h / sy).max(1);
+            let mut out = vec![0u8; dw as usize * dh as usize * 4];
+            for dy in 0..dh {
+                let src_y = (dy * sy).min(h - 1) as usize;
+                for dx in 0..dw {
+                    let src_x = (dx * sx).min(w - 1) as usize;
+                    let si = (src_y * w as usize + src_x) * 4;
+                    let di = (dy as usize * dw as usize + dx as usize) * 4;
+                    out[di..di + 4].copy_from_slice(&rgba[si..si + 4]);
+                }
+            }
+            x /= sx;
+            y /= sy;
+            w = dw;
+            h = dh;
+            downsampled = out;
+            downsampled.as_slice()
+        } else {
+            rgba
+        };
+        let x_end = x.saturating_add(w).min(self.width);
+        let y_end = y.saturating_add(h).min(self.height);
+        if x >= x_end || y >= y_end {
+            return;
+        }
+        let src_stride = w as usize * 4;
+        for row in 0..ATLAS_ROWS {
+            let ty0 = row * ATLAS_TILE_DIM;
+            let ty1 = ty0 + ATLAS_TILE_DIM;
+            let iy0 = y.max(ty0);
+            let iy1 = y_end.min(ty1);
+            if iy0 >= iy1 {
+                continue;
+            }
+            for col in 0..ATLAS_COLS {
+                let idx = (row * ATLAS_COLS + col) as usize;
+                if !self.active[idx] {
+                    continue;
+                }
+                let tx0 = col * ATLAS_TILE_DIM;
+                let tx1 = tx0 + ATLAS_TILE_DIM;
+                let ix0 = x.max(tx0);
+                let ix1 = x_end.min(tx1);
+                if ix0 >= ix1 {
+                    continue;
+                }
+                let copy_w = ix1 - ix0;
+                let copy_h = iy1 - iy0;
+                let row_bytes = copy_w as usize * 4;
+                let mut staging = Vec::with_capacity(row_bytes * copy_h as usize);
+                for sy in (iy0 - y)..(iy1 - y) {
+                    let row_start = sy as usize * src_stride + (ix0 - x) as usize * 4;
+                    staging.extend_from_slice(&pixels[row_start..row_start + row_bytes]);
+                }
+                emit(&self.textures[idx], ix0 - tx0, iy0 - ty0, copy_w, copy_h, &staging);
+            }
+        }
+    }
+}
