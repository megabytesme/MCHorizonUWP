+            atlas_grid: self
+                .tiled_atlas
+                .as_ref()
+                .map_or([1.0, 1.0, 0.5 / 2048.0, 2048.0], |t| t.grid_uniform()),
+            hurt_tint: fl91::unpack_rgba_unorm(g.colored_count[1]),
+            glint_tint: fl91::unpack_rgba_unorm(g.colored_count[2]),
+            dynamic_lights: [
