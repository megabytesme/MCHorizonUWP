+            + crumbling_quads
+            + translucent_crumbling_quads
+            + water_mask_quads
+            + swirl_quads
+            + shadow_quads
+            + translucent_particle_quads
+            + translucent_item_quads
+            + oit_entity_quads
+            + fluid_quads
+            + world_text_quads
+            + world_text_offset_quads
+            + native_solid_quads
+            + native_cutout_quads
+            + native_cutout_mipped_quads;
