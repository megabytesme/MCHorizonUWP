+    pub atlas_grid: [f32; 4],
+}
+
+/// Unpacks a `0xAABBGGRR` (`bytemuck`/u32) color packed like `unpack4x8unorm`.
+pub fn unpack_rgba_unorm(packed: u32) -> [f32; 4] {
+    [
+        (packed & 0xff) as f32 / 255.0,
+        ((packed >> 8) & 0xff) as f32 / 255.0,
+        ((packed >> 16) & 0xff) as f32 / 255.0,
+        ((packed >> 24) & 0xff) as f32 / 255.0,
+    ]
+}
