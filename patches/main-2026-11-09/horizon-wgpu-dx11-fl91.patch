+struct SectionGpu {
+    /// Arena page and first vertex of its solid quads, and after them its
+    /// translucent quads unless those have an arena of their own; (0, 0),
+    /// unused, when that leaves it no quads in `arena`.
+    page: u32,
+    start: u64,
