diff --git a/crates/horizon-client-render/src/hud_fl91.wgsl b/crates/horizon-client-render/src/hud_fl91.wgsl
new file mode 100644
index 0000000..ddd6271
--- /dev/null
+++ b/crates/horizon-client-render/src/hud_fl91.wgsl
@@ -0,0 +1,124 @@
+// Pure-float FL9_1 HUD, crosshair, vignette, and end-portal shaders.
+// Uses up to 6 virtual-atlas tiles + 2 glint textures (8 textures total per fragment stage).
+
+struct Fl91Hud {
+    size: vec4<f32>,
+    end_portal: array<vec4<f32>, 3>,
+    // virtual_w / 2048.0, virtual_h / 2048.0, 0.5 / 2048.0, virtual_h
+    atlas_grid: vec4<f32>,
+}
+
+@group(0) @binding(0) var<uniform> hud: Fl91Hud;
+@group(0) @binding(1) var atlas_0: texture_2d<f32>;
+@group(0) @binding(2) var atlas_1: texture_2d<f32>;
+@group(0) @binding(3) var atlas_2: texture_2d<f32>;
+@group(0) @binding(4) var atlas_3: texture_2d<f32>;
+@group(0) @binding(5) var atlas_4: texture_2d<f32>;
+@group(0) @binding(6) var atlas_5: texture_2d<f32>;
+@group(0) @binding(7) var atlas_sampler: sampler;
+@group(0) @binding(8) var linear_sampler: sampler;
+@group(0) @binding(9) var glint_tex: texture_2d<f32>;
+@group(0) @binding(10) var glint_sampler: sampler;
+@group(0) @binding(11) var glint_armor_tex: texture_2d<f32>;
+
+struct Out {
+    @builtin(position) clip: vec4<f32>,
+    @location(0) uv: vec2<f32>,
+    @location(1) color: vec4<f32>,
+    @location(2) proj: vec4<f32>,
+    @location(3) glint_uv: vec2<f32>,
+}
+
+@vertex fn vs_main(
+    @location(0) pos: vec2<f32>,
+    @location(1) uv: vec2<f32>,
+    @location(2) color: vec4<f32>,
+    @location(3) depth: f32,
+    @location(4) glint_uv: vec2<f32>,
+) -> Out {
+    let pixels = pos * hud.size.z;
+    var out: Out;
+    out.clip = vec4(pixels.x / hud.size.x * 2.0 - 1.0, 1.0 - pixels.y / hud.size.y * 2.0, depth, 1.0);
+    out.uv = uv;
+    out.color = color;
+    out.proj = vec4(out.clip.xy * 0.5 + 0.5, out.clip.zw);
+    out.glint_uv = glint_uv;
+    return out;
+}
+
+fn hud_sample_atlas(uv_in: vec2<f32>) -> vec4<f32> {
+    let t = uv_in * hud.atlas_grid.xy;
+    let c = select(0.0, 1.0, t.x >= 1.0);
+    let r = select(select(0.0, 1.0, t.y >= 1.0), 2.0, t.y >= 2.0);
+    let luv = clamp(vec2(t.x - c, t.y - r), vec2(0.0), vec2(1.0));
+    let s0 = textureSample(atlas_0, atlas_sampler, luv);
+    let s1 = textureSample(atlas_1, atlas_sampler, luv);
+    let s2 = textureSample(atlas_2, atlas_sampler, luv);
+    let s3 = textureSample(atlas_3, atlas_sampler, luv);
+    let s4 = textureSample(atlas_4, atlas_sampler, luv);
+    let s5 = textureSample(atlas_5, atlas_sampler, luv);
+    let r0 = mix(s0, s1, c);
+    let r1 = mix(s2, s3, c);
+    let r2 = mix(s4, s5, c);
+    return select(select(r0, r1, r > 0.5), r2, r > 1.5);
+}
+
+@fragment fn fs_main(in: Out) -> @location(0) vec4<f32> {
+    let is_glint = in.uv.x >= 2.0;
+    let is_armor = in.uv.x >= 4.0;
+    let offset = select(0.0, select(2.0, 4.0, is_armor), is_glint);
+    let base_texel = hud_sample_atlas(in.uv - vec2(offset, 0.0));
+    let guv = fract(in.glint_uv);
+    let item_g = textureSample(glint_tex, glint_sampler, guv);
+    let armor_g = textureSample(glint_armor_tex, glint_sampler, guv);
+
+    let g_raw = hud.size.w * select(item_g, armor_g, is_armor);
+    let tint = hud.end_portal[2].yzw;
+    let tinted = vec4(max(g_raw.r, max(g_raw.g, g_raw.b)) * tint, g_raw.a);
+    let glint = select(g_raw, tinted, tint.x >= 0.0);
+
+    let plain = base_texel * in.color;
+    let foil = vec4(glint.rgb * glint.rgb, base_texel.a);
+    let out_col = select(plain, foil, is_glint);
+    let cutoff = select(0.004, 0.1, is_glint);
+    if out_col.a < cutoff {
+        discard;
+    }
+    return out_col;
+}
+
+@fragment fn fs_crosshair(in: Out) -> @location(0) vec4<f32> {
+    let c = hud_sample_atlas(in.uv) * in.color;
+    if c.a <= 0.0 {
+        discard;
+    }
+    return c;
+}
+
+@fragment fn fs_vignette(in: Out) -> @location(0) vec4<f32> {
+    let t = in.uv * hud.atlas_grid.xy;
+    let c = select(0.0, 1.0, t.x >= 1.0);
+    let r = select(select(0.0, 1.0, t.y >= 1.0), 2.0, t.y >= 2.0);
+    let luv = clamp(vec2(t.x - c, t.y - r), vec2(0.0), vec2(1.0));
+    let s0 = textureSample(atlas_0, linear_sampler, luv);
+    let s1 = textureSample(atlas_1, linear_sampler, luv);
+    let s2 = textureSample(atlas_2, linear_sampler, luv);
+    let s3 = textureSample(atlas_3, linear_sampler, luv);
+    let s4 = textureSample(atlas_4, linear_sampler, luv);
+    let s5 = textureSample(atlas_5, linear_sampler, luv);
+    let r0 = mix(s0, s1, c);
+    let r1 = mix(s2, s3, c);
+    let r2 = mix(s4, s5, c);
+    let texel = select(select(r0, r1, r > 0.5), r2, r > 1.5);
+    return vec4(texel.rgb * in.color.rgb, 1.0);
+}
+
+@fragment fn fs_end_portal(in: Out) -> @location(0) vec4<f32> {
+    let st0 = fract(in.proj.xy / max(in.proj.w, 1e-4));
+    let uv0 = hud.end_portal[0].xy + st0 * hud.end_portal[0].zw;
+    let sky = hud_sample_atlas(uv0).rgb * vec3(0.022087, 0.098399, 0.110818);
+    let scroll = fract(st0 + vec2(0.15, hud.end_portal[2].x * 1.5));
+    let uv1 = hud.end_portal[1].xy + scroll * hud.end_portal[1].zw;
+    let portal = hud_sample_atlas(uv1).rgb * vec3(0.080955, 0.314821, 0.661491);
+    return vec4(sky + portal * 0.35, 1.0);
+}
