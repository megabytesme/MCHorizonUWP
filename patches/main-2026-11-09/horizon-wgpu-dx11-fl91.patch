+/// Largest power of two `<= n` (at least `1`).
+#[inline]
+fn prev_pot(n: u32) -> u32 {
+    if n <= 1 {
+        1
+    } else {
+        1u32 << (31 - n.leading_zeros())
+    }
+}
+
+/// Box-downsamples `6` stacked square RGBA8 cube faces (`6 * size * size * 4`)
+/// until `size <= max_dim` and `size` is a power of two.
+pub fn downsample_cube_faces_rgba8(texels: &[u8], mut size: u32, max_dim: u32) -> (u32, Vec<u8>) {
+    if size <= max_dim && size.is_power_of_two() {
+        return (size, texels.to_vec());
+    }
+    let mut cur = texels.to_vec();
+    let target = max_dim.max(1);
+    while size > target || !size.is_power_of_two() {
+        let next = if !size.is_power_of_two() {
+            prev_pot(size).min(target)
+        } else {
+            (size / 2).max(1)
+        };
+        let face_in = (size * size * 4) as usize;
+        let face_out = (next * next * 4) as usize;
+        let mut out = vec![0u8; face_out * 6];
+        for face in 0..6 {
+            let src = &cur[face * face_in..(face + 1) * face_in];
+            let dst = &mut out[face * face_out..(face + 1) * face_out];
+            for y in 0..next {
+                let sy0 = (y * size / next).min(size - 1);
+                let sy1 = ((sy0 + 1).min(size - 1)) as usize;
+                let sy0 = sy0 as usize;
+                for x in 0..next {
+                    let sx0 = (x * size / next).min(size - 1);
+                    let sx1 = ((sx0 + 1).min(size - 1)) as usize;
+                    let sx0 = sx0 as usize;
+                    let mut acc = [0u32; 4];
+                    for &(sx, sy) in &[(sx0, sy0), (sx1, sy0), (sx0, sy1), (sx1, sy1)] {
+                        let o = (sy * size as usize + sx) * 4;
+                        for c in 0..4 {
+                            acc[c] += u32::from(src[o + c]);
+                        }
+                    }
+                    let d = (y * next + x) as usize * 4;
+                    for c in 0..4 {
+                        dst[d + c] = ((acc[c] + 2) / 4) as u8;
+                    }
+                }
+            }
+        }
+        cur = out;
+        size = next;
+        if size <= target && size.is_power_of_two() {
+            break;
+        }
+    }
+    (size, cur)
+}
+
+/// Ensures an arbitrary RGBA8 image is POT and within `max_dim`, downsampling if needed.
+pub fn fit_rgba8_pot(png_bytes_or_rgba: &[u8], max_dim: u32) -> Option<(u32, u32, Vec<u8>)> {
+    let (w, h, rgba) = decode_bytes(png_bytes_or_rgba).ok()?;
+    let tw = prev_pot(w).min(max_dim).max(1);
+    let th = prev_pot(h).min(max_dim).max(1);
+    if tw == w && th == h {
+        return Some((w, h, rgba));
+    }
+    let mut out = vec![0u8; (tw * th * 4) as usize];
+    for y in 0..th {
+        let sy = (y * h / th).min(h - 1);
+        for x in 0..tw {
+            let sx = (x * w / tw).min(w - 1);
+            let s = ((sy * w + sx) * 4) as usize;
+            let d = ((y * tw + x) * 4) as usize;
+            out[d..d + 4].copy_from_slice(&rgba[s..s + 4]);
+        }
+    }
+    Some((tw, th, out))
+}
