-/// whole by then. A section's record (`FADING`) and its walk mark follow its
-/// `gpu_fading`. `rows`: the level's sections.
-fn mark_fades(
-    sections: &mut resident::Resident<SectionGpu>,
-    records: &mut gpu_culling::Records,
