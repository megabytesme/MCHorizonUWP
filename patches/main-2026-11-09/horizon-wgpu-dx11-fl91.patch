diff --git a/crates/horizon-client-render/src/border_fl91.wgsl b/crates/horizon-client-render/src/border_fl91.wgsl
new file mode 100644
index 0000000..59fed2b
--- /dev/null
+++ b/crates/horizon-client-render/src/border_fl91.wgsl
@@ -0,0 +1,35 @@
+// The FL9_1 world border wall (core/world_border): camera-relative wall quads
+// moved by the model offset, wrapping forcefield UVs in-shader so ClampToEdge
+// obeys FL9_1 repeat limits.
+struct Globals {
+    view_proj: mat4x4<f32>,
+}
+struct Border {
+    color: vec4<f32>,
+    // xyz: model offset, w: texture translation (u and v)
+    offset: vec4<f32>,
+}
+@group(0) @binding(0) var<uniform> globals: Globals;
+@group(0) @binding(1) var forcefield: texture_2d<f32>;
+@group(0) @binding(2) var forcefield_sampler: sampler;
+@group(0) @binding(3) var<uniform> border: Border;
+struct Out {
+    @builtin(position) clip: vec4<f32>,
+    @location(0) uv: vec2<f32>,
+}
+@vertex fn vs_border(@location(0) position: vec3<f32>, @location(1) uv: vec2<f32>) -> Out {
+    var out: Out;
+    out.clip = globals.view_proj * vec4(position + border.offset.xyz, 1.0);
+    out.uv = uv + vec2(border.offset.w);
+    return out;
+}
+@fragment fn fs_border(in: Out) -> @location(0) vec4<f32> {
+    return border_color(in);
+}
+fn border_color(in: Out) -> vec4<f32> {
+    let color = textureSample(forcefield, forcefield_sampler, fract(in.uv));
+    if color.a == 0.0 {
+        discard;
+    }
+    return color * border.color;
+}
diff --git a/crates/horizon-client-render/src/entity_fl91.wgsl b/crates/horizon-client-render/src/entity_fl91.wgsl
new file mode 100644
index 0000000..663ffe0
--- /dev/null
+++ b/crates/horizon-client-render/src/entity_fl91.wgsl
@@ -0,0 +1,435 @@
+// Pure-float FL9_1 entities, block entities, clouds, celestial bodies, and weather shaders.
+// Samples up to 6 2048x2048 virtual-atlas tiles + lightmap + item glint (8 textures total).
+
+struct Fl91Globals {
+    view_proj: mat4x4<f32>,
+    inverse_view: mat4x4<f32>,
+    fog_color: vec4<f32>,
+    fog: vec4<f32>,
+    sky_color: vec4<f32>,
+    misc: vec4<f32>,
+    sunrise: vec4<f32>,
+    sun: vec4<f32>,
+    fog_ends: vec4<f32>,
+    time: vec4<f32>,
+    crumbling_sprite: vec4<f32>,
+    outline_params: vec4<f32>,
+    end_portal_sprites: array<vec4<f32>, 2>,
+    sprite_sheet: vec4<f32>,
+    // virtual_w / 2048.0, virtual_h / 2048.0, 0.5 / 2048.0, virtual_w
+    atlas_grid: vec4<f32>,
+    hurt_tint: vec4<f32>,
+    glint_tint: vec4<f32>,
+    dynamic_lights: array<vec4<f32>, 4>,
+}
+
+@group(0) @binding(0) var<uniform> globals: Fl91Globals;
+@group(0) @binding(1) var atlas_0: texture_2d<f32>;
+@group(0) @binding(2) var atlas_1: texture_2d<f32>;
+@group(0) @binding(3) var atlas_2: texture_2d<f32>;
+@group(0) @binding(4) var atlas_3: texture_2d<f32>;
+@group(0) @binding(5) var atlas_4: texture_2d<f32>;
+@group(0) @binding(6) var atlas_5: texture_2d<f32>;
+@group(0) @binding(7) var atlas_sampler: sampler;
+@group(0) @binding(8) var lightmap: texture_2d<f32>;
+@group(0) @binding(9) var lightmap_sampler: sampler;
+@group(0) @binding(10) var glint_tex: texture_2d<f32>;
+@group(0) @binding(11) var glint_sampler: sampler;
+
+struct EntityOut {
+    @builtin(position) clip: vec4<f32>,
+    @location(0) uv_glint: vec4<f32>,
+    @location(1) color: vec4<f32>,
+    @location(2) overlay_mix: vec4<f32>,
+    @location(3) lm_wrap: vec4<f32>,
+    // x: spherical, y: cylindrical, z: unlit (0 or 1), w: wrap_mode (0 none, 1 beam, 2 weather/swirl)
+    @location(4) fog_flags: vec4<f32>,
+    // x: glint_enabled (0 or 1), y: untextured_rays (0 or 1), z: polytone_fog (0 or 1), w: cloud_or_portal
+    @location(5) mode: vec4<f32>,
+    // For weather tile rect or portal proj xy/w
+    @location(6) aux: vec4<f32>,
+}
+
+fn white_overlay_alpha(idx: f32) -> f32 {
+    if idx < 0.5 { return 0.99607843; }
+    if idx < 1.5 { return 0.99215686; }
+    if idx < 2.5 { return 0.9882353; }
+    if idx < 3.5 { return 0.9843137; }
+    if idx < 4.5 { return 0.98039216; }
+    if idx < 5.5 { return 0.9764706; }
+    if idx < 6.5 { return 0.972549; }
+    if idx < 7.5 { return 0.96862745; }
+    if idx < 8.5 { return 0.9647059; }
+    if idx < 9.5 { return 0.9607843; }
+    if idx < 10.5 { return 0.8784314; }
+    if idx < 11.5 { return 0.8; }
+    if idx < 12.5 { return 0.72156864; }
+    if idx < 13.5 { return 0.6431373; }
+    if idx < 14.5 { return 0.5647059; }
+    return 0.4862745;
+}
+
+fn overlay_texel(overlay: f32) -> vec4<f32> {
+    if (overlay > 0.5 && overlay < 1.5) || (overlay > 7.5 && overlay < 8.5) {
+        if globals.hurt_tint.a > 0.001 {
+            return globals.hurt_tint;
+        }
+        return vec4(1.0, 0.0, 0.0, 0.3019608);
+    }
+    if overlay > 4.5 && overlay < 5.5 {
+        return vec4(1.0, 1.0, 1.0, white_overlay_alpha(15.0));
+    }
+    if overlay >= 15.5 && overlay < 31.5 {
+        return vec4(1.0, 1.0, 1.0, white_overlay_alpha(overlay - 16.0));
+    }
+    return vec4(1.0);
+}
+
+fn entity_light(normal: vec3<f32>, nether: bool) -> f32 {
+    let l0 = normalize(vec3(0.2, 1.0, -0.7));
+    let l1 = normalize(vec3(-0.2, select(1.0, -1.0, nether), 0.7));
+    return min(1.0, (max(0.0, dot(l0, normal)) + max(0.0, dot(l1, normal))) * 0.6 + 0.4);
+}
+
+fn dynamic_block_light(pos: vec3<f32>) -> f32 {
+    let count = globals.time.z;
+    var level = 0.0;
+    if count > 0.5 {
+        let l0 = globals.dynamic_lights[0];
+        level = max(level, l0.w - distance(pos, l0.xyz));
+    }
+    if count > 1.5 {
+        let l1 = globals.dynamic_lights[1];
+        level = max(level, l1.w - distance(pos, l1.xyz));
+    }
+    if count > 2.5 {
+        let l2 = globals.dynamic_lights[2];
+        level = max(level, l2.w - distance(pos, l2.xyz));
+    }
+    if count > 3.5 {
+        let l3 = globals.dynamic_lights[3];
+        level = max(level, l3.w - distance(pos, l3.xyz));
+    }
+    return level * 16.0;
+}
+
+fn entity_vertex_common(
+    position: vec3<f32>,
+    uv: vec2<f32>,
+    overlay: f32,
+    color: vec4<f32>,
+    light_bytes: vec4<f32>,
+    normal_bytes: vec4<f32>,
+    glint_uv: vec2<f32>,
+) -> EntityOut {
+    var out: EntityOut;
+    out.clip = globals.view_proj * vec4(position, 1.0);
+
+    let light = floor(light_bytes * 255.0 + 0.5);
+    let block = max(light.y, dynamic_block_light(position));
+    let lm_uv = clamp(
+        vec2(block, light.x) / 256.0 + vec2(0.5 / 16.0),
+        vec2(0.5 / 16.0),
+        vec2(15.5 / 16.0),
+    );
+    let is_beam = overlay > 5.5 && overlay < 6.5;
+    let is_portal = (overlay > 8.5 && overlay < 10.5);
+    let is_crack = (overlay > 10.5 && overlay < 12.5);
+    let is_cloud = (overlay > 3.5 && overlay < 4.5);
+    let is_sky_cel = (overlay > 1.5 && overlay < 2.5);
+    let unlit = (is_sky_cel || is_cloud || is_beam || is_portal || is_crack);
+
+    let wrap = vec2(light.x + light.y * 256.0, light.z + light.w * 256.0) / 65535.0;
+    out.lm_wrap = vec4(lm_uv, wrap);
+
+    let nb = floor(normal_bytes * 255.0 + 0.5);
+    let normal = select(nb, nb - 256.0, nb >= vec4(128.0)) / 127.0;
+    var shaded = color;
+    if abs(normal.w) >= 0.5 {
+        shaded = vec4(color.rgb * entity_light(normal.xyz, globals.time.y != 0.0), color.a);
+    }
+
+    let is_glint_item = (overlay > 6.5 && overlay < 8.5)
+        || (overlay > 32.5 && overlay < 33.5)
+        || (overlay > 35.5 && overlay < 36.5);
+    let is_rays = (overlay > 36.5 && overlay < 37.5);
+    let is_polytone = (overlay > 44.5 && overlay < 45.5);
+
+    let ov = overlay_texel(overlay);
+    out.uv_glint = vec4(uv, glint_uv);
+    out.color = select(shaded, vec4(0.6, 0.6, 0.6, 1.0), is_portal);
+    out.overlay_mix = select(
+        vec4(ov.rgb * (1.0 - ov.a), ov.a),
+        vec4(0.03, 0.14, 0.18, 1.0),
+        is_portal,
+    );
+
+    let exempt_fog = overlay >= 1.5 && overlay < 4.5;
+    let d_sph = select(length(position), 0.0, exempt_fog);
+    let d_cyl = select(max(length(position.xz), abs(position.y)), 0.0, exempt_fog);
+    let sph_f = (d_sph - globals.fog.x) / max(globals.fog.y - globals.fog.x, 1e-5);
+    let cyl_f = (d_cyl - globals.fog.z) / max(globals.fog.w - globals.fog.z, 1e-5);
+    let cloud_f = length(position) / max(globals.fog_ends.y, 1e-4);
+    let wrap_mode = select(select(0.0, 1.0, is_beam), 2.0, is_crack);
+    out.fog_flags = vec4(
+        select(sph_f, cloud_f, is_cloud),
+        cyl_f,
+        select(0.0, 1.0, unlit),
+        wrap_mode,
+    );
+    out.mode = vec4(
+        select(0.0, globals.fog_ends.w, is_glint_item),
+        select(0.0, 1.0, is_rays),
+        select(0.0, 1.0, is_polytone),
+        select(select(0.0, 1.0, is_cloud), 2.0, is_portal),
+    );
+    out.aux = select(
+        vec4(0.0),
+        vec4(out.clip.xy * 0.5 + out.clip.w * 0.5, out.clip.zw),
+        is_portal,
+    );
+    return out;
+}
+
+@vertex fn vs_entity(
+    @location(0) position: vec3<f32>,
+    @location(1) uv: vec2<f32>,
+    @location(2) layer_bytes: vec4<f32>,
+    @location(3) color: vec4<f32>,
+    @location(4) light_bytes: vec4<f32>,
+    @location(5) normal_bytes: vec4<f32>,
+    @location(6) glint_uv: vec2<f32>,
+) -> EntityOut {
+    let lb = floor(layer_bytes * 255.0 + 0.5);
+    let overlay = lb.x + lb.y * 256.0;
+    return entity_vertex_common(position, uv, overlay, color, light_bytes, normal_bytes, glint_uv);
+}
+
+@vertex fn vs_lightning(
+    @location(0) position: vec3<f32>,
+    @location(1) uv: vec2<f32>,
+    @location(2) layer_bytes: vec4<f32>,
+    @location(3) color: vec4<f32>,
+    @location(4) light_bytes: vec4<f32>,
+    @location(5) normal_bytes: vec4<f32>,
+    @location(7) offset: vec3<f32>,
+) -> EntityOut {
+    let lb = floor(layer_bytes * 255.0 + 0.5);
+    let overlay = lb.x + lb.y * 256.0;
+    return entity_vertex_common(offset + position, uv, overlay, color, light_bytes, normal_bytes, vec2(0.0));
+}
+
+struct CloudInfo {
+    offset: vec4<f32>,
+    colors: array<vec4<f32>, 4>,
+}
+@group(1) @binding(0) var<uniform> cloud: CloudInfo;
+
+fn pick_cloud_color(idx: f32) -> vec4<f32> {
+    var c = cloud.colors[0];
+    c = select(c, cloud.colors[1], idx > 0.5 && idx < 1.5);
+    c = select(c, cloud.colors[2], idx >= 1.5 && idx < 2.5);
+    c = select(c, cloud.colors[3], idx >= 2.5);
+    return c;
+}
+
+@vertex fn vs_cloud(
+    @location(0) position: vec3<f32>,
+    @location(1) uv: vec2<f32>,
+    @location(2) layer_bytes: vec4<f32>,
+    @location(3) _color: vec4<f32>,
+    @location(4) light_bytes: vec4<f32>,
+    @location(5) normal_bytes: vec4<f32>,
+) -> EntityOut {
+    let lb = floor(layer_bytes * 255.0 + 0.5);
+    let overlay = lb.x + lb.y * 256.0;
+    let light = floor(light_bytes * 255.0 + 0.5);
+    let tint = pick_cloud_color(light.x);
+    return entity_vertex_common(position + cloud.offset.xyz, uv, overlay, tint, light_bytes, normal_bytes, vec2(0.0));
+}
+
+struct Fl91StaticEntityUniform {
+    camera_block: vec4<f32>,
+    camera_fraction: vec4<f32>,
+}
+@group(1) @binding(0) var<uniform> static_entity: Fl91StaticEntityUniform;
+
+@vertex fn vs_static_entity(
+    @location(0) position: vec3<f32>,
+    @location(1) uv: vec2<f32>,
+    @location(2) layer_bytes: vec4<f32>,
+    @location(3) color: vec4<f32>,
+    @location(4) light_bytes: vec4<f32>,
+    @location(5) normal_bytes: vec4<f32>,
+    @location(6) glint_uv: vec2<f32>,
+    @location(7) section_origin: vec3<f32>,
+) -> EntityOut {
+    let lb = floor(layer_bytes * 255.0 + 0.5);
+    let overlay = lb.x + lb.y * 256.0;
+    let block_delta = section_origin - static_entity.camera_block.xyz;
+    let camera_relative = block_delta + position - static_entity.camera_fraction.xyz;
+    return entity_vertex_common(camera_relative, uv, overlay, color, light_bytes, normal_bytes, glint_uv);
+}
+
+struct WeatherTime {
+    values: vec4<f32>,
+}
+@group(1) @binding(1) var<uniform> weather_time: WeatherTime;
+
+@vertex fn vs_weather(
+    @location(0) position: vec3<f32>,
+    @location(1) uv: vec2<f32>,
+    @location(2) rect: vec4<f32>,
+    @location(3) animation: vec4<f32>,
+    @location(4) _bases_low: vec4<f32>,
+    @location(5) color: vec4<f32>,
+    @location(6) light_bytes: vec4<f32>,
+    @location(7) snow_bytes: vec4<f32>,
+) -> EntityOut {
+    let snow_val = select(0.0, 1.0, snow_bytes.x > 0.001);
+    let t = weather_time.values.x + weather_time.values.z;
+    var phase = vec2(0.0, 0.0);
+    if snow_val < 0.5 {
+        let step_rain = -(t + animation.y) / 32.0;
+        let prod = step_rain * animation.x;
+        phase = vec2(0.0, prod - floor(prod / 32.0) * 32.0);
+    } else {
+        let du = t * 0.01 * animation.z;
+        let dv = t * animation.w * 0.001;
+        let fall = -(weather_time.values.y + weather_time.values.z) / 512.0;
+        phase = vec2(du, fall + dv);
+    }
+    var out = entity_vertex_common(position, uv + phase, 0.0, color, light_bytes, vec4(0.0), vec2(0.0));
+    out.aux = rect;
+    return out;
+}
+
+fn sample_tiled_atlas(uv_in: vec2<f32>) -> vec4<f32> {
+    let t = uv_in * globals.atlas_grid.xy;
+    let c = step(1.0, t.x);
+    let r1w = step(1.0, t.y);
+    let r2w = step(2.0, t.y);
+    let luv = clamp(vec2(t.x - c, t.y - (r1w + r2w)), vec2(0.0), vec2(1.0));
+    let s0 = textureSample(atlas_0, atlas_sampler, luv);
+    let s1 = textureSample(atlas_1, atlas_sampler, luv);
+    let s2 = textureSample(atlas_2, atlas_sampler, luv);
+    let s3 = textureSample(atlas_3, atlas_sampler, luv);
+    let s4 = textureSample(atlas_4, atlas_sampler, luv);
+    let s5 = textureSample(atlas_5, atlas_sampler, luv);
+    let r01 = mix(mix(s0, s1, c), mix(s2, s3, c), r1w);
+    return mix(r01, mix(s4, s5, c), r2w);
+}
+
+fn entity_fog_factor(fog_flags: vec4<f32>) -> f32 {
+    return clamp(max(fog_flags.x, fog_flags.y), 0.0, 1.0);
+}
+
+fn entity_color(in: EntityOut) -> vec4<f32> {
+    let fw = fract(in.uv_glint.xy);
+    let beam_uv = vec2(in.uv_glint.x, in.lm_wrap.z + fw.y * in.lm_wrap.w);
+    let crack_uv = in.lm_wrap.zw + fw * globals.crumbling_sprite.zw;
+    let uv = select(
+        select(in.uv_glint.xy, beam_uv, in.fog_flags.w > 0.5),
+        crack_uv,
+        in.fog_flags.w > 1.5,
+    );
+    let portal_uv = globals.end_portal_sprites[0].xy + fract(in.aux.xy / max(in.aux.w, 1e-4)) * globals.end_portal_sprites[0].zw;
+    let sample_uv = select(uv, portal_uv, in.mode.w > 1.5);
+    let texel = sample_tiled_atlas(sample_uv);
+    let lm = mix(textureSample(lightmap, lightmap_sampler, in.lm_wrap.xy).rgb, vec3(1.0), in.fog_flags.z);
+    let gl = textureSample(glint_tex, glint_sampler, fract(in.uv_glint.zw));
+
+    let scaled = texel * in.color;
+    var a = select(scaled.a, 1.0, in.mode.w > 1.5);
+    if a < 0.1 {
+        discard;
+    }
+    let gl_max = max(gl.r, max(gl.g, gl.b));
+    let gl_src = select(gl.rgb, gl_max * globals.glint_tint.rgb, globals.glint_tint.a > 0.001) * in.mode.x;
+    var rgb = (in.overlay_mix.rgb + scaled.rgb * in.overlay_mix.a) * lm + gl_src * gl_src;
+    a = max(a, in.mode.x);
+    let f = entity_fog_factor(in.fog_flags) * globals.fog_color.a;
+    return vec4(mix(rgb, globals.fog_color.rgb, f), a);
