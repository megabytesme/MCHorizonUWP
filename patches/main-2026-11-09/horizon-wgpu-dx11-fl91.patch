diff --git a/crates/horizon-client-render/src/screen_fl91.wgsl b/crates/horizon-client-render/src/screen_fl91.wgsl
new file mode 100644
index 0000000..cb4d482
--- /dev/null
+++ b/crates/horizon-client-render/src/screen_fl91.wgsl
@@ -0,0 +1,136 @@
+// Pure-float FL9_1 full-screen camera effects shader reading from the 6-tile atlas.
+
+struct Fl91Globals {
+    view_proj: mat4x4<f32>,
+    inverse_view: mat4x4<f32>,
+    fog_color: vec4<f32>,
+    fog: vec4<f32>,
+    sky_color: vec4<f32>,
+    misc: vec4<f32>,
+    sunrise: vec4<f32>,
+    sun: vec4<f32>,
+    fog_ends: vec4<f32>,
+    time: vec4<f32>,
+    crumbling_sprite: vec4<f32>,
+    outline_params: vec4<f32>,
+    end_portal_sprites: array<vec4<f32>, 2>,
+    sprite_sheet: vec4<f32>,
+    atlas_grid: vec4<f32>,
+    hurt_tint: vec4<f32>,
+    glint_tint: vec4<f32>,
+    dynamic_lights: array<vec4<f32>, 4>,
+}
+
+@group(0) @binding(0) var<uniform> globals: Fl91Globals;
+@group(0) @binding(1) var atlas_0: texture_2d<f32>;
+@group(0) @binding(2) var atlas_1: texture_2d<f32>;
+@group(0) @binding(3) var atlas_2: texture_2d<f32>;
+@group(0) @binding(4) var atlas_3: texture_2d<f32>;
+@group(0) @binding(5) var atlas_4: texture_2d<f32>;
+@group(0) @binding(6) var atlas_5: texture_2d<f32>;
+@group(0) @binding(7) var nearest_sampler: sampler;
+@group(0) @binding(9) var linear_sampler: sampler;
+
+override CLAMP: bool = false;
+
+struct Out {
+    @builtin(position) clip: vec4<f32>,
+    @location(0) uv: vec2<f32>,
+    @location(1) rect: vec4<f32>,
+    @location(2) color: vec4<f32>,
+    @location(3) edges: vec4<f32>,
+}
+
+@vertex fn vs_screen(
+    @location(0) pos: vec2<f32>,
+    @location(1) uv: vec2<f32>,
+    @location(2) rect: vec4<f32>,
+    @location(3) color: vec4<f32>,
+) -> Out {
+    var out: Out;
+    out.clip = vec4(pos, 0.0, 1.0);
+    out.uv = uv;
+    out.rect = rect;
+    out.color = color;
+    let half = globals.atlas_grid.z / max(globals.atlas_grid.xy, vec2(0.001));
+    out.edges = vec4(rect.xy + half, rect.zw - half);
+    return out;
+}
+
+fn screen_uv(in: Out) -> vec2<f32> {
+    var f = in.uv;
+    if !CLAMP {
+        f = fract(f);
+    }
+    let uv = in.rect.xy + f * (in.rect.zw - in.rect.xy);
+    if CLAMP {
+        return clamp(uv, in.edges.xy, in.edges.zw);
+    }
+    return uv;
+}
+
+@fragment fn fs_screen(in: Out) -> @location(0) vec4<f32> {
+    let t = screen_uv(in) * globals.atlas_grid.xy;
+    let c = select(0.0, 1.0, t.x >= 1.0);
+    let r = select(select(0.0, 1.0, t.y >= 1.0), 2.0, t.y >= 2.0);
+    let luv = clamp(vec2(t.x - c, t.y - r), vec2(0.0), vec2(1.0));
+    let s0 = textureSample(atlas_0, nearest_sampler, luv);
+    let s1 = textureSample(atlas_1, nearest_sampler, luv);
+    let s2 = textureSample(atlas_2, nearest_sampler, luv);
+    let s3 = textureSample(atlas_3, nearest_sampler, luv);
+    let s4 = textureSample(atlas_4, nearest_sampler, luv);
+    let s5 = textureSample(atlas_5, nearest_sampler, luv);
+    let res = select(select(mix(s0, s1, c), mix(s2, s3, c), r > 0.5), mix(s4, s5, c), r > 1.5) * in.color;
+    if res.a <= 0.0 {
+        discard;
+    }
+    return res;
+}
+
+@fragment fn fs_screen_blur(in: Out) -> @location(0) vec4<f32> {
+    let t = screen_uv(in) * globals.atlas_grid.xy;
+    let c = select(0.0, 1.0, t.x >= 1.0);
+    let r = select(select(0.0, 1.0, t.y >= 1.0), 2.0, t.y >= 2.0);
+    let luv = clamp(vec2(t.x - c, t.y - r), vec2(0.0), vec2(1.0));
+    let s0 = textureSample(atlas_0, linear_sampler, luv);
+    let s1 = textureSample(atlas_1, linear_sampler, luv);
+    let s2 = textureSample(atlas_2, linear_sampler, luv);
+    let s3 = textureSample(atlas_3, linear_sampler, luv);
+    let s4 = textureSample(atlas_4, linear_sampler, luv);
+    let s5 = textureSample(atlas_5, linear_sampler, luv);
+    let res = select(select(mix(s0, s1, c), mix(s2, s3, c), r > 0.5), mix(s4, s5, c), r > 1.5) * in.color;
+    if res.a <= 0.0 {
+        discard;
+    }
+    return res;
+}
+
+@fragment fn fs_vignette(in: Out) -> @location(0) vec4<f32> {
+    let t = screen_uv(in) * globals.atlas_grid.xy;
+    let c = select(0.0, 1.0, t.x >= 1.0);
+    let r = select(select(0.0, 1.0, t.y >= 1.0), 2.0, t.y >= 2.0);
+    let luv = clamp(vec2(t.x - c, t.y - r), vec2(0.0), vec2(1.0));
+    let s0 = textureSample(atlas_0, nearest_sampler, luv);
+    let s1 = textureSample(atlas_1, nearest_sampler, luv);
+    let s2 = textureSample(atlas_2, nearest_sampler, luv);
+    let s3 = textureSample(atlas_3, nearest_sampler, luv);
+    let s4 = textureSample(atlas_4, nearest_sampler, luv);
+    let s5 = textureSample(atlas_5, nearest_sampler, luv);
+    let res = select(select(mix(s0, s1, c), mix(s2, s3, c), r > 0.5), mix(s4, s5, c), r > 1.5) * in.color;
+    return vec4(res.rgb, 1.0);
+}
+
+@fragment fn fs_vignette_blur(in: Out) -> @location(0) vec4<f32> {
+    let t = screen_uv(in) * globals.atlas_grid.xy;
+    let c = select(0.0, 1.0, t.x >= 1.0);
+    let r = select(select(0.0, 1.0, t.y >= 1.0), 2.0, t.y >= 2.0);
+    let luv = clamp(vec2(t.x - c, t.y - r), vec2(0.0), vec2(1.0));
+    let s0 = textureSample(atlas_0, linear_sampler, luv);
+    let s1 = textureSample(atlas_1, linear_sampler, luv);
+    let s2 = textureSample(atlas_2, linear_sampler, luv);
+    let s3 = textureSample(atlas_3, linear_sampler, luv);
+    let s4 = textureSample(atlas_4, linear_sampler, luv);
+    let s5 = textureSample(atlas_5, linear_sampler, luv);
+    let res = select(select(mix(s0, s1, c), mix(s2, s3, c), r > 0.5), mix(s4, s5, c), r > 1.5) * in.color;
+    return vec4(res.rgb, 1.0);
+}
diff --git a/crates/horizon-client-render/src/terrain_fl91.wgsl b/crates/horizon-client-render/src/terrain_fl91.wgsl
new file mode 100644
index 0000000..dc48c28
--- /dev/null
+++ b/crates/horizon-client-render/src/terrain_fl91.wgsl
@@ -0,0 +1,505 @@
+// Pure-float FL9_1 terrain, native-fluid/model, sky, sunrise, and line shaders.
+// Self-contained: no integer operations, @interpolate(flat), vertex textures,
+// textureDimensions, textureLoad, textureSampleLevel, or derivatives.
+
+struct Fl91Globals {
+    view_proj: mat4x4<f32>,
+    inverse_view: mat4x4<f32>,
+    fog_color: vec4<f32>,
+    fog: vec4<f32>,
+    sky_color: vec4<f32>,
+    misc: vec4<f32>,
+    sunrise: vec4<f32>,
+    sun: vec4<f32>,
+    fog_ends: vec4<f32>,
+    time: vec4<f32>,
+    crumbling_sprite: vec4<f32>,
+    outline_params: vec4<f32>,
+    end_portal_sprites: array<vec4<f32>, 2>,
+    // cols, rows, sheet_capacity, sprite_edge
+    sprite_sheet: vec4<f32>,
+    // virtual_w / 2048.0, virtual_h / 2048.0, 0.5 / 2048.0, virtual_w
+    atlas_grid: vec4<f32>,
+    hurt_tint: vec4<f32>,
+    glint_tint: vec4<f32>,
+    dynamic_lights: array<vec4<f32>, 4>,
+}
+
+@group(0) @binding(0) var<uniform> globals: Fl91Globals;
+@group(0) @binding(1) var sprites_0: texture_2d<f32>;
+@group(0) @binding(2) var sprite_sampler: sampler;
+@group(0) @binding(3) var lightmap: texture_2d<f32>;
+@group(0) @binding(4) var lightmap_sampler: sampler;
+@group(0) @binding(5) var sprites_1: texture_2d<f32>;
+@group(0) @binding(6) var sprites_2: texture_2d<f32>;
+@group(0) @binding(7) var sprites_3: texture_2d<f32>;
+
+override NATIVE_MODEL_ALPHA_CUTOFF: f32 = 0.0;
+
+struct TerrainWire {
+    @builtin(position) clip: vec4<f32>,
+    @location(0) color: vec4<f32>,
+    @location(1) uv_lm: vec4<f32>,
+    // xy: cell origin in sheet UV, z: sheet index, w: is_tiled (0 or 1)
+    @location(2) cell_info: vec4<f32>,
+    // x: spherical, y: cylindrical, z: visibility, w: height
+    @location(3) fog_info: vec4<f32>,
+    // x: is_opaque (0 or 1), y: shaded (for native models), zw: normal/unused
+    @location(4) flags: vec4<f32>,
+}
+
+fn dynamic_block_light(pos: vec3<f32>) -> f32 {
+    let count = globals.time.z;
+    var level = 0.0;
+    if count > 0.5 {
+        let l0 = globals.dynamic_lights[0];
+        level = max(level, l0.w - distance(pos, l0.xyz));
+    }
+    if count > 1.5 {
+        let l1 = globals.dynamic_lights[1];
+        level = max(level, l1.w - distance(pos, l1.xyz));
+    }
+    if count > 2.5 {
+        let l2 = globals.dynamic_lights[2];
+        level = max(level, l2.w - distance(pos, l2.xyz));
+    }
+    if count > 3.5 {
+        let l3 = globals.dynamic_lights[3];
+        level = max(level, l3.w - distance(pos, l3.xyz));
+    }
+    return level * 16.0;
+}
+
+fn fl91_lightmap_uv(sky_255: f32, block_255: f32) -> vec2<f32> {
+    let uv = vec2(block_255, sky_255) / 256.0 + vec2(0.5 / 16.0);
+    return clamp(uv, vec2(0.5 / 16.0), vec2(15.5 / 16.0));
+}
+
+fn decode_instance_step(w: f32) -> f32 {
+    if w > 0.0 && w < 0.001 {
+        return 1.0 / 32768.0;
+    }
+    if w > 0.0 {
+        return 1.0 / 32.0;
+    }
+    return fract(abs(w));
+}
+
+fn decode_instance_visibility(w: f32) -> f32 {
+    if w > 0.0 && w < 0.001 {
+        return clamp(2.0 - w * 32768.0, 0.0, 1.0);
+    }
+    return 1.0;
+}
+
+fn decode_fade_code(w: f32) -> f32 {
+    return floor(max(-w, 0.0));
+}
+
+fn fade_depth(clip: vec4<f32>, w: f32) -> vec4<f32> {
+    let step = decode_instance_step(w);
+    let tile = step > 0.001;
+    let code = decode_fade_code(w);
+    var scale = select(1.0, 1.0 - 2e-3, tile);
+    if code > 0.5 && !tile {
+        scale *= 1.02;
+    }
+    return vec4(clip.xy, clip.z * scale, clip.w);
+}
+
+fn make_cell_info(sprite_layer: f32, is_tiled: f32) -> vec4<f32> {
+    let cols = globals.sprite_sheet.x;
+    let rows = globals.sprite_sheet.y;
+    let cap = globals.sprite_sheet.z;
+    let sheet = floor(sprite_layer / cap);
+    let in_sheet = sprite_layer - sheet * cap;
+    let row = floor(in_sheet / cols);
+    let col = in_sheet - row * cols;
+    return vec4(col / cols, row / rows, sheet, is_tiled);
+}
+
+fn terrain_vertex_common(
+    position: vec3<f32>,
+    uv_bytes: vec4<f32>,
+    layer_light: vec4<f32>,
+    color: vec4<f32>,
+    origin: vec4<f32>,
+    only_opaque: f32,
+    only_cutout: f32,
+) -> TerrainWire {
+    let ll = floor(layer_light * 255.0 + 0.5);
+    let raw_layer = ll.x + ll.y * 256.0;
+    let opaque_bit = step(32768.0, raw_layer);
+    let sprite_layer = raw_layer - opaque_bit * 32768.0;
+    let fade = decode_fade_code(origin.w);
+    let is_opaque_quad = select(0.0, 1.0, opaque_bit > 0.5 && fade < 0.5);
+
+    var out: TerrainWire;
+    if (only_opaque > 0.5 && is_opaque_quad < 0.5) || (only_cutout > 0.5 && is_opaque_quad > 0.5) {
+        out.clip = vec4(2.0, 2.0, 2.0, 1.0);
+        return out;
+    }
+
+    let ub = floor(uv_bytes * 255.0 + 0.5);
+    let packed_uv = vec2(ub.x + ub.y * 256.0, ub.z + ub.w * 256.0);
+    let step_uv = decode_instance_step(origin.w);
+    let uv = packed_uv * step_uv;
+    let is_tiled = select(0.0, 1.0, step_uv > 0.001);
+
+    let pos = position + origin.xyz;
+    out.clip = fade_depth(globals.view_proj * vec4(pos, 1.0), origin.w);
+
+    let block = max(ll.w, dynamic_block_light(pos));
+    let lm_uv = fl91_lightmap_uv(ll.z, block);
+    out.color = color;
+    out.uv_lm = vec4(uv, lm_uv);
+    out.cell_info = make_cell_info(sprite_layer, is_tiled);
+
+    let d_sph = length(pos);
+    let d_cyl = max(length(pos.xz), abs(pos.y));
+    let vis = mix(
+        1.0,
+        decode_instance_visibility(origin.w),
+        clamp((d_sph - 16.0) / 16.0, 0.0, 1.0),
+    );
+    out.fog_info = vec4(d_sph, d_cyl, vis, pos.y);
+    out.flags = vec4(opaque_bit, 1.0, 0.0, 0.0);
+    return out;
+}
+
+@vertex fn vs_terrain(
+    @location(0) position: vec3<f32>,
+    @location(1) uv_bytes: vec4<f32>,
+    @location(2) layer_light: vec4<f32>,
+    @location(3) color: vec4<f32>,
+    @location(5) origin: vec4<f32>,
+) -> TerrainWire {
+    return terrain_vertex_common(position, uv_bytes, layer_light, color, origin, 0.0, 0.0);
+}
+
+@vertex fn vs_terrain_opaque(
+    @location(0) position: vec3<f32>,
+    @location(1) uv_bytes: vec4<f32>,
+    @location(2) layer_light: vec4<f32>,
+    @location(3) color: vec4<f32>,
+    @location(5) origin: vec4<f32>,
+) -> TerrainWire {
+    return terrain_vertex_common(position, uv_bytes, layer_light, color, origin, 1.0, 0.0);
+}
+
+@vertex fn vs_terrain_cutout(
+    @location(0) position: vec3<f32>,
+    @location(1) uv_bytes: vec4<f32>,
+    @location(2) layer_light: vec4<f32>,
+    @location(3) color: vec4<f32>,
+    @location(5) origin: vec4<f32>,
+) -> TerrainWire {
+    return terrain_vertex_common(position, uv_bytes, layer_light, color, origin, 0.0, 1.0);
+}
+
+fn sample_sprite_sheet(uv_in: vec2<f32>, cell_info: vec4<f32>) -> vec4<f32> {
+    let wrapped = uv_in - max(ceil(uv_in) - 1.0, vec2(0.0));
+    let local_uv = mix(clamp(uv_in, vec2(0.0), vec2(1.0)), wrapped, cell_info.w);
+    let pad = 0.25 / globals.sprite_sheet.w;
+    let safe_uv = clamp(local_uv, vec2(pad), vec2(1.0 - pad));
+    let sheet_uv = cell_info.xy + safe_uv / globals.sprite_sheet.xy;
+    let t0 = textureSample(sprites_0, sprite_sampler, sheet_uv);
+    let t1 = textureSample(sprites_1, sprite_sampler, sheet_uv);
+    let t2 = textureSample(sprites_2, sprite_sampler, sheet_uv);
+    let t3 = textureSample(sprites_3, sprite_sampler, sheet_uv);
+    let t01 = select(t0, t1, cell_info.z > 0.5);
+    let t23 = select(t2, t3, cell_info.z > 2.5);
+    return select(t01, t23, cell_info.z > 1.5);
+}
+
+fn finish_terrain_fog(rgb: vec3<f32>, fog_info: vec4<f32>) -> vec3<f32> {
+    let vis_rgb = mix(globals.fog_color.rgb, rgb, fog_info.z);
+    let f_s = clamp((fog_info.x - globals.fog.x) / max(globals.fog.y - globals.fog.x, 1e-5), 0.0, 1.0);
+    let f_c = clamp((fog_info.y - globals.fog.z) / max(globals.fog.w - globals.fog.z, 1e-5), 0.0, 1.0);
+    let f = max(f_s, f_c) * globals.fog_color.a;
+    return mix(vis_rgb, globals.fog_color.rgb, f);
+}
+
+@fragment fn fs_opaque(in: TerrainWire) -> @location(0) vec4<f32> {
+    let texel = sample_sprite_sheet(in.uv_lm.xy, in.cell_info);
+    let lm = textureSample(lightmap, lightmap_sampler, in.uv_lm.zw);
+    let rgb = finish_terrain_fog(texel.rgb * in.color.rgb * lm.rgb, in.fog_info);
+    return vec4(rgb, 1.0);
+}
+
+@fragment fn fs_solid(in: TerrainWire) -> @location(0) vec4<f32> {
+    let texel = sample_sprite_sheet(in.uv_lm.xy, in.cell_info);
+    let lm = textureSample(lightmap, lightmap_sampler, in.uv_lm.zw);
+    let alpha = texel.a * in.color.a;
+    if alpha < 0.5 && in.flags.x < 0.5 {
+        discard;
+    }
+    let rgb = finish_terrain_fog(texel.rgb * in.color.rgb * lm.rgb, in.fog_info);
+    return vec4(rgb, 1.0);
+}
+
+@fragment fn fs_solid_mirror(in: TerrainWire) -> @location(0) vec4<f32> {
+    let texel = sample_sprite_sheet(in.uv_lm.xy, in.cell_info);
+    let lm = textureSample(lightmap, lightmap_sampler, in.uv_lm.zw);
+    let alpha = texel.a * in.color.a;
+    if in.fog_info.w < globals.fog_ends.w || (alpha < 0.5 && in.flags.x < 0.5) {
+        discard;
+    }
+    let rgb = finish_terrain_fog(texel.rgb * in.color.rgb * lm.rgb, in.fog_info);
+    return vec4(rgb, 1.0);
+}
+
+@fragment fn fs_translucent(in: TerrainWire) -> @location(0) vec4<f32> {
+    let texel = sample_sprite_sheet(in.uv_lm.xy, in.cell_info);
+    let lm = textureSample(lightmap, lightmap_sampler, in.uv_lm.zw);
+    let alpha = texel.a * in.color.a;
+    if alpha < 0.01 {
+        discard;
+    }
+    let rgb = finish_terrain_fog(texel.rgb * in.color.rgb * lm.rgb, in.fog_info);
+    return vec4(rgb, alpha);
+}
+
+@fragment fn fs_translucent_mark(in: TerrainWire) -> @location(0) vec4<f32> {
+    let texel = sample_sprite_sheet(in.uv_lm.xy, in.cell_info);
+    if texel.a < 0.6 {
+        discard;
+    }
+    return vec4(0.0, 0.0, 0.0, 1.0);
+}
+
+fn native_material_vertex(
+    position: vec3<f32>,
+    uv: vec2<f32>,
+    layer_bytes: vec4<f32>,
+    color: vec4<f32>,
+    light_bytes: vec4<f32>,
+    normal: vec3<f32>,
+    apply_normal_shade: bool,
+) -> TerrainWire {
+    let lb = floor(layer_bytes * 255.0 + 0.5);
+    let layer = lb.x + lb.y * 256.0;
+    let light = floor(light_bytes * 255.0 + 0.5);
+    let block = max(light.y, dynamic_block_light(position));
+    var c = color;
+    if apply_normal_shade && dot(normal, normal) > 0.0 {
+        let l0 = normalize(vec3(0.2, 1.0, -0.7));
+        let l1 = normalize(vec3(-0.2, select(1.0, -1.0, globals.time.y > 0.5), 0.7));
+        let shade = min(1.0, (max(0.0, dot(l0, normal)) + max(0.0, dot(l1, normal))) * 0.6 + 0.4);
+        c = vec4(c.rgb * shade, c.a);
+    }
+    var out: TerrainWire;
+    out.clip = globals.view_proj * vec4(position, 1.0);
+    out.color = c;
+    out.uv_lm = vec4(uv, fl91_lightmap_uv(light.x, block));
+    out.cell_info = make_cell_info(layer, 0.0);
+    out.fog_info = vec4(length(position), max(length(position.xz), abs(position.y)), 1.0, position.y);
+    out.flags = vec4(0.0, 1.0, 0.0, 0.0);
+    return out;
+}
+
+@vertex fn vs_native_fluid(
+    @location(0) position: vec3<f32>,
+    @location(1) uv: vec2<f32>,
+    @location(2) layer_bytes: vec4<f32>,
+    @location(3) color: vec4<f32>,
+    @location(4) light_bytes: vec4<f32>,
+    @location(5) normal_bytes: vec4<f32>,
+    @location(6) _glint_uv: vec2<f32>,
+) -> TerrainWire {
+    let nb = floor(normal_bytes * 255.0 + 0.5);
+    let ns = select(nb, nb - 256.0, nb >= vec4(128.0)) / 127.0;
+    return native_material_vertex(position, uv, layer_bytes, color, light_bytes, ns.xyz, false);
+}
+
+@fragment fn fs_native_fluid(in: TerrainWire) -> @location(0) vec4<f32> {
+    let texel = sample_sprite_sheet(in.uv_lm.xy, in.cell_info);
+    let lm = textureSample(lightmap, lightmap_sampler, in.uv_lm.zw);
+    let alpha = texel.a * in.color.a;
+    if alpha < 0.01 {
+        discard;
+    }
+    let rgb = finish_terrain_fog(texel.rgb * in.color.rgb * lm.rgb, in.fog_info);
+    return vec4(rgb, alpha);
+}
+
+@vertex fn vs_native_model(
+    @location(0) position: vec3<f32>,
+    @location(1) uv: vec2<f32>,
+    @location(2) layer_bytes: vec4<f32>,
+    @location(3) color: vec4<f32>,
+    @location(4) light_bytes: vec4<f32>,
+    @location(5) _normal_z: vec4<f32>,
+    @location(6) _glint_uv: vec2<f32>,
+) -> TerrainWire {
+    return native_material_vertex(position, uv, layer_bytes, color, light_bytes, vec3(0.0), false);
+}
+
+@fragment fn fs_native_model(in: TerrainWire) -> @location(0) vec4<f32> {
+    let texel = sample_sprite_sheet(in.uv_lm.xy, in.cell_info);
+    let lm = textureSample(lightmap, lightmap_sampler, in.uv_lm.zw);
+    let alpha = texel.a * in.color.a;
+    if alpha < NATIVE_MODEL_ALPHA_CUTOFF {
+        discard;
+    }
+    let rgb = finish_terrain_fog(texel.rgb * in.color.rgb * lm.rgb, in.fog_info);
+    return vec4(rgb, 1.0);
+}
+
+// Sky, horizon disc, sunrise, depth reset, and screen-space lines.
+struct SkyOut {
+    @builtin(position) clip: vec4<f32>,
+    @location(0) ray: vec3<f32>,
+}
+
+@vertex fn vs_sky(@location(0) ndc: vec2<f32>) -> SkyOut {
+    var out: SkyOut;
+    out.clip = vec4(ndc, 0.0, 1.0);
+    out.ray = (globals.inverse_view * vec4(
+        ndc.x * globals.misc.z * globals.misc.w,
+        ndc.y * globals.misc.w,
+        -1.0,
+        0.0,
+    )).xyz;
+    return out;
+}
+
+fn disc_distance(d: vec3<f32>, y: f32) -> vec2<f32> {
+    if d.y * y <= 0.0 {
+        return vec2(-1.0);
+    }
+    let p = abs(d.xz * (y / d.y));
+    let s = (max(p.x, p.y) + min(p.x, p.y) * 0.41421356) * (1.0 / 512.0);
+    if s > 1.0 {
+        return vec2(-1.0);
+    }
+    let ay = abs(y);
+    let rim = sqrt(512.0 * 512.0 + y * y);
+    return vec2(ay + s * (rim - ay), ay + s * (512.0 - ay));
+}
+
+fn sky_fog(color: vec3<f32>, dist: vec2<f32>) -> vec3<f32> {
+    let end_d = max(globals.fog_ends.x, 1e-4);
+    let fs = clamp(dist.x / end_d, 0.0, 1.0);
+    let fc = select(0.0, 1.0, dist.y >= end_d);
+    let f = max(fs, fc) * globals.fog_color.a;
+    return mix(color, globals.fog_color.rgb, f);
+}
+
+fn sky_base_color(in: SkyOut) -> vec4<f32> {
+    let d = normalize(in.ray);
+    var color = globals.fog_color.rgb;
+    let dist = disc_distance(d, 16.0);
+    if dist.x >= 0.0 {
+        color = sky_fog(globals.sky_color.rgb, dist);
+    }
+    return vec4(color, 1.0);
+}
+
+@fragment fn fs_sky_base(in: SkyOut) -> @location(0) vec4<f32> {
+    return sky_base_color(in);
+}
+
+@fragment fn fs_sky(in: SkyOut) -> @location(0) vec4<f32> {
+    return sky_base_color(in);
+}
+
+@fragment fn fs_dark_disc(in: SkyOut) -> @location(0) vec4<f32> {
+    let d = normalize(in.ray);
+    let dist = disc_distance(d, -4.0);
+    if dist.x < 0.0 {
+        discard;
+    }
+    return vec4(sky_fog(vec3(0.0), dist), 1.0);
+}
+
+@fragment fn fs_depth_reset(_in: SkyOut) -> @location(0) vec4<f32> {
+    return vec4(0.0);
+}
+
+struct SunriseOut {
+    @builtin(position) clip: vec4<f32>,
+    @location(0) weight: f32,
+}
+
+@vertex fn vs_sunrise(@location(0) clip: vec4<f32>, @location(1) weight: f32) -> SunriseOut {
+    return SunriseOut(clip, weight);
+}
+
+@fragment fn fs_sunrise(in: SunriseOut) -> @location(0) vec4<f32> {
+    return vec4(globals.sunrise.rgb, in.weight * globals.sunrise.a);
+}
+
+struct LineOut {
+    @builtin(position) clip: vec4<f32>,
+    @location(0) spherical: f32,
+    @location(1) cylindrical: f32,
+    @location(2) color: vec4<f32>,
+}
+
+fn line_clip(corner: vec2<f32>, start: vec3<f32>, end_p: vec3<f32>, width: f32, layered: bool) -> vec4<f32> {
+    let position = mix(start, end_p, corner.x);
+    let dir_p = select(end_p - start, normalize(end_p - start), layered);
+    let scale_p = select(1.0, globals.outline_params.w, layered);
+    let view_shrink = 1.0 - 1.0 / 256.0;
+    let line_start = globals.view_proj * vec4((position * scale_p) * view_shrink, 1.0);
+    let line_end = globals.view_proj * vec4(((position + dir_p) * scale_p) * view_shrink, 1.0);
+    let ndc1 = line_start.xyz / line_start.w;
+    let ndc2 = line_end.xyz / line_end.w;
+    let screen = globals.outline_params.xy;
+    let delta_screen = (ndc2.xy - ndc1.xy) * screen;
+    let len_sq = dot(delta_screen, delta_screen);
+    let dir_s = delta_screen * inverseSqrt(max(len_sq, 1e-8));
+    var offset = vec2(-dir_s.y, dir_s.x) * width / screen;
+    if offset.x < 0.0 {
+        offset = -offset;
+    }
+    offset *= corner.y;
+    return vec4((ndc1 + vec3(offset, 0.0)) * line_start.w, line_start.w);
+}
+
+@vertex fn vs_line(
+    @location(4) corner: vec2<f32>,
+    @location(0) start: vec3<f32>,
+    @location(1) end_p: vec3<f32>,
+    @location(2) argb: vec4<f32>,
+    @location(3) width: f32,
+) -> LineOut {
+    let position = mix(start, end_p, corner.x);
+    var out: LineOut;
+    out.clip = line_clip(corner, start, end_p, width, true);
+    out.spherical = length(position);
+    out.cylindrical = max(length(position.xz), abs(position.y));
+    out.color = argb.zyxw;
+    return out;
+}
+
+@fragment fn fs_line(in: LineOut) -> @location(0) vec4<f32> {
+    let f_s = clamp((in.spherical - globals.fog.x) / max(globals.fog.y - globals.fog.x, 1e-5), 0.0, 1.0);
+    let f_c = clamp((in.cylindrical - globals.fog.z) / max(globals.fog.w - globals.fog.z, 1e-5), 0.0, 1.0);
+    let f = max(f_s, f_c) * globals.fog_color.a;
+    return vec4(mix(in.color.rgb, globals.fog_color.rgb, f), in.color.a);
+}
+
+@vertex fn vs_debug_line(
+    @location(4) corner: vec2<f32>,
+    @location(0) start: vec3<f32>,
+    @location(1) end_p: vec3<f32>,
+    @location(2) argb: vec4<f32>,
+    @location(3) width: f32,
+) -> LineOut {
+    let position = mix(start, end_p, corner.x);
+    var out: LineOut;
+    out.clip = line_clip(corner, start, end_p, width, false);
+    out.spherical = length(position);
+    out.cylindrical = max(length(position.xz), abs(position.y));
+    out.color = argb.zyxw;
+    return out;
+}
+
+@fragment fn fs_debug_line(in: LineOut) -> @location(0) vec4<f32> {
+    let f_s = clamp((in.spherical - globals.fog.x) / max(globals.fog.y - globals.fog.x, 1e-5), 0.0, 1.0);
+    let f_c = clamp((in.cylindrical - globals.fog.z) / max(globals.fog.w - globals.fog.z, 1e-5), 0.0, 1.0);
+    let f = max(f_s, f_c) * globals.fog_color.a;
+    return vec4(mix(in.color.rgb, globals.fog_color.rgb, f), in.color.a);
+}
