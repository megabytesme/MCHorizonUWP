-            Some(t) => t.create_view(&wgpu::TextureViewDescriptor {
-                dimension: Some(wgpu::TextureViewDimension::D2Array),
-                mip_level_count: mips,
-                ..Default::default()
-            }),
-            None => unused.clone(),
-        })
-        .collect()
