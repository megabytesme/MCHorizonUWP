+//! Native UWP Direct3D 11 presentation for the feature-level 9_1 path.
+//!
+//! This module is an initial backend building block; the Horizon renderer
+//! still needs to pass it terrain, sprites and UI before it can run the game.
+
+#[cfg(windows)]
+mod device;
+#[cfg(windows)]
+mod thumbnail;
+
+#[cfg(windows)]
+pub use device::{DepthConvention, DrawPass, DynamicMesh, Mesh, Renderer, Texture, Vertex};
diff --git a/uwp/d3d11-backend/src/thumbnail.rs b/uwp/d3d11-backend/src/thumbnail.rs
new file mode 100644
index 0000000000000000000000000000000000000000..a368f040976cf3c23ed1fd0292bae217d6ced9c6
--- /dev/null
+++ b/uwp/d3d11-backend/src/thumbnail.rs
@@ -0,0 +1,53 @@
+/// Downsample the centred square of a mapped BGRA backbuffer to opaque RGBA.
+pub(crate) fn square_rgba(
+    bytes: &[u8],
+    width: usize,
+    height: usize,
+    stride: usize,
+    size: usize,
+) -> Option<Vec<u8>> {
+    if width == 0
+        || height == 0
+        || size == 0
+        || stride < width.checked_mul(4)?
+        || bytes.len() < stride.checked_mul(height)?
+    {
+        return None;
+    }
+    let side = width.min(height);
+    let x0 = (width - side) / 2;
+    let y0 = (height - side) / 2;
+    let mut output = vec![0; size.checked_mul(size)?.checked_mul(4)?];
+    for y in 0..size {
+        for x in 0..size {
+            let source = (y0 + y * side / size) * stride + (x0 + x * side / size) * 4;
+            let dest = (y * size + x) * 4;
+            output[dest..dest + 4].copy_from_slice(&[
+                bytes[source + 2],
+                bytes[source + 1],
+                bytes[source],
+                255,
+            ]);
+        }
+    }
+    Some(output)
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn crops_the_middle_and_swaps_bgra() {
+        let pixels = [10, 20, 30, 1, 11, 21, 31, 2, 12, 22, 32, 3, 13, 23, 33, 4];
+        assert_eq!(
+            square_rgba(&pixels, 4, 1, 16, 1),
+            Some(vec![31, 21, 11, 255])
+        );
+    }
+    #[test]
+    fn handles_stride_and_rejects_invalid_sizes() {
+        let pixels = [1, 2, 3, 4, 0, 0, 0, 0, 5, 6, 7, 8, 0, 0, 0, 0];
+        assert_eq!(square_rgba(&pixels, 1, 2, 8, 1), Some(vec![3, 2, 1, 255]));
+        assert!(square_rgba(&pixels, 2, 2, 4, 1).is_none());
+        assert!(square_rgba(&pixels, 1, 2, 8, 0).is_none());
+    }
+}
diff --git a/uwp/d3d11-backend/terrain.hlsl b/uwp/d3d11-backend/terrain.hlsl
new file mode 100644
index 0000000000000000000000000000000000000000..817be2d7d12b5a030c0e9dea7e8ec73693791948
--- /dev/null
+++ b/uwp/d3d11-backend/terrain.hlsl
@@ -0,0 +1,44 @@
+// A small terrain pipeline using only feature-level 9_1 capabilities.
+cbuffer Frame : register(b0) { row_major float4x4 view_projection; };
+Texture2D atlas : register(t0);
+SamplerState atlas_sampler : register(s0);
+
+struct VertexInput {
+    float3 position : POSITION;
+    float2 uv : TEXCOORD0;
+    float4 color : COLOR0;
+};
+struct VertexOutput {
+    float4 position : SV_POSITION;
+    float2 uv : TEXCOORD0;
+    float4 color : COLOR0;
+};
+VertexOutput VSMain(VertexInput input) {
+    VertexOutput output;
+    output.position = mul(float4(input.position, 1.0), view_projection);
+    output.uv = input.uv;
+    output.color = input.color;
+    return output;
+}
+float4 PSMain(VertexOutput input) : SV_TARGET {
+    float4 color = atlas.Sample(atlas_sampler, input.uv) * input.color;
+    clip(color.a - 0.5);
+    return color;
+}
+float4 PSOpaque(VertexOutput input) : SV_TARGET {
+    float4 color = atlas.Sample(atlas_sampler, input.uv) * input.color;
+    return float4(color.rgb, 1.0);
+}
+float4 PSEntity(VertexOutput input) : SV_TARGET {
+    float4 color = atlas.Sample(atlas_sampler, input.uv) * input.color;
+    clip(color.a - 0.1);
+    return color;
+}
+float4 PSAlpha(VertexOutput input) : SV_TARGET {
+    return atlas.Sample(atlas_sampler, input.uv) * input.color;
+}
+float4 PSInvert(VertexOutput input) : SV_TARGET {
+    float4 color = atlas.Sample(atlas_sampler, input.uv) * input.color;
+    clip(color.a - 0.001);
+    return color;
+}
