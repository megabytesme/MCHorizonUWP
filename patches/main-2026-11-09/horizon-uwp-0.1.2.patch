+//! Feature-level 9_1 D3D11 presentation of Horizon CPU-side HUD frames.
+//!
+//! Presents Horizon HUD and streamed terrain using CPU-side game data.
+
+use horizon_client_render::{
+    chunk::ColumnLayout,
+    gfx::{Frame, SectionKey},
+    hud::HudAtlas,
+    mesher::SectionMesh,
+    native_terrain,
+    presentation::TerrainBackend,
+};
+use horizon_native_hud::{Atlas, d3d11::HudRenderer};
+use horizon_native_window::NativeRenderer as WindowRenderer;
+
+// Marker-gated CPU wall timings. Present includes its synchronization wait;
+// these are not GPU timestamp queries and do not measure simulation time.
+#[cfg(feature = "native-d3d11-readback")]
+#[derive(Default)]
+struct NativeTimings {
+    frames: u32,
+    parts: [std::time::Duration; 7],
+    uploads: u64,
+    upload_time: std::time::Duration,
+}
+
+#[cfg(feature = "native-d3d11-readback")]
+impl NativeTimings {
+    fn record(&mut self, sample: NativeFrameSample, counts: (usize, usize, usize)) {
+        for (total, elapsed) in self.parts.iter_mut().zip(sample.parts) {
+            *total += elapsed;
+        }
+        self.frames += 1;
+        if self.frames >= 120 {
+            let ms = self
+                .parts
+                .map(|d| d.as_secs_f64() * 1000.0 / f64::from(self.frames));
+            log::info!(
+                "Horizon: native frame CPU averages ms over {} frames: prep={:.2} opaque={:.2} entities={:.2} translucent={:.2} hand={:.2} hud={:.2} present={:.2}; {} section uploads in {:.1} ms total",
+                self.frames,
+                ms[0],
+                ms[1],
+                ms[2],
+                ms[3],
+                ms[4],
+                ms[5],
+                ms[6],
+                self.uploads,
+                self.upload_time.as_secs_f64() * 1000.0
+            );
+            log::info!(
+                "Horizon: native scene visible sections={} opaque batches={} translucent batches={}",
+                counts.0,
+                counts.1,
+                counts.2
+            );
+            *self = Self::default();
+        }
+    }
+}
+
+#[cfg(feature = "native-d3d11-readback")]
+struct NativeFrameSample {
+    last: std::time::Instant,
+    parts: [std::time::Duration; 7],
+}
+#[cfg(feature = "native-d3d11-readback")]
+impl NativeFrameSample {
+    fn new() -> Self {
+        Self {
+            last: std::time::Instant::now(),
+            parts: [std::time::Duration::ZERO; 7],
+        }
+    }
+    fn mark(&mut self, part: usize) {
+        let now = std::time::Instant::now();
+        self.parts[part] += now.duration_since(self.last);
+        self.last = now;
+    }
+    fn restart(&mut self) {
+        self.last = std::time::Instant::now();
+    }
+}
+
+pub struct NativeRenderer {
+    window: WindowRenderer,
+    atlas: Atlas,
+    hud: HudRenderer,
+    panorama: horizon_native_panorama::Panorama,
+    entities: horizon_native_entities::d3d11::EntityRenderer,
+    viewport: [u32; 2],
+    benchmark: bool,
+    scene: Option<horizon_native_scene::TerrainScene>,
+    world_icon_request: Option<std::path::PathBuf>,
+    layout: ColumnLayout,
+    #[cfg(feature = "native-d3d11-readback")]
+    probed: bool,
+    #[cfg(feature = "native-d3d11-readback")]
+    probed_world: bool,
+    #[cfg(feature = "native-d3d11-readback")]
+    world_probe_frames: u64,
+    #[cfg(feature = "native-d3d11-readback")]
+    timings: Option<NativeTimings>,
+}
+
+/// Create the CoreWindow swap chain before the XAML dispatcher callback
+/// returns. The game thread consumes it when the title renderer is created.
+#[cfg(all(target_vendor = "uwp", feature = "native-d3d11"))]
+pub fn prepare_window_renderer_on_ui_thread() -> i32 {
+    match WindowRenderer::prepare_on_ui_thread() {
+        Ok(()) => 0,
+        Err(error) => error.code().0,
+    }
+}
+
+impl NativeRenderer {
+    pub fn new(
+        atlas: &HudAtlas,
+        faces: &horizon_client_render::gfx::panorama::Faces,
+        viewport: [u32; 2],
+    ) -> crate::Result<Self> {
+        let window = WindowRenderer::from_host_window()?;
+        #[cfg(feature = "native-d3d11-readback")]
+        let diagnostics = horizon_client_render::logging::game_home()
+            .join("native-world-smoke.enable")
+            .is_file();
+        let atlas = Atlas::from_horizon(atlas, 2048)?;
+        let hud = HudRenderer::new(window.renderer(), &atlas)?;
+        let panorama =
+            horizon_native_panorama::Panorama::new(window.renderer(), faces.size, &faces.texels())?;
+        let entities = horizon_native_entities::d3d11::EntityRenderer::new(&atlas);
+        Ok(Self {
+            window,
+            atlas,
+            hud,
+            panorama,
+            entities,
+            viewport,
+            benchmark: std::env::var("HORIZON_UWP_BENCHMARK").as_deref() == Ok("standard"),
+            scene: None,
+            world_icon_request: None,
+            layout: ColumnLayout::VANILLA,
+            #[cfg(feature = "native-d3d11-readback")]
+            probed: !diagnostics,
+            #[cfg(feature = "native-d3d11-readback")]
+            probed_world: !diagnostics,
+            #[cfg(feature = "native-d3d11-readback")]
+            world_probe_frames: 0,
+            #[cfg(feature = "native-d3d11-readback")]
+            timings: diagnostics.then(NativeTimings::default),
+        })
+    }
+
+    /// Upload block sprite pages before accepting world section meshes.
+    pub fn set_terrain(
+        &mut self,
+        assets: &horizon_client_render::assets::RenderAssets,
+    ) -> crate::Result<()> {
+        let mip_scene = (|| -> crate::Result<_> {
+            let atlas = native_terrain::from_render_assets(assets)?;
+            Ok(horizon_native_scene::TerrainScene::new(
+                self.window.renderer(),
+                atlas,
+            )?)
+        })();
+        let scene = match mip_scene {
+            Ok(scene) => scene,
+            Err(error) => {
+                log::warn!(
+                    "Native terrain mip atlas unavailable ({error}); retrying with the compact atlas"
+                );
+                let atlas = horizon_native_terrain::Atlas::from_layers(
+                    assets.sprite_size,
+                    assets.texture_layers as usize,
+                    &assets.pixels.get(),
+                )?;
+                horizon_native_scene::TerrainScene::new(self.window.renderer(), atlas)?
+            }
+        };
+        self.window
+            .renderer_mut()
+            .set_depth_convention(horizon_uwp_d3d11::DepthConvention::Reverse);
+        self.scene = Some(scene);
+        Ok(())
+    }
+
+    pub fn viewport_size(&self) -> [u32; 2] {
+        self.viewport
+    }
+
+    pub fn adapter_info(&self) -> Option<(String, u32)> {
+        self.window.renderer().adapter_info().ok()
+    }
+
+    pub fn resize(&mut self, viewport: [u32; 2]) -> crate::Result<()> {
+        if viewport.contains(&0) || viewport == self.viewport {
+            return Ok(());
+        }
+        self.window.resize(viewport[0], viewport[1])?;
+        self.viewport = viewport;
+        Ok(())
+    }
+
+    pub fn world_icon_ready(&self) -> bool {
+        self.scene
+            .as_ref()
+            .is_some_and(|scene| scene.drawable_section_count() > 10)
+    }
+
+    pub fn request_world_icon(&mut self, path: std::path::PathBuf) {
+        self.world_icon_request = Some(path);
+    }
+
+    fn capture_world_icon(&self, path: &std::path::Path) -> crate::Result<()> {
+        let pixels = self.window.renderer().world_thumbnail()?;
+        let temporary = path.with_extension("png.tmp");
+        let result = (|| -> crate::Result<()> {
+            let file = std::fs::File::create(&temporary)?;
+            let mut encoder = png::Encoder::new(file, 64, 64);
+            encoder.set_color(png::ColorType::Rgba);
+            encoder.set_depth(png::BitDepth::Eight);
+            let mut writer = encoder.write_header()?;
+            writer.write_image_data(&pixels)?;
+            writer.finish()?;
+            if path.exists() {
+                std::fs::remove_file(&temporary)?;
+            } else {
+                std::fs::rename(&temporary, path)?;
+            }
+            Ok(())
+        })();
+        if result.is_err() {
+            let _ = std::fs::remove_file(&temporary);
+        }
+        result
+    }
+
+    pub fn present(&mut self, frame: &Frame<'_>) -> crate::Result<bool> {
+        #[cfg(feature = "native-d3d11-readback")]
+        let mut sample = (!frame.title && self.timings.is_some()).then(NativeFrameSample::new);
+        let converted = self.atlas.convert_horizon(frame.hud)?;
+        let color = if frame.title {
+            [0.0, 0.0, 0.0]
+        } else {
+            frame.sky.sky_color
+        };
+        self.window
+            .renderer()
+            .begin_frame([color[0], color[1], color[2], 1.0])?;
+        if frame.title {
+            self.panorama.draw(
+                self.window.renderer(),
+                self.viewport,
+                frame.yaw,
+                frame.pitch,
+            )?;
+        }
+        let world_view = if frame.title {
+            None
+        } else {
+            let aspect = self.viewport[0] as f32 / self.viewport[1].max(1) as f32;
+            let projection = glam::Mat4::perspective_rh(
+                frame.fov_degrees.to_radians(),
+                aspect,
+                frame.depth_far,
+                0.05,
+            );
+            Some(
+                (projection
+                    * frame.bob
+                    * frame.spin
+                    * horizon_client_render::camera::view_matrix(frame.yaw, frame.pitch))
+                .to_cols_array_2d(),
+            )
+        };
+        #[cfg(feature = "native-d3d11-readback")]
+        if let Some(sample) = &mut sample {
+            sample.mark(0);
+        }
+        if let (Some(scene), Some(view)) = (&self.scene, world_view) {
+            scene.draw_opaque(self.window.renderer(), view, frame.camera.to_array());
+        }
+        #[cfg(feature = "native-d3d11-readback")]
+        if let Some(sample) = &mut sample {
+            sample.mark(1);
+        }
+        #[cfg(feature = "native-d3d11-readback")]
+        if !frame.title && !self.probed_world {
+            if let Some(scene) = &self.scene {
+                let drawable = scene.drawable_section_count();
+                if drawable > 0 {
+                    self.world_probe_frames = self.world_probe_frames.wrapping_add(1);
+                    if self.world_probe_frames % 60 == 1 {
+                        let clear = color.map(|c| (c.clamp(0.0, 1.0) * 255.0).round() as u8);
+                        match self.window.renderer().probe_pixels_different_from(clear, 1) {
+                            Ok((width, height, count)) => {
+                                log::info!(
+                                    "Horizon: native world readback {width}x{height}, {count} non-sky pixels before HUD, {drawable} drawable sections ({} resident)",
+                                    scene.section_count()
+                                );
+                                self.probed_world = count > 0;
+                            }
+                            Err(error) => {
+                                self.probed_world = true;
+                                log::warn!("Horizon: native world readback failed: {error}");
+                            }
+                        }
+                    }
+                }
+            }
+        }
+        #[cfg(feature = "native-d3d11-readback")]
+        if let Some(sample) = &mut sample {
+            sample.restart();
+        }
+        if !frame.title {
+            self.entities
+                .draw_entities(
+                    self.window.renderer(),
+                    &self.atlas,
+                    &converted.patches,
+                    frame,
+                    self.viewport,
+                )
+                .map_err(|error| format!("native entity rendering: {error}"))?;
+            #[cfg(feature = "native-d3d11-readback")]
+            if let Some(sample) = &mut sample {
+                sample.mark(2);
+            }
+            if let (Some(scene), Some(view)) = (&self.scene, world_view) {
+                scene.draw_translucent(self.window.renderer(), view, frame.camera.to_array());
+            }
+            #[cfg(feature = "native-d3d11-readback")]
+            if let Some(sample) = &mut sample {
+                sample.mark(3);
+            }
+            if let Some(path) = self.world_icon_request.take() {
+                if let Err(error) = self.capture_world_icon(&path) {
+                    log::warn!("Horizon: native world icon capture failed: {error}");
+                }
+            }
+            if !frame.hand.is_empty() {
+                self.window.renderer().clear_depth()?;
+                self.entities
+                    .draw_hand(
+                        self.window.renderer(),
+                        &self.atlas,
+                        // draw_entities already applied this frame's atlas updates.
+                        &[],
+                        frame,
+                        self.viewport,
+                    )
+                    .map_err(|error| format!("native hand rendering: {error}"))?;
+            }
+        }
+        #[cfg(feature = "native-d3d11-readback")]
+        if let Some(sample) = &mut sample {
+            sample.mark(4);
+        }
+        let scene = &self.scene;
+        self.hud
+            .draw_supported(
+                self.window.renderer(),
+                &self.atlas,
+                &converted.patches,
+                &converted.draws,
+                self.viewport,
+                converted.scale,
+            )
+            .map_err(|error| {
+                if let Some((sections, batches, mesh_bytes, atlas_bytes)) = scene.as_ref().map(|scene| scene.allocation_stats()) {
+                    format!("native HUD rendering: {error}; terrain: {sections} sections, {batches} batches, {} MiB of mesh buffers, {} MiB of atlas pixels (excluding driver overhead)", mesh_bytes / 1_048_576, atlas_bytes / 1_048_576)
+                } else {
+                    format!("native HUD rendering: {error}")
+                }
+            })?;
+        #[cfg(feature = "native-d3d11-readback")]
+        if let Some(sample) = &mut sample {
+            sample.mark(5);
+        }
+        #[cfg(feature = "native-d3d11-readback")]
+        if frame.title && !self.probed {
+            self.probed = true;
+            match self.window.renderer().probe_non_black_pixels() {
+                Ok((width, height, count)) => log::info!(
+                    "Horizon: native title readback {width}x{height}, {count} non-black pixels, {} HUD draws",
+                    converted.draws.len()
+                ),
+                Err(error) => log::warn!("Horizon: native title readback failed: {error}"),
+            }
+        }
+        #[cfg(feature = "native-d3d11-readback")]
+        if let Some(sample) = &mut sample {
+            sample.restart();
+        }
+        self.window
+            .renderer()
+            .present_with_vsync(!self.benchmark)
+            .map_err(|error| format!("native frame presentation: {error}"))?;
+        #[cfg(feature = "native-d3d11-readback")]
+        if let (Some(mut sample), Some(timings)) = (sample, &mut self.timings) {
+            sample.mark(6);
+            let counts = if timings.frames == 119 {
+                match (&self.scene, world_view) {
+                    (Some(scene), Some(view)) => {
+                        scene.visible_counts(view, frame.camera.to_array())
+                    }
+                    _ => (0, 0, 0),
+                }
+            } else {
+                (0, 0, 0)
+            };
+            timings.record(sample, counts);
+        }
+        Ok(true)
+    }
+}
+
+impl TerrainBackend for NativeRenderer {
+    fn upload_section(&mut self, key: SectionKey, mesh: &SectionMesh) -> crate::Result<()> {
+        #[cfg(feature = "native-d3d11-readback")]
+        let started = self.timings.as_ref().map(|_| std::time::Instant::now());
+        let mesh = native_terrain::from_section(mesh);
+        let origin = [
+            key.0 as f64 * 16.0,
+            self.layout.min_y() as f64 + key.1 as f64 * 16.0,
+            key.2 as f64 * 16.0,
+        ];
+        let result = self
+            .scene
+            .as_mut()
+            .ok_or("native terrain is not initialized")?
+            .upload(
+                self.window.renderer(),
+                key,
+                origin,
+                &mesh.solid,
+                &mesh.translucent,
+            );
+        #[cfg(feature = "native-d3d11-readback")]
+        if let (Some(started), Some(timings)) = (started, &mut self.timings) {
+            timings.uploads += 1;
+            timings.upload_time += started.elapsed();
+        }
+        result
+    }
+    fn clear_sections(&mut self, layout: ColumnLayout) {
+        if let Some(scene) = &mut self.scene {
+            scene.clear();
+        }
+        self.layout = layout;
+    }
+    fn remove_columns(&mut self, columns: &mut dyn Iterator<Item = (i32, i32)>) {
+        if let Some(scene) = &mut self.scene {
+            scene.remove_columns(columns);
+        }
+    }
+    fn has_section(&self, key: SectionKey) -> bool {
+        self.scene
+            .as_ref()
+            .is_some_and(|scene| scene.has_section(key))
+    }
+    fn section_count(&self) -> usize {
+        self.scene.as_ref().map_or(0, |scene| scene.section_count())
+    }
+}
diff --git a/crates/horizon-client/src/ram_limit.rs b/crates/horizon-client/src/ram_limit.rs
new file mode 100644
index 0000000000000000000000000000000000000000..b56555d4b2cd48be53abd5928c24a610c9c79cbe
--- /dev/null
+++ b/crates/horizon-client/src/ram_limit.rs
@@ -0,0 +1,433 @@
+//! The player's RAM limit: from the launcher's slider at the start (`HORIZON_MEMORY_LIMIT_MB`), and
+//! `/ramlimit` while the game runs. The window answers that command itself, so it works on any
+//! server. On Windows the system holds the game under the limit (`horizon_threads::memory_limit`).
+//! Under pressure, [`Governor`] turns far terrain off and lowers the render distance in use, never
+//! the option the player saved, and gives them back when there is room. Only a game that can't run
+//! under the limit at all ends with a crash report.
+use horizon_threads::capped;
+use horizon_threads::memory_limit::{self, Pressure};
+use std::path::{Path, PathBuf};
+use std::sync::OnceLock;
+use std::time::{Duration, Instant};
+
+/// The command's name, which the chat box lists with the server's.
+pub const COMMAND: &str = "ramlimit";
+const ENV: &str = "HORIZON_MEMORY_LIMIT_MB";
+/// A ceiling at the allocator: past it the game ends instead of paging.
+const HARD_ENV: &str = "HORIZON_MEMORY_HARD_MB";
+const MIB: u64 = 1024 * 1024;
+/// The lowest render distance the game runs at (`Options.renderDistance`'s lowest).
+pub const LOWEST_DISTANCE: i32 = 2;
+/// A step down waits this long for the last one to free its memory.
+const STEP_DOWN_EVERY: Duration = Duration::from_secs(3);
+/// A step back up waits this long after any change, so the game doesn't go up and down.
+const STEP_UP_EVERY: Duration = Duration::from_secs(30);
+
+/// What a [`Governor`] step changed.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Step {
+    FarTerrainOff,
+    Lowered(i32),
+    Raised(i32),
+    FarTerrainBack,
+}
+
+/// How far the game has stepped down to stay under the limit.
+#[derive(Debug, Default)]
+pub struct Governor {
+    /// The render distance in use, when lower than the player's.
+    cap: Option<i32>,
+    far_off: bool,
+    changed: Option<Instant>,
+}
+
+impl Governor {
+    /// The render distance to use when the player chose `chosen`.
+    pub fn distance(&self, chosen: i32) -> i32 {
+        self.cap.map_or(chosen, |cap| cap.min(chosen))
+    }
+
+    /// Whether far terrain is off for memory.
+    pub fn far_off(&self) -> bool {
+        self.far_off
+    }
+
+    /// Whether there is nothing left to give up.
+    pub fn at_lowest(&self, chosen: i32, has_far: bool) -> bool {
+        (self.far_off || !has_far) && self.distance(chosen) <= LOWEST_DISTANCE
+    }
+
+    /// Gives everything back at once: the limit was lifted.
+    pub fn reset(&mut self) -> bool {
+        let stepped = self.cap.is_some() || self.far_off;
+        *self = Governor::default();
+        stepped
+    }
+
+    /// One look at how tight memory is.
+    pub fn step(
+        &mut self,
+        now: Instant,
+        pressure: Pressure,
+        chosen: i32,
+        has_far: bool,
+    ) -> Option<Step> {
+        let waited = |every| {
+            self.changed
+                .is_none_or(|at| now.duration_since(at) >= every)
+        };
+        let step = match pressure {
+            Pressure::Over { keep } => {
+                if !waited(STEP_DOWN_EVERY) {
+                    return None;
+                }
+                if has_far && !self.far_off {
+                    self.far_off = true;
+                    Some(Step::FarTerrainOff)
+                } else {
+                    let now_at = self.distance(chosen);
+                    // Chunks' memory grows with the distance's square.
+                    let next = ((f64::from(now_at) * keep.sqrt()) as i32)
+                        .min(now_at - 1)
+                        .max(LOWEST_DISTANCE);
+                    (next < now_at).then(|| {
+                        self.cap = Some(next);
+                        Step::Lowered(next)
+                    })
+                }
+            }
+            Pressure::Room if waited(STEP_UP_EVERY) => match self.cap {
+                Some(cap) => {
+                    let next = cap + 1;
+                    self.cap = (next < chosen).then_some(next);
+                    Some(Step::Raised(next.min(chosen)))
+                }
+                None if self.far_off => {
+                    self.far_off = false;
+                    Some(Step::FarTerrainBack)
+                }
+                None => None,
+            },
+            _ => None,
+        };
+        if step.is_some() {
+            self.changed = Some(now);
+        }
+        step
+    }
+}
+
+/// The limit in bytes, if there is one.
+pub fn limit() -> Option<u64> {
+    memory_limit::get()
+}
+
+/// The memory the game holds, in bytes.
+pub fn used() -> Option<u64> {
+    memory_limit::resident_bytes()
+}
+
+/// See [`memory_limit::frame`].
+pub fn frame() {
+    memory_limit::frame();
+}
+
+/// A game this slow, faulting hard under a cap the system enforces, is short of memory.
+const SLOW_FPS: f32 = 30.;
+
+/// See [`memory_limit::pressure`]. Under a cap the system enforces the game is already under the
+/// limit, so nothing the player sees goes unless the game is slow as well.
+pub fn pressure(limit: u64, fps: f32) -> Pressure {
+    if capped::limit().is_some() {
+        // A hard ceiling is a budget of its own: what the process commits
+        // decides, and a smooth frame does not excuse holding more. Shedding
+        // down to it is the point, so frames suffering is not the trigger.
+        return horizon_threads::allocator_commit()
+            .0
+            .try_into()
+            .map_or(Pressure::Steady, |commit| {
+                memory_limit::pressure_of_commit(commit, limit)
+            });
+    }
+    let pressure = memory_limit::pressure(limit);
+    needed(pressure, memory_limit::system_enforced(), fps)
+}
+
+fn needed(pressure: Pressure, enforced: bool, fps: f32) -> Pressure {
+    match pressure {
+        Pressure::Over { .. } if enforced && fps >= SLOW_FPS => Pressure::Steady,
+        pressure => pressure,
+    }
+}
+
+/// See [`memory_limit::can_shrink`].
+pub fn can_shrink() {
+    memory_limit::can_shrink();
+}
+
+/// Where a crash report goes, and from which side.
+static REPORT_TO: OnceLock<(PathBuf, &'static str)> = OnceLock::new();
+
+/// Applies the launcher's limit, if there is one.
+pub fn start(home: &Path, side: &'static str) {
+    let _ = REPORT_TO.set((home.to_path_buf(), side));
+    if let Ok(value) = std::env::var(ENV) {
+        match value.trim().parse::<u64>() {
+            Ok(mb) => set(Some(mb)),
+            Err(_) => log::warn!("{ENV}={value} is not a number of MiB: no limit set"),
+        }
+    }
+    if let Ok(value) = std::env::var(HARD_ENV) {
+        match value.trim().parse::<u64>() {
+            Ok(mb) => set_hard(Some(mb)),
+            Err(_) => log::warn!("{HARD_ENV}={value} is not a number of MiB: no hard limit set"),
+        }
+    }
+}
+
+fn set(mb: Option<u64>) {
+    memory_limit::set(mb.map(|mb| mb.saturating_mul(MIB)), exceeded);
+}
+
+/// Sets the ceiling at the allocator, and with no working set limit yet, gives
+/// the governor the same budget: alone, a hard ceiling would end the game
+/// before anything stepped down.
+fn set_hard(mb: Option<u64>) {
+    capped::set_limit(mb.map(|mb| mb.saturating_mul(MIB)));
+    if let Some(mb) = mb
+        && memory_limit::get().is_none()
+    {
+        set(Some(mb));
+    }
+}
+
+fn exceeded(used: u64, limit: u64) {
+    let message = format!(
+        "The game can't run under its RAM limit: it holds {} MiB and the limit is {} MiB. Raise \
+         the limit in the launcher's Launch panel.",
+        used / MIB,
+        limit / MIB
+    );
+    log::error!("{message}");
+    if let Some((home, side)) = REPORT_TO.get() {
+        crate::crash::report_memory_limit(home, side, message);
+    }
+    crate::logging::flush();
+    // AppContainer applications cannot call the desktop ExitProcess API.
+    // This is an unrecoverable memory-limit failure, after the report is saved.
+    #[cfg(target_vendor = "uwp")]
+    std::process::abort();
+    #[cfg(not(target_vendor = "uwp"))]
+    std::process::exit(101);
+}
+
+#[derive(Debug, PartialEq, Eq)]
+enum Request {
+    Show,
+    Set(Option<u64>),
+    SetHard(Option<u64>),
+    Usage,
+}
+
+/// `/ramlimit`, `/ramlimit <MiB>`, `/ramlimit off`. None: another command.
+fn parse(command: &str) -> Option<Request> {
+    let mut words = command.split_whitespace();
+    if words.next() != Some(COMMAND) {
+        return None;
+    }
+    Some(match (words.next(), words.next(), words.next()) {
+        (None, _, _) => Request::Show,
+        (Some("off"), None, _) => Request::Set(None),
+        (Some("hard"), Some("off"), None) => Request::SetHard(None),
+        (Some("hard"), Some(mb), None) => mb
+            .parse()
+            .map_or(Request::Usage, |mb| Request::SetHard(Some(mb))),
+        (Some(mb), None, _) => mb
+            .parse()
+            .map_or(Request::Usage, |mb| Request::Set(Some(mb))),
+        _ => Request::Usage,
+    })
+}
+
+fn describe(limit: Option<u64>, hard: Option<u64>, used: Option<u64>) -> String {
+    let limit = limit.map_or("off".to_owned(), |limit| format!("{} MB", limit / MIB));
+    let hard_off = hard.is_none();
+    let hard = hard.map_or("off".to_owned(), |hard| format!("{} MB", hard / MIB));
+    let holds = used.map_or(String::new(), |used| {
+        // With a hard limit, the number that counts is the process's commit,
+        // since that is what the budget is spent on.
+        let what = if hard_off { "game" } else { "process" };
+        format!(" The {what} holds {} MB.", used / MIB)
+    });
+    format!("RAM limit: {limit}. Hard limit: {hard}.{holds}")
+}
+
+/// Runs `/ramlimit` and returns what to say in chat, or None when `command` is another command.
+pub fn run(command: &str) -> Option<String> {
+    Some(match parse(command)? {
+        Request::Show => describe(
+            memory_limit::get(),
+            capped::limit(),
+            match capped::limit() {
+                Some(_) => Some(horizon_threads::allocator_commit().0 as u64),
+                None => memory_limit::resident_bytes(),
+            },
+        ),
+        Request::Set(None) => {
+            set(None);
+            "RAM limit off until the game closes.".to_owned()
+        }
+        Request::Set(Some(mb)) => {
+            set(Some(mb));
+            format!(
+                "RAM limit set to {mb} MB until the game closes. The game stays under it, and runs \
+                 slower if it's very low."
+            )
+        }
+        Request::SetHard(None) => {
+            set_hard(None);
+            "Hard memory limit off until the game closes.".to_owned()
+        }
+        Request::SetHard(Some(mb)) => {
+            set_hard(Some(mb));
+            format!(
+                "Hard memory limit set to {mb} MB until the game closes: past it the game ends \
+                 instead of paging."
+            )
+        }
+        Request::Usage => {
+            "Usage: /ramlimit, /ramlimit <MB>, /ramlimit off, /ramlimit hard <MB> or /ramlimit \
+             hard off"
+                .to_owned()
+        }
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn under_a_cap_the_system_enforces_only_a_slow_game_gives_anything_up() {
+        const OVER: Pressure = Pressure::Over { keep: 0.8 };
+        assert_eq!(needed(OVER, true, 200.), Pressure::Steady);
+        assert_eq!(needed(OVER, true, 12.), OVER);
+        assert_eq!(
+            needed(OVER, false, 200.),
+            OVER,
+            "nothing else holds this game under"
+        );
+        assert_eq!(needed(Pressure::Room, true, 12.), Pressure::Room);
+    }
+
+    const FAR_OVER: Pressure = Pressure::Over { keep: 0.125 };
+    const OVER: Pressure = Pressure::Over { keep: 0.8 };
+
+    #[test]
+    fn under_pressure_far_terrain_goes_first_then_the_distance_falls_to_the_lowest() {
+        let mut g = Governor::default();
+        let mut at = Instant::now();
+        assert_eq!(g.step(at, FAR_OVER, 32, true), Some(Step::FarTerrainOff));
+        assert!(g.far_off());
+        assert_eq!(
+            g.step(at, FAR_OVER, 32, true),
+            None,
+            "waits for that to free"
+        );
+        let mut distances = Vec::new();
+        for _ in 0..12 {
