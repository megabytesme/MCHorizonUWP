@@ -0,0 +1,22 @@
+use horizon_uwp_credential_store as vault;
+#[unsafe(no_mangle)]
+pub extern "C" fn horizon_vault_probe() -> i32 {
+    let key = format!("synthetic-rust-{}", std::process::id());
+    if !matches!(vault::get(&key), Ok(None)) {
+        return 1;
+    }
+    let original = "X".repeat(8192);
+    if vault::set(&key, &original).is_err() {
+        return 2;
+    }
+    let check = matches!(vault::get(&key),Ok(Some(s)) if s.expose()==original && format!("{s:?}")=="Secret(<hidden>)");
+    let replaced = vault::set(&key, "replacement").is_ok();
+    let check2 = matches!(vault::get(&key),Ok(Some(s)) if s.expose()=="replacement");
+    let removed = matches!(vault::remove(&key), Ok(true));
+    let missing = matches!(vault::get(&key), Ok(None));
+    if check && replaced && check2 && removed && missing {
+        0
+    } else {
+        3
+    }
+}
diff --git a/uwp/credential-store/src/lib.rs b/uwp/credential-store/src/lib.rs
new file mode 100644
index 0000000000000000000000000000000000000000..3650b09423c0f1ef8a68bc281915376d6dd19edf
--- /dev/null
+++ b/uwp/credential-store/src/lib.rs
@@ -0,0 +1,71 @@
+//! Bounded UWP Credential Locker bridge. No credentials are logged.
+#![cfg(target_vendor = "uwp")]
+use std::{ffi::c_void, fmt, ptr};
+unsafe extern "C" {
+    fn horizon_vault_set(
+        key: *const u8,
+        key_len: usize,
+        secret: *const u8,
+        secret_len: usize,
+    ) -> i32;
+    fn horizon_vault_get(
+        key: *const u8,
+        key_len: usize,
+        output: *mut *mut u8,
+        output_len: *mut usize,
+    ) -> i32;
+    fn horizon_vault_remove(key: *const u8, key_len: usize) -> i32;
+    fn horizon_vault_free(output: *mut c_void, output_len: usize);
+}
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct VaultError;
+impl fmt::Display for VaultError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.write_str("Credential Locker operation failed")
+    }
+}
+impl std::error::Error for VaultError {}
+/// Secret value deliberately redacts its Debug representation.
+pub struct Secret(String);
+impl Secret {
+    pub fn expose(&self) -> &str {
+        &self.0
+    }
+}
+impl fmt::Debug for Secret {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.write_str("Secret(<hidden>)")
+    }
+}
+/// Store a nonempty UTF-8 secret for the account key.
+pub fn set(key: &str, secret: &str) -> Result<(), VaultError> {
+    (unsafe { horizon_vault_set(key.as_ptr(), key.len(), secret.as_ptr(), secret.len()) } == 0)
+        .then_some(())
+        .ok_or(VaultError)
+}
+/// Read one value. Missing entries are distinct from system errors.
+pub fn get(key: &str) -> Result<Option<Secret>, VaultError> {
+    let mut output = ptr::null_mut();
+    let mut len = 0;
+    let status = unsafe { horizon_vault_get(key.as_ptr(), key.len(), &mut output, &mut len) };
+    if status == 1 {
+        return Ok(None);
+    }
+    if status != 0 || output.is_null() || len > 65536 {
+        if !output.is_null() {
+            unsafe { horizon_vault_free(output.cast(), len) };
+        }
+        return Err(VaultError);
+    }
+    let value = String::from_utf8(unsafe { std::slice::from_raw_parts(output, len) }.to_vec());
+    unsafe { horizon_vault_free(output.cast(), len) };
+    value.map(|s| Some(Secret(s))).map_err(|_| VaultError)
+}
+/// Remove one entry, returning false if it did not exist.
+pub fn remove(key: &str) -> Result<bool, VaultError> {
+    match unsafe { horizon_vault_remove(key.as_ptr(), key.len()) } {
+        0 => Ok(true),
+        1 => Ok(false),
+        _ => Err(VaultError),
+    }
+}
