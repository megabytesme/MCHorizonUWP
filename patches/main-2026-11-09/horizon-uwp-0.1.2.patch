diff --git a/uwp/d3d11-backend/README.md b/uwp/d3d11-backend/README.md
new file mode 100644
index 0000000000000000000000000000000000000000..8b3c5b069a96db05151809eb10a5e56b45fb94eb
--- /dev/null
+++ b/uwp/d3d11-backend/README.md
@@ -0,0 +1,36 @@
+# Native Direct3D 11 backend
+
+This Rust library provides the first rendering primitives for the phone path:
+a CoreWindow swap chain and hardware device forced to feature level 9_1,
+indexed 16-bit meshes, a 2D RGBA atlas, depth buffering, alpha blending,
+forward and reversed depth conventions, and vertex/pixel
+shaders compiled with the 9_1 profiles. It does not yet replace Horizon's
+wgpu renderer or load its game data.
+
+The development probe in `probe/` uses these primitives in a UWP host. It
+draws textured quads with depth, translucent and overlay passes; before
+presenting it reads back pixels after each pass and writes the result to
+`LocalState/rust-d3d11-probe.txt`. On x64 UWP the expected pixels and depth
+occlusion in both depth conventions, alpha blending, atlas rectangle updates
+and depth-independent overlays passed, and the host
+passed the strict UWP link. The same Rust code
+and host also compiled and passed the strict link for ARM32 using VS 2017 and
+the 15063 SDK. This is not a phone or full-game verification.
+
+The shaders are compiled at build time by the Windows SDK's `fxc.exe`; run
+Cargo from an MSVC developer environment with `WindowsSdkDir` and
+`WindowsSDKVersion` set. For a UWP build, prepare the patched Rust sources as
+described in `../rust-std/README.md` and build the probe static library for the
+desired UWP target with `-Z build-std=std,panic_abort`. The probe's native
+`build-host.cmd x64` and `build-host.cmd arm` link the respective host and
+require `HORIZON_D3D11_PROBE_LIB` to name that target's static library.
+
+The current pipeline is intentionally minimal: it uses point sampling,
+alpha cutout, and has no lighting, texture animation,
+UI geometry integration or device-loss recovery. Native terrain
+integration must account for those missing operations and convert Horizon's
+sprite-array and vertex data to the supported formats.
+
+The renderer and its immediate context are bound to their creating thread; the
+Rust type is intentionally neither `Send` nor `Sync`. The safe CoreWindow
+owner must validate the UI thread before constructing it.
diff --git a/uwp/d3d11-backend/build.rs b/uwp/d3d11-backend/build.rs
new file mode 100644
index 0000000000000000000000000000000000000000..38f9722c5136b7b75dee12e22fb7c1665ea43e7e
--- /dev/null
+++ b/uwp/d3d11-backend/build.rs
@@ -0,0 +1,34 @@
+use std::{env, path::PathBuf, process::Command};
+
+fn main() {
+    println!("cargo:rerun-if-changed=terrain.hlsl");
+    println!("cargo:rerun-if-env-changed=WindowsSdkDir");
+    println!("cargo:rerun-if-env-changed=WindowsSDKVersion");
+    if env::var_os("CARGO_CFG_WINDOWS").is_none() {
+        return;
+    }
+    let sdk =
+        PathBuf::from(env::var_os("WindowsSdkDir").expect("run in an MSVC developer environment"));
+    let version = env::var("WindowsSDKVersion").expect("Windows SDK version is not set");
+    let fxc = sdk
+        .join("bin")
+        .join(version.trim_end_matches(['\\', '/']))
+        .join("x64/fxc.exe");
+    let out = PathBuf::from(env::var_os("OUT_DIR").unwrap());
+    for (entry, profile, file) in [
+        ("VSMain", "vs_4_0_level_9_1", "terrain-vs.cso"),
+        ("PSMain", "ps_4_0_level_9_1", "terrain-ps.cso"),
+        ("PSOpaque", "ps_4_0_level_9_1", "terrain-opaque-ps.cso"),
+        ("PSEntity", "ps_4_0_level_9_1", "entity-ps.cso"),
+        ("PSAlpha", "ps_4_0_level_9_1", "terrain-alpha-ps.cso"),
+        ("PSInvert", "ps_4_0_level_9_1", "terrain-invert-ps.cso"),
+    ] {
+        let status = Command::new(&fxc)
+            .args(["/nologo", "/Zpr", "/T", profile, "/E", entry, "/Fo"])
+            .arg(out.join(file))
+            .arg("terrain.hlsl")
+            .status()
+            .expect("could not run fxc");
+        assert!(status.success(), "{entry} shader compilation failed");
+    }
+}
diff --git a/uwp/d3d11-backend/probe/App.cpp b/uwp/d3d11-backend/probe/App.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..bd052dc7251394b5d2eeb104f5023b74bd15472b
--- /dev/null
+++ b/uwp/d3d11-backend/probe/App.cpp
@@ -0,0 +1,79 @@
+// UWP lifecycle glue for the Rust-owned Direct3D 9_1 renderer test.
+#include <windows.h>
+#include <windows.storage.h>
+#ifdef HORIZON_D3D11_PHONE_DIALOG
+#include <windows.ui.popups.h>
+#include <cstring>
+#endif
+
+extern "C" void* __cdecl horizon_d3d11_probe_create(void* window);
+extern "C" bool __cdecl horizon_d3d11_probe_render(void* probe);
+extern "C" bool __cdecl horizon_d3d11_probe_resize(void* probe);
+extern "C" void __cdecl horizon_d3d11_probe_destroy(void* probe);
+extern "C" void __cdecl horizon_d3d11_probe_report(const unsigned char* text, size_t size) {
+    auto base = Windows::Storage::ApplicationData::Current->LocalFolder->Path;
+    auto path = Platform::String::Concat(base, ref new Platform::String(L"\\rust-d3d11-probe.txt"));
+    HANDLE file = CreateFile2(path->Data(), GENERIC_WRITE, FILE_SHARE_READ, CREATE_ALWAYS, nullptr);
+    if (file == INVALID_HANDLE_VALUE) return;
+    DWORD written = 0;
+    if (size <= MAXDWORD) WriteFile(file, text, static_cast<DWORD>(size), &written, nullptr);
+    CloseHandle(file);
+#ifdef HORIZON_D3D11_PHONE_DIALOG
+    try {
+        const bool passed = size >= 4 && std::memcmp(text, "PASS", 4) == 0;
+        auto content = passed
+            ? L"PASS: Direct3D 9_1 textures, depth, transparency, overlays and terrain conversion worked."
+            : L"FAIL: the Direct3D 9_1 test did not produce the expected pixels. Details are saved in app storage.";
+        auto dialog = ref new Windows::UI::Popups::MessageDialog(ref new Platform::String(content), ref new Platform::String(L"Horizon D3D11 test"));
+        dialog->ShowAsync();
+    } catch (Platform::Exception^) {
+        // The diagnostic file remains available if the dialog cannot open.
+    }
+#endif
+}
+
+using namespace Windows::ApplicationModel::Activation;
+using namespace Windows::ApplicationModel::Core;
+using namespace Windows::Foundation;
+using namespace Windows::UI::Core;
+
+ref class AppView sealed : IFrameworkView {
+public:
+    AppView() : probe_(nullptr), closed_(false), visible_(true) {}
+    virtual ~AppView() { if (probe_) horizon_d3d11_probe_destroy(probe_); }
+    virtual void Initialize(CoreApplicationView^ view) {
+        view->Activated += ref new TypedEventHandler<CoreApplicationView^, IActivatedEventArgs^>(this, &AppView::Activated);
+    }
+    virtual void SetWindow(CoreWindow^ window) {
+        window_ = window;
+        window->Closed += ref new TypedEventHandler<CoreWindow^, CoreWindowEventArgs^>(this, &AppView::Closed);
+        window->VisibilityChanged += ref new TypedEventHandler<CoreWindow^, VisibilityChangedEventArgs^>(this, &AppView::VisibilityChanged);
+        window->SizeChanged += ref new TypedEventHandler<CoreWindow^, WindowSizeChangedEventArgs^>(this, &AppView::SizeChanged);
+        probe_ = horizon_d3d11_probe_create(reinterpret_cast<void*>(window));
+        if (!probe_) throw ref new Platform::FailureException();
+    }
+    virtual void Load(Platform::String^) {}
+    virtual void Run() {
+        while (!closed_) {
+            window_->Dispatcher->ProcessEvents(visible_ ? CoreProcessEventsOption::ProcessAllIfPresent : CoreProcessEventsOption::ProcessOneAndAllPending);
+            if (visible_ && !closed_ && !horizon_d3d11_probe_render(probe_)) throw ref new Platform::FailureException();
+        }
+    }
+    virtual void Uninitialize() {}
+private:
+    void Activated(CoreApplicationView^, IActivatedEventArgs^) { window_->Activate(); }
+    void Closed(CoreWindow^, CoreWindowEventArgs^) { closed_ = true; }
+    void VisibilityChanged(CoreWindow^, VisibilityChangedEventArgs^ args) { visible_ = args->Visible; }
+    void SizeChanged(CoreWindow^, WindowSizeChangedEventArgs^) {
+        if (probe_ && !horizon_d3d11_probe_resize(probe_)) throw ref new Platform::FailureException();
+    }
+    CoreWindow^ window_;
+    void* probe_;
+    bool closed_, visible_;
+};
+ref class AppViewSource sealed : IFrameworkViewSource {
+public:
+    virtual IFrameworkView^ CreateView() { return ref new AppView(); }
+};
+[Platform::MTAThread]
+int main(Platform::Array<Platform::String^>^) { CoreApplication::Run(ref new AppViewSource()); return 0; }
