diff --git a/uwp/xaudio-stream/README.md b/uwp/xaudio-stream/README.md
new file mode 100644
index 0000000000000000000000000000000000000000..b960561f4e4eaa0b8257713b757ef4c9d9d9ac89
--- /dev/null
+++ b/uwp/xaudio-stream/README.md
@@ -0,0 +1,19 @@
+# Experimental UWP XAudio2 output
+
+This opt-in backend connects the existing Horizon software mixer to the UWP
+host's XAudio2 source voice. It uses stereo 32-bit float samples at 48 kHz and
+three 1,024-frame buffers. The standard UWP build remains silent unless the
+`uwp-audio` feature is enabled and the corresponding host object is linked.
+
+Build `uwp/game-bridge` for the UWP target with `uwp-audio` in addition to the
+renderer features, then set `HORIZON_UWP_XAUDIO=1` while running
+`uwp/host/build-game.cmd`. Both settings are required; mixing an audio-enabled
+Rust library with an ordinary host fails at link time. XAudio2 is supplied by
+Windows 10, with the SDK's `xaudio2.lib` linked by the strict host linker.
+Minecraft's sound event metadata and audio files are separate resources and
+are not included in this source tree.
+
+The backend currently opens only the default output. Device changes, voice
+errors and user-selected output devices do not yet trigger a stream restart.
+The user confirmed that sounds and gameplay worked on the Lumia 950 XL with
+an experimental ARM32 package. Output-device changes remain untested.
diff --git a/uwp/xaudio-stream/host/XAudioStream.cpp b/uwp/xaudio-stream/host/XAudioStream.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..e1cb1d2ce87c5bb8a1d6f260a99648d11e4c6d7e
--- /dev/null
+++ b/uwp/xaudio-stream/host/XAudioStream.cpp
@@ -0,0 +1,93 @@
+// UWP XAudio2 output for Horizon's existing stereo CPU mixer.
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <windows.h>
+#include <wrl/client.h>
+#include <xaudio2.h>
+using Fill = void(__cdecl *)(void *, float *, size_t);
+namespace {
+constexpr unsigned kChannels = 2, kFrames = 1024, kBuffers = 3, kRate = 48000;
+class Output final : public IXAudio2VoiceCallback {
+  Microsoft::WRL::ComPtr<IXAudio2> engine_;
+  IXAudio2MasteringVoice *master_ = nullptr;
+  IXAudio2SourceVoice *voice_ = nullptr;
+  Fill fill_;
+  void *context_;
+  std::atomic<bool> closing_{false};
+  float samples_[kBuffers][kFrames * kChannels]{};
+  HRESULT enqueue(unsigned slot) {
+    fill_(context_, samples_[slot], kFrames * kChannels);
+    XAUDIO2_BUFFER b{};
+    b.AudioBytes = sizeof(samples_[slot]);
+    b.pAudioData = reinterpret_cast<const BYTE *>(samples_[slot]);
+    b.pContext = reinterpret_cast<void *>(static_cast<uintptr_t>(slot + 1));
+    return voice_->SubmitSourceBuffer(&b);
+  }
+
+public:
+  Output(Fill f, void *c) : fill_(f), context_(c) {}
+  ~Output() {
+    closing_.store(true);
+    if (voice_) {
+      voice_->Stop();
+      voice_->DestroyVoice();
+    }
+    if (master_)
+      master_->DestroyVoice();
+  }
+  bool start() {
+    HRESULT hr =
+        XAudio2Create(engine_.GetAddressOf(), 0, XAUDIO2_DEFAULT_PROCESSOR);
+    if (SUCCEEDED(hr))
+      hr = engine_->CreateMasteringVoice(&master_);
+    WAVEFORMATEX f{};
+    f.wFormatTag = WAVE_FORMAT_IEEE_FLOAT;
+    f.nChannels = kChannels;
+    f.nSamplesPerSec = kRate;
+    f.wBitsPerSample = 32;
+    f.nBlockAlign = kChannels * sizeof(float);
+    f.nAvgBytesPerSec = kRate * f.nBlockAlign;
+    if (SUCCEEDED(hr))
+      hr = engine_->CreateSourceVoice(&voice_, &f, 0,
+                                      XAUDIO2_DEFAULT_FREQ_RATIO, this);
+    for (unsigned i = 0; i < kBuffers && SUCCEEDED(hr); i++)
+      hr = enqueue(i);
+    if (SUCCEEDED(hr))
+      hr = voice_->Start();
+    return SUCCEEDED(hr);
+  }
+  void STDMETHODCALLTYPE OnVoiceProcessingPassStart(UINT32) override {}
+  void STDMETHODCALLTYPE OnVoiceProcessingPassEnd() override {}
+  void STDMETHODCALLTYPE OnStreamEnd() override {}
+  void STDMETHODCALLTYPE OnBufferStart(void *) override {}
+  void STDMETHODCALLTYPE OnLoopEnd(void *) override {}
+  void STDMETHODCALLTYPE OnVoiceError(void *, HRESULT) override {
+    closing_.store(true);
+  }
+  void STDMETHODCALLTYPE OnBufferEnd(void *token) override {
+    uintptr_t n = reinterpret_cast<uintptr_t>(token);
+    if (!closing_.load() && n >= 1 && n <= kBuffers) {
+      if (FAILED(enqueue(static_cast<unsigned>(n - 1))))
+        closing_.store(true);
+    }
+  }
+};
+} // namespace
+extern "C" void *__cdecl horizon_xaudio_open(Fill callback, void *context) {
+  if (!callback || !context)
+    return nullptr;
+  try {
+    Output *output = new Output(callback, context);
+    if (!output->start()) {
+      delete output;
+      return nullptr;
+    }
+    return output;
+  } catch (...) {
+    return nullptr;
+  }
+}
+extern "C" void __cdecl horizon_xaudio_close(void *output) {
+  delete static_cast<Output *>(output);
+}
diff --git a/uwp/xaudio-stream/src/lib.rs b/uwp/xaudio-stream/src/lib.rs
new file mode 100644
index 0000000000000000000000000000000000000000..c8476a2a3a06e239bc635423e0a076603d96fbe3
--- /dev/null
+++ b/uwp/xaudio-stream/src/lib.rs
@@ -0,0 +1,59 @@
+//! Safe Rust facade around the UWP XAudio2 host callback.
+#![cfg(target_vendor = "uwp")]
+use std::{ffi::c_void, ptr::NonNull, sync::Mutex};
+type Fill = Box<dyn FnMut(&mut [f32]) + Send>;
+struct Callback {
+    fill: Mutex<Fill>,
+}
+unsafe extern "C" {
+    fn horizon_xaudio_open(
+        callback: unsafe extern "C" fn(*mut c_void, *mut f32, usize),
+        context: *mut c_void,
+    ) -> *mut c_void;
+    fn horizon_xaudio_close(stream: *mut c_void);
+}
+unsafe extern "C" fn fill(context: *mut c_void, data: *mut f32, len: usize) {
+    if context.is_null() || data.is_null() || len > 16384 {
+        return;
+    }
+    let output = unsafe { std::slice::from_raw_parts_mut(data, len) };
+    let cb = unsafe { &*(context as *mut Callback) };
+    if let Ok(mut f) = cb.fill.lock() {
+        (f)(output)
+    } else {
+        output.fill(0.);
+    }
+}
+pub struct Stream {
+    native: NonNull<c_void>,
+    callback: NonNull<Callback>,
+}
+impl Stream {
+    pub fn open(fill: impl FnMut(&mut [f32]) + Send + 'static) -> Result<Self, String> {
+        let callback = Box::new(Callback {
+            fill: Mutex::new(Box::new(fill)),
+        });
+        let raw = Box::into_raw(callback);
+        let native = unsafe { horizon_xaudio_open(fill_callback, raw.cast()) };
+        if let Some(native) = NonNull::new(native) {
+            Ok(Self {
+                native,
+                callback: NonNull::new(raw).unwrap(),
+            })
+        } else {
+            unsafe { drop(Box::from_raw(raw)) };
+            Err("XAudio2 output could not be opened".into())
+        }
+    }
+}
+unsafe extern "C" fn fill_callback(context: *mut c_void, data: *mut f32, len: usize) {
+    unsafe { fill(context, data, len) }
+}
+impl Drop for Stream {
+    fn drop(&mut self) {
+        unsafe {
+            horizon_xaudio_close(self.native.as_ptr());
+            drop(Box::from_raw(self.callback.as_ptr()));
+        }
+    }
+}
