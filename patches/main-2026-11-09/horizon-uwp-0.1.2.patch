+    };
+
+    // SAFETY: `IOHIDElementGetChildren` is documented to return CFArray of IOHIDElement.
+    let elements = unsafe { elements.cast_unchecked::<IOHIDElement>() };
+
+    elements.into_iter().collect()
+}
