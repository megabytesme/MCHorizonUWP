+pub unsafe fn eviocgbit(fd: libc::c_int, ev: u32, len: libc::c_int, buf: *mut u8) -> libc::c_int {
+    ::nix::libc::ioctl(
+        fd,
+        request_code_read!(b'E', 0x20 + ev, len) as IoctlRequest,
+        buf,
+    )
