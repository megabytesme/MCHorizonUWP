+                device_id: DEVICE_ID,
+            });
+        }
+
+        #[method(scrollWheel:)]
+        fn scroll_wheel(&self, event: &NSEvent) {
+            trace_scope!("scrollWheel:");
+
+            self.mouse_motion(event);
+
+            let delta = {
+                let (x, y) = unsafe { (event.scrollingDeltaX(), event.scrollingDeltaY()) };
