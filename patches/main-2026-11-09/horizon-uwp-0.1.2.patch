--- /dev/null
+++ b/uwp/builder/Core/PackageOutput.cs
@@ -0,0 +1,43 @@
+namespace Horizon.Builder.Core;
+
+public sealed record SignedPackageOutput(string Client, string Certificate, string? ResourceFramework, string InstallationGuide, IReadOnlyList<string>? Dependencies = null);
+
+/// <summary>Creates distributable copies of the client and optional private resource framework.</summary>
+public static class PackageOutput
+{
+    public static async Task<SignedPackageOutput> CreateAsync(string unsignedClient, string? unsignedResourceFramework,
+        PackageSigningIdentity identity, string signTool, string newOutputDirectory, IReadOnlyList<string>? dependencies = null)
+    {
+        var output = Path.GetFullPath(newOutputDirectory);
+        if (Directory.Exists(output) || File.Exists(output)) throw new IOException("Choose a new signed output directory.");
+        if (!Directory.Exists(Path.GetDirectoryName(output))) throw new DirectoryNotFoundException("The output parent directory does not exist.");
+        Directory.CreateDirectory(output);
+        var client = Path.Combine(output, "HorizonUWP.appx");
+        var certificate = Path.Combine(output, "HorizonUWP.cer");
+        await PackageSigning.SignAsync(unsignedClient, client, certificate, identity, signTool);
+        string? framework = null;
+        if (unsignedResourceFramework is not null)
+        {
+            framework = Path.Combine(output, "HorizonResources.appx");
+            await PackageSigning.SignAsync(unsignedResourceFramework, framework, null, identity, signTool);
+        }
+        var guide = Path.Combine(output, "Install.md");
+        await using var guideSource = typeof(PackageOutput).Assembly.GetManifestResourceStream("Horizon.Builder.Core.InstallGuide.md")
+            ?? throw new InvalidOperationException("The installation guide is missing.");
+        await using var guideOutput = new FileStream(guide, FileMode.CreateNew, FileAccess.Write, FileShare.None, 4096, useAsync: true);
+        await guideSource.CopyToAsync(guideOutput);
+        var copied = new List<string>();
+        if (dependencies is { Count: > 0 })
+        {
+            var folder = Path.Combine(output, "Dependencies");
+            Directory.CreateDirectory(folder);
+            foreach (var dependency in dependencies)
+            {
+                var target = Path.Combine(folder, Path.GetFileName(dependency));
+                File.Copy(dependency, target, overwrite: false);
+                copied.Add(target);
+            }
+        }
+        return new(client, certificate, framework, guide, copied);
+    }
+}
diff --git a/uwp/builder/Core/PackageSigning.cs b/uwp/builder/Core/PackageSigning.cs
new file mode 100644
index 0000000000000000000000000000000000000000..7e66a26641e160d4624d45d608e7b160f96bfd6a
--- /dev/null
+++ b/uwp/builder/Core/PackageSigning.cs
@@ -0,0 +1,105 @@
+using System.Diagnostics;
+using System.IO.Compression;
+using System.Security.Cryptography;
+using System.Security.Cryptography.X509Certificates;
+using System.Xml.Linq;
+
+namespace Horizon.Builder.Core;
+
+public sealed record PackageSigningIdentity(string Thumbprint, string Publisher);
+
+/// <summary>Creates a user-owned local signing identity and signs private APPX copies.</summary>
+public static class PackageSigning
+{
+    private const string FriendlyName = "MCHorizonUWP local package signing";
+
+    public static PackageSigningIdentity GetOrCreateIdentity()
+    {
+        if (!OperatingSystem.IsWindows()) throw new PlatformNotSupportedException("Package signing requires Windows.");
+        using var mutex = new Mutex(false, @"Local\MCHorizonUWP.PackageSigningIdentity");
+        var acquired = false;
+        try { acquired = mutex.WaitOne(TimeSpan.FromSeconds(30)); }
+        catch (AbandonedMutexException) { acquired = true; }
+        if (!acquired) throw new TimeoutException("Another builder is preparing the signing identity.");
+        try
+        {
+            using var store = new X509Store(StoreName.My, StoreLocation.CurrentUser);
+            store.Open(OpenFlags.ReadWrite);
+            var matches = store.Certificates.Cast<X509Certificate2>().Where(cert => cert.FriendlyName == FriendlyName).ToArray();
+            if (matches.Length > 1) throw new InvalidOperationException("More than one local MCHorizonUWP signing certificate exists; select or remove the duplicate before continuing.");
+            if (matches.Length == 1)
+            {
+                var existing = matches[0];
+                if (!existing.HasPrivateKey || existing.NotBefore > DateTime.Now || existing.NotAfter <= DateTime.Now
+                    || !existing.Subject.StartsWith("CN=MCHorizonUWP-", StringComparison.Ordinal))
+                    throw new InvalidOperationException("The existing package signing certificate is expired, not yet valid, or missing its private key. Preserve it and restore or renew the identity before continuing.");
+                return new(existing.Thumbprint, existing.Subject);
+            }
+            var id = Guid.NewGuid().ToString("N");
+            var parameters = new CngKeyCreationParameters { KeyUsage = CngKeyUsages.Signing,
+                ExportPolicy = CngExportPolicies.AllowExport, Provider = CngProvider.MicrosoftSoftwareKeyStorageProvider };
+            using var key = CngKey.Create(CngAlgorithm.Rsa, "MCHorizonUWP.Package." + id, parameters);
+            using var rsa = new RSACng(key);
+            var request = new CertificateRequest("CN=MCHorizonUWP-" + id, rsa, HashAlgorithmName.SHA256, RSASignaturePadding.Pkcs1);
+            request.CertificateExtensions.Add(new X509BasicConstraintsExtension(false, false, 0, true));
+            request.CertificateExtensions.Add(new X509KeyUsageExtension(X509KeyUsageFlags.DigitalSignature, true));
+            var usages = new OidCollection { new Oid("1.3.6.1.5.5.7.3.3") };
+            request.CertificateExtensions.Add(new X509EnhancedKeyUsageExtension(usages, true));
+            request.CertificateExtensions.Add(new X509SubjectKeyIdentifierExtension(request.PublicKey, false));
+            using var certificate = request.CreateSelfSigned(DateTimeOffset.UtcNow.AddMinutes(-5), DateTimeOffset.UtcNow.AddYears(5));
+            certificate.FriendlyName = FriendlyName;
+            store.Add(certificate);
+            return new(certificate.Thumbprint, certificate.Subject);
+        }
+        finally { mutex.ReleaseMutex(); }
+    }
+
+    public static async Task SignAsync(string unsignedPackage, string signedPackage, string? publicCertificate,
+        PackageSigningIdentity identity, string signTool)
+    {
+        if (!OperatingSystem.IsWindows()) throw new PlatformNotSupportedException("Package signing requires Windows.");
+        if (identity.Thumbprint.Length != 40 || !identity.Thumbprint.All(char.IsAsciiHexDigit)) throw new InvalidDataException("Invalid signing certificate thumbprint.");
+        using var store = new X509Store(StoreName.My, StoreLocation.CurrentUser);
+        store.Open(OpenFlags.ReadOnly | OpenFlags.OpenExistingOnly);
+        // Self-signed identities are intentionally not trusted automatically.
+        var matches = store.Certificates.Find(X509FindType.FindByThumbprint, identity.Thumbprint, validOnly: false);
+        if (matches.Count != 1 || !matches[0].HasPrivateKey || matches[0].Subject != identity.Publisher
+            || matches[0].NotBefore > DateTime.Now || matches[0].NotAfter <= DateTime.Now)
+            throw new InvalidOperationException("The selected signing identity is unavailable or has changed.");
+        using (var zip = ZipFile.OpenRead(unsignedPackage))
+        {
+            var manifests = zip.Entries.Where(entry => entry.FullName.Equals("AppxManifest.xml", StringComparison.OrdinalIgnoreCase)).ToArray();
+            if (manifests.Length != 1 || manifests[0].Length > 1024 * 1024 || zip.GetEntry("AppxSignature.p7x") is not null)
+                throw new InvalidDataException("The package must contain one valid manifest and be unsigned.");
+            var manifest = manifests[0];
+            using var input = manifest.Open();
+            var document = XDocument.Load(input);
+            var root = document.Root ?? throw new InvalidDataException("The package manifest is invalid.");
+            if ((string?)root.Element(root.Name.Namespace + "Identity")?.Attribute("Publisher") != identity.Publisher)
+                throw new InvalidDataException("The package publisher does not match the signing certificate.");
+        }
+        var target = Path.GetFullPath(signedPackage);
+        var certificatePath = publicCertificate is null ? null : Path.GetFullPath(publicCertificate);
+        if (target.Equals(certificatePath, StringComparison.OrdinalIgnoreCase) || File.Exists(target) || Directory.Exists(target)
+            || certificatePath is not null && (File.Exists(certificatePath) || Directory.Exists(certificatePath)))
+            throw new IOException("Choose new package and certificate output paths.");
+        File.Copy(unsignedPackage, target, overwrite: false);
+        var start = new ProcessStartInfo(Path.GetFullPath(signTool)) { UseShellExecute = false, CreateNoWindow = true,
+            RedirectStandardOutput = true, RedirectStandardError = true };
+        foreach (var arg in new[] { "sign", "/fd", "SHA256", "/sha1", identity.Thumbprint, target }) start.ArgumentList.Add(arg);
+        using var process = Process.Start(start) ?? throw new InvalidOperationException("Could not start SignTool.");
+        var stdout = process.StandardOutput.ReadToEndAsync();
+        var stderr = process.StandardError.ReadToEndAsync();
+        await process.WaitForExitAsync();
+        await Task.WhenAll(stdout, stderr);
+        if (process.ExitCode != 0) throw new InvalidOperationException($"SignTool failed (exit code {process.ExitCode}); the output was retained for diagnosis.");
+        using (var signed = ZipFile.OpenRead(target))
+            if (signed.GetEntry("AppxSignature.p7x") is null)
+                throw new InvalidDataException("SignTool did not add an APPX signature; the output was retained for diagnosis.");
+        if (certificatePath is not null)
+        {
+            await using var certFile = new FileStream(certificatePath, FileMode.CreateNew, FileAccess.Write, FileShare.None, 4096, useAsync: true);
+            await certFile.WriteAsync(matches[0].Export(X509ContentType.Cert));
+        }
+    }
+}
diff --git a/uwp/builder/Core/ReleaseSource.cs b/uwp/builder/Core/ReleaseSource.cs
new file mode 100644
index 0000000000000000000000000000000000000000..091604094865ed363b958f01a5f51a126350b425
--- /dev/null
+++ b/uwp/builder/Core/ReleaseSource.cs
@@ -0,0 +1,45 @@
+namespace Horizon.Builder.Core;
+
+public sealed class PreparedRelease
+{
+    internal PreparedRelease(string sourceDirectory, CatalogPatch patch, CatalogClient client, CompatibilityResult compatibility,
+        string builderVersion, string architecture)
+        => (SourceDirectory, Patch, Client, Compatibility, BuilderVersion, Architecture) =
+            (sourceDirectory, patch, client, compatibility, builderVersion, architecture);
+
+    public string SourceDirectory { get; }
+    public CatalogPatch Patch { get; }
+    public CatalogClient Client { get; }
+    public CompatibilityResult Compatibility { get; }
+    public string BuilderVersion { get; }
+    public string Architecture { get; }
+}
+
+/// <summary>Authenticates, selects and assembles a release in a new workspace.</summary>
+public static class ReleaseSource
+{
+    public static async Task<PreparedRelease> PrepareAsync(CatalogTransport transport, Uri catalogUri, Uri signatureUri,
+        byte[] trustedPublicKey, string patchVersion, string clientVersion, string builderVersion, string architecture,
+        string workspace, string git, CancellationToken cancellationToken = default)
+    {
+        ArgumentNullException.ThrowIfNull(transport);
+        var catalog = await transport.GetCatalogAsync(catalogUri, signatureUri, trustedPublicKey, cancellationToken);
+        var compatibility = catalog.Check(patchVersion, clientVersion, builderVersion, architecture);
+        if (!compatibility.Allowed) throw new InvalidOperationException(compatibility.Reason);
+        var patch = catalog.Patches.Single(item => item.Version == patchVersion);
+        var client = catalog.Clients.Single(item => item.Version == clientVersion);
+        var root = Path.GetFullPath(workspace);
+        if (Directory.Exists(root) || File.Exists(root)) throw new IOException("The release workspace already exists.");
+        Directory.CreateDirectory(root);
+        var upstreamFile = Path.Combine(root, "upstream.zip");
+        var patchFile = Path.Combine(root, "patch.diff");
+        var clientFile = Path.Combine(root, "client.zip");
+        await transport.DownloadArtifactAsync(patch.Upstream, upstreamFile, cancellationToken);
+        await transport.DownloadArtifactAsync(patch.Artifact, patchFile, cancellationToken);
+        await transport.DownloadArtifactAsync(client.Artifact, clientFile, cancellationToken);
+        var source = Path.Combine(root, "source");
+        await SourceAssembler.AssembleAsync(upstreamFile, patch.Upstream.Sha256, patchFile, patch.Artifact.Sha256,
+            clientFile, client.Artifact.Sha256, source, git);
+        return new(source, patch, client, compatibility, builderVersion, architecture);
+    }
+}
diff --git a/uwp/builder/Core/ResourceFrameworkPacker.cs b/uwp/builder/Core/ResourceFrameworkPacker.cs
new file mode 100644
index 0000000000000000000000000000000000000000..fdc7cbf213f6194bfb88ac2caa58642727f694de
--- /dev/null
+++ b/uwp/builder/Core/ResourceFrameworkPacker.cs
@@ -0,0 +1,122 @@
+using System.Diagnostics;
+using System.Security.Cryptography;
+using System.Security.Cryptography.X509Certificates;
+using System.Text;
+using System.Text.Json;
+using System.Text.RegularExpressions;
+using System.Xml.Linq;
+
+namespace Horizon.Builder.Core;
+
+public sealed record ResourceFramework(string Package, string Name);
+
+/// <summary>Packages a private prepared resource snapshot for reuse by clients.</summary>
+public static class ResourceFrameworkPacker
+{
+    public const string Publisher = "CN=HorizonUWPPrototype";
+
+    public static async Task<ResourceFramework> PackAsync(string resources, string newOutputDirectory, IProgress<string>? progress = null, string? publisher = null)
+    {
+        publisher ??= Publisher;
+        _ = new X500DistinguishedName(publisher);
+        var gameVersion = ReadGameVersion(resources);
+        var output = Path.GetFullPath(newOutputDirectory);
+        if (Directory.Exists(output) || File.Exists(output)) throw new IOException("Choose a new framework output directory.");
+        if (!Directory.Exists(Path.GetDirectoryName(output))) throw new DirectoryNotFoundException("The framework output parent does not exist.");
+        if (LocalBuildRunner.ResourcesContainWorkspace(resources, output))
+            throw new InvalidDataException("Framework output cannot be inside the selected resources.");
+        var makeAppx = SyntheticFrameworkPacker.FindMakeAppx();
+        var stage = Path.Combine(output, "framework");
+        Directory.CreateDirectory(Path.Combine(stage, "Assets"));
+        var stagedResources = Path.Combine(stage, "resources");
+        progress?.Report("Copying prepared resources to a private framework workspace.");
+        await Task.Run(() => LocalBuildRunner.StageResources(resources, stagedResources));
+        if (ReadGameVersion(stagedResources) != gameVersion)
+            throw new InvalidDataException("The resource version changed while staging; choose a stable resource directory.");
+        await using (var logo = typeof(ResourceFrameworkPacker).Assembly.GetManifestResourceStream(
+            "Horizon.Builder.Core.Assets.FrameworkLogo.png") ?? throw new InvalidOperationException("Framework logo missing."))
+        await using (var file = new FileStream(Path.Combine(stage, "Assets", "StoreLogo.png"), FileMode.CreateNew))
+            await logo.CopyToAsync(file);
+
+        // Include paths and content hashes from the staged copy, so different
+        // prepared trees cannot silently replace one another as one framework.
+        progress?.Report("Computing the resource framework identity.");
+        var digest = await Task.Run(() => ResourceDigest(stagedResources));
+        var prefix = "Horizon.Asset." + gameVersion.Replace('.', '-') + ".";
+        var digestLength = Math.Min(30, 50 - prefix.Length);
+        var name = prefix + digest[..digestLength];
+        XNamespace ns = "http://schemas.microsoft.com/appx/manifest/foundation/windows10";
+        var manifest = new XDocument(new XDeclaration("1.0", "utf-8", null),
+            new XElement(ns + "Package",
+                new XElement(ns + "Identity", new XAttribute("Name", name), new XAttribute("Publisher", publisher),
+                    new XAttribute("Version", "1.0.0.0"), new XAttribute("ProcessorArchitecture", "neutral")),
+                new XElement(ns + "Properties", new XElement(ns + "Framework", "true"),
+                    new XElement(ns + "DisplayName", "Horizon Minecraft resources"),
+                    new XElement(ns + "PublisherDisplayName", "Horizon UWP"),
+                    new XElement(ns + "Logo", @"Assets\StoreLogo.png")),
+                new XElement(ns + "Dependencies", new XElement(ns + "TargetDeviceFamily",
+                    new XAttribute("Name", "Windows.Universal"), new XAttribute("MinVersion", "10.0.15063.0"),
+                    new XAttribute("MaxVersionTested", "10.0.15063.0"))),
+                new XElement(ns + "Resources", new XElement(ns + "Resource", new XAttribute("Language", "en-us")))));
+        using (var file = new FileStream(Path.Combine(stage, "AppxManifest.xml"), FileMode.CreateNew)) manifest.Save(file);
+
+        var package = Path.Combine(output, name + ".appx");
+        progress?.Report("Building the resource framework package. This may take several minutes.");
+        for (var attempt = 1; attempt <= 2; attempt++)
+        {
+            var start = new ProcessStartInfo(makeAppx) { UseShellExecute = false, CreateNoWindow = true,
+                RedirectStandardOutput = true, RedirectStandardError = true };
+            // The output directory belongs to this operation; /o replaces only a partial output from its first attempt.
+            foreach (var argument in new[] { "pack", "/d", ExtendedPath(stage), "/p", ExtendedPath(package), "/o" }) start.ArgumentList.Add(argument);
+            using var process = Process.Start(start) ?? throw new InvalidOperationException("Could not start MakeAppx.");
+            var stdout = process.StandardOutput.ReadToEndAsync();
+            var stderr = process.StandardError.ReadToEndAsync();
+            await process.WaitForExitAsync();
+            await Task.WhenAll(stdout, stderr);
+            if (process.ExitCode == 0 && File.Exists(package)) return new(package, name);
+            if (attempt == 1) { progress?.Report("Resource packaging failed; retrying once."); continue; }
+            // This log stays in the private build workspace and may include resource file names.
+            var lines = (await stdout + "\n" + await stderr).Split('\n').TakeLast(30);
+            await File.WriteAllLinesAsync(Path.Combine(output, "makeappx-error.log"), lines);
+            throw new InvalidOperationException($"MakeAppx failed (exit code {process.ExitCode}); see makeappx-error.log in the retained framework workspace.");
+        }
+        throw new InvalidOperationException("Resource packaging failed; framework workspace retained.");
+    }
+
+    private static string ExtendedPath(string path)
+    {
+        var full = Path.GetFullPath(path);
+        if (!OperatingSystem.IsWindows() || full.StartsWith(@"\\?\", StringComparison.Ordinal)) return full;
+        return full.StartsWith(@"\\", StringComparison.Ordinal) ? @"\\?\UNC\" + full[2..] : @"\\?\" + full;
+    }
+
+    private static string ReadGameVersion(string resources)
+    {
+        var manifest = Path.Combine(Path.GetFullPath(resources), "horizon-resources.json");
+        var info = new FileInfo(manifest);
+        if (!info.Exists || info.Length > 1024 * 1024) throw new InvalidDataException("Select prepared resources with a valid Horizon manifest.");
+        using var document = JsonDocument.Parse(File.ReadAllBytes(manifest));
+        var version = document.RootElement.TryGetProperty("minecraft", out var value) && value.ValueKind == JsonValueKind.String
+            ? value.GetString() : null;
+        if (version is null || !Regex.IsMatch(version, @"^[0-9]{1,5}(\.[0-9]{1,5}){1,3}$", RegexOptions.CultureInvariant)
+            || ("Horizon.Asset." + version + ".").Length > 30)
+            throw new InvalidDataException("The prepared resources have an unsupported Minecraft version.");
+        return version;
+    }
+
+    private static string ResourceDigest(string root)
+    {
+        using var treeHash = IncrementalHash.CreateHash(HashAlgorithmName.SHA256);
+        foreach (var file in Directory.EnumerateFiles(root, "*", SearchOption.AllDirectories)
+            .Select(path => (Path: path, Relative: Path.GetRelativePath(root, path).Replace('\\', '/')))
+            .OrderBy(item => item.Relative, StringComparer.Ordinal))
+        {
+            var relative = Encoding.UTF8.GetBytes(file.Relative);
+            treeHash.AppendData(BitConverter.GetBytes(relative.Length));
+            treeHash.AppendData(relative);
+            using var input = File.OpenRead(file.Path);
+            treeHash.AppendData(SHA256.HashData(input));
+        }
+        return Convert.ToHexString(treeHash.GetHashAndReset()).ToLowerInvariant();
+    }
+}
diff --git a/uwp/builder/Core/SetupChecker.cs b/uwp/builder/Core/SetupChecker.cs
new file mode 100644
index 0000000000000000000000000000000000000000..c02985afa6f75fd85b82b56638472df51cbe08a7
--- /dev/null
+++ b/uwp/builder/Core/SetupChecker.cs
@@ -0,0 +1,69 @@
+namespace Horizon.Builder.Core;
+
+public enum TargetProfile { DesktopX64, SurfaceProX, WindowsMobile, DesktopX86 }
+public enum CheckStatus { Found, Missing, Review }
+public sealed record SetupCheck(string Name, CheckStatus Status, string Detail, Uri? Instructions = null);
+
+// A scan is evidence of file presence, not a compatibility or build guarantee.
+public interface IProbe
+{
+    string? FindOnPath(string executable);
+    bool FileExists(string path);
+    IEnumerable<string> Directories(string path);
+    string? EnvironmentValue(string name);
+}
+
+public sealed class SetupChecker(IProbe probe)
+{
+    public IReadOnlyList<SetupCheck> Scan(TargetProfile profile, bool splitRelease = false, bool unifiedToolchain = false)
+    {
+        var checks = new List<SetupCheck>();
+        CheckPath(checks, "Git", "git.exe", "Install Git for Windows from its official publisher.", "https://git-scm.com/install/windows");
+        CheckPath(checks, "Rustup", "rustup.exe", "Install Rust using the official Rustup installer.", "https://rust-lang.org/learn/get-started/");
+        CheckPath(checks, "Cargo", "cargo.exe", "Install Cargo with Rustup.", "https://rust-lang.org/learn/get-started/");
+        CheckPath(checks, "Python", "python.exe", "Install Python from its official publisher.", "https://www.python.org/downloads/windows/");
+
+        var kitsRoot = Path.Combine(probe.EnvironmentValue("ProgramFiles(x86)") ?? @"C:\Program Files (x86)", "Windows Kits", "10");
+        var hostSdk = profile == TargetProfile.SurfaceProX ? "10.0.26100.0" : unifiedToolchain ? "10.0.19041.0" : splitRelease ? "10.0.17763.0" : "10.0.15063.0";
+        var hostBin = Path.Combine(kitsRoot, "bin", hostSdk, "x64");
+        var packageBin = Path.Combine(kitsRoot, "bin", "10.0.26100.0", "x64");
+        var hasSdk = probe.FileExists(Path.Combine(hostBin, "fxc.exe"))
+            && probe.FileExists(Path.Combine(kitsRoot, "Include", hostSdk, "um", "Windows.h"))
+            && probe.FileExists(Path.Combine(packageBin, "makeappx.exe")) && probe.FileExists(Path.Combine(packageBin, "signtool.exe"))
+            && (profile != TargetProfile.WindowsMobile || splitRelease
+                || probe.FileExists(Path.Combine(kitsRoot, "Include", "10.0.16299.0", "um", "Windows.h")));
+        checks.Add(!hasSdk
+            ? new("Windows SDK and packaging tools", CheckStatus.Missing,
+                $"The recipe needs SDK {hostSdk} headers and shader compiler, plus SDK 10.0.26100.0 packaging tools." +
+                (profile == TargetProfile.WindowsMobile && !splitRelease ? " The legacy mobile shell also needs SDK 10.0.16299.0." : ""),
+                new Uri("https://learn.microsoft.com/en-us/windows/apps/windows-sdk/downloads"))
+            : new("Windows SDK and packaging tools", CheckStatus.Found, $"Found SDK {hostSdk} headers and shader compiler and SDK 10.0.26100.0 packaging tools. Target compatibility still needs validation."));
+
+        var vsRoots = new[] { probe.EnvironmentValue("ProgramFiles(x86)"), probe.EnvironmentValue("ProgramFiles") }
+            .Where(path => !string.IsNullOrWhiteSpace(path)).Distinct(StringComparer.OrdinalIgnoreCase)
+            .Select(path => Path.Combine(path!, "Microsoft Visual Studio"));
+        var arch = profile switch { TargetProfile.DesktopX86 => "x86", TargetProfile.DesktopX64 => "x64", TargetProfile.SurfaceProX => "arm64", _ => "arm" };
+        var msvc = vsRoots.SelectMany(probe.Directories).SelectMany(probe.Directories)
+            .SelectMany(edition => probe.Directories(Path.Combine(edition, "VC", "Tools", "MSVC")))
+            .FirstOrDefault(toolset => probe.FileExists(Path.Combine(toolset, "bin", "Hostx64", arch, "cl.exe"))
+                && probe.FileExists(Path.Combine(toolset, "lib", arch, "store", "vcruntime.lib")));
+        checks.Add(msvc is null
+            ? new("Visual C++ UWP tools", CheckStatus.Missing, $"No x64-hosted {arch} compiler and UWP libraries found in standard Visual Studio locations. Install the matching C++ UWP workload and target tools.",
+                new Uri("https://learn.microsoft.com/en-us/windows/apps/winui/winui2/getting-started"))
+            : new("Visual C++ UWP tools", CheckStatus.Found, $"Found {arch} compiler and UWP libraries. The recipe must still validate its required toolset version."));
+        checks.Add(new("Rust UWP standard library", CheckStatus.Review,
+            "The UWP build requires a recipe-specific Rust standard-library patch and target build. Presence and compatibility have not yet been verified."));
+        checks.Add(new("Build recipe and signing", CheckStatus.Review,
+            profile == TargetProfile.SurfaceProX
+                ? "An ARM64 build recipe is available; validate the selected source and resources separately. Its packages require signing before installation."
+                : "A pinned local build recipe is available; validate the selected source and resources separately. Its packages require signing before installation."));
+        return checks;
+    }
+
+    private void CheckPath(List<SetupCheck> checks, string label, string name, string missing, string instructions)
+    {
+        var path = probe.FindOnPath(name);
+        checks.Add(path is null ? new(label, CheckStatus.Missing, missing, new Uri(instructions))
+            : new(label, CheckStatus.Found, $"Found on PATH. Version and recipe compatibility have not been checked."));
+    }
+}
diff --git a/uwp/builder/Core/SourceAssembler.cs b/uwp/builder/Core/SourceAssembler.cs
new file mode 100644
index 0000000000000000000000000000000000000000..5f94a9f5753664855c4af6bcbfe84cc1e524f2bf
--- /dev/null
+++ b/uwp/builder/Core/SourceAssembler.cs
@@ -0,0 +1,107 @@
+using System.Diagnostics;
+using System.IO.Compression;
+using System.Security.Cryptography;
+
+namespace Horizon.Builder.Core;
+
+/// <summary>Assembles already authenticated and downloaded release inputs in a new directory.</summary>
+public static class SourceAssembler
+{
+    private const long MaxExpandedBytes = 4L * 1024 * 1024 * 1024;
+    private const int MaxEntries = 100_000;
+
+    public static async Task AssembleAsync(string upstreamZip, string expectedUpstreamHash, string patch,
+        string expectedPatchHash, string clientZip, string expectedClientHash, string output, string git)
+    {
+        await VerifyAsync(upstreamZip, expectedUpstreamHash);
+        await VerifyAsync(patch, expectedPatchHash);
+        await VerifyAsync(clientZip, expectedClientHash);
+        var root = Path.GetFullPath(output);
+        if (Directory.Exists(root) || File.Exists(root)) throw new IOException("The source workspace already exists.");
+        Directory.CreateDirectory(root);
+        Extract(upstreamZip, root, upstream: true);
+        await ApplyPatchAsync(git, root, patch, check: true);
+        await ApplyPatchAsync(git, root, patch, check: false);
+        Extract(clientZip, root, upstream: false);
+    }
+
+    private static async Task VerifyAsync(string path, string expected)
+    {
+        if (expected is null || expected.Length != 64 || !expected.All(char.IsAsciiHexDigit))
+            throw new InvalidDataException("The expected input digest is invalid.");
+        await using var stream = File.OpenRead(path);
+        var actual = Convert.ToHexString(await SHA256.HashDataAsync(stream));
+        if (!actual.Equals(expected, StringComparison.OrdinalIgnoreCase))
+            throw new InvalidDataException("A downloaded input does not match its expected digest.");
+    }
+
+    private static void Extract(string archive, string output, bool upstream)
+    {
+        using var zip = ZipFile.OpenRead(archive);
+        if (zip.Entries.Count > MaxEntries) throw new InvalidDataException("The archive contains too many entries.");
+        var root = Path.GetFullPath(output).TrimEnd(Path.DirectorySeparatorChar) + Path.DirectorySeparatorChar;
+        var names = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
+        long total = 0;
+        string? prefix = null;
+        foreach (var entry in zip.Entries)
+        {
+            var raw = entry.FullName;
+            if (raw.Contains('\\') || raw.StartsWith('/') || raw.Contains(':')) throw new InvalidDataException("Invalid archive path.");
+            var parts = raw.Split('/', StringSplitOptions.RemoveEmptyEntries);
+            if (parts.Any(part => part is "." or ".." || part.EndsWith(' ') || part.EndsWith('.')))
+                throw new InvalidDataException("Invalid archive path.");
+            if (parts.Length == 0) continue;
+            if (upstream)
+            {
+                prefix ??= parts[0];
+                if (parts[0] != prefix) throw new InvalidDataException("The upstream archive has multiple roots.");
+                parts = parts[1..];
+            }
+            else if (parts[0] == "notices") continue;
+            else if (parts[0] != "uwp") throw new InvalidDataException("The client archive contains a file outside the UWP directory.");
+            if (parts.Length == 0) continue;
+            var relative = Path.Combine(parts);
+            var target = Path.GetFullPath(Path.Combine(root, relative));
+            if (!target.StartsWith(root, StringComparison.OrdinalIgnoreCase) || !names.Add(target))
+                throw new InvalidDataException("The archive has an escaping or duplicate path.");
+            var unixType = (entry.ExternalAttributes >> 16) & 0xF000;
+            if (unixType == 0xA000)
+            {
+                // This upstream documentation symlink is not needed for a build.
+                if (upstream && relative == "CLAUDE.md" && entry.Length == 9)
+                {
+                    using var reader = new StreamReader(entry.Open());
+                    if (reader.ReadToEnd() == "AGENTS.md") continue;
+                }
+                throw new InvalidDataException("The archive contains an unsupported symbolic link.");
+            }
+            if (unixType != 0 && unixType != 0x8000 && unixType != 0x4000)
+                throw new InvalidDataException("The archive contains an unsupported file type.");
+            if (raw.EndsWith('/')) { Directory.CreateDirectory(target); continue; }
+            if (entry.Length > MaxExpandedBytes - total) throw new InvalidDataException("The archive expands beyond the allowed size.");
+            total += entry.Length;
+            Directory.CreateDirectory(Path.GetDirectoryName(target)!);
+            using var input = entry.Open();
+            using var file = new FileStream(target, FileMode.CreateNew, FileAccess.Write, FileShare.None);
+            input.CopyTo(file);
+        }
+    }
+
+    private static async Task ApplyPatchAsync(string git, string output, string patch, bool check)
+    {
+        var start = new ProcessStartInfo(Path.GetFullPath(git)) { WorkingDirectory = output, UseShellExecute = false,
+            CreateNoWindow = true, RedirectStandardOutput = true, RedirectStandardError = true };
+        foreach (var arg in new[] { "-c", "core.fsmonitor=false", "-c", "core.autocrlf=true", "apply", "--binary", "--whitespace=nowarn" }) start.ArgumentList.Add(arg);
+        if (check) start.ArgumentList.Add("--check");
+        start.ArgumentList.Add("--"); start.ArgumentList.Add(Path.GetFullPath(patch));
+        start.Environment["GIT_CONFIG_NOSYSTEM"] = "1";
+        start.Environment["GIT_CONFIG_GLOBAL"] = "NUL";
+        start.Environment["GIT_TERMINAL_PROMPT"] = "0";
+        using var process = Process.Start(start) ?? throw new InvalidOperationException("Could not start Git.");
+        var stdout = process.StandardOutput.ReadToEndAsync();
+        var stderr = process.StandardError.ReadToEndAsync();
+        await process.WaitForExitAsync();
+        await Task.WhenAll(stdout, stderr);
+        if (process.ExitCode != 0) throw new InvalidDataException($"The patch could not be {(check ? "validated" : "applied")} (Git exit code {process.ExitCode}).");
+    }
+}
