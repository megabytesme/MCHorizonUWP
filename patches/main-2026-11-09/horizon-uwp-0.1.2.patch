+    if entries
+        .iter()
+        .any(|entry| entry.ip.eq_ignore_ascii_case(address))
+    {
+        return 1;
+    }
+    match horizon_protocol::servers::prepend(
+        &file,
+        &horizon_protocol::servers::ServerEntry::new(name.trim(), address.trim()),
+    ) {
+        Ok(()) => 0,
+        Err(_) => -1,
