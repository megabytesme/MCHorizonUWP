new file mode 100644
index 0000000000000000000000000000000000000000..8858bae4b89ea8fa5de7b13c97048ffe3a55decf
--- /dev/null
+++ b/uwp/game-bridge/src/pregame.rs
@@ -0,0 +1,258 @@
+//! Native UWP pre-game account flow. All tokens stay inside this process.
+use horizon_account_core::{
+    sign_in::{self, Attempt, Event},
+    vault::{CredentialLocker, SecretStore},
+};
+use horizon_client::auth::AuthSession;
+use std::{
+    sync::{Arc, mpsc::TryRecvError},
+    time::Duration,
+};
+
+unsafe extern "C" {
+    fn horizon_uwp_dialog_show(text: *const u8, len: usize, kind: u32) -> i32;
+    fn horizon_uwp_dialog_poll() -> i32;
+    fn horizon_uwp_dialog_cancel();
+    fn horizon_uwp_window_closed() -> i32;
+    fn horizon_uwp_window_visible() -> i32;
+    fn horizon_uwp_pump_events();
+    fn horizon_uwp_page_tick();
+}
+
+const MENU: u32 = 0;
+const ACCOUNT: u32 = 1;
+const WAIT: u32 = 2;
+const NOTICE: u32 = 3;
+const CONFIRM: u32 = 4;
+const SAVED_ACCOUNT: u32 = 5;
+const REPLACE: u32 = 6;
+
+fn closed() -> bool {
+    unsafe { horizon_uwp_window_closed() != 0 }
+}
+fn pump() {
+    unsafe { horizon_uwp_pump_events() };
+    unsafe { horizon_uwp_page_tick() };
+    std::thread::sleep(Duration::from_millis(20));
+}
+fn show(text: &str, kind: u32) -> bool {
+    if unsafe { horizon_uwp_dialog_show(text.as_ptr(), text.len(), kind) == 0 } {
+        true
+    } else {
+        crate::report_failure("Horizon could not display the startup page.");
+        false
+    }
+}
+fn poll() -> i32 {
+    let result = unsafe { horizon_uwp_dialog_poll() };
+    if result == -2 {
+        crate::report_failure("The Horizon startup page stopped responding.");
+        -1
+    } else {
+        result
+    }
+}
+fn dismiss() -> bool {
+    unsafe { horizon_uwp_dialog_cancel() };
+    let deadline = std::time::Instant::now() + Duration::from_secs(5);
+    while !closed() && poll() == 0 && std::time::Instant::now() < deadline {
+        pump();
+    }
+    !closed() && poll() != 0
+}
+fn prompt(text: &str, kind: u32) -> i32 {
+    if !show(text, kind) {
+        return -1;
+    }
+    while !closed() {
+        let selected = poll();
+        if selected != 0 {
+            return selected;
+        }
+        pump();
+    }
+    -1
+}
+fn notice(text: &str) {
+    let _ = prompt(text, NOTICE);
+}
+
+enum Outcome {
+    Play(AuthSession),
+    Menu,
+    Exit,
+}
+
+fn wait(attempt: Attempt) -> Outcome {
+    if !show("Contacting the account service…", WAIT) {
+        return Outcome::Exit;
+    }
+    loop {
+        if closed() {
+            attempt.cancel();
+            return Outcome::Exit;
+        }
+        if poll() != 0 {
+            attempt.cancel();
+            return Outcome::Menu;
+        }
+        match attempt.try_recv() {
+            Ok(Event::Prompt {
+                user_code,
+                verification_uri,
+            }) => {
+                if !dismiss() {
+                    return Outcome::Exit;
+                }
+                if closed() {
+                    attempt.cancel();
+                    return Outcome::Exit;
+                }
+                let text = format!(
+                    "On another device, open {verification_uri} and enter:\n\n{user_code}\n\nReturn here after approving sign-in."
+                );
+                if !show(&text, WAIT) {
+                    attempt.cancel();
+                    return Outcome::Exit;
+                }
+            }
+            Ok(Event::Ready(session)) => {
+                if !dismiss() {
+                    return Outcome::Exit;
+                }
+                // AuthSession::parse returns fixed errors and never echoes the JSON.
+                return match AuthSession::parse(&session.into_json()) {
+                    Ok(session) => Outcome::Play(session),
+                    Err(_) => {
+                        notice("The account session could not be opened.");
+                        Outcome::Menu
+                    }
+                };
+            }
+            Ok(Event::Offline(_)) => {
+                if !dismiss() {
+                    return Outcome::Exit;
+                }
+                notice(
+                    "The account service could not be reached. Choose Play offline to continue without an online session.",
+                );
+                return Outcome::Menu;
+            }
+            Ok(Event::NoAccount) => {
+                if !dismiss() {
+                    return Outcome::Exit;
+                }
+                notice("No saved account was found. Choose Sign in to add one.");
+                return Outcome::Menu;
+            }
+            Ok(Event::SignedOut { removed }) => {
+                if !dismiss() {
+                    return Outcome::Exit;
+                }
+                notice(if removed {
+                    "The saved account was removed."
+                } else {
+                    "No saved account was found."
+                });
+                return Outcome::Menu;
+            }
+            Ok(Event::Failed(error)) => {
+                if !dismiss() {
+                    return Outcome::Exit;
+                }
+                notice(&error.to_string());
+                return Outcome::Menu;
+            }
+            Ok(Event::Cancelled) => {
+                if !dismiss() {
+                    return Outcome::Exit;
+                }
+                return Outcome::Menu;
+            }
+            Err(TryRecvError::Empty) => pump(),
+            Err(TryRecvError::Disconnected) => {
+                if !dismiss() {
+                    return Outcome::Exit;
+                }
+                notice("The account operation ended unexpectedly.");
+                return Outcome::Menu;
+            }
+        }
+    }
+}
+
+/// None means the window was closed; Some(None) starts an offline game.
+pub fn start() -> Option<Option<AuthSession>> {
+    // Do not show modal UI behind the splash screen. Some hosts are already
+    // visible before event delivery, so bound the wait and let ShowAsync fail
+    // safely rather than leaving an unresponsive window.
+    let deadline = std::time::Instant::now() + Duration::from_secs(5);
+    while !closed()
+        && unsafe { horizon_uwp_window_visible() == 0 }
+        && std::time::Instant::now() < deadline
+    {
+        pump();
+    }
+    if closed() {
+        return None;
+    }
+    let store: Arc<dyn SecretStore> = Arc::new(CredentialLocker);
+    let client_id = crate::account_client_id::client_id(option_env!("HORIZON_MSA_CLIENT_ID"));
+    loop {
+        match prompt("Choose how to start Horizon.", MENU) {
+            1 => return Some(None),
+            2 => {
+                let outcome = match prompt("Manage the Microsoft account for this app.", ACCOUNT) {
+                    1 => match client_id {
+                        Some(id) => {
+                            if prompt(
+                                "A successful sign-in replaces this app's saved account. Continue?",
+                                REPLACE,
+                            ) != 1
+                            {
+                                Outcome::Menu
+                            } else {
+                                match sign_in::start(id.to_owned(), Arc::clone(&store)) {
+                                    Ok(attempt) => wait(attempt),
+                                    Err(error) => {
+                                        notice(&error.to_string());
+                                        Outcome::Menu
+                                    }
+                                }
+                            }
+                        }
+                        None => {
+                            notice("Microsoft sign-in is not configured for this build.");
+                            Outcome::Menu
+                        }
+                    },
+                    2 => match prompt("Use or remove the saved account?", SAVED_ACCOUNT) {
+                        1 => wait(sign_in::restore(
+                            client_id.map(str::to_owned),
+                            Arc::clone(&store),
+                        )),
+                        2 => {
+                            if prompt(
+                                "Remove this app's saved account from Credential Locker?",
+                                CONFIRM,
+                            ) == 1
+                            {
+                                wait(sign_in::sign_out(Arc::clone(&store)))
+                            } else {
+                                Outcome::Menu
+                            }
+                        }
+                        _ => Outcome::Menu,
+                    },
+                    _ => Outcome::Menu,
+                };
+                match outcome {
+                    Outcome::Play(session) => return Some(Some(session)),
+                    Outcome::Exit => return None,
+                    Outcome::Menu => {}
+                }
+            }
+            _ => return None,
+        }
+    }
+}
diff --git a/uwp/game-bridge/src/server_status.rs b/uwp/game-bridge/src/server_status.rs
new file mode 100644
index 0000000000000000000000000000000000000000..2ba12413c9f68c6cd93ea15ed9359fca51a395cd
--- /dev/null
+++ b/uwp/game-bridge/src/server_status.rs
@@ -0,0 +1,169 @@
+//! Bounded status data for the UWP server page and live tile.
+
+const MAX_ICON: usize = 48 * 1024;
+
+pub(crate) fn decode_saved_icon(encoded: &str) -> Option<Vec<u8>> {
+    let encoded = encoded
+        .strip_prefix("data:image/png;base64,")
+        .unwrap_or(encoded);
+    if encoded.len() > MAX_ICON * 2 {
+        return None;
+    }
+    let bytes = horizon_client::skins::base64_decode(&encoded.replace('\n', ""))?;
+    // Validate the PNG signature and IHDR dimensions before passing untrusted
+    // server data to a platform image decoder.
+    if bytes.len() > MAX_ICON
+        || bytes.len() < 24
+        || &bytes[..8] != b"\x89PNG\r\n\x1a\n"
+        || &bytes[12..16] != b"IHDR"
+        || bytes[16..24] != [0, 0, 0, 64, 0, 0, 0, 64]
+    {
+        return None;
+    }
+    Some(bytes)
+}
+
+fn icon(json: &serde_json::Value) -> Option<Vec<u8>> {
+    let value = json["favicon"].as_str()?;
+    if !value.starts_with("data:image/png;base64,") {
+        return None;
+    }
+    decode_saved_icon(value)
+}
+
+fn payload(json: &serde_json::Value) -> Vec<u8> {
+    let motd = horizon_client::component::to_text(&json["description"], &mut |s| {
+        horizon_client::text::Text::literal(s)
+    })
+    .resolve_legacy()
+    .plain();
+    let motd: String = motd
+        .chars()
+        .filter(|c| !c.is_control() || *c == '\n')
+        .take(512)
+        .collect();
+    let players = match (
+        json["players"]["online"].as_i64(),
+        json["players"]["max"].as_i64(),
+    ) {
+        (Some(online), Some(max)) if online >= 0 && max >= 0 => format!("{online}/{max} players"),
+        _ => "Player count unavailable".into(),
+    };
+    let icon = icon(json).unwrap_or_default();
+    let mut out = Vec::with_capacity(8 + motd.len() + players.len() + icon.len());
+    out.extend_from_slice(&(motd.len() as u16).to_le_bytes());
+    out.extend_from_slice(&(players.len() as u16).to_le_bytes());
+    out.extend_from_slice(&(icon.len() as u32).to_le_bytes());
+    out.extend_from_slice(motd.as_bytes());
+    out.extend_from_slice(players.as_bytes());
+    out.extend_from_slice(&icon);
+    out
+}
+
+#[unsafe(no_mangle)]
+#[cfg(target_vendor = "uwp")]
+pub unsafe extern "C" fn horizon_uwp_server_status(
+    address: *const u8,
+    address_len: usize,
+    output: *mut u8,
+    capacity: usize,
+) -> isize {
+    if address.is_null() || output.is_null() || address_len == 0 || address_len > 1024 {
+        return -1;
+    }
+    let address =
+        match std::str::from_utf8(unsafe { std::slice::from_raw_parts(address, address_len) }) {
+            Ok(value) => value,
+            Err(_) => return -1,
+        };
+    let (json, _) = match horizon_client::net::ping(address, std::time::Duration::from_secs(5)) {
+        Ok(result) => result,
+        Err(_) => return -1,
+    };
+    let bytes = payload(&json);
+    if bytes.len() > capacity {
+        return -1;
+    }
+    unsafe { std::ptr::copy_nonoverlapping(bytes.as_ptr(), output, bytes.len()) };
+    bytes.len() as isize
+}
+
+#[unsafe(no_mangle)]
+#[cfg(target_vendor = "uwp")]
+pub unsafe extern "C" fn horizon_uwp_world_summary(
+    path: *const u16,
+    path_len: usize,
+    output: *mut u8,
+    capacity: usize,
+) -> isize {
+    use std::os::windows::ffi::OsStringExt;
+    if path.is_null() || output.is_null() || path_len == 0 || path_len > 32767 {
+        return -1;
+    }
+    let path = std::path::PathBuf::from(std::ffi::OsString::from_wide(unsafe {
+        std::slice::from_raw_parts(path, path_len)
+    }));
+    let Some(level) = horizon_client::save::Level::read_summary(&path) else {
+        return -1;
+    };
+    let mode = if level.hardcore {
+        "Hardcore"
+    } else {
+        match level.mode() {
+            1 => "Creative",
+            2 => "Adventure",
+            3 => "Spectator",
+            _ => "Survival",
+        }
+    };
+    let detail = format!(
+        "{} · {} · Day {}",
+        mode,
+        level.difficulty,
+        level.day_time.max(0) / 24_000 + 1
+    );
+    let bytes = detail.as_bytes();
+    if bytes.len() > capacity {
+        return -1;
+    }
+    unsafe { std::ptr::copy_nonoverlapping(bytes.as_ptr(), output, bytes.len()) };
+    bytes.len() as isize
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn status_has_bounded_text_and_correct_player_count() {
+        let json = serde_json::json!({"description": {"text": "Hello", "extra": [{"text":" world"}]}, "players": {"online": 3, "max": 20}});
+        let out = payload(&json);
+        let text_len = u16::from_le_bytes([out[0], out[1]]) as usize;
+        let players_len = u16::from_le_bytes([out[2], out[3]]) as usize;
+        assert_eq!(&out[8..8 + text_len], b"Hello world");
+        assert_eq!(
+            &out[8 + text_len..8 + text_len + players_len],
+            b"3/20 players"
+        );
+        assert_eq!(&out[4..8], &[0, 0, 0, 0]);
+    }
+
+    #[test]
+    fn invalid_or_wrong_sized_icons_are_rejected() {
+        assert!(icon(&serde_json::json!({"favicon":"data:image/png;base64,aGVsbG8="})).is_none());
+        assert!(icon(&serde_json::json!({"favicon":"https://example.com/icon.png"})).is_none());
+        let mut png = b"\x89PNG\r\n\x1a\n\0\0\0\rIHDR\0\0\0\x40\0\0\0\x40".to_vec();
+        let encoded = horizon_client::lan::base64(&png);
+        assert_eq!(decode_saved_icon(&encoded), Some(png.clone()));
+        assert_eq!(
+            icon(&serde_json::json!({"favicon":format!("data:image/png;base64,{encoded}")})),
+            Some(png.clone())
+        );
+        png[19] = 32;
+        let encoded = horizon_client::lan::base64(&png);
+        assert!(
+            icon(&serde_json::json!({"favicon":format!("data:image/png;base64,{encoded}")}))
+                .is_none()
+        );
+    }
+}
diff --git a/uwp/game-bridge/src/update_check.rs b/uwp/game-bridge/src/update_check.rs
new file mode 100644
index 0000000000000000000000000000000000000000..75fbc4c6d6489ed34fd0e25a198f6c4a42a69de8
--- /dev/null
+++ b/uwp/game-bridge/src/update_check.rs
@@ -0,0 +1,754 @@
+//! Quiet, read-only release checks for catalog-built UWP packages.
+//!
+//! The installed release identity is stamped by the builder. The check uses a
+//! maintainer-signed client catalog and public Horizon release metadata only;
+//! it never sends account details or installs an update.
+
+use std::path::Path;
+#[cfg(all(target_vendor = "uwp", feature = "xaml-shell"))]
+use std::path::PathBuf;
+#[cfg(all(target_vendor = "uwp", feature = "xaml-shell"))]
+use std::sync::mpsc::{self, Receiver};
+use std::time::{Duration, SystemTime, UNIX_EPOCH};
+
+const CATALOG_URL: &str =
+    "https://raw.githubusercontent.com/megabytesme/MCHorizonUWP/main/catalog/catalog-v1.json";
+const SIGNATURE_URL: &str =
+    "https://raw.githubusercontent.com/megabytesme/MCHorizonUWP/main/catalog/catalog-v1.sig";
+const HORIZON_RELEASES_URL: &str =
+    "https://api.github.com/repos/horizon-rust/horizon/releases?per_page=100";
+const CLIENT_RELEASE_BASE: &str =
+    "https://github.com/megabytesme/MCHorizonUWP/releases/tag/client-v";
+const HORIZON_RELEASE_BASE: &str = "https://github.com/horizon-rust/horizon/releases/tag/";
+const GITHUB_API_BASE: &str = "https://api.github.com/repos/horizon-rust/horizon";
+const CATALOG_LIMIT: usize = 2_000_000;
+const RELEASES_LIMIT: usize = 512_000;
+const COMPARE_LIMIT: usize = 64_000;
+const CACHE_MAX_BYTES: u64 = 32_768;
+const CACHE_TTL: Duration = Duration::from_secs(6 * 60 * 60);
+const STALE_CACHE_TTL: Duration = Duration::from_secs(24 * 60 * 60);
+const PUBLIC_CATALOG_KEY_DER: &[u8] = include_bytes!("../assets/catalog-public.der");
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct InstalledRelease {
+    pub patch_version: String,
+    pub client_version: String,
+    pub upstream_commit: String,
+}
+
+impl InstalledRelease {
+    /// Parses `HorizonRelease.json` from the APPX root.
+    pub fn parse_json(bytes: &[u8]) -> Option<Self> {
+        if bytes.len() > 4096 {
+            return None;
+        }
+        let value: serde_json::Value = serde_json::from_slice(bytes).ok()?;
+        if value.get("schema_version")?.as_u64()? != 1 {
+            return None;
+        }
+        let patch_version = value.get("patch_version")?.as_str()?.to_owned();
+        let client_version = value.get("client_version")?.as_str()?.to_owned();
+        let upstream_commit = value.get("upstream_commit")?.as_str()?.to_ascii_lowercase();
+        parse_version(&patch_version)?;
+        parse_version(&client_version)?;
+        if !is_commit(&upstream_commit) {
+            return None;
+        }
+        Some(Self {
+            patch_version,
+            client_version,
+            upstream_commit,
+        })
+    }
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct UpdateNotice {
+    pub message: String,
+    pub stable_game_tag: Option<String>,
+    pub nightly_game_tag: Option<String>,
+    pub client_version: Option<String>,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+struct NoticeParts {
+    stable_game_tag: Option<String>,
+    nightly_game_tag: Option<String>,
+    client_version: Option<String>,
+}
+
+impl NoticeParts {
+    fn notice(self) -> Option<UpdateNotice> {
+        if self.stable_game_tag.is_none()
+            && self.nightly_game_tag.is_none()
+            && self.client_version.is_none()
+        {
+            return None;
+        }
+        let mut lines = Vec::new();
+        if let Some(tag) = &self.stable_game_tag {
+            lines.push(format!(
+                "A newer Horizon stable release is available: {tag} ({HORIZON_RELEASE_BASE}{tag})."
+            ));
+        }
+        if let Some(tag) = &self.nightly_game_tag {
+            lines.push(format!(
+                "A newer Horizon nightly is available: {tag} ({HORIZON_RELEASE_BASE}{tag})."
+            ));
+        }
+        if let Some(version) = &self.client_version {
+            lines.push(format!("A newer MCHorizonUWP client is available: {version} ({CLIENT_RELEASE_BASE}{version})."));
+        }
+        Some(UpdateNotice {
+            message: lines.join("\n"),
+            stable_game_tag: self.stable_game_tag,
+            nightly_game_tag: self.nightly_game_tag,
+            client_version: self.client_version,
+        })
+    }
+}
+
+#[derive(Debug)]
+struct Release {
+    tag: String,
+    commit: String,
+}
+
+#[derive(Debug)]
+struct CacheRecord {
+    notice: NoticeParts,
+}
+
+#[derive(Debug)]
+struct CheckResult {
+    parts: NoticeParts,
+    complete: bool,
+}
+
+/// Starts a background, read-only release check. `None` means the check is
+/// disabled or this package does not contain valid release metadata.
+///
+/// The caller should poll the returned receiver from its normal UI pump. A
+/// completed check sends `None` when there is no newer release or the network
+/// is unavailable.
+#[cfg(all(target_vendor = "uwp", feature = "xaml-shell"))]
+pub fn spawn(
+    enabled: bool,
+    installed: Option<InstalledRelease>,
+    cache_path: PathBuf,
+) -> Option<Receiver<Option<UpdateNotice>>> {
+    if !enabled {
+        return None;
+    }
+    let installed = installed?;
+    let (sender, receiver) = mpsc::channel();
+    std::thread::spawn(move || {
+        let notice = check_with_cache(&installed, &cache_path, |url, limit| {
+            horizon_uwp_https_bridge::get(url, limit)
+        });
+        let _ = sender.send(notice);
+    });
+    Some(receiver)
+}
+
+fn check_with_cache<F>(
+    installed: &InstalledRelease,
+    cache_path: &Path,
+    fetch: F,
+) -> Option<UpdateNotice>
+where
+    F: FnMut(&str, usize) -> Option<Vec<u8>>,
+{
+    let now = unix_now()?;
+    if let Some(cached) = load_cache(cache_path, installed, now, CACHE_TTL) {
+        return cached.notice.notice();
+    }
+    let result = perform_check(installed, fetch);
+    if result.complete {
+        save_cache(cache_path, installed, &result.parts, now);
+    }
+    let notice = result.parts.notice();
+    if result.complete || notice.is_some() {
+        notice
+    } else {
+        load_cache(cache_path, installed, now, STALE_CACHE_TTL)
+            .and_then(|entry| entry.notice.notice())
+    }
+}
+
+fn perform_check<F>(installed: &InstalledRelease, mut fetch: F) -> CheckResult
+where
+    F: FnMut(&str, usize) -> Option<Vec<u8>>,
+{
+    let mut complete = true;
+    let client_update = match fetch(CATALOG_URL, CATALOG_LIMIT)
+        .and_then(|catalog| fetch(SIGNATURE_URL, 64).map(|signature| (catalog, signature)))
+        .and_then(|(catalog, signature)| verify_and_parse_catalog(&catalog, &signature).ok())
+        .and_then(|clients| {
+            clients
+                .into_iter()
+                .max_by(|left, right| compare_versions(left, right))
+        }) {
+        Some(newest_client) => (compare_versions(&newest_client, &installed.client_version)
+            .is_gt())
+        .then_some(newest_client),
+        None => {
+            complete = false;
+            None
+        }
+    };
+
+    let game_releases = fetch(HORIZON_RELEASES_URL, RELEASES_LIMIT)
+        .and_then(|bytes| select_game_releases(&bytes).ok());
+    if game_releases.is_none() {
+        complete = false;
+    }
+    let mut ahead_cache = std::collections::HashMap::<String, bool>::new();
+    let (stable_game_tag, nightly_game_tag) = if let Some((stable, nightly)) = game_releases {
+        let stable = match release_is_ahead(
+            stable.as_ref(),
+            &installed.upstream_commit,
+            &mut ahead_cache,
+            &mut fetch,
+        ) {
+            Ok(tag) => tag,
+            Err(()) => {
+                complete = false;
+                None
+            }
+        };
+        let nightly = match release_is_ahead(
+            nightly.as_ref(),
+            &installed.upstream_commit,
+            &mut ahead_cache,
+            &mut fetch,
+        ) {
+            Ok(tag) => tag,
+            Err(()) => {
+                complete = false;
+                None
+            }
+        };
+        (stable, nightly)
+    } else {
+        (None, None)
+    };
+    CheckResult {
+        parts: NoticeParts {
+            stable_game_tag,
+            nightly_game_tag,
+            client_version: client_update,
+        },
+        complete,
+    }
+}
+
+fn release_is_ahead<F>(
+    release: Option<&Release>,
+    installed_commit: &str,
+    ahead_cache: &mut std::collections::HashMap<String, bool>,
+    fetch: &mut F,
+) -> Result<Option<String>, ()>
+where
+    F: FnMut(&str, usize) -> Option<Vec<u8>>,
+{
+    let Some(release) = release else {
+        return Ok(None);
+    };
+    if release.commit == installed_commit {
+        return Ok(None);
+    }
+    let ahead = if let Some(value) = ahead_cache.get(&release.commit) {
+        *value
+    } else {
+        let url = format!(
+            "{GITHUB_API_BASE}/compare/{installed_commit}...{}",
+            release.commit
+        );
+        let response = fetch(&url, COMPARE_LIMIT).ok_or(())?;
+        let value = compare_is_ahead(&response)?;
+        ahead_cache.insert(release.commit.clone(), value);
+        value
+    };
+    Ok(ahead.then(|| release.tag.clone()))
+}
+
+fn verify_and_parse_catalog(bytes: &[u8], signature_bytes: &[u8]) -> Result<Vec<String>, ()> {
+    if bytes.len() > CATALOG_LIMIT || signature_bytes.len() != 64 {
+        return Err(());
+    }
+    use p256::ecdsa::{Signature, VerifyingKey, signature::Verifier};
+    use p256::pkcs8::DecodePublicKey;
+    let key = VerifyingKey::from_public_key_der(PUBLIC_CATALOG_KEY_DER).map_err(|_| ())?;
+    let signature = Signature::from_slice(signature_bytes).map_err(|_| ())?;
+    key.verify(bytes, &signature).map_err(|_| ())?;
+
+    let catalog: serde_json::Value = serde_json::from_slice(bytes).map_err(|_| ())?;
+    if catalog
+        .get("schema_version")
+        .and_then(serde_json::Value::as_u64)
+        != Some(1)
+    {
+        return Err(());
+    }
+    let clients = catalog
+        .get("clients")
+        .and_then(serde_json::Value::as_array)
+        .ok_or(())?;
+    let mut versions = Vec::with_capacity(clients.len());
+    for client in clients {
+        let version = client
+            .get("version")
+            .and_then(serde_json::Value::as_str)
+            .ok_or(())?
+            .to_owned();
+        parse_version(&version).ok_or(())?;
+        versions.push(version);
+    }
+    if versions.is_empty() {
+        return Err(());
+    }
+    Ok(versions)
+}
+
+fn select_game_releases(bytes: &[u8]) -> Result<(Option<Release>, Option<Release>), ()> {
+    let value: serde_json::Value = serde_json::from_slice(bytes).map_err(|_| ())?;
+    let entries = value.as_array().ok_or(())?;
+    let mut stable: Option<(String, Release)> = None;
+    let mut nightly: Option<(String, String, Release)> = None;
+    for entry in entries {
+        if entry.get("draft").and_then(serde_json::Value::as_bool) != Some(false) {
+            continue;
+        }
+        let Some(tag) = entry.get("tag_name").and_then(serde_json::Value::as_str) else {
+            continue;
+        };
+        let Some(commit) = entry
+            .get("target_commitish")
+            .and_then(serde_json::Value::as_str)
+        else {
+            continue;
+        };
+        let commit = commit.to_ascii_lowercase();
+        if !is_commit(&commit) {
+            continue;
+        }
+        let published_at = entry
+            .get("published_at")
+            .and_then(serde_json::Value::as_str)
+            .unwrap_or("")
+            .to_owned();
+        let release = Release {
+            tag: tag.to_owned(),
+            commit,
+        };
+        if let Some(version) = tag
+            .strip_prefix('v')
+            .filter(|version| parse_version(version).is_some())
+        {
+            let key = version.to_owned();
+            if stable
+                .as_ref()
+                .is_none_or(|(current, _)| compare_versions(&key, current).is_gt())
+            {
+                stable = Some((key, release));
+            }
+        } else if is_nightly_tag(tag) {
+            // Date-suffixed tags sort chronologically; `nightly` falls back to
+            // GitHub's publication timestamp and remains a valid old-style tag.
+            let date = tag.strip_prefix("nightly-").unwrap_or("").to_owned();
+            let order = if date.is_empty() {
+                published_at.clone()
+            } else {
+                date.clone()
+            };
+            if nightly
+                .as_ref()
+                .is_none_or(|(current_order, current_published, _)| {
+                    (&order, &published_at) > (current_order, current_published)
+                })
+            {
+                nightly = Some((order, published_at, release));
+            }
+        }
+    }
+    Ok((
+        stable.map(|(_, release)| release),
+        nightly.map(|(_, _, release)| release),
+    ))
+}
+
+fn compare_is_ahead(bytes: &[u8]) -> Result<bool, ()> {
+    let value: serde_json::Value = serde_json::from_slice(bytes).map_err(|_| ())?;
+    let status = value
+        .get("status")
+        .and_then(serde_json::Value::as_str)
+        .ok_or(())?;
+    let ahead_by = value
+        .get("ahead_by")
+        .and_then(serde_json::Value::as_u64)
+        .ok_or(())?;
+    Ok(status == "ahead" && ahead_by > 0)
+}
+
+fn is_nightly_tag(tag: &str) -> bool {
+    if tag == "nightly" {
+        return true;
+    }
+    let Some(date) = tag.strip_prefix("nightly-") else {
+        return false;
+    };
+    let mut parts = date.split('-');
+    let (Some(year), Some(month), Some(day), None) =
+        (parts.next(), parts.next(), parts.next(), parts.next())
+    else {
+        return false;
+    };
+    year.len() == 4
+        && month.len() == 2
+        && day.len() == 2
+        && year.bytes().all(|byte| byte.is_ascii_digit())
+        && month.bytes().all(|byte| byte.is_ascii_digit())
+        && day.bytes().all(|byte| byte.is_ascii_digit())
+}
+
+fn parse_version(value: &str) -> Option<(u64, u64, u64)> {
+    let mut parts = value.split('.');
+    let (Some(major), Some(minor), Some(patch), None) =
+        (parts.next(), parts.next(), parts.next(), parts.next())
+    else {
+        return None;
+    };
+    fn number(part: &str) -> Option<u64> {
+        if part.is_empty()
+            || (part.len() > 1 && part.starts_with('0'))
+            || !part.bytes().all(|byte| byte.is_ascii_digit())
+        {
+            None
+        } else {
+            part.parse().ok()
+        }
+    }
+    Some((number(major)?, number(minor)?, number(patch)?))
+}
+
+fn compare_versions(left: &str, right: &str) -> std::cmp::Ordering {
+    match (parse_version(left), parse_version(right)) {
+        (Some(left), Some(right)) => left.cmp(&right),
+        _ => std::cmp::Ordering::Equal,
+    }
+}
+
+fn is_commit(value: &str) -> bool {
+    value.len() == 40 && value.bytes().all(|byte| byte.is_ascii_hexdigit())
+}
+
+fn unix_now() -> Option<u64> {
+    SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .ok()
+        .map(|time| time.as_secs())
+}
+
+fn load_cache(
+    path: &Path,
+    installed: &InstalledRelease,
+    now: u64,
+    max_age: Duration,
+) -> Option<CacheRecord> {
+    let metadata = std::fs::metadata(path).ok()?;
+    if metadata.len() > CACHE_MAX_BYTES {
+        return None;
+    }
+    let bytes = std::fs::read(path).ok()?;
+    let value: serde_json::Value = serde_json::from_slice(&bytes).ok()?;
+    if value
+        .get("schema_version")
+        .and_then(serde_json::Value::as_u64)
+        != Some(1)
+    {
+        return None;
+    }
+    let checked_at = value
+        .get("checked_at")
+        .and_then(serde_json::Value::as_u64)?;
+    if now < checked_at || now - checked_at > max_age.as_secs() {
+        return None;
+    }
+    let cached_installed = InstalledRelease {
+        patch_version: value.get("patch_version")?.as_str()?.to_owned(),
+        client_version: value.get("client_version")?.as_str()?.to_owned(),
+        upstream_commit: value.get("upstream_commit")?.as_str()?.to_ascii_lowercase(),
+    };
+    if &cached_installed != installed {
+        return None;
+    }
+    let notice = parse_cached_notice(value.get("notice")?)?;
+    Some(CacheRecord { notice })
+}
+
+fn parse_cached_notice(value: &serde_json::Value) -> Option<NoticeParts> {
+    if !value.is_object() {
+        return None;
+    }
+    let stable_game_tag = optional_string(value, "stable_game_tag")?;
+    let nightly_game_tag = optional_string(value, "nightly_game_tag")?;
+    let client_version = optional_string(value, "client_version")?;
+    if stable_game_tag
+        .as_deref()
+        .is_some_and(|tag| !is_stable_tag(tag))
+        || nightly_game_tag
+            .as_deref()
+            .is_some_and(|tag| !is_nightly_tag(tag))
+        || client_version
+            .as_deref()
+            .is_some_and(|version| parse_version(version).is_none())
+    {
+        return None;
+    }
+    Some(NoticeParts {
+        stable_game_tag,
+        nightly_game_tag,
+        client_version,
+    })
+}
+
+fn optional_string(value: &serde_json::Value, name: &str) -> Option<Option<String>> {
+    match value.get(name)? {
+        serde_json::Value::Null => Some(None),
+        serde_json::Value::String(text) => Some(Some(text.clone())),
+        _ => None,
+    }
+}
+
+fn is_stable_tag(tag: &str) -> bool {
+    tag.strip_prefix('v')
+        .is_some_and(|version| parse_version(version).is_some())
+}
+
+fn save_cache(path: &Path, installed: &InstalledRelease, notice: &NoticeParts, checked_at: u64) {
+    let value = serde_json::json!({
+        "schema_version": 1,
+        "checked_at": checked_at,
+        "patch_version": installed.patch_version,
+        "client_version": installed.client_version,
+        "upstream_commit": installed.upstream_commit,
+        "notice": {
+            "stable_game_tag": notice.stable_game_tag,
+            "nightly_game_tag": notice.nightly_game_tag,
+            "client_version": notice.client_version,
+        },
+    });
+    let Ok(bytes) = serde_json::to_vec(&value) else {
+        return;
+    };
+    if let Some(parent) = path.parent() {
+        if std::fs::create_dir_all(parent).is_err() {
+            return;
+        }
+    }
+    let temporary = path.with_extension("json.tmp");
+    if std::fs::write(&temporary, &bytes).is_err() {
+        return;
+    }
+    // Windows rename does not replace an existing file. Removing the old
+    // non-sensitive cache first leaves only a short interval without a cache.
+    let _ = std::fs::remove_file(path);
+    let _ = std::fs::rename(temporary, path);
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const REAL_CATALOG: &[u8] = include_bytes!("../tests/fixtures/catalog-v1.json");
+    const REAL_SIGNATURE: &[u8] = include_bytes!("../tests/fixtures/catalog-v1.sig");
+
+    #[test]
+    fn appx_metadata_is_strict_and_uses_the_catalog_identity() {
+        let bytes = br#"{"schema_version":1,"patch_version":"0.1.0","client_version":"0.1.1","upstream_commit":"F42EF42EF6CECCB3C6A20BEA2481D87949A51C81"}"#;
+        let installed = InstalledRelease::parse_json(bytes).unwrap();
+        assert_eq!(installed.client_version, "0.1.1");
+        assert_eq!(
+            installed.upstream_commit,
+            "f42ef42ef6ceccb3c6a20bea2481d87949a51c81"
+        );
+        assert!(InstalledRelease::parse_json(br#"{"schema_version":1,"patch_version":"0.1","client_version":"0.1.1","upstream_commit":"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"}"#).is_none());
+        assert!(InstalledRelease::parse_json(br#"{"schema_version":2,"patch_version":"0.1.0","client_version":"0.1.1","upstream_commit":"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"}"#).is_none());
+    }
+
+    #[test]
+    fn bundled_catalog_key_accepts_signed_catalog_and_rejects_tampering() {
+        let versions = verify_and_parse_catalog(REAL_CATALOG, REAL_SIGNATURE).unwrap();
+        assert_eq!(
+            versions
+                .into_iter()
+                .max_by(|left, right| compare_versions(left, right))
+                .as_deref(),
+            Some("0.1.1")
+        );
+        let mut tampered = REAL_CATALOG.to_vec();
+        tampered[0] ^= 1;
+        assert!(verify_and_parse_catalog(&tampered, REAL_SIGNATURE).is_err());
+    }
+
+    #[test]
+    fn game_release_selection_ignores_launcher_tags_and_keeps_stable_and_nightly_separate() {
+        let releases = format!(
+            r#"[
+          {{"draft":false,"tag_name":"launcher@0.2.99","target_commitish":"{}","published_at":"2026-11-06T10:00:00Z"}},
+          {{"draft":false,"tag_name":"v0.2.96","target_commitish":"{}","published_at":"2026-11-04T10:00:00Z"}},
+          {{"draft":false,"tag_name":"v0.2.97","target_commitish":"{}","published_at":"2026-11-05T10:00:00Z"}},
+          {{"draft":false,"tag_name":"nightly-2026-11-05","target_commitish":"{}","published_at":"2026-11-05T11:00:00Z"}},
+          {{"draft":false,"tag_name":"nightly-2026-11-04","target_commitish":"{}","published_at":"2026-11-04T11:00:00Z"}}
+        ]"#,
+            "a".repeat(40),
+            "b".repeat(40),
+            "c".repeat(40),
+            "d".repeat(40),
+            "e".repeat(40)
+        );
+        let (stable, nightly) = select_game_releases(releases.as_bytes()).unwrap();
+        assert_eq!(stable.unwrap().tag, "v0.2.97");
+        assert_eq!(nightly.unwrap().tag, "nightly-2026-11-05");
+    }
+
+    #[test]
+    fn signed_catalog_and_public_github_metadata_report_each_newer_stream() {
+        let installed = InstalledRelease {
+            patch_version: "0.1.0".to_owned(),
+            client_version: "0.1.0".to_owned(),
+            upstream_commit: "a".repeat(40),
+        };
+        let releases = format!(
+            r#"[
+              {{"draft":false,"tag_name":"launcher@0.2.99","target_commitish":"{}","published_at":"2026-11-06T10:00:00Z"}},
+              {{"draft":false,"tag_name":"v0.2.97","target_commitish":"{}","published_at":"2026-11-05T10:00:00Z"}},
+              {{"draft":false,"tag_name":"nightly-2026-11-05","target_commitish":"{}","published_at":"2026-11-05T11:00:00Z"}}
+            ]"#,
+            "f".repeat(40),
+            "b".repeat(40),
+            "c".repeat(40)
+        );
+        let mut comparisons = 0;
+        let result = perform_check(&installed, |url, _| {
+            if url == CATALOG_URL {
+                Some(REAL_CATALOG.to_vec())
+            } else if url == SIGNATURE_URL {
+                Some(REAL_SIGNATURE.to_vec())
+            } else if url == HORIZON_RELEASES_URL {
+                Some(releases.as_bytes().to_vec())
+            } else if url.starts_with(&format!("{GITHUB_API_BASE}/compare/")) {
+                comparisons += 1;
+                Some(br#"{"status":"ahead","ahead_by":3}"#.to_vec())
+            } else {
+                None
+            }
+        });
+        assert!(result.complete);
+        let notice = result.parts;
+        assert_eq!(comparisons, 2);
+        assert_eq!(notice.stable_game_tag.as_deref(), Some("v0.2.97"));
+        assert_eq!(
+            notice.nightly_game_tag.as_deref(),
+            Some("nightly-2026-11-05")
+        );
+        assert_eq!(notice.client_version.as_deref(), Some("0.1.1"));
+        assert!(
+            notice
+                .notice()
+                .unwrap()
+                .message
+                .contains(CLIENT_RELEASE_BASE)
+        );
+    }
+
+    #[test]
+    fn only_an_ahead_comparison_is_reported() {
+        assert!(compare_is_ahead(br#"{"status":"ahead","ahead_by":1}"#).unwrap());
+        assert!(!compare_is_ahead(br#"{"status":"identical","ahead_by":0}"#).unwrap());
+        assert!(!compare_is_ahead(br#"{"status":"diverged","ahead_by":2}"#).unwrap());
+        assert!(!compare_is_ahead(br#"{"status":"behind","ahead_by":0}"#).unwrap());
+    }
+
+    #[test]
+    fn version_and_tag_parsing_excludes_invalid_and_launcher_streams() {
+        assert!(compare_versions("0.10.0", "0.9.99").is_gt());
+        assert_eq!(parse_version("01.2.3"), None);
+        assert!(is_nightly_tag("nightly-2026-11-05"));
+        assert!(!is_nightly_tag("launcher@0.2.99"));
+        assert!(!is_stable_tag("v0.2.97-rc1"));
+    }
+
+    #[test]
+    fn cached_notice_is_checked_against_a_fresh_signature_free_local_record() {
+        let root = std::env::temp_dir().join(format!("huwp-update-cache-{}", std::process::id()));
+        let path = root.join("update-check.json");
+        let installed = InstalledRelease {
+            patch_version: "0.1.0".to_owned(),
+            client_version: "0.1.1".to_owned(),
+            upstream_commit: "a".repeat(40),
+        };
+        let parts = NoticeParts {
+            stable_game_tag: Some("v0.2.97".to_owned()),
+            nightly_game_tag: None,
+            client_version: None,
+        };
+        save_cache(&path, &installed, &parts, 1000);
+        let loaded = load_cache(&path, &installed, 1000 + 60, CACHE_TTL).unwrap();
+        assert_eq!(loaded.notice, parts);
+        assert!(load_cache(&path, &installed, 1000 + CACHE_TTL.as_secs() + 1, CACHE_TTL).is_none());
+        assert!(
+            load_cache(
+                &path,
+                &InstalledRelease {
+                    client_version: "0.1.0".to_owned(),
+                    ..installed
+                },
+                1000 + 60,
+                CACHE_TTL
+            )
+            .is_none()
+        );
+        let _ = std::fs::remove_dir_all(root);
+    }
+
+    #[test]
+    fn a_fresh_check_cache_avoids_all_repeat_network_requests() {
+        let root =
+            std::env::temp_dir().join(format!("huwp-update-cache-flow-{}", std::process::id()));
+        let path = root.join("update-check.json");
+        let installed = InstalledRelease {
+            patch_version: "0.1.0".to_owned(),
+            client_version: "0.1.0".to_owned(),
+            upstream_commit: "a".repeat(40),
+        };
+        let releases = format!(
+            r#"[
+              {{"draft":false,"tag_name":"v0.2.97","target_commitish":"{}","published_at":"2026-11-05T10:00:00Z"}},
+              {{"draft":false,"tag_name":"nightly-2026-11-05","target_commitish":"{}","published_at":"2026-11-05T11:00:00Z"}}
+            ]"#,
+            "b".repeat(40),
+            "c".repeat(40)
+        );
+        let first = check_with_cache(&installed, &path, |url, _| {
+            if url == CATALOG_URL {
+                Some(REAL_CATALOG.to_vec())
+            } else if url == SIGNATURE_URL {
+                Some(REAL_SIGNATURE.to_vec())
+            } else if url == HORIZON_RELEASES_URL {
+                Some(releases.as_bytes().to_vec())
+            } else if url.starts_with(&format!("{GITHUB_API_BASE}/compare/")) {
+                Some(br#"{"status":"ahead","ahead_by":1}"#.to_vec())
+            } else {
+                None
+            }
+        });
+        assert!(first.is_some());
+        let cached = check_with_cache(&installed, &path, |_, _| {
+            panic!("fresh cache should avoid release-network requests")
+        });
+        assert_eq!(cached.unwrap().stable_game_tag.as_deref(), Some("v0.2.97"));
+        let _ = std::fs::remove_dir_all(root);
+    }
+}
diff --git a/uwp/game-bridge/src/xaml_pregame.rs b/uwp/game-bridge/src/xaml_pregame.rs
new file mode 100644
index 0000000000000000000000000000000000000000..4b6f64991e5417fd31f9aee4f963e2818ba53555
--- /dev/null
+++ b/uwp/game-bridge/src/xaml_pregame.rs
@@ -0,0 +1,533 @@
+//! Native UWP pre-game account flow. All tokens stay inside this process.
+use horizon_account_core::{
+    profiles::{self, Profile, ProfileStore},
+    sign_in::{self, Attempt, Event},
+    vault::{CredentialLocker, SecretStore},
+};
+use horizon_client::auth::AuthSession;
+use std::path::Path;
+use std::{
+    sync::{Arc, mpsc::TryRecvError},
+    time::Duration,
+};
+
+unsafe extern "C" {
+    fn horizon_uwp_dialog_show(text: *const u8, len: usize, kind: u32) -> i32;
+    fn horizon_uwp_dialog_poll() -> i32;
+    fn horizon_uwp_dialog_cancel();
+    fn horizon_uwp_window_closed() -> i32;
+    fn horizon_uwp_window_visible() -> i32;
+    fn horizon_uwp_pump_events();
+    fn horizon_uwp_page_tick();
+    fn horizon_uwp_page_profile(text: *const u8, len: usize, kind: u32);
+    fn horizon_uwp_page_skin(text: *const u8, len: usize);
+    fn horizon_uwp_page_accounts(text: *const u8, len: usize);
+    fn horizon_uwp_dialog_text(buffer: *mut u8, capacity: usize) -> usize;
+    fn horizon_uwp_telemetry_prompt(mask: u32) -> i32;
+    fn horizon_uwp_page_selected_telemetry_mask() -> u32;
+    fn horizon_uwp_page_update_enabled() -> i32;
+    fn horizon_uwp_release_metadata(buffer: *mut u8, capacity: usize) -> usize;
+    fn horizon_uwp_page_update_notice(text: *const u8, len: usize);
+}
+
+fn start_update_check(game_dir: &Path) {
+    let enabled = unsafe { horizon_uwp_page_update_enabled() != 0 };
+    let mut metadata = [0u8; 4096];
+    let length = unsafe { horizon_uwp_release_metadata(metadata.as_mut_ptr(), metadata.len()) };
+    let installed = metadata
+        .get(..length)
+        .filter(|_| length > 0 && length <= metadata.len())
+        .and_then(crate::update_check::InstalledRelease::parse_json);
+    if let Some(receiver) =
+        crate::update_check::spawn(enabled, installed, game_dir.join("update-check.json"))
+    {
+        let _ = std::thread::Builder::new()
+            .name("Horizon update notice".into())
+            .spawn(move || {
+                if let Ok(Some(notice)) = receiver.recv() {
+                    let message = notice.message.as_bytes();
+                    unsafe { horizon_uwp_page_update_notice(message.as_ptr(), message.len()) };
+                }
+            });
+    }
+}
+
+const MENU: u32 = 0;
+const ACCOUNT: u32 = 1;
+const WAIT: u32 = 2;
+const NOTICE: u32 = 3;
+const CONFIRM: u32 = 4;
+const SELECT_ACCOUNT: u32 = 5;
+const OFFLINE_NAME: u32 = 7;
+const ADD_ACCOUNT: u32 = 8;
+
+pub struct Selection {
+    pub session: Option<AuthSession>,
+    pub offline_name: Option<String>,
+}
+
+fn closed() -> bool {
+    unsafe { horizon_uwp_window_closed() != 0 }
+}
+fn pump() {
+    unsafe { horizon_uwp_pump_events() };
+    unsafe { horizon_uwp_page_tick() };
+    std::thread::sleep(Duration::from_millis(20));
+}
+fn show(text: &str, kind: u32) -> bool {
+    if unsafe { horizon_uwp_dialog_show(text.as_ptr(), text.len(), kind) == 0 } {
+        true
+    } else {
+        crate::report_failure("Horizon could not display the startup page.");
+        false
+    }
+}
+fn poll() -> i32 {
+    let result = unsafe { horizon_uwp_dialog_poll() };
+    if result == -2 {
+        crate::report_failure("The Horizon startup page stopped responding.");
+        -1
+    } else {
+        result
+    }
+}
+fn dismiss() -> bool {
+    unsafe { horizon_uwp_dialog_cancel() };
+    let deadline = std::time::Instant::now() + Duration::from_secs(5);
+    while !closed() && poll() == 0 && std::time::Instant::now() < deadline {
+        pump();
+    }
+    !closed() && poll() != 0
+}
+fn prompt(text: &str, kind: u32) -> i32 {
+    if !show(text, kind) {
+        return -1;
+    }
+    while !closed() {
+        let selected = poll();
+        if selected != 0 {
+            return selected;
+        }
+        pump();
+    }
+    -1
+}
+fn notice(text: &str) {
+    let _ = prompt(text, NOTICE);
+}
+
+enum Outcome {
+    Play(AuthSession, Option<String>),
+    SignedOut,
+    Menu,
+    Exit,
+}
+
+fn wait(attempt: Attempt) -> Outcome {
+    if !show("Contacting the account service…", WAIT) {
+        return Outcome::Exit;
+    }
+    loop {
+        if closed() {
+            attempt.cancel();
+            return Outcome::Exit;
+        }
+        if poll() != 0 {
+            attempt.cancel();
+            return Outcome::Menu;
+        }
+        match attempt.try_recv() {
+            Ok(Event::Prompt {
+                user_code,
+                verification_uri,
+            }) => {
+                if !dismiss() {
+                    return Outcome::Exit;
+                }
+                if closed() {
+                    attempt.cancel();
+                    return Outcome::Exit;
+                }
+                let text = format!(
+                    "On another device, open {verification_uri} and enter:\n\n{user_code}\n\nReturn here after approving sign-in."
+                );
+                if !show(&text, WAIT) {
+                    attempt.cancel();
+                    return Outcome::Exit;
+                }
+            }
+            Ok(Event::Ready(session)) => {
+                if !dismiss() {
+                    return Outcome::Exit;
+                }
+                let skin = session
+                    .account
+                    .skin
+                    .as_ref()
+                    .and_then(|(url, _)| profiles::safe_skin_url(url));
+                // AuthSession::parse returns fixed errors and never echoes the JSON.
+                return match AuthSession::parse(&session.into_json()) {
+                    Ok(session) => Outcome::Play(session, skin),
+                    Err(_) => {
+                        notice("The account session could not be opened.");
+                        Outcome::Menu
+                    }
+                };
+            }
+            Ok(Event::Offline(_)) => {
+                if !dismiss() {
+                    return Outcome::Exit;
+                }
+                notice(
+                    "The account service could not be reached. Start the game without signing in to play offline.",
+                );
+                return Outcome::SignedOut;
+            }
+            Ok(Event::NoAccount) => {
+                if !dismiss() {
+                    return Outcome::Exit;
+                }
+                notice("No saved account was found. Choose Sign in to add one.");
+                return Outcome::SignedOut;
+            }
+            Ok(Event::SignedOut { removed }) => {
+                if !dismiss() {
+                    return Outcome::Exit;
+                }
+                notice(if removed {
+                    "The saved account was removed."
+                } else {
+                    "No saved account was found."
+                });
+                return Outcome::SignedOut;
+            }
+            Ok(Event::Failed(error)) => {
+                if !dismiss() {
+                    return Outcome::Exit;
+                }
+                notice(&error.to_string());
+                return Outcome::Menu;
+            }
+            Ok(Event::Cancelled) => {
+                if !dismiss() {
+                    return Outcome::Exit;
+                }
+                return Outcome::Menu;
+            }
+            Err(TryRecvError::Empty) => pump(),
+            Err(TryRecvError::Disconnected) => {
+                if !dismiss() {
+                    return Outcome::Exit;
+                }
+                notice("The account operation ended unexpectedly.");
+                return Outcome::Menu;
+            }
+        }
+    }
+}
+
+fn set_profile(name: Option<&str>, kind: u32) {
+    let bytes = name.unwrap_or("").as_bytes();
+    unsafe { horizon_uwp_page_profile(bytes.as_ptr(), bytes.len(), kind) };
+}
+
+fn set_skin(url: Option<&str>) {
+    let bytes = url.unwrap_or("").as_bytes();
+    unsafe { horizon_uwp_page_skin(bytes.as_ptr(), bytes.len()) };
+}
+
+fn choose_profile(store: &dyn SecretStore, question: &str) -> Option<Profile> {
+    let profiles = match profiles::list(store) {
+        Ok(profiles) => profiles,
+        Err(_) => {
+            notice(
+                "The saved accounts could not be opened. Your existing credentials were preserved.",
+            );
+            return None;
+        }
+    };
+    if profiles.is_empty() {
+        notice("No saved accounts were found. Add an online or offline account first.");
+        return None;
+    }
+    let mut labels = String::new();
+    for profile in &profiles {
+        let name: String = profile
+            .name
+            .chars()
+            .map(|c| {
+                if c == '\n' || c == '\r' || c == '\t' {
+                    ' '
+                } else {
+                    c
+                }
+            })
+            .collect();
+        labels.push_str(if profile.online {
+            "Online\t"
+        } else {
+            "Offline\t"
+        });
+        labels.push_str(&name);
+        labels.push('\n');
+    }
+    unsafe { horizon_uwp_page_accounts(labels.as_ptr(), labels.len()) };
+    let answer = prompt(question, SELECT_ACCOUNT);
+    answer
+        .checked_sub(100)
+        .and_then(|i| profiles.get(i as usize))
+        .cloned()
+}
+
+/// None means the window was closed. A selection without a session is offline.
+pub fn start(game_dir: &Path) -> Option<Selection> {
+    start_update_check(game_dir);
+    let deadline = std::time::Instant::now() + Duration::from_secs(5);
+    while !closed()
+        && unsafe { horizon_uwp_window_visible() == 0 }
+        && std::time::Instant::now() < deadline
+    {
+        pump();
+    }
+    if closed() {
+        return None;
+    }
+    let (mut telemetry_mask, telemetry_confirmed) =
+        horizon_client::telemetry::uwp_consent_mask(game_dir);
+    if !telemetry_confirmed {
+        if unsafe { horizon_uwp_telemetry_prompt(telemetry_mask) } == 0 {
+            while !closed() {
+                match poll() {
+                    1 => {
+                        telemetry_mask = unsafe { horizon_uwp_page_selected_telemetry_mask() };
+                        if horizon_client::telemetry::save_uwp_consent_mask(
+                            game_dir,
+                            telemetry_mask,
+                        )
+                        .is_err()
+                        {
+                            notice(
+                                "Telemetry choices could not be saved. No telemetry will be sent until you confirm them in a later launch.",
+                            );
+                        }
+                        break;
+                    }
+                    2 | -1 => break,
+                    0 => pump(),
+                    _ => break,
+                }
+            }
+        }
+    }
+    if closed() {
+        return None;
+    }
+    let store: Arc<dyn SecretStore> = Arc::new(CredentialLocker);
+    let client_id = crate::account_client_id::client_id(option_env!("HORIZON_MSA_CLIENT_ID"));
+    let mut active = Selection {
+        session: None,
+        offline_name: None,
+    };
+    let mut active_id: Option<String> = None;
+    let mut pending_online: Option<String> = None;
+    match profiles::selected(store.as_ref()) {
+        Ok(Some(profile)) if profile.online => {
+            set_profile(Some(&profile.name), 3);
+            set_skin(profile.skin.as_deref());
+            active_id = Some(profile.id.clone());
+            pending_online = Some(profile.id);
+        }
+        Ok(Some(profile)) => {
+            set_profile(Some(&profile.name), 2);
+            set_skin(None);
+            active_id = Some(profile.id);
+            active.offline_name = Some(profile.name);
+        }
+        Ok(None) => {}
+        Err(_) => {
+            notice("Saved accounts could not be opened. Existing credentials were preserved.")
+        }
+    }
+    loop {
+        match prompt("Play Minecraft: Java Edition with Horizon.", MENU) {
+            1 => {
+                if let Some(id) = pending_online.as_ref() {
+                    let selected = match ProfileStore::selected(Arc::clone(&store), id.clone()) {
+                        Ok(selected) => selected,
+                        Err(_) => {
+                            notice("The saved account could not be opened.");
+                            continue;
+                        }
+                    };
+                    match wait(sign_in::restore(
+                        client_id.map(str::to_owned),
+                        Arc::new(selected),
+                    )) {
+                        Outcome::Play(session, _) => {
+                            return Some(Selection {
+                                session: Some(session),
+                                offline_name: None,
+                            });
+                        }
+                        Outcome::Exit => return None,
+                        _ => continue,
+                    }
+                }
+                return Some(active);
+            }
+            2 => {
+                let account_action = match prompt("Manage the accounts on this device.", ACCOUNT) {
+                    1 => match prompt("Choose how to add an account.", ADD_ACCOUNT) {
+                        1 => 1,
+                        2 => 3,
+                        _ => 0,
+                    },
+                    2 => 2,
+                    3 => 4,
+                    _ => 0,
+                };
+                let outcome = match account_action {
+                    1 => match client_id {
+                        Some(id) => {
+                            let account_store: Arc<dyn SecretStore> =
+                                Arc::new(ProfileStore::adding(Arc::clone(&store)));
+                            match sign_in::start(id.to_owned(), account_store) {
+                                Ok(attempt) => wait(attempt),
+                                Err(error) => {
+                                    notice(&error.to_string());
+                                    Outcome::Menu
+                                }
+                            }
+                        }
+                        None => {
+                            notice("Microsoft sign-in is not configured for this build.");
+                            Outcome::Menu
+                        }
+                    },
+                    2 => match choose_profile(store.as_ref(), "Choose an account to use.") {
+                        Some(profile) if profile.online => {
+                            match ProfileStore::selected(Arc::clone(&store), profile.id) {
+                                Ok(selected) => wait(sign_in::restore(
+                                    client_id.map(str::to_owned),
+                                    Arc::new(selected),
+                                )),
+                                Err(_) => {
+                                    notice("The selected account could not be opened.");
+                                    Outcome::Menu
+                                }
+                            }
+                        }
+                        Some(profile) => {
+                            if profiles::select(store.as_ref(), &profile.id).is_err() {
+                                notice("The account selection could not be saved for next time.");
+                            }
+                            set_profile(Some(&profile.name), 2);
+                            set_skin(None);
+                            active_id = Some(profile.id);
+                            pending_online = None;
+                            active = Selection {
+                                session: None,
+                                offline_name: Some(profile.name),
+                            };
+                            Outcome::Menu
+                        }
+                        None => Outcome::Menu,
+                    },
+                    3 => {
+                        if prompt(
+                            "Choose an offline player name (3–16 letters, digits or underscores).",
+                            OFFLINE_NAME,
+                        ) == 1
+                        {
+                            let mut buffer = [0u8; 64];
+                            let length = unsafe {
+                                horizon_uwp_dialog_text(buffer.as_mut_ptr(), buffer.len())
+                            };
+                            let name = buffer
+                                .get(..length)
+                                .and_then(|b| std::str::from_utf8(b).ok())
+                                .unwrap_or("");
+                            match profiles::add_offline(store.as_ref(), name) {
+                                Ok(profile) => {
+                                    if profiles::select(store.as_ref(), &profile.id).is_err() {
+                                        notice(
+                                            "The account selection could not be saved for next time.",
+                                        );
+                                    }
+                                    set_profile(Some(&profile.name), 2);
+                                    set_skin(None);
+                                    active_id = Some(profile.id);
+                                    pending_online = None;
+                                    active = Selection {
+                                        session: None,
+                                        offline_name: Some(profile.name),
+                                    };
+                                }
+                                Err(_) => notice(
+                                    "The offline account could not be added. Check the name and available account slots.",
+                                ),
+                            }
+                        }
+                        Outcome::Menu
+                    }
+                    4 => {
+                        if let Some(profile) =
+                            choose_profile(store.as_ref(), "Choose an account to remove.")
+                        {
+                            if prompt("Remove this account from this app?", CONFIRM) == 1 {
+                                match profiles::remove(store.as_ref(), &profile.id) {
+                                    Ok(true) => {
+                                        if active_id.as_deref() == Some(profile.id.as_str()) {
+                                            active_id = None;
+                                            pending_online = None;
+                                            active = Selection {
+                                                session: None,
+                                                offline_name: None,
+                                            };
+                                            set_profile(None, 0);
+                                            set_skin(None);
+                                        }
+                                        notice("The account was removed.");
+                                    }
+                                    Ok(false) => notice("The account was not found."),
+                                    Err(_) => notice("The account could not be removed."),
+                                }
+                            }
+                        }
+                        Outcome::Menu
+                    }
+                    _ => Outcome::Menu,
+                };
+                match outcome {
+                    Outcome::Play(session, skin) => {
+                        let id = format!("online:{:032x}", session.uuid);
+                        if profiles::select(store.as_ref(), &id).is_err() {
+                            notice("The account selection could not be saved for next time.");
+                        }
+                        active_id = Some(id);
+                        pending_online = None;
+                        set_profile(Some(&session.name), 1);
+                        set_skin(skin.as_deref());
+                        active = Selection {
+                            session: Some(session),
+                            offline_name: None,
+                        };
+                    }
+                    Outcome::SignedOut => {
+                        active_id = None;
+                        pending_online = None;
+                        active = Selection {
+                            session: None,
+                            offline_name: None,
+                        };
+                        set_profile(None, 0);
+                        set_skin(None);
+                    }
+                    Outcome::Exit => return None,
+                    Outcome::Menu => {}
+                }
+            }
+            _ => return None,
+        }
+    }
+}
