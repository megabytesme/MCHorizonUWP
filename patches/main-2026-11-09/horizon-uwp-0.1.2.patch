@@ -0,0 +1,553 @@
+/// The configured Azure app, if any: the run-time variable wins over the build-time one, and an
+/// empty value means none.
+pub fn client_id() -> Option<String> {
+    std::env::var("HORIZON_MSA_CLIENT_ID")
+        .ok()
+        .or_else(|| option_env!("HORIZON_MSA_CLIENT_ID").map(str::to_owned))
+        .map(|id| id.trim().to_owned())
+        .filter(|id| !id.is_empty())
+}
+
+/// Where the requests go: the real services, or a mock in tests.
+#[derive(Clone, Debug)]
+pub struct Endpoints {
+    /// The OAuth 2.0 v2 endpoints for personal accounts (`â€¦/devicecode`, `â€¦/token`).
+    pub microsoft: String,
+    pub xbox_user: String,
+    pub xsts: String,
+    /// api.minecraftservices.com.
+    pub minecraft: String,
+}
+
+impl Endpoints {
+    pub fn live() -> Self {
+        // Development builds only: `HORIZON_MSA_MICROSOFT_ENDPOINT` points the device-code and
+        // token requests at a local mock, to see and screenshot the sign-in panel.
+        let microsoft = std::env::var("HORIZON_MSA_MICROSOFT_ENDPOINT")
+            .ok()
+            .filter(|_| cfg!(debug_assertions))
+            .unwrap_or_else(|| "https://login.microsoftonline.com/consumers/oauth2/v2.0".into());
+        Self {
+            microsoft,
+            xbox_user: "https://user.auth.xboxlive.com/user/authenticate".into(),
+            xsts: "https://xsts.auth.xboxlive.com/xsts/authorize".into(),
+            minecraft: "https://api.minecraftservices.com".into(),
+        }
+    }
+}
+
+enum Body<'a> {
+    Form(Vec<(&'a str, &'a str)>),
+    Json(Value),
+}
+
+fn str_field(v: &Value, key: &str) -> Option<String> {
+    v.get(key).and_then(Value::as_str).map(str::to_owned)
+}
+
+fn now() -> u64 {
+    SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .map_or(0, |d| d.as_secs())
+}
+
+// ----- The device-code flow ----------------------------------------------------------------------
+
+/// What the player types at the verification page.
+#[derive(Clone, PartialEq)]
+pub struct DeviceCode {
+    pub user_code: String,
+    pub verification_uri: String,
+    pub interval: u64,
+    pub expires_at: u64,
+    device_code: String,
+}
+
+impl std::fmt::Debug for DeviceCode {
+    // The device code can be traded for tokens once the player approves: never shown.
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("DeviceCode")
+            .field("user_code", &self.user_code)
+            .field("verification_uri", &self.verification_uri)
+            .finish_non_exhaustive()
+    }
+}
+
+/// The Microsoft tokens; the access token only lasts for the Xbox step.
+pub struct MsTokens {
+    access: String,
+    refresh: String,
+}
+
+impl std::fmt::Debug for MsTokens {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str("MsTokens(<hidden>)")
+    }
+}
+
+pub enum Poll {
+    Pending,
+    /// The server asked to poll less often: wait 5 s more.
+    SlowDown,
+    Done(MsTokens),
+}
+
+pub fn device_code(ep: &Endpoints, client_id: &str) -> Result<DeviceCode, String> {
+    let (status, v) = send(
+        request_to("POST", &format!("{}/devicecode", ep.microsoft)),
+        Some(Body::Form(vec![("client_id", client_id), ("scope", SCOPE)])),
+        "Microsoft",
+    )?;
+    match (
+        status,
+        str_field(&v, "user_code"),
+        str_field(&v, "device_code"),
+    ) {
+        (200, Some(user_code), Some(device_code)) => Ok(DeviceCode {
+            user_code,
+            verification_uri: str_field(&v, "verification_uri")
+                .unwrap_or_else(|| "https://www.microsoft.com/link".into()),
+            interval: v
+                .get("interval")
+                .and_then(Value::as_u64)
+                .unwrap_or(5)
+                .max(1),
+            expires_at: now() + v.get("expires_in").and_then(Value::as_u64).unwrap_or(900),
+            device_code,
+        }),
+        _ => Err(oauth_error(&v)),
+    }
+}
+
+/// The OAuth error codes as messages for the player.
+fn oauth_error(v: &Value) -> String {
+    match v.get("error").and_then(Value::as_str) {
+        Some("authorization_declined") => "Sign-in was declined in the browser.".into(),
+        Some("expired_token") => "The sign-in code expired. Start again.".into(),
+        Some("bad_verification_code") => "The sign-in code was not recognised. Start again.".into(),
+        Some("invalid_grant") => SIGN_IN_AGAIN.into(),
+        Some("invalid_client" | "unauthorized_client") => {
+            "Microsoft refused this launcher's app registration (client ID).".into()
+        }
+        Some(other) => format!("Microsoft sign-in failed ({other})."),
+        None => "Microsoft sign-in failed.".into(),
+    }
+}
+
+/// One poll of the token endpoint while the player signs in.
+pub fn poll(ep: &Endpoints, client_id: &str, code: &DeviceCode) -> Result<Poll, String> {
+    let (status, v) = send(
+        request_to("POST", &format!("{}/token", ep.microsoft)),
+        Some(Body::Form(vec![
+            ("grant_type", "urn:ietf:params:oauth:grant-type:device_code"),
+            ("client_id", client_id),
+            ("device_code", &code.device_code),
+        ])),
+        "Microsoft",
+    )?;
+    match v.get("error").and_then(Value::as_str) {
+        Some("authorization_pending") => return Ok(Poll::Pending),
+        Some("slow_down") => return Ok(Poll::SlowDown),
+        _ => {}
+    }
+    ms_tokens(status, &v).map(Poll::Done)
+}
+
+fn ms_tokens(status: u16, v: &Value) -> Result<MsTokens, String> {
+    match (
+        status,
+        str_field(v, "access_token"),
+        str_field(v, "refresh_token"),
+    ) {
+        (200, Some(access), Some(refresh)) => Ok(MsTokens { access, refresh }),
+        _ => Err(oauth_error(v)),
+    }
+}
+
+/// Wait for the player to finish in the browser, polling as asked, until the code expires or
+/// `cancelled` says stop.
+pub fn wait_for_sign_in(
+    ep: &Endpoints,
+    client_id: &str,
+    code: &DeviceCode,
+    cancelled: &dyn Fn() -> bool,
+) -> Result<MsTokens, String> {
+    let mut interval = code.interval;
+    loop {
+        let until = std::time::Instant::now() + Duration::from_secs(interval);
+        while std::time::Instant::now() < until {
+            if cancelled() {
+                return Err("Sign-in cancelled.".into());
+            }
+            std::thread::sleep(Duration::from_millis(100));
+        }
+        if now() > code.expires_at {
+            return Err("The sign-in code expired. Start again.".into());
+        }
+        match poll(ep, client_id, code)? {
+            Poll::Pending => {}
+            Poll::SlowDown => interval += 5,
+            Poll::Done(tokens) => return Ok(tokens),
+        }
+    }
+}
+
+fn refresh_ms(ep: &Endpoints, client_id: &str, refresh: &str) -> Result<MsTokens, String> {
+    let (status, v) = send(
+        request_to("POST", &format!("{}/token", ep.microsoft)),
+        Some(Body::Form(vec![
+            ("grant_type", "refresh_token"),
+            ("client_id", client_id),
+            ("refresh_token", refresh),
+            ("scope", SCOPE),
+        ])),
+        "Microsoft",
+    )?;
+    ms_tokens(status, &v)
+}
+
+// ----- Xbox Live, XSTS, Minecraft ----------------------------------------------------------------
+
+/// The XSTS `XErr` codes, as the official launcher explains them.
+fn xsts_error(code: u64) -> String {
+    match code {
+        2148916233 => "This Microsoft account has no Xbox profile yet. Sign in once at xbox.com to create one, then try again.".into(),
+        2148916235 => "Xbox Live is not available in your country or region.".into(),
+        2148916236 | 2148916237 => "This account needs adult verification on xbox.com before it can play.".into(),
+        2148916238 => "This is a child account: an adult has to add it to a Microsoft family first.".into(),
+        other => format!("Xbox Live refused the sign-in (error {other})."),
+    }
+}
+
+/// The Minecraft access token from the Microsoft one, through Xbox Live and XSTS.
+struct Minecraft {
+    token: String,
+    expires_at: u64,
+    xuid: Option<String>,
+}
+
+fn minecraft_login(
+    ep: &Endpoints,
+    ms_access: &str,
+    progress: &dyn Fn(session::Phase),
+) -> Result<Minecraft, String> {
+    progress(session::Phase::Xbox);
+    let (status, xbl) = send(
+        request_to("POST", &ep.xbox_user),
+        Some(Body::Json(json!({
+            "Properties": {
+                "AuthMethod": "RPS",
+                "SiteName": "user.auth.xboxlive.com",
+                "RpsTicket": format!("d={ms_access}"),
+            },
+            "RelyingParty": "http://auth.xboxlive.com",
+            "TokenType": "JWT",
+        }))),
+        "Xbox Live",
+    )?;
+    let xbl_token = str_field(&xbl, "Token")
+        .filter(|_| status == 200)
+        .ok_or("Xbox Live refused the sign-in.")?;
+    let (status, xsts) = send(
+        request_to("POST", &ep.xsts),
+        Some(Body::Json(json!({
+            "Properties": { "SandboxId": "RETAIL", "UserTokens": [xbl_token] },
+            "RelyingParty": "rp://api.minecraftservices.com/",
+            "TokenType": "JWT",
+        }))),
+        "Xbox Live",
+    )?;
+    if let Some(code) = xsts.get("XErr").and_then(Value::as_u64) {
+        return Err(xsts_error(code));
+    }
+    let claims = xsts.pointer("/DisplayClaims/xui/0");
+    let (Some(xsts_token), Some(uhs)) = (
+        str_field(&xsts, "Token").filter(|_| status == 200),
+        claims.and_then(|c| str_field(c, "uhs")),
+    ) else {
+        return Err("Xbox Live refused the sign-in.".into());
+    };
+    let xuid = claims.and_then(|c| str_field(c, "xid"));
+    progress(session::Phase::Minecraft);
+    let (token, expires_in) = minecraft_token(ep, &format!("XBL3.0 x={uhs};{xsts_token}"))?;
+    Ok(Minecraft {
+        token,
+        expires_at: now() + expires_in,
+        xuid,
+    })
+}
+
+/// The Minecraft access token and its lifetime from the XSTS one (`XBL3.0 x=<uhs>;<token>`).
+/// `launcher/login` first: a new account's token from `login_with_xbox` names no profile, so
+/// joining an online-mode server answers "Profile not found" (found and diagnosed by
+/// martipops). `login_with_xbox` stays the fallback, so a sign-in that worked before still does
+/// when the other refuses.
+fn minecraft_token(ep: &Endpoints, xtoken: &str) -> Result<(String, u64), String> {
+    let lifetime = |v: &Value| v.get("expires_in").and_then(Value::as_u64).unwrap_or(86400);
+    let launcher = send(
+        request_to("POST", &format!("{}/launcher/login", ep.minecraft)),
+        Some(Body::Json(
+            json!({ "xtoken": xtoken, "platform": "PC_LAUNCHER" }),
+        )),
+        "the Minecraft services",
+    );
+    if let Ok((200, v)) = &launcher {
+        if let Some(token) = str_field(v, "access_token") {
+            return Ok((token, lifetime(v)));
+        }
+    }
+    let (status, mc) = send(
+        request_to(
+            "POST",
+            &format!("{}/authentication/login_with_xbox", ep.minecraft),
+        ),
+        Some(Body::Json(json!({ "identityToken": xtoken }))),
+        "the Minecraft services",
+    )?;
+    match (status, str_field(&mc, "access_token")) {
+        (200, Some(token)) => Ok((token, lifetime(&mc))),
+        // New Azure apps are refused until Mojang approves them (Minecraft API access).
+        (403, _) => Err(
+            "The Minecraft services refused this launcher: its app is not approved by Mojang yet."
+                .into(),
+        ),
+        (429, _) => Err("Too many sign-ins in a short time. Wait a minute and try again.".into()),
+        _ => Err("The Minecraft services refused the sign-in.".into()),
+    }
+}
+
+fn bearer(request: AccountRequest, token: &str) -> AccountRequest {
+    request.set("Authorization", &format!("Bearer {token}"))
+}
+
+/// Whether the account owns Minecraft: Java Edition (Game Pass included).
+fn owns_game(ep: &Endpoints, token: &str) -> Result<bool, String> {
+    let (status, v) = send(
+        bearer(
+            request_to("GET", &format!("{}/entitlements/mcstore", ep.minecraft)),
+            token,
+        ),
+        None,
+        "the Minecraft services",
+    )?;
+    if status != 200 {
+        return Err("Could not check which games this account owns.".into());
+    }
+    Ok(v.get("items")
+        .and_then(Value::as_array)
+        .is_some_and(|items| {
+            items.iter().any(|i| {
+                matches!(
+                    i.get("name").and_then(Value::as_str),
+                    Some("game_minecraft" | "product_minecraft")
+                )
+            })
+        }))
+}
+
+/// A Minecraft profile, as the launcher shows and remembers it (no secrets).
+#[derive(Clone, Debug, PartialEq, serde::Serialize, serde::Deserialize)]
+pub struct Account {
+    /// The profile UUID without dashes.
+    pub uuid: String,
+    pub name: String,
+    /// The active skin's URL (textures.minecraft.net) and model ("classic" or "slim").
+    #[serde(default)]
+    pub skin: Option<(String, String)>,
+    #[serde(default)]
+    pub cape: Option<String>,
+}
+
+/// The profile; none when the account has none (it doesn't own the game, or never made one).
+fn profile(ep: &Endpoints, token: &str) -> Result<Option<Account>, String> {
+    let (status, v) = send(
+        bearer(
+            request_to("GET", &format!("{}/minecraft/profile", ep.minecraft)),
+            token,
+        ),
+        None,
+        "the Minecraft services",
+    )?;
+    if status == 404 {
+        return Ok(None);
+    }
+    let (Some(uuid), Some(name)) = (str_field(&v, "id"), str_field(&v, "name")) else {
+        return Err("Could not read the Minecraft profile.".into());
+    };
+    let active = |key: &str| {
+        v.get(key)
+            .and_then(Value::as_array)
+            .and_then(|list| {
+                list.iter()
+                    .find(|s| s.get("state").and_then(Value::as_str) == Some("ACTIVE"))
+            })
+            .cloned()
+    };
+    Ok(Some(Account {
+        uuid: uuid.replace('-', "").to_lowercase(),
+        name,
+        skin: active("skins").and_then(|s| {
+            Some((
+                str_field(&s, "url")?,
+                str_field(&s, "variant")
+                    .unwrap_or_else(|| "CLASSIC".into())
+                    .to_lowercase(),
+            ))
+        }),
+        cape: active("capes").and_then(|c| str_field(&c, "url")),
+    }))
+}
+
+/// What the keychain keeps for one account.
+#[derive(Clone, serde::Serialize, serde::Deserialize)]
+pub struct Secrets {
+    refresh_token: String,
+    #[serde(default)]
+    sign_in_required: bool,
+    minecraft_token: String,
+    minecraft_expires_at: u64,
+    #[serde(default)]
+    xuid: Option<String>,
+    /// The last answer the Minecraft services gave: whether the account owns the game. It is
+    /// kept here, beside the tokens, so that no plain file can say yes. Accounts saved before it
+    /// existed passed the same check at sign-in, which refuses everyone else.
+    #[serde(default = "owned_at_sign_in")]
+    owns: bool,
+}
+fn owned_at_sign_in() -> bool {
+    true
+}
+impl std::fmt::Debug for Secrets {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str("Secrets(<hidden>)")
+    }
+}
+
+/// From Microsoft tokens to a ready account: Xbox, XSTS, Minecraft, ownership, profile.
+pub fn finish_sign_in(ep: &Endpoints, ms: MsTokens) -> Result<(Account, Secrets), String> {
+    finish_sign_in_with_progress(ep, ms, &|_| {})
+}
+
+pub fn finish_sign_in_with_progress(
+    ep: &Endpoints,
+    ms: MsTokens,
+    progress: &dyn Fn(session::Phase),
+) -> Result<(Account, Secrets), String> {
+    let mc = minecraft_login(ep, &ms.access, progress)?;
+    progress(session::Phase::Ownership);
+    if !owns_game(ep, &mc.token)? {
+        return Err(DOES_NOT_OWN.into());
+    }
+    progress(session::Phase::Profile);
+    let account = profile(ep, &mc.token)?.ok_or(NO_PROFILE)?;
+    Ok((account, Secrets::new(ms.refresh, mc)))
+}
+
+impl Secrets {
+    fn new(refresh_token: String, mc: Minecraft) -> Self {
+        Self {
+            refresh_token,
+            sign_in_required: false,
+            minecraft_token: mc.token,
+            minecraft_expires_at: mc.expires_at,
+            xuid: mc.xuid,
+            owns: true,
+        }
+    }
+}
+
+/// What asking the Minecraft services again found for one account.
+pub enum Check {
+    /// It owns the game: its profile as it is now (the name may have changed) and its tokens.
+    Owns(Account, Secrets),
+    /// The services said it doesn't own the game (or has no profile any more).
+    DoesNot(Secrets),
+    /// No answer (no network, a sign-in that can't be renewed): the last answer stands.
+    NoAnswer(String, Secrets),
+}
+
+/// Asks whether `account` owns the game, with a Minecraft token renewed through the refresh token
+/// first when it has less than an hour left. The secrets come back renewed whatever the answer.
+pub fn check(
+    ep: &Endpoints,
+    client_id: Option<&str>,
+    account: &Account,
+    secrets: Secrets,
+) -> Check {
+    check_with(ep, client_id, account, secrets, false, &|_| {})
+}
+
+fn check_with(
+    ep: &Endpoints,
+    client_id: Option<&str>,
+    account: &Account,
+    mut secrets: Secrets,
+    force: bool,
+    progress: &dyn Fn(session::Phase),
+) -> Check {
+    if secrets.sign_in_required {
+        return Check::NoAnswer(SIGN_IN_AGAIN.into(), secrets);
+    }
+    if force || secrets.minecraft_expires_at <= now() + RENEW_BEFORE {
+        progress(session::Phase::Microsoft);
+        let renewed = client_id
+            .ok_or_else(|| NOT_CONFIGURED.to_string())
+            .and_then(|id| refresh_ms(ep, id, &secrets.refresh_token));
+        let ms = match renewed {
+            Ok(ms) => ms,
+            Err(e) => {
+                secrets.sign_in_required = e == SIGN_IN_AGAIN;
+                return Check::NoAnswer(e, secrets);
+            }
+        };
+        // Microsoft can rotate its refresh credential even if a later service fails.
+        secrets.refresh_token = ms.refresh;
+        match minecraft_login(ep, &ms.access, progress) {
+            Ok(mc) => {
+                secrets = Secrets {
+                    owns: secrets.owns,
+                    ..Secrets::new(secrets.refresh_token, mc)
+                }
+            }
+            Err(e) => return Check::NoAnswer(e, secrets),
+        }
+    }
+    let token = &secrets.minecraft_token;
+    progress(session::Phase::Ownership);
+    match owns_game(ep, token).and_then(|owns| {
+        if !owns {
+            return Ok(None);
+        }
+        progress(session::Phase::Profile);
+        profile(ep, token)
+    }) {
+        Err(e) => Check::NoAnswer(e, secrets),
+        Ok(None) => Check::DoesNot(Secrets {
+            owns: false,
+            ..secrets
+        }),
+        Ok(Some(p)) if p.uuid != account.uuid => Check::NoAnswer(
+            OTHER_PROFILE.into(),
+            Secrets {
+                sign_in_required: true,
+                ..secrets
+            },
+        ),
+        Ok(Some(p)) => Check::Owns(
+            p,
+            Secrets {
+                owns: true,
+                ..secrets
+            },
+        ),
+    }
+}
+
+impl Secrets {
+    /// JSON for a one-use in-memory game session; do not log or persist it.
+    pub fn session_json(&self, account: &Account) -> String {
+        serde_json::json!({ "name": account.name, "uuid": account.uuid,
+            "access_token": self.minecraft_token, "user_type": "msa", "xuid": self.xuid })
+        .to_string()
+    }
+}
diff --git a/crates/horizon-account-core/src/sign_in.rs b/crates/horizon-account-core/src/sign_in.rs
new file mode 100644
index 0000000000000000000000000000000000000000..a8a82b305aaf18e84853e301d50a10b7ad5abe49
--- /dev/null
+++ b/crates/horizon-account-core/src/sign_in.rs
@@ -0,0 +1,467 @@
+//! Cancellable, background device-code sign-in with secure storage.
+use crate::{
+    check, device_code, finish_sign_in, vault, wait_for_sign_in, Account, Check, Endpoints,
+};
+use std::fmt;
+use std::sync::{
+    atomic::{AtomicBool, Ordering},
+    mpsc, Arc, Mutex,
+};
+
+// Only one operation may refresh or replace the active account at a time.
+// This prevents overlapping workers from losing a rotated refresh token.
+static ACCOUNT_OPERATION: Mutex<()> = Mutex::new(());
+
+/// A game session whose token is never included in debug output.
+pub struct Session {
+    pub account: Account,
+    session_json: String,
+}
+impl Session {
+    /// Consume the session for an in-memory handoff to the game; do not log it.
+    pub fn into_json(self) -> String {
+        self.session_json
+    }
+}
+impl fmt::Debug for Session {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("Session")
+            .field("account", &self.account)
+            .field("session_json", &"<hidden>")
+            .finish()
+    }
+}
+
+#[derive(Debug, PartialEq, Eq)]
+pub enum SignInError {
+    NotConfigured,
+    RegistrationRejected,
+    MinecraftApprovalRequired,
+    Declined,
+    CodeExpired,
+    DoesNotOwn,
+    NoProfile,
+    XboxSetup,
+    RateLimited,
+    Protocol,
+    SecureStore,
+}
+
+impl fmt::Display for SignInError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.write_str(match self {
+            Self::NotConfigured => "Microsoft sign-in is not configured for this build.",
+            Self::RegistrationRejected => "Microsoft refused this app registration.",
+            Self::MinecraftApprovalRequired => "Minecraft services refused this app. Its public application ID may need Mojang approval.",
+            Self::Declined => "Sign-in was declined in the browser.",
+            Self::CodeExpired => "The sign-in code expired. Start again.",
+            Self::DoesNotOwn => "This account does not own Minecraft: Java Edition.",
+            Self::NoProfile => "Create a Minecraft profile at minecraft.net, then sign in again.",
+            Self::XboxSetup => "Check this account's Xbox profile and family settings at xbox.com.",
+            Self::RateLimited => "Too many sign-ins. Wait a minute and try again.",
+            Self::Protocol => "Sign-in failed. Check your connection and try again.",
+            Self::SecureStore => "Could not save the account in Credential Locker.",
+        })
+    }
+}
+
+// Only fixed, known messages are surfaced. Unexpected server-provided text may
+// contain secrets, so it is reduced to a generic error rather than displayed.
+fn classify(message: &str) -> SignInError {
+    match message {
+        "Microsoft refused this launcher's app registration (client ID)." => SignInError::RegistrationRejected,
+        "The Minecraft services refused this launcher: its app is not approved by Mojang yet." => SignInError::MinecraftApprovalRequired,
+        "Sign-in was declined in the browser." => SignInError::Declined,
+        "The sign-in code expired. Start again." => SignInError::CodeExpired,
+        "This account doesn't own Minecraft: Java Edition." => SignInError::DoesNotOwn,
+        "This account has no Minecraft profile yet. Create one at minecraft.net, then sign in again." => SignInError::NoProfile,
+        "This Microsoft account has no Xbox profile yet. Sign in once at xbox.com to create one, then try again."
+        | "Xbox Live is not available in your country or region."
+        | "This account needs adult verification on xbox.com before it can play."
+        | "This is a child account: an adult has to add it to a Microsoft family first." => SignInError::XboxSetup,
+        "Too many sign-ins in a short time. Wait a minute and try again." => SignInError::RateLimited,
+        _ => SignInError::Protocol,
+    }
+}
+
+#[derive(Debug)]
+pub enum Event {
+    /// The public code and verification address for the player to enter.
+    Prompt {
+        user_code: String,
+        verification_uri: String,
+    },
+    Ready(Session),
+    /// The previous owner can play offline, but no online session was issued.
+    Offline(Account),
+    NoAccount,
+    SignedOut {
+        removed: bool,
+    },
+    Failed(SignInError),
+    Cancelled,
+}
+
+/// Dropping an attempt asks its worker to stop; requests already in flight can
+/// take until the HTTPS adapter's timeout to return.
+pub struct Attempt {
+    events: mpsc::Receiver<Event>,
+    cancelled: Arc<AtomicBool>,
+}
+impl Attempt {
+    pub fn try_recv(&self) -> Result<Event, mpsc::TryRecvError> {
+        self.events.try_recv()
+    }
+    pub fn cancel(&self) {
+        self.cancelled.store(true, Ordering::Release);
+    }
+}
+impl Drop for Attempt {
+    fn drop(&mut self) {
+        self.cancel();
+    }
+}
+
+/// Starts a sign-in on a worker. The complete account is saved in the provided
+/// secure store before a session is handed to the caller. There is no disk or
+/// memory-only fallback if that write fails.
+pub fn start(
+    client_id: String,
+    store: Arc<dyn vault::SecretStore>,
+) -> Result<Attempt, SignInError> {
+    let client_id = client_id.trim().to_owned();
+    if client_id.is_empty() {
+        return Err(SignInError::NotConfigured);
+    }
+    let (send, events) = mpsc::channel();
+    let cancelled = Arc::new(AtomicBool::new(false));
+    let worker_cancelled = Arc::clone(&cancelled);
+    std::thread::spawn(move || {
+        let stopped = || worker_cancelled.load(Ordering::Acquire);
+        let _guard = match ACCOUNT_OPERATION.lock() {
+            Ok(guard) => guard,
+            Err(_) => {
+                let _ = send.send(Event::Failed(SignInError::Protocol));
+                return;
+            }
+        };
+        if stopped() {
+            let _ = send.send(Event::Cancelled);
+            return;
+        }
+        let outcome = (|| {
+            let endpoints = Endpoints::live();
+            let code = device_code(&endpoints, &client_id).map_err(|error| classify(&error))?;
+            if stopped() {
+                return Ok(None);
+            }
+            if send
+                .send(Event::Prompt {
+                    user_code: code.user_code.clone(),
+                    verification_uri: code.verification_uri.clone(),
+                })
+                .is_err()
+            {
+                return Ok(None);
+            }
+            let tokens = match wait_for_sign_in(&endpoints, &client_id, &code, &stopped) {
+                Ok(tokens) => tokens,
+                Err(_) if stopped() => return Ok(None),
+                Err(error) => return Err(classify(&error)),
+            };
+            if stopped() {
+                return Ok(None);
+            }
+            let (account, secrets) =
+                finish_sign_in(&endpoints, tokens).map_err(|error| classify(&error))?;
+            if stopped() {
+                return Ok(None);
+            }
+            let stored = vault::StoredAccount::new(account, secrets);
+            vault::save(store.as_ref(), &stored).map_err(|_| SignInError::SecureStore)?;
+            let session_json = stored.secrets.session_json(&stored.account);
+            Ok(Some(Session {
+                account: stored.account,
+                session_json,
+            }))
+        })();
+        let event = match outcome {
+            Ok(Some(session)) => Event::Ready(session),
+            Ok(None) => Event::Cancelled,
+            Err(error) => Event::Failed(error),
+        };
+        let _ = send.send(event);
+    });
+    Ok(Attempt { events, cancelled })
+}
+
+/// Restores and rechecks the active account on a worker. A network failure
+/// permits an established owner to play offline without handing out a session.
+pub fn restore(client_id: Option<String>, store: Arc<dyn vault::SecretStore>) -> Attempt {
+    let (send, events) = mpsc::channel();
+    let cancelled = Arc::new(AtomicBool::new(false));
+    let worker_cancelled = Arc::clone(&cancelled);
+    std::thread::spawn(move || {
+        let stopped = || worker_cancelled.load(Ordering::Acquire);
+        let _guard = match ACCOUNT_OPERATION.lock() {
+            Ok(guard) => guard,
+            Err(_) => {
+                let _ = send.send(Event::Failed(SignInError::Protocol));
+                return;
+            }
+        };
+        if stopped() {
+            let _ = send.send(Event::Cancelled);
+            return;
+        }
+        let event = match vault::load(store.as_ref()) {
+            _ if stopped() => Event::Cancelled,
+            Err(_) => Event::Failed(SignInError::SecureStore),
+            Ok(None) => Event::NoAccount,
+            Ok(Some(stored)) => {
+                let account = stored.account;
+                let answer = check(
+                    &Endpoints::live(),
+                    client_id.as_deref(),
+                    &account,
+                    stored.secrets,
+                );
+                // A refresh may have rotated the stored token. Persist its
+                // result even if cancellation arrived during the request.
+                match finish_restore(store.as_ref(), account, answer) {
+                    Err(error) => Event::Failed(error),
+                    Ok(_) if stopped() => Event::Cancelled,
+                    Ok(event) => event,
+                }
+            }
+        };
+        let _ = send.send(event);
+    });
+    Attempt { events, cancelled }
+}
+
+/// Removes the active account on a worker, serialized with sign-in and refresh.
+pub fn sign_out(store: Arc<dyn vault::SecretStore>) -> Attempt {
+    let (send, events) = mpsc::channel();
+    let cancelled = Arc::new(AtomicBool::new(false));
+    let worker_cancelled = Arc::clone(&cancelled);
+    std::thread::spawn(move || {
+        let _guard = match ACCOUNT_OPERATION.lock() {
+            Ok(guard) => guard,
+            Err(_) => {
+                let _ = send.send(Event::Failed(SignInError::Protocol));
+                return;
+            }
+        };
+        let event = if worker_cancelled.load(Ordering::Acquire) {
+            Event::Cancelled
+        } else {
+            match vault::remove(store.as_ref()) {
+                Ok(removed) => Event::SignedOut { removed },
+                Err(_) => Event::Failed(SignInError::SecureStore),
+            }
+        };
+        let _ = send.send(event);
+    });
+    Attempt { events, cancelled }
+}
+
+fn finish_restore(
+    store: &dyn vault::SecretStore,
+    previous: Account,
+    answer: Check,
+) -> Result<Event, SignInError> {
+    let (account, secrets, online) = match answer {
+        Check::Owns(account, secrets) => (account, secrets, true),
+        Check::DoesNot(secrets) => {
+            vault::save(store, &vault::StoredAccount::new(previous, secrets))
+                .map_err(|_| SignInError::SecureStore)?;
+            return Err(SignInError::DoesNotOwn);
+        }
+        Check::NoAnswer(_, secrets) => (previous, secrets, false),
+    };
+    let stored = vault::StoredAccount::new(account, secrets);
+    // A refresh token may have rotated even if a later ownership request failed.
+    vault::save(store, &stored).map_err(|_| SignInError::SecureStore)?;
+    if online {
+        let session_json = stored.secrets.session_json(&stored.account);
+        Ok(Event::Ready(Session {
+            account: stored.account,
+            session_json,
+        }))
+    } else if stored.secrets.owns {
+        Ok(Event::Offline(stored.account))
+    } else {
+        Err(SignInError::Protocol)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::time::{Duration, Instant};
+
+    #[derive(Default)]
+    struct Store {
+        value: Mutex<Option<String>>,
+        fail: bool,
+    }
+    impl vault::SecretStore for Store {
+        fn get(&self, _key: &str) -> Result<Option<String>, vault::StoreError> {
+            Ok(self.value.lock().unwrap().clone())
+        }
+        fn set(&self, _key: &str, value: &str) -> Result<(), vault::StoreError> {
+            if self.fail {
+                return Err(vault::StoreError);
+            }
+            *self.value.lock().unwrap() = Some(value.to_owned());
+            Ok(())
+        }
+        fn remove(&self, _key: &str) -> Result<bool, vault::StoreError> {
+            Ok(self.value.lock().unwrap().take().is_some())
+        }
+    }
+    fn next(attempt: &Attempt) -> Event {
+        let deadline = Instant::now() + Duration::from_secs(30);
+        loop {
+            match attempt.try_recv() {
+                Ok(event) => return event,
+                Err(mpsc::TryRecvError::Empty) if Instant::now() < deadline => {
+                    std::thread::sleep(Duration::from_millis(10))
+                }
+                error => panic!("unexpected event state: {error:?}"),
+            }
+        }
+    }
+    fn saved() -> vault::StoredAccount {
+        let account = Account {
+            uuid: "00000000000000000000000000000001".into(),
+            name: "Tester".into(),
+            skin: None,
+            cape: None,
+        };
+        let secrets = serde_json::from_value(serde_json::json!({"refresh_token":"synthetic-refresh","minecraft_token":"synthetic-token","minecraft_expires_at":123,"owns":true})).unwrap();
+        vault::StoredAccount::new(account, secrets)
+    }
+    #[test]
+    fn restore_only_hands_out_an_online_session_after_secure_save() {
+        let store = Store::default();
+        let record = saved();
+        let account = record.account.clone();
+        let event = finish_restore(
+            &store,
+            account.clone(),
+            Check::Owns(account, record.secrets),
+        )
+        .unwrap();
+        let Event::Ready(session) = event else {
+            panic!("expected online session")
+        };
+        assert!(!format!("{session:?}").contains("synthetic"));
+        assert!(vault::load(&store).unwrap().is_some());
+        let failed = Store {
+            fail: true,
+            ..Default::default()
+        };
+        let record = saved();
+        let account = record.account.clone();
+        assert!(matches!(
+            finish_restore(
+                &failed,
+                account.clone(),
+                Check::Owns(account, record.secrets)
+            ),
+            Err(SignInError::SecureStore)
+        ));
+    }
+    #[test]
+    fn restore_returns_offline_without_leaking_a_session_and_remembers_denial() {
+        let store = Store::default();
+        let record = saved();
+        let previous = record.account.clone();
+        let event = finish_restore(
+            &store,
+            previous.clone(),
+            Check::NoAnswer("synthetic-secret".into(), record.secrets),
+        )
+        .unwrap();
+        assert!(matches!(event, Event::Offline(account) if account.name == "Tester"));
+        let record = vault::load(&store).unwrap().unwrap();
+        let mut json = serde_json::to_value(&record.secrets).unwrap();
+        json["owns"] = serde_json::json!(false);
+        let denied = serde_json::from_value(json).unwrap();
+        assert!(matches!(
+            finish_restore(&store, previous, Check::DoesNot(denied)),
+            Err(SignInError::DoesNotOwn)
+        ));
+        let record = vault::load(&store).unwrap().unwrap();
+        assert!(!record.secrets.owns);
+    }
+    #[test]
+    fn unknown_server_errors_are_not_echoed() {
+        assert_eq!(classify("The Minecraft services refused this launcher: its app is not approved by Mojang yet."), SignInError::MinecraftApprovalRequired);
+        let error = classify("synthetic-secret-from-server");
+        assert_eq!(error, SignInError::Protocol);
+        assert!(!error.to_string().contains("synthetic"));
+        assert_eq!(
+            classify("This account doesn't own Minecraft: Java Edition."),
+            SignInError::DoesNotOwn
+        );
+    }
+    #[test]
+    fn signs_in_stores_account_and_redacts_session() {
+        let store = Arc::new(Store::default());
+        let attempt = start("fake-client".into(), store.clone()).unwrap();
+        assert!(
+            matches!(next(&attempt), Event::Prompt { user_code, .. } if user_code == "TEST-CODE")
+        );
+        let Event::Ready(session) = next(&attempt) else {
+            panic!("expected session")
+        };
+        assert_eq!(session.account.name, "Tester");
+        assert!(!format!("{session:?}").contains("synthetic"));
+        assert!(session.into_json().contains("synthetic-minecraft"));
+        assert!(vault::load(store.as_ref()).unwrap().is_some());
+    }
+    #[test]
+    fn sign_out_removes_the_stored_account() {
+        let store = Arc::new(Store::default());
+        vault::save(store.as_ref(), &saved()).unwrap();
+        let attempt = sign_out(store.clone());
+        assert!(matches!(next(&attempt), Event::SignedOut { removed: true }));
+        assert!(vault::load(store.as_ref()).unwrap().is_none());
+    }
+    #[test]
+    fn concurrent_operations_are_serialized_and_a_waiting_one_can_cancel() {
+        let store = Arc::new(Store::default());
+        let first = start("fake-client".into(), store.clone()).unwrap();
+        assert!(matches!(next(&first), Event::Prompt { .. }));
+        let second = start("fake-client".into(), store.clone()).unwrap();
+        second.cancel();
+        assert!(matches!(next(&first), Event::Ready(_)));
+        assert!(matches!(next(&second), Event::Cancelled));
+        assert!(vault::load(store.as_ref()).unwrap().is_some());
+    }
+    #[test]
+    fn cancel_stops_before_saving() {
+        let store = Arc::new(Store::default());
+        let attempt = start("fake-client".into(), store.clone()).unwrap();
+        assert!(matches!(next(&attempt), Event::Prompt { .. }));
+        attempt.cancel();
+        assert!(matches!(next(&attempt), Event::Cancelled));
+        assert!(store.value.lock().unwrap().is_none());
+    }
+    #[test]
+    fn store_failure_never_returns_a_session() {
+        let store = Arc::new(Store {
+            fail: true,
+            ..Default::default()
+        });
+        let attempt = start("fake-client".into(), store).unwrap();
+        assert!(matches!(next(&attempt), Event::Prompt { .. }));
+        assert!(matches!(
+            next(&attempt),
+            Event::Failed(SignInError::SecureStore)
+        ));
+    }
+}
