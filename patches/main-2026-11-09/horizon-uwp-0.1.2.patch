+    #[inline]
+    pub fn set_cursor_visible(&self, visible: bool) {
+        let view = self.view();
+        let state_changed = view.set_cursor_visible(visible);
+        if state_changed {
+            self.window().invalidateCursorRectsForView(&view);
+        }
+    }
