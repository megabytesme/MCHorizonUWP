+++ b/uwp/credential-store/README.md
@@ -0,0 +1,21 @@
+# UWP Credential Locker adapter
+
+This optional host adapter uses `Windows.Security.Credentials.PasswordVault`
+for per-account secrets. It distinguishes a missing key from storage errors,
+rejects invalid or oversized input, never logs values and clears its temporary
+UTF-8 output allocation before freeing it. The `Secret` wrapper redacts Debug
+output; this is not a promise that platform or Rust string copies are wiped.
+The application must handle errors without falling back to plaintext storage.
+
+The API is a standalone building block; the game does not yet call it and this
+crate does not implement Microsoft sign-in. A UWP app is limited to 20 locker
+entries. A synthetic desktop UWP probe exercised missing, storing and reading
+an 8,192-character value, replacement, removal and missing again. The ARM32
+probe passed SDK 15063 strict linking; the user confirmed an earlier short-value
+Credential Locker round trip on Lumia. Long values and this adapter remain to be
+tested on the phone.
+
+The Rust facade was also exercised end-to-end in an x64 UWP host with a
+synthetic 8,192-character value, replacement, removal and Debug redaction.
+That host passed the SDK 15063 strict link audit. Its source is under
+`probe/rust` and `probe/RustApp.cpp`; no real token was used.
diff --git a/uwp/credential-store/host/CredentialStore.cpp b/uwp/credential-store/host/CredentialStore.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..fec8999b8fbd6299924f7223905a66a114cc695a
--- /dev/null
+++ b/uwp/credential-store/host/CredentialStore.cpp
@@ -0,0 +1,127 @@
+// New MSVC STL headers name these desktop functions even under AppContainer.
+// Declarations allow the headers to compile; this bridge never calls them.
+#if defined(_MSC_VER) && _MSC_VER >= 1940 && defined(WINAPI_FAMILY)
+extern "C" __declspec(dllimport) char* __cdecl getenv(const char*);
+extern "C" __declspec(dllimport) int __cdecl system(const char*);
+#endif
+
+#include <algorithm>
+#include <cstdlib>
+#include <cstring>
+#include <roapi.h>
+#include <string>
+#include <windows.h>
+#include <windows.security.credentials.h>
+using namespace Windows::Security::Credentials;
+namespace {
+constexpr HRESULT kNotFound = HRESULT_FROM_WIN32(ERROR_NOT_FOUND);
+Platform::String ^
+    to_string(const unsigned char *bytes, size_t length, size_t limit) {
+  if (!bytes || !length || length > limit || memchr(bytes, 0, length))
+    throw ref new Platform::InvalidArgumentException();
+  int n = MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS,
+                              reinterpret_cast<const char *>(bytes),
+                              static_cast<int>(length), nullptr, 0);
+  if (n <= 0)
+    throw ref new Platform::InvalidArgumentException();
+  std::wstring value(n, L'\0');
+  if (!MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS,
+                           reinterpret_cast<const char *>(bytes),
+                           static_cast<int>(length), &value[0], n))
+    throw ref new Platform::InvalidArgumentException();
+  auto result = ref new Platform::String(value.data(), n);
+  SecureZeroMemory(&value[0], value.size() * sizeof(wchar_t));
+  return result;
+}
+Platform::String ^ resource() {
+  return ref new Platform::String(L"dev.playhorizon.uwp.accounts");
+}
+} // namespace
+extern "C" int __cdecl horizon_vault_set(const unsigned char *key,
+                                         size_t key_len,
+                                         const unsigned char *secret,
+                                         size_t secret_len) {
+  HRESULT init = RoInitialize(RO_INIT_MULTITHREADED);
+  if (FAILED(init) && init != RPC_E_CHANGED_MODE)
+    return -1;
+  int status = -1;
+  try {
+    auto vault = ref new PasswordVault();
+    vault->Add(
+        ref new PasswordCredential(resource(), to_string(key, key_len, 256),
+                                   to_string(secret, secret_len, 65536)));
+    status = 0;
+  } catch (...) {
+  }
+  if (SUCCEEDED(init))
+    RoUninitialize();
+  return status;
+}
+extern "C" int __cdecl horizon_vault_get(const unsigned char *key,
+                                         size_t key_len, unsigned char **output,
+                                         size_t *output_len) {
+  if (!output || !output_len)
+    return -1;
+  *output = nullptr;
+  *output_len = 0;
+  HRESULT init = RoInitialize(RO_INIT_MULTITHREADED);
+  if (FAILED(init) && init != RPC_E_CHANGED_MODE)
+    return -1;
+  int status = -1;
+  try {
+    auto vault = ref new PasswordVault();
+    auto credential = vault->Retrieve(resource(), to_string(key, key_len, 256));
+    credential->RetrievePassword();
+    auto value = credential->Password;
+    int n = WideCharToMultiByte(CP_UTF8, WC_ERR_INVALID_CHARS, value->Data(),
+                                value->Length(), nullptr, 0, nullptr, nullptr);
+    if (n <= 0 || n > 65536)
+      throw ref new Platform::FailureException();
+    auto data = static_cast<unsigned char *>(malloc(n));
+    if (!data)
+      throw ref new Platform::OutOfMemoryException();
+    if (!WideCharToMultiByte(CP_UTF8, WC_ERR_INVALID_CHARS, value->Data(),
+                             value->Length(), reinterpret_cast<char *>(data), n,
+                             nullptr, nullptr)) {
+      SecureZeroMemory(data, n);
+      free(data);
+      throw ref new Platform::FailureException();
+    }
+    *output = data;
+    *output_len = n;
+    status = 0;
+  } catch (Platform::Exception ^ ex) {
+    if (ex->HResult == kNotFound)
+      status = 1;
+  } catch (...) {
+  }
+  if (SUCCEEDED(init))
+    RoUninitialize();
+  return status;
+}
+extern "C" int __cdecl horizon_vault_remove(const unsigned char *key,
+                                            size_t key_len) {
+  HRESULT init = RoInitialize(RO_INIT_MULTITHREADED);
+  if (FAILED(init) && init != RPC_E_CHANGED_MODE)
+    return -1;
+  int status = -1;
+  try {
+    auto vault = ref new PasswordVault();
+    auto credential = vault->Retrieve(resource(), to_string(key, key_len, 256));
+    vault->Remove(credential);
+    status = 0;
+  } catch (Platform::Exception ^ ex) {
+    if (ex->HResult == kNotFound)
+      status = 1;
+  } catch (...) {
+  }
+  if (SUCCEEDED(init))
+    RoUninitialize();
+  return status;
+}
+extern "C" void __cdecl horizon_vault_free(void *data, size_t length) {
+  if (data) {
+    SecureZeroMemory(data, length);
+    free(data);
+  }
+}
