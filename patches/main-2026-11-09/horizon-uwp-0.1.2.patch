+#[cfg(target_vendor = "uwp")]
+fn run_uwp(home: &Path) {
+    let official_session = live::session_id();
+    let self_hosted_session = live::session_id();
+    let version = crate::telemetry::version();
+    loop {
+        let consent = horizon_telemetry::Consent::load(home);
+        let official = consent.allows_live_to(Destination::Official);
+        let self_hosted = consent.allows_live_to(Destination::SelfHosted);
+        if !official && !self_hosted {
+            return;
+        }
+        let lan = LAN.load(Ordering::Relaxed);
+        if official {
+            let ping = Ping::new(&official_session, &version, lan);
+            let _ = crate::telemetry::send_uwp_live(home, Destination::Official, &ping);
+        }
+        if self_hosted {
+            let ping = Ping::new(&self_hosted_session, &version, lan);
+            let _ = crate::telemetry::send_uwp_live(home, Destination::SelfHosted, &ping);
+        }
+        // set_lan unparks the worker so the endpoint sees the new state immediately.
+        std::thread::park_timeout(live::INTERVAL);
+    }
+}
