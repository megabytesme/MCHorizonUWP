+        (Architecture.X86, TargetProfile.DesktopX86) => true,
+        (Architecture.Arm64, TargetProfile.SurfaceProX or TargetProfile.DesktopX86) => true,
+        (Architecture.Arm64, TargetProfile.DesktopX64) => windows.Build >= 22000,
+        (Architecture.Arm, TargetProfile.WindowsMobile) => true,
+        _ => false,
+    };
+
+    public static async Task InstallAsync(SignedPackageOutput output, IProgress<string>? progress = null)
+    {
+        if (!OperatingSystem.IsWindows()) throw new PlatformNotSupportedException("Local installation requires Windows.");
+        if (output.Dependencies is not { Count: > 0 } || !File.Exists(output.Client) || !File.Exists(output.Certificate)
+            || output.Dependencies.Any(path => !File.Exists(path)) || output.ResourceFramework is { } resource && !File.Exists(resource))
+            throw new FileNotFoundException("The signed package or one of its installation dependencies is missing.");
+        using var certificate = new X509Certificate2(output.Certificate);
+        var identity = PackageSigning.GetOrCreateIdentity();
+        if (certificate.HasPrivateKey || certificate.Thumbprint != identity.Thumbprint || certificate.Subject != identity.Publisher)
+            throw new InvalidDataException("The public certificate does not match this builder's signing identity.");
+        using (var store = new X509Store(StoreName.TrustedPeople, StoreLocation.LocalMachine))
+        {
+            store.Open(OpenFlags.ReadOnly | OpenFlags.OpenExistingOnly);
+            if (store.Certificates.Find(X509FindType.FindByThumbprint, certificate.Thumbprint, validOnly: false).Count == 0)
+            {
+                progress?.Report("Approve the Windows administrator prompt to trust your package certificate.");
+                var certutil = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.System), "certutil.exe");
+                var trust = new ProcessStartInfo(certutil) { UseShellExecute = true, Verb = "runas", WindowStyle = ProcessWindowStyle.Hidden };
+                foreach (var arg in new[] { "-addstore", "TrustedPeople", Path.GetFullPath(output.Certificate) }) trust.ArgumentList.Add(arg);
+                using var process = Process.Start(trust) ?? throw new InvalidOperationException("Could not start certificate installation.");
+                await process.WaitForExitAsync();
+                if (process.ExitCode != 0) throw new InvalidOperationException("Windows could not trust the certificate. The package was not installed.");
+            }
+        }
+        var dependencies = output.Dependencies.Select(Path.GetFullPath).ToList();
+        if (output.ResourceFramework is { } framework) dependencies.Add(Path.GetFullPath(framework));
+        var payload = JsonSerializer.Serialize(new { Client = Path.GetFullPath(output.Client), Dependencies = dependencies });
+        var system = Environment.GetFolderPath(Environment.SpecialFolder.System);
+        var powershell = Path.Combine(system, "WindowsPowerShell", "v1.0", "powershell.exe");
+        var start = new ProcessStartInfo(powershell) { UseShellExecute = false, CreateNoWindow = true,
+            RedirectStandardOutput = true, RedirectStandardError = true };
+        foreach (var arg in new[] { "-NoProfile", "-NonInteractive", "-Command",
+            "$ErrorActionPreference='Stop'; $p=ConvertFrom-Json $env:HORIZON_UWP_INSTALL_PATHS; Add-AppxPackage -Path $p.Client -DependencyPath @($p.Dependencies)" })
+            start.ArgumentList.Add(arg);
+        start.Environment["HORIZON_UWP_INSTALL_PATHS"] = payload;
+        progress?.Report("Installing the framework dependencies and client for your Windows account.");
+        using var installer = Process.Start(start) ?? throw new InvalidOperationException("Could not start package installation.");
+        var stdout = installer.StandardOutput.ReadToEndAsync();
+        var stderr = installer.StandardError.ReadToEndAsync();
+        await installer.WaitForExitAsync();
+        await Task.WhenAll(stdout, stderr);
+        if (installer.ExitCode != 0) throw new InvalidOperationException("Windows could not install the package. Open the included installation guide and check its dependencies.");
+    }
+}
diff --git a/uwp/builder/Core/LocalRecipe.cs b/uwp/builder/Core/LocalRecipe.cs
new file mode 100644
index 0000000000000000000000000000000000000000..e1e0928d188e60549c2ac006f352f947090ebd12
--- /dev/null
+++ b/uwp/builder/Core/LocalRecipe.cs
@@ -0,0 +1,237 @@
+using System.Diagnostics;
+using System.Text.Json;
+using System.Xml.Linq;
+
+namespace Horizon.Builder.Core;
+
+public sealed record RecipeStep(string Name, string Executable, IReadOnlyList<string> Arguments);
+public sealed record LocalBuildPlan(string SourceCommit, string Target, IReadOnlyList<string> Features,
+    IReadOnlyList<RecipeStep> Steps, IReadOnlyList<string> Notes);
+public sealed record RustToolchainFacts(string Version, bool SourceAvailable);
+
+/// <summary>Recipe for one locally available source revision.</summary>
+public static class LocalRecipe
+{
+    public const string SourceCommit = "8b7ab39874de3dbc3a32ce683f86e0e5dd6cc46d";
+    public const string UpstreamNightlyDate = "2026-11-03";
+    public const string UpstreamNightlyCommit = "f42ef42ef6ceccb3c6a20bea2481d87949a51c81";
+    public const string UpstreamNightlyShortCommit = "f42ef42";
+    public const string DefaultPackageVersion = "2026.1105.14.0";
+    public const string UpstreamReleaseVersion = "nightly-" + UpstreamNightlyDate;
+    public const string UpstreamNightly = UpstreamNightlyDate + " " + UpstreamNightlyShortCommit;
+    public const string RustVersion = "1.99.1";
+    public const string RustToolchain = RustVersion + "-x86_64-pc-windows-msvc";
+    public const string MinecraftVersion = "26.3";
+    public const string SourceManifestVersion = "1.0.1.0";
+
+    /// <summary>Client packaging arguments for the selected resource mode.</summary>
+    public static IReadOnlyList<string> ResourceArguments(BuildSelection selection, string? resources = null, string? builtFramework = null)
+    {
+        var existing = selection.ValidatedExistingResourceFramework;
+        if (existing is not null) return ["-ResourceFrameworkName", existing];
+        if (selection.UseResourceFramework) return ["-ResourceFrameworkName", builtFramework ?? "<framework-name>"];
+        return ["-Resources", resources ?? "<selected-resources>"];
+    }
+
+    public static void ValidateResourceSelection(BuildSelection selection, string? resources, string? minecraftDirectory)
+    {
+        if (selection.ValidatedExistingResourceFramework is not null) return;
+        if (string.IsNullOrWhiteSpace(resources)) throw new InvalidOperationException("Choose prepared resources.");
+        ValidateResources(resources);
+        if (selection.PrepareSounds) ValidateSoundPreparation(resources, minecraftDirectory);
+    }
+
+    /// <summary>Encode a release's UTC publication time in four APPX version fields.</summary>
+    public static string PackageVersionFor(DateTimeOffset published)
+    {
+        var utc = published.ToUniversalTime();
+        return FormattableString.Invariant($"{utc.Year}.{utc.Month * 100 + utc.Day}.{utc.Hour * 100 + utc.Minute}.{utc.Second}");
+    }
+
+    public static void ConfigureManifest(XDocument manifest, BuildSelection selection, PackageSigningIdentity? signingIdentity = null)
+    {
+        var identity = manifest.Root?.Element(manifest.Root.Name.Namespace + "Identity")
+            ?? throw new InvalidDataException("The pinned package manifest has no identity.");
+        if ((string?)identity.Attribute("Name") != "HorizonUWPPrototype"
+            || (string?)identity.Attribute("Publisher") != "CN=HorizonUWPPrototype"
+            || (string?)identity.Attribute("Version") != SourceManifestVersion)
+            throw new InvalidDataException("The pinned package identity or version did not match the recipe.");
+        identity.SetAttributeValue("Version", selection.ValidatedPackageVersion);
+        if (signingIdentity is not null)
+        {
+            identity.SetAttributeValue("Name", "MCHorizonUWP");
+            identity.SetAttributeValue("Publisher", signingIdentity.Publisher);
+        }
+    }
+
+    public static LocalBuildPlan Plan(BuildSelection selection)
+    {
+        var packageVersion = selection.ValidatedPackageVersion;
+        var clientId = selection.ValidatedMicrosoftClientId;
+        var existingFramework = selection.ValidatedExistingResourceFramework;
+        var arm32 = selection.Target == TargetProfile.WindowsMobile;
+        var arch = selection.Target switch
+        {
+            TargetProfile.DesktopX64 => "x64",
+            TargetProfile.DesktopX86 => "x86",
+            TargetProfile.SurfaceProX => "arm64",
+            TargetProfile.WindowsMobile => "arm",
+            _ => throw new ArgumentOutOfRangeException(nameof(selection)),
+        };
+        var steps = new List<RecipeStep>
+        {
+            new("Snapshot pinned source", "git", ["archive", "--format=tar", SourceCommit]),
+            new("Prepare Rust source copy", "powershell", ["-NoProfile", "-File", "uwp/rust-std/prepare-source.ps1", "-Destination", ".local/builder-rust-std", "-Toolchain", RustToolchain]),
+        };
+        if (arm32) steps.Add(new("Prepare ARM32 overrides", "python", ["uwp/arm32-deps/prepare.py", "--offline-arm32"]));
+        var prefix = new List<string> { "+" + RustToolchain };
+        if (arm32) prefix.AddRange(["--config", ".local/arm32-windows-sys/patches-offline-arm32.toml"]);
+        var fetch = new List<string>(prefix);
+        fetch.AddRange(["fetch", "--manifest-path", "uwp/game-bridge/Cargo.toml", "--target", selection.RustTarget,
+            "--target", "x86_64-pc-windows-msvc", "-Z", "build-std=std,panic_abort"]);
+        steps.Add(new("Fetch Cargo dependencies", "cargo", fetch.AsReadOnly()));
+        if (selection.PrepareSounds)
+        {
+            steps.Add(new("Build resource preparer", "cargo", ["+" + RustToolchain, "build", "--manifest-path", "Cargo.toml",
+                "-p", "horizon-prepare", "--bin", "horizon-prepare", "--target", "x86_64-pc-windows-msvc", "--target-dir", ".local/builder-prepare-target"]));
+            steps.Add(new("Prepare sound assets", "horizon-prepare", ["sounds", "--root", "<snapshot>", "--minecraft-dir", "<selected-installation>"]));
+        }
+        var cargo = new List<string>(prefix);
+        cargo.AddRange(["build", "--offline", "--manifest-path", "uwp/game-bridge/Cargo.toml", "--features", string.Join(',', selection.Features),
+            "-Z", "build-std=std,panic_abort", "--target", selection.RustTarget, "--release", "--target-dir", ".local/builder-target"]);
+        steps.Add(new("Build game bridge", "cargo", cargo.AsReadOnly()));
+        steps.Add(new("Strict-link host", "cmd", ["/d", "/c", "uwp/host/build-game.cmd", arch]));
+        if (selection.UseResourceFramework)
+            steps.Add(new("Package reusable resources", "MakeAppx", ["<prepared-resources>", "<framework-output>"]));
+        var package = new List<string> { "-NoProfile", "-File", "uwp/host/package.ps1", "-Architecture", arch,
+            "-Executable", $"uwp/host/build/game-{arch}/HorizonUWP.exe", "-OutputDirectory", ".local/builder-output",
+        };
+        package.AddRange(ResourceArguments(selection));
+        steps.Add(new("Create unsigned client package", "powershell", package.AsReadOnly()));
+        var notes = new List<string> { "Build and staging occur in a new app-owned snapshot; the selected checkout is not modified.",
+            $"Based on Horizon nightly {UpstreamNightlyDate}, source {UpstreamNightlyShortCommit}; this is a UWP port, not an official Horizon binary.",
+            "The renderer is checked on the device before launch; unavailable graphics devices are not offered.",
+            "The resulting APPX requires matching dependencies and a user-controlled signing identity.",
+            $"The isolated manifest will use package version {packageVersion}; choose a version newer than the target device's installed package.",
+            "At least 10 GiB free space is required. Cargo fetches missing dependencies before the offline build and uses all available processor cores." };
+        if (existingFramework is null) notes.Add("The resource manifest version is checked; resource ownership and complete content integrity are not established by this check.");
+        if (selection.PrepareSounds) notes.Add("Sound preparation copies selected resources into the build workspace and reads your Minecraft asset store; it does not modify either selection.");
+        if (selection.UseResourceFramework) notes.Add("The separate unsigned resource framework contains your private prepared resources; retain it for clients using the same content and install it as a dependency.");
+        if (existingFramework is not null) notes.Add($"The client requires the existing {existingFramework} framework, published by {ResourceFrameworkPacker.Publisher}, on the target. Its installation is not checked by this builder.");
+        if (selection.NativeDeviceVibration) notes.Add("Device vibration is an optional native mod with its own setting, separate from controller vibration; unsupported devices are ignored.");
+        if (clientId is null) notes.Add("No Microsoft application ID was supplied; sign-in needs a build configured with an approved public client ID.");
+        else notes.Add("Microsoft sign-in uses the configured public application ID and device-code flow; Xbox/Minecraft access depends on that registration.");
+        if (arm32) notes.Add("ARM32 uses the offline TLS dependency override; account, skin and Minecraft session requests use the WinRT HTTPS adapter.");
+        return new(SourceCommit, selection.RustTarget, selection.Features, steps.AsReadOnly(), notes.AsReadOnly());
+    }
+
+    public static async Task ValidateSourceAsync(string sourceDirectory, IProbe probe)
+    {
+        var root = Path.GetFullPath(sourceDirectory);
+        if (!Directory.Exists(root)) throw new DirectoryNotFoundException("Choose an existing Horizon source directory.");
+        var git = probe.FindOnPath("git.exe") ?? throw new InvalidOperationException("Git is required to inspect the selected source.");
+        var start = new ProcessStartInfo(git) { UseShellExecute = false, CreateNoWindow = true, RedirectStandardOutput = true, RedirectStandardError = true };
+        foreach (var arg in new[] { "-C", root, "-c", "core.fsmonitor=false", "cat-file", "-e", SourceCommit + "^{commit}" }) start.ArgumentList.Add(arg);
+        start.Environment["GIT_CONFIG_NOSYSTEM"] = "1";
+        start.Environment["GIT_CONFIG_GLOBAL"] = "NUL";
+        start.Environment["GIT_TERMINAL_PROMPT"] = "0";
+        start.Environment["GIT_OPTIONAL_LOCKS"] = "0";
+        using var process = Process.Start(start) ?? throw new InvalidOperationException("Could not start Git.");
+        var stdout = process.StandardOutput.ReadToEndAsync();
+        var stderr = process.StandardError.ReadToEndAsync();
+        await process.WaitForExitAsync();
+        await Task.WhenAll(stdout, stderr); // Git output can contain local paths; do not log it.
+        if (process.ExitCode != 0) throw new InvalidOperationException("The selected Git repository does not contain the pinned Horizon revision.");
+    }
+
+    public static void ValidateResources(string resourcesDirectory)
+    {
+        var manifest = Path.Combine(Path.GetFullPath(resourcesDirectory), "horizon-resources.json");
+        var file = new FileInfo(manifest);
+        if (!file.Exists || file.Length > 1024 * 1024) throw new InvalidDataException("Select prepared resources with a valid Horizon manifest.");
+        using var document = JsonDocument.Parse(File.ReadAllBytes(manifest));
+        if (!document.RootElement.TryGetProperty("minecraft", out var version) || version.ValueKind != JsonValueKind.String || version.GetString() != MinecraftVersion)
+            throw new InvalidDataException("The selected resources are not for Minecraft 26.3.");
+    }
+
+    /// Presence only: preparation verifies individual sound objects separately.
+    public static string? SoundWarning(string resourcesDirectory)
+    {
+        var minecraft = Path.Combine(Path.GetFullPath(resourcesDirectory), "assets", "minecraft");
+        return File.Exists(Path.Combine(minecraft, "sounds.json")) && Directory.Exists(Path.Combine(minecraft, "sounds"))
+            ? null
+            : "Sound metadata or files are missing. The client will be silent until sounds are prepared from your Minecraft installation.";
+    }
+
+    public static void ValidateSoundPreparation(string resourcesDirectory, string? minecraftDirectory)
+    {
+        if (minecraftDirectory is null || !Directory.Exists(minecraftDirectory))
+            throw new DirectoryNotFoundException("Choose a Minecraft installation to prepare sounds.");
+        var minecraft = Path.Combine(Path.GetFullPath(resourcesDirectory), "assets", "minecraft");
+        if (File.Exists(Path.Combine(minecraft, "sounds.json")) || Directory.Exists(Path.Combine(minecraft, "sounds")))
+            throw new InvalidDataException("Selected resources already contain some sound data. Use complete resources without sound preparation, or choose a sound-free copy.");
+    }
+
+    public static IReadOnlyList<string> ToolchainBlockers(BuildSelection selection, IProbe probe, RustToolchainFacts rust, bool splitRelease = false, bool unifiedToolchain = false)
+    {
+        var blockers = new List<string>();
+        foreach (var tool in new[] { "git.exe", "rustup.exe", "cargo.exe", "python.exe" })
+            if (probe.FindOnPath(tool) is null) blockers.Add($"{tool} was not found on PATH.");
+        if (!rust.Version.StartsWith("rustc " + RustVersion + " ", StringComparison.Ordinal))
+            blockers.Add($"The recipe requires rustc {RustVersion} and matching rust-src.");
+        if (!rust.SourceAvailable) blockers.Add($"The {RustVersion} toolchain does not contain rust-src.");
+        var pf = probe.EnvironmentValue("ProgramFiles") ?? @"C:\Program Files";
+        var pfx86 = probe.EnvironmentValue("ProgramFiles(x86)") ?? @"C:\Program Files (x86)";
+        var arch = selection.Target switch
+        {
+            TargetProfile.DesktopX64 => "x64",
+            TargetProfile.DesktopX86 => "x86",
+            TargetProfile.SurfaceProX => "arm64",
+            TargetProfile.WindowsMobile => "arm",
+            _ => throw new ArgumentOutOfRangeException(nameof(selection)),
+        };
+        var unifiedRoot = unifiedToolchain ? VisualCppInstallation.FindForTarget(probe, selection.Target) : null;
+        var vc = unifiedToolchain ? (unifiedRoot is null ? "" : Path.Combine(unifiedRoot, "VC", "Auxiliary", "Build", "vcvarsall.bat")) : arch == "arm"
+            ? Path.Combine(pfx86, "Microsoft Visual Studio", splitRelease ? "2022" : "2017", splitRelease ? "BuildTools" : "Community", "VC", "Auxiliary", "Build", "vcvarsall.bat")
+            : Path.Combine(pf, "Microsoft Visual Studio", "18", "Community", "VC", "Auxiliary", "Build", "vcvarsall.bat");
+        if (!probe.FileExists(vc)) blockers.Add(unifiedToolchain
+            ? $"Visual Studio Build Tools with x64 and {arch} C++ UWP tools was not found."
+            : $"The checked-in {arch} host script's Visual Studio installation was not found.");
+        if (!unifiedToolchain && arch == "arm" && selection.PrepareSounds && !probe.FileExists(Path.Combine(pf, "Microsoft Visual Studio", "18", "Community", "VC", "Auxiliary", "Build", "vcvarsall.bat")))
+            blockers.Add("Sound preparation requires the x64 Visual Studio installation used by the checked-in desktop host script.");
+        if ((arch is "arm" or "arm64") && !probe.FileExists(Path.Combine(pf, "LLVM", "bin", "clang.exe")))
+            blockers.Add($"The {arch.ToUpperInvariant()} recipe requires clang.exe in the standard LLVM installation.");
+        var sdk = Path.Combine(pfx86, "Windows Kits", "10", "bin");
+        var hostSdk = arch == "arm64" ? "10.0.26100.0" : unifiedToolchain ? "10.0.19041.0" : splitRelease ? "10.0.17763.0" : "10.0.15063.0";
+        if (!probe.FileExists(Path.Combine(sdk, hostSdk, "x64", "fxc.exe")))
+            blockers.Add($"The host script requires Windows SDK {hostSdk} fxc.exe.");
+        var kitRoot = Path.Combine(pfx86, "Windows Kits", "10");
+        if (!probe.FileExists(Path.Combine(kitRoot, "Include", hostSdk, "um", "Windows.h")))
+            blockers.Add($"The host script requires Windows SDK {hostSdk} headers.");
+        if (arch == "arm" && !splitRelease && !probe.FileExists(Path.Combine(kitRoot, "Include", "10.0.16299.0", "um", "Windows.h")))
+            blockers.Add("The legacy mobile shell requires Windows SDK 10.0.16299.0 headers.");
+        if (!probe.FileExists(Path.Combine(sdk, "10.0.26100.0", "x64", "makeappx.exe")))
+            blockers.Add("The package script requires Windows SDK 10.0.26100.0 MakeAppx.exe.");
+        return blockers.AsReadOnly();
+    }
+
+    public static async Task<RustToolchainFacts> InspectRustAsync(IProbe probe)
+    {
+        var rustup = probe.FindOnPath("rustup.exe");
+        if (rustup is null) return new("", false);
+        async Task<string> Run(params string[] args)
+        {
+            var start = new ProcessStartInfo(rustup) { UseShellExecute = false, CreateNoWindow = true, RedirectStandardOutput = true, RedirectStandardError = true };
+            foreach (var arg in args) start.ArgumentList.Add(arg);
+            using var process = Process.Start(start) ?? throw new InvalidOperationException("Could not inspect the Rust toolchain.");
+            var output = process.StandardOutput.ReadToEndAsync();
+            var error = process.StandardError.ReadToEndAsync();
+            await process.WaitForExitAsync();
+            await Task.WhenAll(output, error);
+            return process.ExitCode == 0 ? (await output).Trim() : "";
+        }
+        var version = await Run("run", RustToolchain, "rustc", "--version");
+        var sysroot = await Run("run", RustToolchain, "rustc", "--print", "sysroot");
+        return new(version, !string.IsNullOrWhiteSpace(sysroot) && probe.FileExists(Path.Combine(sysroot, "lib", "rustlib", "src", "rust", "library", "Cargo.toml")));
+    }
+}
diff --git a/uwp/builder/Core/MinecraftAssetPreparation.cs b/uwp/builder/Core/MinecraftAssetPreparation.cs
new file mode 100644
index 0000000000000000000000000000000000000000..c4c3aea9c0a12fe805f365e47eb25ab36369843d
--- /dev/null
+++ b/uwp/builder/Core/MinecraftAssetPreparation.cs
@@ -0,0 +1,93 @@
+using System.Diagnostics;
+
+namespace Horizon.Builder.Core;
+
+/// <summary>Builds Horizon's pinned downloader and preparer in a private authenticated release workspace.</summary>
+public static class MinecraftAssetPreparation
+{
+    public static async Task<string> PrepareAsync(PreparedRelease release, BuildSelection selection, bool ownershipVerified,
+        IProbe probe, IProgress<string>? progress = null)
+    {
+        if (!ownershipVerified) throw new InvalidOperationException("Sign in with an account that owns Minecraft: Java Edition first.");
+        LocalBuildRunner.ValidatePreparedRelease(release, selection);
+        var source = Path.GetFullPath(release.SourceDirectory);
+        var workspace = Directory.GetParent(source)?.FullName ?? throw new InvalidOperationException("The release workspace is invalid.");
+        var drive = Path.GetPathRoot(workspace) ?? throw new InvalidOperationException("The release drive is invalid.");
+        if (new DriveInfo(drive).AvailableFreeSpace < 20L * 1024 * 1024 * 1024)
+            throw new IOException("At least 20 GiB of free space is required to download and prepare Minecraft resources and build the client.");
+        var privateData = Path.Combine(workspace, "minecraft-download");
+        if (Directory.Exists(privateData) || File.Exists(privateData))
+            throw new IOException("The resource preparation workspace already exists.");
+        var tool = await StageHelperAsync(source, workspace);
+        var cargo = probe.FindOnPath("cargo.exe") ?? throw new InvalidOperationException("Cargo is required to prepare Minecraft resources.");
+        var unifiedRoot = release.Client.Version == "0.1.1" ? VisualCppInstallation.FindForTarget(probe, selection.Target) : null;
+        if (release.Client.Version == "0.1.1" && unifiedRoot is null) throw new InvalidOperationException("The Visual C++ toolchain is missing.");
+        var system = Environment.GetFolderPath(Environment.SpecialFolder.System);
+        var cmd = Path.Combine(system, "cmd.exe");
+        var environment = await LocalBuildRunner.VisualCppEnvironment(cmd, TargetProfile.DesktopX64, probe, splitRelease: true, unifiedRoot: unifiedRoot);
+        environment["CARGO_BUILD_JOBS"] = LocalBuildRunner.CurrentCargoJobCount().ToString(System.Globalization.CultureInfo.InvariantCulture);
+        progress?.Report("Building Horizon's Minecraft resource preparation helper.");
+        await LocalBuildRunner.RunProcess(cargo, tool, ["+" + LocalRecipe.RustToolchain, "build", "--locked", "--release", "--target", "x86_64-pc-windows-msvc",
+            "--manifest-path", Path.Combine(tool, "Cargo.toml"), "--target-dir", Path.Combine(tool, "target")], environment);
+        var executable = Path.Combine(tool, "target", "x86_64-pc-windows-msvc", "release", "horizon-uwp-assets.exe");
+        var start = new ProcessStartInfo(executable) { UseShellExecute = false, CreateNoWindow = true,
+            WorkingDirectory = workspace, RedirectStandardOutput = true, RedirectStandardError = true };
+        start.ArgumentList.Add(source);
+        start.ArgumentList.Add(privateData);
+        foreach (var (name, folder) in new[] { ("HORIZON_HOME", "game"), ("HORIZON_LAUNCHER_HOME", "launcher"),
+            ("XDG_DATA_HOME", "xdg-data"), ("XDG_CONFIG_HOME", "xdg-config"), ("HORIZON_LAUNCHER_TRASH", "trash"),
+            ("HORIZON_LAUNCHER_CLIPBOARD", "clipboard"), ("HORIZON_LAUNCHER_DESKTOP", "desktop") })
+            start.Environment[name] = Path.Combine(workspace, "isolated", folder);
+        start.Environment["HORIZON_LAUNCHER_NO_SELF_UPDATE"] = "1";
+        start.Environment["HORIZON_NO_AUDIO"] = "1";
+        progress?.Report("Downloading and preparing your Minecraft resources. This can take a while.");
+        using var process = Process.Start(start) ?? throw new InvalidOperationException("Could not start Minecraft resource preparation.");
+        var errors = process.StandardError.ReadToEndAsync();
+        var lastUpdate = Stopwatch.StartNew();
+        while (await process.StandardOutput.ReadLineAsync() is { } line)
+        {
+            if (lastUpdate.Elapsed >= TimeSpan.FromSeconds(1) && !line.StartsWith("READY ", StringComparison.Ordinal))
+            {
+                progress?.Report(line.Length <= 300 ? line : line[..300]);
+                lastUpdate.Restart();
+            }
+        }
+        await process.WaitForExitAsync();
+        var error = (await errors).Trim();
+        if (process.ExitCode != 0)
+        {
+            var lastLine = error.Split('\n', StringSplitOptions.RemoveEmptyEntries).LastOrDefault()?.Trim();
+            throw new InvalidOperationException("Minecraft resource preparation failed." + (string.IsNullOrWhiteSpace(lastLine) ? "" : " " + lastLine));
+        }
+        var resources = Path.Combine(source, ".local", "horizon-client", LocalRecipe.MinecraftVersion);
+        if (!File.Exists(Path.Combine(resources, "horizon-resources.json")))
+            throw new InvalidDataException("Horizon did not produce the expected Minecraft resources.");
+        return resources;
+    }
+
+    internal static async Task<string> StageHelperAsync(string source, string workspace)
+    {
+        var tool = Path.Combine(workspace, "asset-tool");
+        if (Directory.Exists(tool) || File.Exists(tool)) throw new IOException("The resource helper workspace already exists.");
+        Directory.CreateDirectory(Path.Combine(tool, "src"));
+        await WriteEmbeddedAsync("Cargo.toml", Path.Combine(tool, "Cargo.toml"));
+        await WriteEmbeddedAsync("Cargo.lock", Path.Combine(tool, "Cargo.lock"));
+        await WriteEmbeddedAsync("main.rs", Path.Combine(tool, "src", "main.rs"));
+        foreach (var name in new[] { "mojang.rs", "sources.rs" })
+        {
+            var origin = Path.Combine(source, "launcher", "src", name);
+            if (!File.Exists(origin) || (File.GetAttributes(origin) & FileAttributes.ReparsePoint) != 0)
+                throw new InvalidDataException("The authenticated release is missing Horizon's asset downloader.");
+            File.Copy(origin, Path.Combine(tool, "src", name), overwrite: false);
+        }
+        return tool;
+    }
+
+    private static async Task WriteEmbeddedAsync(string name, string destination)
+    {
+        await using var input = typeof(MinecraftAssetPreparation).Assembly.GetManifestResourceStream("Horizon.Builder.Core.AssetTool." + name)
+            ?? throw new InvalidOperationException("The resource preparation helper is missing.");
+        await using var output = new FileStream(destination, FileMode.CreateNew, FileAccess.Write, FileShare.None, 81920, useAsync: true);
+        await input.CopyToAsync(output);
+    }
+}
diff --git a/uwp/builder/Core/MinecraftSignIn.cs b/uwp/builder/Core/MinecraftSignIn.cs
new file mode 100644
index 0000000000000000000000000000000000000000..eec0825b57a9c6d5acaa47e71c1fd1cae79c6919
--- /dev/null
+++ b/uwp/builder/Core/MinecraftSignIn.cs
@@ -0,0 +1,129 @@
+using System.Net.Http.Headers;
+using System.Text;
+using System.Text.Json;
+
+namespace Horizon.Builder.Core;
+
+/// <summary>A one-time ownership check. Tokens stay in memory and are not written to the launcher's account store.</summary>
+public sealed class MinecraftSignIn : IDisposable
+{
+    private const string MicrosoftBase = "https://login.microsoftonline.com/consumers/oauth2/v2.0";
+    private const string MinecraftBase = "https://api.minecraftservices.com";
+    private readonly HttpClient http;
+
+    public MinecraftSignIn() : this(new SocketsHttpHandler { AllowAutoRedirect = false }) { }
+    internal MinecraftSignIn(HttpMessageHandler handler)
+    {
+        http = new HttpClient(handler) { Timeout = TimeSpan.FromSeconds(30), MaxResponseContentBufferSize = 1024 * 1024 };
+        http.DefaultRequestHeaders.Accept.Add(new MediaTypeWithQualityHeaderValue("application/json"));
+    }
+    public void Dispose() => http.Dispose();
+
+    public sealed class Challenge
+    {
+        internal Challenge(string userCode, string deviceCode, Uri verificationUri, DateTimeOffset expires, int interval)
+            => (UserCode, DeviceCode, VerificationUri, Expires, Interval) = (userCode, deviceCode, verificationUri, expires, interval);
+        public string UserCode { get; }
+        public Uri VerificationUri { get; }
+        internal string DeviceCode { get; }
+        internal DateTimeOffset Expires { get; }
+        internal int Interval { get; }
+        public override string ToString() => "Microsoft sign-in challenge";
+    }
+
+    public async Task<Challenge> BeginAsync(CancellationToken cancellationToken = default)
+    {
+        using var request = new HttpRequestMessage(HttpMethod.Post, MicrosoftBase + "/devicecode")
+        {
+            Content = new FormUrlEncodedContent(new Dictionary<string, string> { ["client_id"] = HorizonIdentity.ClientId, ["scope"] = "XboxLive.signin offline_access" }),
+        };
+        using var response = await SendAsync(request, cancellationToken);
+        if (response.Status != 200) throw new InvalidOperationException("Microsoft could not start sign-in.");
+        var value = response.Body.RootElement;
+        var code = RequiredString(value, "user_code");
+        var secret = RequiredString(value, "device_code");
+        var uri = Uri.TryCreate(OptionalString(value, "verification_uri"), UriKind.Absolute, out var parsed)
+            && parsed.Scheme == Uri.UriSchemeHttps && parsed.UserInfo.Length == 0
+            && (parsed.Host.Equals("microsoft.com", StringComparison.OrdinalIgnoreCase) || parsed.Host.EndsWith(".microsoft.com", StringComparison.OrdinalIgnoreCase))
+                ? parsed : new Uri("https://www.microsoft.com/link");
+        var interval = value.TryGetProperty("interval", out var intervalJson) && intervalJson.TryGetInt32(out var seconds) ? Math.Clamp(seconds, 1, 1800) : 5;
+        var lifetime = value.TryGetProperty("expires_in", out var expiresJson) && expiresJson.TryGetInt32(out var expiry) ? Math.Clamp(expiry, 1, 1800) : 900;
+        return new(code, secret, uri, DateTimeOffset.UtcNow.AddSeconds(lifetime), interval);
+    }
+
+    public async Task<bool> CompleteOwnershipCheckAsync(Challenge challenge, CancellationToken cancellationToken = default)
+    {
+        ArgumentNullException.ThrowIfNull(challenge);
+        var interval = challenge.Interval;
+        string microsoftToken;
+        while (true)
+        {
+            if (DateTimeOffset.UtcNow >= challenge.Expires) throw new InvalidOperationException("The sign-in code expired. Start again.");
+            await Task.Delay(TimeSpan.FromSeconds(interval), cancellationToken);
+            if (DateTimeOffset.UtcNow >= challenge.Expires) throw new InvalidOperationException("The sign-in code expired. Start again.");
+            using var request = new HttpRequestMessage(HttpMethod.Post, MicrosoftBase + "/token")
+            {
+                Content = new FormUrlEncodedContent(new Dictionary<string, string> {
+                    ["grant_type"] = "urn:ietf:params:oauth:grant-type:device_code", ["client_id"] = HorizonIdentity.ClientId, ["device_code"] = challenge.DeviceCode }),
+            };
+            using var response = await SendAsync(request, cancellationToken);
+            var error = OptionalString(response.Body.RootElement, "error");
+            if (error == "authorization_pending") continue;
+            if (error == "slow_down") { interval = Math.Min(interval + 5, 1800); continue; }
+            if (response.Status != 200) throw new InvalidOperationException("Microsoft sign-in was declined or could not be completed.");
+            microsoftToken = RequiredString(response.Body.RootElement, "access_token");
+            break;
+        }
+
+        using var xbox = await PostJsonAsync("https://user.auth.xboxlive.com/user/authenticate", new {
+            Properties = new { AuthMethod = "RPS", SiteName = "user.auth.xboxlive.com", RpsTicket = "d=" + microsoftToken },
+            RelyingParty = "http://auth.xboxlive.com", TokenType = "JWT" }, cancellationToken);
+        if (xbox.Status != 200) throw new InvalidOperationException("Xbox Live refused the sign-in.");
+        var xboxToken = RequiredString(xbox.Body.RootElement, "Token");
+        using var xsts = await PostJsonAsync("https://xsts.auth.xboxlive.com/xsts/authorize", new {
+            Properties = new { SandboxId = "RETAIL", UserTokens = new[] { xboxToken } },
+            RelyingParty = "rp://api.minecraftservices.com/", TokenType = "JWT" }, cancellationToken);
+        if (xsts.Status != 200) throw new InvalidOperationException("Xbox Live could not authorize this account. Check its Xbox profile and family settings.");
+        var xstsToken = RequiredString(xsts.Body.RootElement, "Token");
+        var claims = xsts.Body.RootElement.GetProperty("DisplayClaims").GetProperty("xui");
+        if (claims.GetArrayLength() == 0) throw new InvalidDataException("Xbox Live returned incomplete sign-in information.");
+        var userHash = RequiredString(claims[0], "uhs");
+        var xToken = $"XBL3.0 x={userHash};{xstsToken}";
+        using var primary = await PostJsonAsync(MinecraftBase + "/launcher/login", new { xtoken = xToken, platform = "PC_LAUNCHER" }, cancellationToken);
+        string minecraftToken;
+        if (primary.Status == 200 && OptionalString(primary.Body.RootElement, "access_token") is { Length: > 0 } token)
+            minecraftToken = token;
+        else
+        {
+            using var fallback = await PostJsonAsync(MinecraftBase + "/authentication/login_with_xbox", new { identityToken = xToken }, cancellationToken);
+            if (fallback.Status != 200) throw new InvalidOperationException("Minecraft services refused the sign-in.");
+            minecraftToken = RequiredString(fallback.Body.RootElement, "access_token");
+        }
+        using var ownershipRequest = new HttpRequestMessage(HttpMethod.Get, MinecraftBase + "/entitlements/mcstore");
+        ownershipRequest.Headers.Authorization = new AuthenticationHeaderValue("Bearer", minecraftToken);
+        using var ownership = await SendAsync(ownershipRequest, cancellationToken);
+        if (ownership.Status != 200) throw new InvalidOperationException("Could not check Minecraft ownership.");
+        return ownership.Body.RootElement.TryGetProperty("items", out var items) && items.ValueKind == JsonValueKind.Array
+            && items.EnumerateArray().Any(item => OptionalString(item, "name") is "game_minecraft" or "product_minecraft");
+    }
+
+    private async Task<JsonResponse> PostJsonAsync(string url, object body, CancellationToken cancellationToken)
+    {
+        using var request = new HttpRequestMessage(HttpMethod.Post, url) { Content = new StringContent(JsonSerializer.Serialize(body), Encoding.UTF8, "application/json") };
+        return await SendAsync(request, cancellationToken);
+    }
+
+    private async Task<JsonResponse> SendAsync(HttpRequestMessage request, CancellationToken cancellationToken)
+    {
+        using var response = await http.SendAsync(request, HttpCompletionOption.ResponseContentRead, cancellationToken);
+        var bytes = await response.Content.ReadAsByteArrayAsync(cancellationToken);
+        try { return new((int)response.StatusCode, JsonDocument.Parse(bytes)); }
+        catch (JsonException) { throw new InvalidDataException("A sign-in service returned an invalid response."); }
+    }
+
+    private static string? OptionalString(JsonElement value, string name)
+        => value.ValueKind == JsonValueKind.Object && value.TryGetProperty(name, out var item) && item.ValueKind == JsonValueKind.String ? item.GetString() : null;
+    private static string RequiredString(JsonElement value, string name)
+        => OptionalString(value, name) is { Length: > 0 and <= 65536 } text ? text : throw new InvalidDataException("A sign-in service returned incomplete information.");
+    private sealed record JsonResponse(int Status, JsonDocument Body) : IDisposable { public void Dispose() => Body.Dispose(); }
+}
diff --git a/uwp/builder/Core/NativeBundleStager.cs b/uwp/builder/Core/NativeBundleStager.cs
new file mode 100644
index 0000000000000000000000000000000000000000..39399dfbf5d86be3daa2668b89edf1afb368ac75
--- /dev/null
+++ b/uwp/builder/Core/NativeBundleStager.cs
@@ -0,0 +1,112 @@
+using System.Diagnostics;
+using System.IO.Compression;
+using System.Runtime.InteropServices;
+using System.Security.Cryptography;
+using System.Text.Json;
+using System.Text.RegularExpressions;
+
+namespace Horizon.Builder.Core;
+
+public sealed record StagedNativeBundle(string Id, string Version, string Path, string Sha256, string Verification);
+
+/// <summary>Uses a pinned Horizon launcher to verify registry bundles in an isolated workspace.</summary>
+public sealed class NativeBundleStager
+{
+    private readonly string root;
+    private readonly string launcher;
+    private readonly SemaphoreSlim gate = new(1, 1);
+    private NativeBundleStager(string root, string launcher) => (this.root, this.launcher) = (root, launcher);
+
+    public static CatalogArtifact LauncherFor(Architecture architecture)
+    {
+        var (name, digest) = architecture switch
+        {
+            Architecture.X64 => ("x64", "add9bbd03e35335cf1750716c603cf2a5591959f56c689fb2ef4e608f01a73d3"),
+            Architecture.Arm64 => ("arm64", "51e6493d752bac8824211af975d295197e49093cbf1f3ea82218c0322add95e5"),
+            _ => throw new PlatformNotSupportedException("A Horizon launcher is not available for this builder architecture."),
+        };
+        return new($"https://github.com/horizon-rust/horizon/releases/download/launcher%400.2.42/horizon-launcher-windows-{name}.zip", digest);
+    }
+
+    public static async Task<NativeBundleStager> CreateAsync(CatalogTransport transport, string newWorkspace,
+        Architecture architecture, CancellationToken cancellationToken = default)
+    {
+        var artifact = LauncherFor(architecture);
+        var root = Path.GetFullPath(newWorkspace);
+        if (Directory.Exists(root) || File.Exists(root)) throw new IOException("The native-mod workspace already exists.");
+        Directory.CreateDirectory(root);
+        var archive = Path.Combine(root, "launcher.zip");
+        await transport.DownloadArtifactAsync(artifact, archive, cancellationToken);
+        return OpenVerifiedArchive(archive, root, artifact.Sha256);
+    }
+
+    internal static NativeBundleStager OpenVerifiedArchive(string archive, string workspace, string expectedHash)
+    {
+        using (var stream = File.OpenRead(archive))
+            if (!Convert.ToHexString(SHA256.HashData(stream)).Equals(expectedHash, StringComparison.OrdinalIgnoreCase))
+                throw new InvalidDataException("The Horizon launcher archive does not match the pinned release.");
+        using var zip = ZipFile.OpenRead(archive);
+        var candidates = zip.Entries.Where(entry => entry.FullName == "horizon-launcher.exe").ToArray();
+        if (candidates.Length != 1 || candidates[0].Length is <= 0 or > 120 * 1024 * 1024
+            || ((candidates[0].ExternalAttributes >> 16) & 0xF000) is not (0 or 0x8000))
+            throw new InvalidDataException("The Horizon launcher archive is invalid.");
+        var executable = Path.Combine(Path.GetFullPath(workspace), "horizon-launcher.exe");
+        using var input = candidates[0].Open();
+        using var output = new FileStream(executable, FileMode.CreateNew, FileAccess.Write, FileShare.None);
+        input.CopyTo(output);
+        return new(Path.GetFullPath(workspace), executable);
+    }
+
+    public async Task<IReadOnlyList<StagedNativeBundle>> InstallAsync(string id, CancellationToken cancellationToken = default)
+    {
+        if (!Regex.IsMatch(id, "^[a-z0-9_]{1,64}$")) throw new ArgumentException("Invalid native mod ID.", nameof(id));
+        await gate.WaitAsync(cancellationToken);
+        try { return await InstallCoreAsync(id, cancellationToken); }
+        finally { gate.Release(); }
+    }
+
+    private async Task<IReadOnlyList<StagedNativeBundle>> InstallCoreAsync(string id, CancellationToken cancellationToken)
+    {
+        var game = Path.Combine(root, "game");
+        var start = new ProcessStartInfo(launcher) { UseShellExecute = false, CreateNoWindow = true,
+            RedirectStandardOutput = true, RedirectStandardError = true, WorkingDirectory = root };
+        foreach (var arg in new[] { "--json", "mods", "install", id, "--source", "horizon" }) start.ArgumentList.Add(arg);
+        foreach (var (name, folder) in new[] { ("HORIZON_HOME", "game"), ("HORIZON_LAUNCHER_HOME", "launcher-home"),
+            ("XDG_DATA_HOME", "xdg-data"), ("XDG_CONFIG_HOME", "xdg-config"), ("HORIZON_LAUNCHER_TRASH", "trash"),
+            ("HORIZON_LAUNCHER_CLIPBOARD", "clipboard"), ("HORIZON_LAUNCHER_DESKTOP", "desktop") })
+            start.Environment[name] = Path.Combine(root, folder);
+        start.Environment["HORIZON_LAUNCHER_NO_SELF_UPDATE"] = "1";
+        start.Environment["HORIZON_NO_AUDIO"] = "1";
+        start.Environment.Remove("HORIZON_MOD_INDEX");
+        start.Environment.Remove("HORIZON_GITHUB_TOKEN");
+        using var process = Process.Start(start) ?? throw new InvalidOperationException("Could not start the Horizon launcher.");
+        var stdout = process.StandardOutput.ReadToEndAsync(cancellationToken);
+        var stderr = process.StandardError.ReadToEndAsync(cancellationToken);
+        try { await process.WaitForExitAsync(cancellationToken); }
+        catch (OperationCanceledException) { if (!process.HasExited) process.Kill(entireProcessTree: true); throw; }
+        await Task.WhenAll(stdout, stderr);
+        if (process.ExitCode != 0) throw new InvalidOperationException($"Horizon could not stage this native mod (exit code {process.ExitCode}); workspace retained.");
+        using var document = JsonDocument.Parse(await stdout);
+        var bundles = new List<StagedNativeBundle>();
+        foreach (var entry in document.RootElement.EnumerateArray())
+        {
+            var project = entry.GetProperty("project").GetString() ?? "";
+            var file = entry.GetProperty("file").GetString() ?? "";
+            var checksum = entry.GetProperty("checksum").GetString() ?? "";
+            var version = entry.GetProperty("version").GetString() ?? "";
+            var verification = entry.GetProperty("verdict").GetString() ?? "";
+            if (!Regex.IsMatch(project, "^[a-z0-9_]{1,64}$") || file != $"horizon-native-mods/{project}.hnmod"
+                || !checksum.StartsWith("SHA-256:", StringComparison.Ordinal) || checksum.Length != 72
+                || !checksum[8..].All(char.IsAsciiHexDigit) || version.Length == 0)
+                throw new InvalidDataException("Horizon returned an unexpected native-mod result.");
+            var path = Path.Combine(game, "horizon-native-mods", project + ".hnmod");
+            await using var stream = File.OpenRead(path);
+            var actual = Convert.ToHexString(await SHA256.HashDataAsync(stream, cancellationToken));
+            if (!actual.Equals(checksum[8..], StringComparison.OrdinalIgnoreCase))
+                throw new InvalidDataException("The staged native mod does not match Horizon's verified checksum.");
+            bundles.Add(new(project, version, path, actual, verification));
+        }
+        if (!bundles.Any(bundle => bundle.Id == id)) throw new InvalidDataException("Horizon did not stage the requested native mod.");
+        return bundles;
+    }
+}
diff --git a/uwp/builder/Core/NativeModBuild.cs b/uwp/builder/Core/NativeModBuild.cs
new file mode 100644
index 0000000000000000000000000000000000000000..a232c07646815a647dd8f17e5f4dc808cc36be78
--- /dev/null
+++ b/uwp/builder/Core/NativeModBuild.cs
@@ -0,0 +1,129 @@
+using System.IO.Compression;
+using System.Runtime.InteropServices;
+using System.Text;
+using System.Text.Json;
+using System.Text.RegularExpressions;
+
+namespace Horizon.Builder.Core;
+
+/// <summary>Stages verified registry bundles and applies their mixins to an isolated source tree.</summary>
+internal static class NativeModBuild
+{
+    private const string HooksFile = "crates/horizon-client/src/game/native_hooks.rs";
+
+    internal static async Task<string> ApplyAsync(string source, string workspace, IReadOnlyList<string> requested,
+        string cargo, IReadOnlyDictionary<string, string> hostEnvironment, IProgress<string>? progress)
+    {
+        if (requested.Count == 0) return source;
+        if (requested.Count > 100 || requested.Distinct(StringComparer.Ordinal).Count() != requested.Count)
+            throw new InvalidDataException("The selected native-mod list is invalid.");
+        progress?.Report("Downloading and verifying selected native mods with Horizon.");
+        using var transport = new CatalogTransport();
+        var stager = await NativeBundleStager.CreateAsync(transport, Path.Combine(workspace, "native-download"), RuntimeInformation.ProcessArchitecture);
+        var bundles = new Dictionary<string, StagedNativeBundle>(StringComparer.Ordinal);
+        foreach (var id in requested)
+            foreach (var bundle in await stager.InstallAsync(id)) bundles[bundle.Id] = bundle;
+        var hookText = await File.ReadAllTextAsync(Path.Combine(source, HooksFile));
+        var hookMatch = Regex.Match(hookText, @"(?m)^pub\(crate\) const NATIVE_HOOKS_API: u32 = (\d+);\s*$");
+        if (!hookMatch.Success || !int.TryParse(hookMatch.Groups[1].Value, out var availableHooks))
+            throw new InvalidDataException("This patch does not declare a supported native-mod hook version.");
+        var mods = Path.Combine(workspace, "native-mixins");
+        Directory.CreateDirectory(mods);
+        string? mixinsRevision = null;
+        foreach (var bundle in bundles.Values.OrderBy(b => b.Id, StringComparer.Ordinal))
+        {
+            var revision = ExtractBundle(bundle, mods, availableHooks);
+            if (mixinsRevision is not null && mixinsRevision != revision)
+                throw new InvalidOperationException("These selected mods require different versions of Horizon's mixin tool; choose compatible mods.");
+            mixinsRevision = revision;
+        }
+        if (mixinsRevision is null) throw new InvalidDataException("No native mods were staged.");
+        var toolRoot = Path.Combine(workspace, "native-tool");
+        progress?.Report("Building Horizon's native-mod transformation tool.");
+        await LocalBuildRunner.RunProcess(cargo, workspace,
+            ["+" + LocalRecipe.RustToolchain, "install", "--locked", "--git", "https://github.com/horizon-rust/horizon-mixins", "--rev", mixinsRevision,
+                "--root", toolRoot, "horizon-mixins-cli"], hostEnvironment);
+        var executable = Path.Combine(toolRoot, "bin", "horizon-mixins.exe");
+        var staged = Path.Combine(workspace, "native-source");
+        await File.WriteAllTextAsync(Path.Combine(source, ".horizon-revision"), LocalRecipe.UpstreamNightlyCommit + "\n");
+        var lib = Path.Combine(source, "crates", "horizon-client", "src", "lib.rs");
+        var original = await File.ReadAllTextAsync(lib);
+        // The upstream transformer mistakes this built-in crate setting for an attribute macro.
+        // Remove it only while transforming, and restore it byte-for-byte in the staged output.
+        const string attribute = "#![recursion_limit = \"256\"]";
+        var index = original.IndexOf(attribute, StringComparison.Ordinal);
+        if (index < 0 || original.IndexOf(attribute, index + attribute.Length, StringComparison.Ordinal) >= 0)
+            throw new InvalidDataException("Unexpected client crate settings; cannot safely apply native mods.");
+        var stripped = original.Remove(index, attribute.Length);
+        try
+        {
+            await File.WriteAllTextAsync(lib, stripped, new UTF8Encoding(false));
+            progress?.Report("Applying the selected native mods to the release source.");
+            await LocalBuildRunner.RunProcess(executable, workspace, ["apply", "--workspace", source, "--mods", mods, "--out", staged], hostEnvironment);
+        }
+        finally { await File.WriteAllTextAsync(lib, original, new UTF8Encoding(false)); }
+        var stagedLib = Path.Combine(staged, "crates", "horizon-client", "src", "lib.rs");
+        if (await File.ReadAllTextAsync(stagedLib) != stripped)
+            throw new InvalidDataException("A native mod changes the client crate root; this combination is not supported yet.");
+        await File.WriteAllTextAsync(stagedLib, original, new UTF8Encoding(false));
+        return staged;
+    }
+
+    private static string ExtractBundle(StagedNativeBundle bundle, string modsRoot, int availableHooks)
+    {
+        using var zip = ZipFile.OpenRead(bundle.Path);
+        var metadataEntries = zip.Entries.Where(e => e.FullName == "horizon-native.json").ToArray();
+        if (metadataEntries.Length != 1 || metadataEntries[0].Length is <= 0 or > 65536)
+            throw new InvalidDataException("Native mod metadata is invalid.");
+        using var metadataStream = metadataEntries[0].Open();
+        using var metadata = JsonDocument.Parse(metadataStream);
+        var root = metadata.RootElement;
+        var revision = root.GetProperty("mixins").GetString() ?? "";
+        var horizon = root.GetProperty("horizon").GetString() ?? "";
+        if (root.GetProperty("id").GetString() != bundle.Id || root.GetProperty("game").GetString() != LocalRecipe.MinecraftVersion
+            || !Regex.IsMatch(revision, "^[0-9a-f]{40}$") || !Regex.IsMatch(horizon, "^[0-9a-f]{40}$"))
+            throw new InvalidDataException("Native mod metadata does not match the selected release.");
+        var hasHooks = root.TryGetProperty("hooks", out var hooks);
+        if (hasHooks && (hooks.ValueKind != JsonValueKind.Number || !hooks.TryGetInt32(out var required) || required < 0 || required > availableHooks))
+            throw new InvalidDataException($"{bundle.Id} needs a different version of Horizon's native hooks.");
+        if (!hasHooks && horizon != LocalRecipe.UpstreamNightlyCommit)
+            throw new InvalidDataException($"{bundle.Id} requires a different Horizon revision.");
+        var prefix = $"mixins/{bundle.Id}/";
+        var destination = Path.Combine(modsRoot, bundle.Id);
+        Directory.CreateDirectory(destination);
+        long total = 0;
+        foreach (var entry in zip.Entries)
+        {
+            if (entry.FullName == "horizon-native.json") continue;
+            if (!entry.FullName.StartsWith(prefix, StringComparison.Ordinal) || entry.FullName.EndsWith('/'))
+                throw new InvalidDataException($"{bundle.Id} contains native-mod data this builder cannot yet include.");
+            var relative = entry.FullName[prefix.Length..];
+            if (relative.Length == 0 || relative.Contains('\\') || relative.Split('/').Any(p => p is "" or "." or "..")
+                || ((entry.ExternalAttributes >> 16) & 0xF000) is not (0 or 0x8000))
+                throw new InvalidDataException("Native mod contains an unsafe archive entry.");
+            if (entry.Length < 0 || entry.Length > 64L * 1024 * 1024 - total) throw new InvalidDataException("Native mod is too large.");
+            total += entry.Length;
+            var path = Path.GetFullPath(Path.Combine(destination, relative));
+            if (!path.StartsWith(Path.GetFullPath(destination) + Path.DirectorySeparatorChar, StringComparison.OrdinalIgnoreCase))
+                throw new InvalidDataException("Native mod entry leaves its workspace.");
+            Directory.CreateDirectory(Path.GetDirectoryName(path)!);
+            using var input = entry.Open();
+            using var output = new FileStream(path, FileMode.CreateNew);
+            input.CopyTo(output);
+        }
+        var manifestPath = Path.Combine(destination, "horizon-mixin.toml");
+        var manifest = File.ReadAllText(manifestPath);
+        if (Regex.IsMatch(manifest, @"(?im)^\s*\[\[?\s*post[-_]build\b"))
+            throw new InvalidDataException($"{bundle.Id} requires a post-build step this builder does not yet support.");
+        if (hasHooks)
+        {
+            var pattern = $"(?m)^([ \\t]*horizon_revision[ \\t]*=[ \\t]*\"{Regex.Escape(horizon)}\")[ \\t]*\\r?$";
+            var matches = Regex.Matches(manifest, pattern);
+            if (matches.Count != 1) throw new InvalidDataException("Native mod Horizon revision is not unambiguous.");
+            manifest = manifest[..matches[0].Index] + matches[0].Value.Replace(horizon, LocalRecipe.UpstreamNightlyCommit, StringComparison.Ordinal)
+                + manifest[(matches[0].Index + matches[0].Length)..];
+            File.WriteAllText(manifestPath, manifest, new UTF8Encoding(false));
+        }
+        return revision;
+    }
+}
diff --git a/uwp/builder/Core/NativeModIndex.cs b/uwp/builder/Core/NativeModIndex.cs
new file mode 100644
index 0000000000000000000000000000000000000000..8cd1c34b4d69a122b9cf13d3a73814d29e29d47d
--- /dev/null
+++ b/uwp/builder/Core/NativeModIndex.cs
@@ -0,0 +1,77 @@
+using System.Text.Json;
+using System.Text.RegularExpressions;
+
+namespace Horizon.Builder.Core;
+
+/// <summary>Read-only native-mod browsing; installing requires Horizon's complete bundle verification and mixin pipeline.</summary>
+public sealed record NativeModListing(string Id, string Name, string Summary, string Version, string[] Authors);
+
+public static class NativeModIndex
+{
+    public const string RegistryUrl = "https://horizon-rust.github.io/horizon-mods/index.json";
+    private const int MaxBytes = 16 * 1024 * 1024;
+
+    public static async Task<IReadOnlyList<NativeModListing>> FetchAsync(CancellationToken cancellationToken = default)
+    {
+        using var handler = new SocketsHttpHandler { AllowAutoRedirect = false };
+        using var http = new HttpClient(handler) { Timeout = TimeSpan.FromSeconds(45) };
+        using var response = await http.GetAsync(RegistryUrl, HttpCompletionOption.ResponseHeadersRead, cancellationToken);
+        response.EnsureSuccessStatusCode();
+        if (response.Content.Headers.ContentLength is > MaxBytes) throw new InvalidDataException("The mod index is too large.");
+        await using var stream = await response.Content.ReadAsStreamAsync(cancellationToken);
+        using var bytes = new MemoryStream();
+        var buffer = new byte[8192];
+        int count;
+        while ((count = await stream.ReadAsync(buffer, cancellationToken)) != 0)
+        {
+            if (bytes.Length + count > MaxBytes) throw new InvalidDataException("The mod index is too large.");
+            bytes.Write(buffer, 0, count);
+        }
+        return Parse(bytes.ToArray());
+    }
+
+    public static IReadOnlyList<NativeModListing> Parse(byte[] bytes)
+    {
+        if (bytes.Length > MaxBytes) throw new InvalidDataException("The mod index is too large.");
+        try
+        {
+            using var document = JsonDocument.Parse(bytes);
+            var root = document.RootElement;
+            if (root.GetProperty("schema").GetInt32() != 1) throw new InvalidDataException("Unsupported mod index schema.");
+            var revoked = root.TryGetProperty("revoked", out var revokedJson) ? revokedJson.EnumerateArray().Select(item =>
+                (Id: item.GetProperty("id").GetString(), Hash: item.TryGetProperty("sha256", out var hash) && hash.ValueKind == JsonValueKind.String ? hash.GetString() : null)).ToArray()
+                : [];
+            var listings = new List<NativeModListing>();
+            var ids = new HashSet<string>(StringComparer.Ordinal);
+            foreach (var project in root.GetProperty("projects").EnumerateArray())
+            {
+                if (project.GetProperty("kind").GetString() != "native-mod") continue;
+                var id = project.GetProperty("id").GetString() ?? "";
+                var name = project.GetProperty("name").GetString() ?? "";
+                var summary = project.GetProperty("summary").GetString() ?? "";
+                if (!Regex.IsMatch(id, "^[a-z0-9_]{1,64}$") || !ids.Add(id) || name.Length is < 1 or > 256 || summary.Length > 2048)
+                    throw new InvalidDataException("The native mod index has an invalid project.");
+                var authors = project.TryGetProperty("authors", out var authorsJson)
+                    ? authorsJson.EnumerateArray().Select(a => a.GetString() ?? "").ToArray() : [];
+                foreach (var version in project.GetProperty("versions").EnumerateArray())
+                {
+                    if (version.GetProperty("game").GetString() != LocalRecipe.MinecraftVersion) continue;
+                    var file = version.GetProperty("file");
+                    var fileName = file.GetProperty("name").GetString() ?? "";
+                    var hash = file.GetProperty("sha256").GetString() ?? "";
+                    var label = version.GetProperty("version").GetString() ?? "";
+                    if (!fileName.EndsWith(".hnmod", StringComparison.Ordinal) || hash.Length != 64 || !hash.All(char.IsAsciiHexDigit)
+                        || label.Length is < 1 or > 128) throw new InvalidDataException("The native mod index has an invalid version.");
+                    if (revoked.Any(r => r.Id == id && (r.Hash is null || r.Hash.Equals(hash, StringComparison.OrdinalIgnoreCase)))) continue;
+                    listings.Add(new(id, name, summary, label, authors));
+                    break;
+                }
+            }
+            return listings.OrderBy(item => item.Name, StringComparer.OrdinalIgnoreCase).ToArray();
+        }
+        catch (Exception error) when (error is JsonException or InvalidOperationException or KeyNotFoundException or FormatException)
+        {
+            throw new InvalidDataException("The mod index is invalid.", error);
+        }
+    }
+}
diff --git a/uwp/builder/Core/NightlyRelease.cs b/uwp/builder/Core/NightlyRelease.cs
new file mode 100644
index 0000000000000000000000000000000000000000..b02e660a2cd4a54da100dfc3ea0c8f53af0348c7
--- /dev/null
+++ b/uwp/builder/Core/NightlyRelease.cs
@@ -0,0 +1,72 @@
+using System.Globalization;
+using System.Net.Http.Headers;
+using System.Text.Json;
+
+namespace Horizon.Builder.Core;
+
+/// <summary>A published upstream checkpoint, not a validated UWP port.</summary>
+public sealed record NightlyRelease(string SourceCommit, DateTimeOffset PublishedAt, string ReleaseNotes)
+{
+    private const string ReleaseUrl = "https://api.github.com/repos/horizon-rust/horizon/releases/tags/nightly";
+
+    public static NightlyRelease Parse(string json)
+    {
+        using var document = JsonDocument.Parse(json);
+        var root = document.RootElement;
+        var tag = root.GetProperty("tag_name").GetString();
+        if ((tag != "nightly" && !(tag?.StartsWith("nightly-", StringComparison.Ordinal) ?? false)) ||
+            !root.GetProperty("prerelease").GetBoolean())
+            throw new InvalidDataException("GitHub did not return Horizon's nightly release.");
+        var commit = root.GetProperty("target_commitish").GetString();
+        var published = root.GetProperty("published_at").GetString();
+        if (commit is null || commit.Length != 40 || commit.Any(c => !Uri.IsHexDigit(c)) ||
+            !DateTimeOffset.TryParseExact(published, "yyyy-MM-dd'T'HH:mm:ss'Z'", CultureInfo.InvariantCulture,
+                DateTimeStyles.AssumeUniversal | DateTimeStyles.AdjustToUniversal, out var time))
+            throw new InvalidDataException("The nightly release metadata is incomplete.");
+        var notes = root.TryGetProperty("body", out var body) && body.ValueKind == JsonValueKind.String
+            ? body.GetString() ?? "" : "";
+        return new(commit.ToLowerInvariant(), time, notes);
+    }
+
+    public static async Task<NightlyRelease> FetchAsync()
+    {
+        return await FetchAsync(ReleaseUrl);
+    }
+
+    /// <summary>Fetch notes for the archived release matching the build's pinned source.</summary>
+    public static async Task<string?> FetchPinnedNotesAsync(string date, string sourceCommit)
+    {
+        if (!DateTime.TryParseExact(date, "yyyy-MM-dd", CultureInfo.InvariantCulture,
+                DateTimeStyles.None, out _))
+            throw new ArgumentException("The pinned nightly date is invalid.", nameof(date));
+        var current = await FetchAsync(ReleaseUrl);
+        if (current.SourceCommit == sourceCommit && current.ReleaseNotes.Length != 0)
+            return current.ReleaseNotes.Length <= 1024 * 1024 ? current.ReleaseNotes : null;
+        NightlyRelease? archived;
+        try { archived = await FetchAsync($"https://api.github.com/repos/horizon-rust/horizon/releases/tags/nightly-{date}"); }
+        catch (HttpRequestException error) when (error.StatusCode == System.Net.HttpStatusCode.NotFound) { return null; }
+        if (archived.SourceCommit != sourceCommit || archived.ReleaseNotes.Length == 0) return null;
+        return archived.ReleaseNotes.Length <= 1024 * 1024 ? archived.ReleaseNotes : null;
+    }
+
+    private static async Task<NightlyRelease> FetchAsync(string url)
+    {
+        using var client = new HttpClient { Timeout = TimeSpan.FromSeconds(15) };
+        client.DefaultRequestHeaders.UserAgent.Add(new ProductInfoHeaderValue("HorizonUWPBuilder", "1.0"));
+        client.DefaultRequestHeaders.Accept.Add(new MediaTypeWithQualityHeaderValue("application/vnd.github+json"));
+        using var response = await client.GetAsync(url, HttpCompletionOption.ResponseHeadersRead);
+        if (response.Content.Headers.ContentLength is > 1_000_000)
+            throw new InvalidDataException("The nightly release response is too large.");
+        response.EnsureSuccessStatusCode();
+        await using var stream = await response.Content.ReadAsStreamAsync();
+        using var buffer = new MemoryStream();
+        var bytes = new byte[8192];
+        int count;
+        while ((count = await stream.ReadAsync(bytes)) != 0)
+        {
+            if (buffer.Length + count > 1_000_000) throw new InvalidDataException("The nightly release response is too large.");
+            buffer.Write(bytes, 0, count);
+        }
+        return Parse(System.Text.Encoding.UTF8.GetString(buffer.ToArray()));
+    }
+}
