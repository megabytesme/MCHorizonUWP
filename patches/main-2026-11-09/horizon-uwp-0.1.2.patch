diff --git a/uwp/gamepad-bridge/README.md b/uwp/gamepad-bridge/README.md
new file mode 100644
index 0000000000000000000000000000000000000000..c4bf70260616d3ac23332af8d03fc5179d57d084
--- /dev/null
+++ b/uwp/gamepad-bridge/README.md
@@ -0,0 +1,17 @@
+# UWP controllers
+
+The `uwp-controller` feature uses Horizon's `gilrs` Windows.Gaming.Input
+backend. Standard `Gamepad` controllers use their mapped controls; other
+controllers exposed as `RawGameController` use the bundled SDL mapping
+database or gilrs' generic fallback. There is no controller allowlist. A
+supplemental mapping uses the X2 layout measured on the Lumia 950 XL. Unknown
+layouts may still need mapping, and system-reserved buttons may not reach the game.
+
+Input feeds the same controller settings, action bindings, deadzones and menus
+as desktop Horizon. Standard Gamepad vibration is used when available;
+device-specific HID effects are separate. The old native `Gamepad.cpp` bridge
+is retained for historical experiments; the game no longer links it.
+
+The UWP build uses a local `gilrs-core` compatibility patch for Windows 10
+15063, where `NonRoamableId` is unavailable. Runtime validation on the target
+OS and real controllers is still needed. Device vibration is a separate mod.
diff --git a/uwp/gamepad-bridge/host/Gamepad.cpp b/uwp/gamepad-bridge/host/Gamepad.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..56b1ed6f072b6dcc5a869f90dd5123565b8f5418
--- /dev/null
+++ b/uwp/gamepad-bridge/host/Gamepad.cpp
@@ -0,0 +1,87 @@
+#include <windows.h>
+#include <windows.gaming.input.h>
+#include <windows.system.threading.h>
+
+using namespace Windows::Gaming::Input;
+using namespace Windows::System::Threading;
+
+struct HorizonGamepadReading {
+    UINT32 buttons;
+    float left_x, left_y, right_x, right_y, left_trigger, right_trigger;
+    UINT32 connected;
+};
+static_assert(sizeof(HorizonGamepadReading) == 32, "gamepad bridge ABI");
+
+namespace {
+Gamepad^ active = nullptr;
+ThreadPoolTimer^ motor_timer = nullptr;
+
+bool engaged(const GamepadReading& value) {
+    return value.Buttons != GamepadButtons::None ||
+        value.LeftThumbstickX > 0.5 || value.LeftThumbstickX < -0.5 ||
+        value.LeftThumbstickY > 0.5 || value.LeftThumbstickY < -0.5 ||
+        value.RightThumbstickX > 0.5 || value.RightThumbstickX < -0.5 ||
+        value.RightThumbstickY > 0.5 || value.RightThumbstickY < -0.5 ||
+        value.LeftTrigger > 0.5 || value.RightTrigger > 0.5;
+}
+
+void stop(Gamepad^ pad) {
+    if (motor_timer != nullptr) { motor_timer->Cancel(); motor_timer = nullptr; }
+    if (pad == nullptr) return;
+    try { pad->Vibration = GamepadVibration{}; } catch (...) {}
+}
+}
+
+extern "C" int __cdecl horizon_uwp_gamepad_read(HorizonGamepadReading* output) {
+    if (!output) return -1;
+    *output = HorizonGamepadReading{};
+    try {
+        auto pads = Gamepad::Gamepads;
+        const auto count = pads->Size;
+        bool present = false;
+        for (unsigned int i = 0; i < count; ++i) if (pads->GetAt(i) == active) present = true;
+        if (!present) { stop(active); active = count ? pads->GetAt(0) : nullptr; }
+        if (active == nullptr) return 0;
+        auto reading = active->GetCurrentReading();
+        if (!engaged(reading)) {
+            for (unsigned int i = 0; i < count; ++i) {
+                auto candidate = pads->GetAt(i);
+                if (candidate == active) continue;
+                auto value = candidate->GetCurrentReading();
+                if (engaged(value)) { stop(active); active = candidate; reading = value; break; }
+            }
+        }
+        output->buttons = static_cast<UINT32>(reading.Buttons);
+        output->left_x = static_cast<float>(reading.LeftThumbstickX);
+        output->left_y = static_cast<float>(reading.LeftThumbstickY);
+        output->right_x = static_cast<float>(reading.RightThumbstickX);
+        output->right_y = static_cast<float>(reading.RightThumbstickY);
+        output->left_trigger = static_cast<float>(reading.LeftTrigger);
+        output->right_trigger = static_cast<float>(reading.RightTrigger);
+        output->connected = count;
+        return 1;
+    } catch (...) {
+        stop(active);
+        active = nullptr;
+        return -1;
+    }
+}
+
+extern "C" int __cdecl horizon_uwp_gamepad_vibrate(float strong, float weak, UINT32 millis) {
+    if (!(strong >= 0 && strong <= 1 && weak >= 0 && weak <= 1) || millis > 2000 || active == nullptr) return -1;
+    try {
+        stop(active);
+        if (!millis) return 0;
+        GamepadVibration value{};
+        value.LeftMotor = strong;
+        value.RightMotor = weak;
+        active->Vibration = value;
+        auto pad = active;
+        Windows::Foundation::TimeSpan delay{};
+        delay.Duration = static_cast<INT64>(millis) * 10000;
+        motor_timer = ThreadPoolTimer::CreateTimer(ref new TimerElapsedHandler([pad](ThreadPoolTimer^) {
+            try { pad->Vibration = GamepadVibration{}; } catch (...) {}
+        }), delay);
+        return 0;
+    } catch (...) { stop(active); return -1; }
+}
diff --git a/uwp/gamepad-bridge/src/lib.rs b/uwp/gamepad-bridge/src/lib.rs
new file mode 100644
index 0000000000000000000000000000000000000000..9843ee539242be6e43b89cd883ca38b8853366b4
--- /dev/null
+++ b/uwp/gamepad-bridge/src/lib.rs
@@ -0,0 +1,38 @@
+//! Safe facade for the host's Windows.Gaming.Input bridge.
+#![cfg(target_vendor = "uwp")]
+
+/// A WinRT gamepad reading. Axes are positive right/up; triggers are 0..1.
+#[repr(C)]
+#[derive(Clone, Copy, Default)]
+pub struct Reading {
+    pub buttons: u32,
+    pub left_x: f32,
+    pub left_y: f32,
+    pub right_x: f32,
+    pub right_y: f32,
+    pub left_trigger: f32,
+    pub right_trigger: f32,
+    pub connected: u32,
+}
+
+extern "C" {
+    fn horizon_uwp_gamepad_read(reading: *mut Reading) -> i32;
+    fn horizon_uwp_gamepad_vibrate(strong: f32, weak: f32, millis: u32) -> i32;
+}
+
+/// The active controller, if one is available.
+pub fn read() -> Option<Reading> {
+    let mut reading = Reading::default();
+    // The host writes one complete Reading before returning success.
+    (unsafe { horizon_uwp_gamepad_read(&mut reading) } == 1).then_some(reading)
+}
+
+/// Set the active controller's motors. Invalid values are refused.
+pub fn vibrate(strong: f32, weak: f32, millis: u32) -> bool {
+    if !strong.is_finite() || !weak.is_finite() || millis > 2000 {
+        return false;
+    }
+    unsafe {
+        horizon_uwp_gamepad_vibrate(strong.clamp(0.0, 1.0), weak.clamp(0.0, 1.0), millis) == 0
+    }
+}
diff --git a/uwp/gyro-bridge/host/Gyrometer.cpp b/uwp/gyro-bridge/host/Gyrometer.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..96f55c1de58ddc0e6d1bad555886e7bdace423ed
--- /dev/null
+++ b/uwp/gyro-bridge/host/Gyrometer.cpp
@@ -0,0 +1,196 @@
+#if defined(_MSC_VER) && _MSC_VER >= 1940 && defined(WINAPI_FAMILY)
+extern "C" __declspec(dllimport) char* __cdecl getenv(const char*);
+extern "C" __declspec(dllimport) int __cdecl system(const char*);
+#endif
+#include <windows.h>
+#include <windows.devices.sensors.h>
+#include <windows.graphics.display.h>
+#include <algorithm>
+#include <atomic>
+#include <cmath>
+#include <cstdint>
+#include <mutex>
+
+using namespace Windows::Devices::Sensors;
+using namespace Windows::Foundation;
+using namespace Windows::Graphics::Display;
+
+namespace {
+std::mutex mutex;
+std::atomic<int> display_orientation{0};
+Gyrometer^ sensor;
+Windows::Foundation::EventRegistrationToken reading_token{};
+bool requested = false;
+bool visible = true;
+bool starting = false;
+bool running = false;
+std::uint32_t generation = 0;
+std::int64_t previous_timestamp = 0;
+float turned_x = 0.0f;
+float turned_y = 0.0f;
+
+void reading_changed(std::uint32_t expected_generation, GyrometerReadingChangedEventArgs^ args) {
+    try {
+        auto reading = args->Reading;
+        if (reading == nullptr) return;
+        const auto timestamp = reading->Timestamp.UniversalTime;
+        std::lock_guard<std::mutex> guard(mutex);
+        if (!running || generation != expected_generation) return;
+        if (previous_timestamp != 0 && timestamp > previous_timestamp) {
+            const double seconds = static_cast<double>(timestamp - previous_timestamp) / 10000000.0;
+            if (seconds > 0.0 && seconds <= 0.1) {
+                constexpr double radians_per_degree = 0.017453292519943295;
+                const double x = reading->AngularVelocityX * seconds * radians_per_degree;
+                const double y = reading->AngularVelocityY * seconds * radians_per_degree;
+                if (std::isfinite(x) && std::isfinite(y)) {
+                    turned_x = std::clamp(turned_x + static_cast<float>(x), -6.2831853f, 6.2831853f);
+                    turned_y = std::clamp(turned_y + static_cast<float>(y), -6.2831853f, 6.2831853f);
+                }
+            }
+        }
+        previous_timestamp = timestamp;
+    } catch (...) {}
+}
+
+void stop_sensor() {
+    Gyrometer^ old_sensor = nullptr;
+    Windows::Foundation::EventRegistrationToken old_token{};
+    {
+        std::lock_guard<std::mutex> guard(mutex);
+        ++generation;
+        starting = false;
+        running = false;
+        old_sensor = sensor;
+        old_token = reading_token;
+        sensor = nullptr;
+        reading_token = Windows::Foundation::EventRegistrationToken{};
+        previous_timestamp = 0;
+        turned_x = 0.0f;
+        turned_y = 0.0f;
+    }
+    if (old_sensor != nullptr) {
+        try { old_sensor->ReadingChanged -= old_token; } catch (...) {}
+        try { old_sensor->ReportInterval = 0; } catch (...) {}
+    }
+}
+
+bool start_sensor() {
+    std::uint32_t started_generation = 0;
+    {
+        std::lock_guard<std::mutex> guard(mutex);
+        if (!requested || !visible || running) return running;
+        if (starting) return false;
+        starting = true;
+        started_generation = ++generation;
+    }
+
+    Gyrometer^ candidate = nullptr;
+    Windows::Foundation::EventRegistrationToken token{};
+    try {
+        candidate = Gyrometer::GetDefault();
+        if (candidate == nullptr) {
+            std::lock_guard<std::mutex> guard(mutex);
+            if (generation == started_generation) starting = false;
+            return false;
+        }
+        // GetForCurrentView requires a UI view; this function also runs on
+        // the game worker, so use the orientation last reported by the shell.
+        try {
+            auto orientation = static_cast<DisplayOrientations>(display_orientation.load());
+            if (orientation != DisplayOrientations::None) candidate->ReadingTransform = orientation;
+        } catch (Platform::Exception^) { /* Orientation is optional for sensor startup. */ }
+        candidate->ReportInterval = (std::max)(16u, candidate->MinimumReportInterval);
+        token = candidate->ReadingChanged += ref new TypedEventHandler<Gyrometer^, GyrometerReadingChangedEventArgs^>(
+            [started_generation](Gyrometer^, GyrometerReadingChangedEventArgs^ args) {
+                reading_changed(started_generation, args);
+            });
+    } catch (...) {
+        std::lock_guard<std::mutex> guard(mutex);
+        if (generation == started_generation) starting = false;
+        return false;
+    }
+
+    bool keep = false;
+    {
+        std::lock_guard<std::mutex> guard(mutex);
+        keep = generation == started_generation && requested && visible;
+        starting = false;
+        if (keep) {
+            sensor = candidate;
+            reading_token = token;
+            running = true;
+            previous_timestamp = 0;
+            turned_x = 0.0f;
+            turned_y = 0.0f;
+        }
+    }
+    if (!keep) {
+        try { candidate->ReadingChanged -= token; } catch (...) {}
+        try { candidate->ReportInterval = 0; } catch (...) {}
+    }
+    return keep;
+}
+
+void reconcile() {
+    bool should_run = false;
+    bool is_running = false;
+    {
+        std::lock_guard<std::mutex> guard(mutex);
+        should_run = requested && visible;
+        is_running = running || starting;
+    }
+    if (should_run && !is_running) start_sensor();
+    else if (!should_run && is_running) stop_sensor();
+}
+}
+
+extern "C" void __cdecl horizon_uwp_gyro_set_orientation(int value) {
+    display_orientation.store(value);
+    Gyrometer^ current = nullptr;
+    { std::lock_guard<std::mutex> guard(mutex); current = sensor; }
+    if (current != nullptr) {
+        try { current->ReadingTransform = static_cast<DisplayOrientations>(value); }
+        catch (Platform::Exception^) {}
+    }
+}
+
+extern "C" int __cdecl horizon_uwp_gyro_available() {
+    try { return Gyrometer::GetDefault() != nullptr ? 1 : 0; }
+    catch (...) { return 0; }
+}
+
+extern "C" int __cdecl horizon_uwp_gyro_enable(int enabled) {
+    try {
+        {
+            std::lock_guard<std::mutex> guard(mutex);
+            requested = enabled != 0;
+        }
+        reconcile();
+        std::lock_guard<std::mutex> guard(mutex);
+        return running ? 1 : 0;
+    } catch (...) { return 0; }
+}
+
+extern "C" void __cdecl horizon_uwp_gyro_set_visible(int is_visible) {
+    try {
+        {
+            std::lock_guard<std::mutex> guard(mutex);
+            visible = is_visible != 0;
+        }
+        reconcile();
+    } catch (...) {}
+}
+
+extern "C" int __cdecl horizon_uwp_gyro_take(float* x, float* y, int* rotation) {
+    if (x == nullptr || y == nullptr || rotation == nullptr) return 0;
+    try {
+        std::lock_guard<std::mutex> guard(mutex);
+        if (!running) return 0;
+        *x = turned_x;
+        *y = turned_y;
+        *rotation = 0;
+        turned_x = 0.0f;
+        turned_y = 0.0f;
+        return 1;
+    } catch (...) { return 0; }
+}
