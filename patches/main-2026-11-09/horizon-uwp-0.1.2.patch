+    pub fn focus_window(&self) {
+        let _ = self.canvas.borrow().raw().focus();
+    }
+
+    #[inline]
+    pub fn request_user_attention(&self, _request_type: Option<UserAttentionType>) {
+        // Currently an intentional no-op
+    }
+
