+#[derive(Debug)]
+pub(crate) enum CustomCursorSource {
+    Image(CursorImage),
+    Url { url: String, hotspot_x: u16, hotspot_y: u16 },
+    Animation { duration: Duration, cursors: Vec<RootCustomCursor> },
+}
