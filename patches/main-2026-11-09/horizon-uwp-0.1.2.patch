+            self.mouse_motion(event);
+            self.mouse_click(event, ElementState::Pressed);
+        }
+
+        #[method(mouseUp:)]
+        fn mouse_up(&self, event: &NSEvent) {
+            trace_scope!("mouseUp:");
+            self.mouse_motion(event);
+            self.mouse_click(event, ElementState::Released);
+        }
+
+        #[method(rightMouseDown:)]
+        fn right_mouse_down(&self, event: &NSEvent) {
