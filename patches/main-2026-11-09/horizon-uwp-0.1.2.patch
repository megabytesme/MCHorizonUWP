@@ -0,0 +1,147 @@
+using System.Globalization;
+using System.Text.Json;
+using System.Text.Json.Serialization;
+
+namespace Horizon.Builder.Core;
+
+// Catalog parsing and selection only. Callers must authenticate the catalog
+// and verify each artifact before using it; this class does not fetch code.
+public sealed record CatalogArtifact(string Url, string Sha256);
+public sealed record CatalogPatch(string Version, string UpstreamCommit, int Bridge, CatalogArtifact Upstream, CatalogArtifact Artifact);
+public sealed record CatalogClient(string Version, int Bridge, CatalogArtifact Artifact);
+public sealed record CatalogRange(string MinInclusive, string MaxExclusive);
+public sealed record CatalogRule(CatalogRange Patch, CatalogRange Client, CatalogRange Builder, string[] Architectures);
+public sealed record CatalogEvidence(string Patch, string Client, string Builder, string Architecture, bool BuildPassed, bool DevicePassed);
+public sealed record CompatibilityResult(bool Allowed, bool BuildVerified, bool DeviceVerified, string Reason);
+
+public sealed record CompatibilityCatalog(int SchemaVersion, CatalogPatch[] Patches, CatalogClient[] Clients,
+    CatalogRule[] Rules, CatalogEvidence[] Evidence)
+{
+    private static readonly JsonSerializerOptions JsonOptions = new()
+    {
+        PropertyNamingPolicy = JsonNamingPolicy.SnakeCaseLower,
+        UnmappedMemberHandling = JsonUnmappedMemberHandling.Disallow,
+    };
+
+    public static CompatibilityCatalog Parse(string json)
+    {
+        if (json.Length > 2_000_000) throw new InvalidDataException("The catalog is too large.");
+        CompatibilityCatalog catalog;
+        try
+        {
+            using var document = JsonDocument.Parse(json);
+            RejectDuplicateProperties(document.RootElement);
+            catalog = JsonSerializer.Deserialize<CompatibilityCatalog>(json, JsonOptions) ?? throw new InvalidDataException("The catalog is empty.");
+        }
+        catch (JsonException error) { throw new InvalidDataException("The catalog is invalid.", error); }
+        catalog.Validate();
+        return catalog;
+    }
+
+    public CompatibilityResult Check(string patchVersion, string clientVersion, string builderVersion, string architecture)
+    {
+        var patch = Patches.SingleOrDefault(p => p.Version == patchVersion);
+        var client = Clients.SingleOrDefault(c => c.Version == clientVersion);
+        if (patch is null || client is null) return new(false, false, false, "The selected release is not in the catalog.");
+        if (patch.Bridge != client.Bridge) return new(false, false, false, "The UWP bridge versions differ.");
+        if (!Rules.Any(rule => Contains(rule.Patch, patchVersion) && Contains(rule.Client, clientVersion)
+            && Contains(rule.Builder, builderVersion) && rule.Architectures.Contains(architecture, StringComparer.Ordinal)))
+            return new(false, false, false, "This builder, patch, client and architecture combination is not declared compatible.");
+        var evidence = Evidence.SingleOrDefault(e => e.Patch == patchVersion && e.Client == clientVersion
+            && e.Builder == builderVersion && e.Architecture == architecture);
+        return new(true, evidence?.BuildPassed == true, evidence?.DevicePassed == true,
+            evidence?.BuildPassed == true ? "The catalog records a successful build for this exact combination." : "This combination has not been verified by a recorded build.");
+    }
+
+    private void Validate()
+    {
+        if (SchemaVersion != 1 || Patches is null || Clients is null || Rules is null || Evidence is null)
+            throw new InvalidDataException("Unsupported or incomplete catalog.");
+        if (Patches.Any(x => x is null) || Clients.Any(x => x is null) || Rules.Any(x => x is null) || Evidence.Any(x => x is null))
+            throw new InvalidDataException("The catalog contains an empty entry.");
+        if (Patches.Select(p => p.Version).Distinct(StringComparer.Ordinal).Count() != Patches.Length
+            || Clients.Select(c => c.Version).Distinct(StringComparer.Ordinal).Count() != Clients.Length)
+            throw new InvalidDataException("Duplicate release versions are not permitted.");
+        foreach (var patch in Patches)
+        {
+            _ = ParseVersion(patch.Version);
+            if (patch.Bridge <= 0 || !IsHex(patch.UpstreamCommit, 40)) throw new InvalidDataException("Invalid patch identity.");
+            ValidateArtifact(patch.Upstream);
+            ValidateArtifact(patch.Artifact);
+        }
+        foreach (var client in Clients)
+        {
+            _ = ParseVersion(client.Version);
+            if (client.Bridge <= 0) throw new InvalidDataException("Invalid client bridge version.");
+            ValidateArtifact(client.Artifact);
+        }
+        foreach (var rule in Rules)
+        {
+            ValidateRange(rule.Patch); ValidateRange(rule.Client); ValidateRange(rule.Builder);
+            if (rule.Architectures is null || rule.Architectures.Length == 0
+                || rule.Architectures.Any(a => !IsArchitecture(a))
+                || rule.Architectures.Distinct(StringComparer.Ordinal).Count() != rule.Architectures.Length)
+                throw new InvalidDataException("Invalid target architectures.");
+        }
+        var uniqueEvidence = new HashSet<(string, string, string, string)>();
+        foreach (var item in Evidence)
+        {
+            _ = ParseVersion(item.Patch); _ = ParseVersion(item.Client); _ = ParseVersion(item.Builder);
+            if (!IsArchitecture(item.Architecture) || item.DevicePassed && !item.BuildPassed
+                || !uniqueEvidence.Add((item.Patch, item.Client, item.Builder, item.Architecture)))
+                throw new InvalidDataException("Invalid or duplicate test evidence.");
+            if (!Patches.Any(p => p.Version == item.Patch) || !Clients.Any(c => c.Version == item.Client))
+                throw new InvalidDataException("Test evidence refers to an unknown release.");
+            var patch = Patches.Single(p => p.Version == item.Patch);
+            var client = Clients.Single(c => c.Version == item.Client);
+            if (patch.Bridge != client.Bridge || !Rules.Any(rule => Contains(rule.Patch, item.Patch)
+                && Contains(rule.Client, item.Client) && Contains(rule.Builder, item.Builder)
+                && rule.Architectures.Contains(item.Architecture, StringComparer.Ordinal)))
+                throw new InvalidDataException("Test evidence refers to an incompatible combination.");
+        }
+    }
+
+    private static void RejectDuplicateProperties(JsonElement element)
+    {
+        if (element.ValueKind == JsonValueKind.Object)
+        {
+            var names = new HashSet<string>(StringComparer.Ordinal);
+            foreach (var property in element.EnumerateObject())
+            {
+                if (!names.Add(property.Name)) throw new InvalidDataException("The catalog contains a duplicate property.");
+                RejectDuplicateProperties(property.Value);
+            }
+        }
+        else if (element.ValueKind == JsonValueKind.Array)
+            foreach (var item in element.EnumerateArray()) RejectDuplicateProperties(item);
+    }
+
+    private static void ValidateArtifact(CatalogArtifact artifact)
+    {
+        if (artifact is null || !Uri.TryCreate(artifact.Url, UriKind.Absolute, out var uri)
+            || uri.Scheme != Uri.UriSchemeHttps || !string.IsNullOrEmpty(uri.UserInfo) || !IsHex(artifact.Sha256, 64))
+            throw new InvalidDataException("Invalid release artifact.");
+    }
+
+    private static bool IsHex(string? value, int length) => value is not null && value.Length == length && value.All(char.IsAsciiHexDigit);
+    private static bool IsArchitecture(string? value) => value is "x86" or "x64" or "arm" or "arm64";
+    private static void ValidateRange(CatalogRange range)
+    {
+        if (range is null || ParseVersion(range.MinInclusive) >= ParseVersion(range.MaxExclusive))
+            throw new InvalidDataException("Invalid compatibility range.");
+    }
+    private static bool Contains(CatalogRange range, string value)
+    {
+        var version = ParseVersion(value);
+        return version >= ParseVersion(range.MinInclusive) && version < ParseVersion(range.MaxExclusive);
+    }
+    // This first schema accepts only three-part stable numeric versions.
+    private static Version ParseVersion(string? value)
+    {
+        var parts = value?.Split('.');
+        if (parts is null || parts.Length != 3 || parts.Any(part => part.Length == 0 || part.Length > 1 && part[0] == '0'
+            || !int.TryParse(part, NumberStyles.None, CultureInfo.InvariantCulture, out _)))
+            throw new InvalidDataException("Versions must have three numeric components without leading zeros.");
+        return new Version(int.Parse(parts[0], CultureInfo.InvariantCulture), int.Parse(parts[1], CultureInfo.InvariantCulture), int.Parse(parts[2], CultureInfo.InvariantCulture));
+    }
+}
diff --git a/uwp/builder/Core/DependencyProvisioner.cs b/uwp/builder/Core/DependencyProvisioner.cs
new file mode 100644
index 0000000000000000000000000000000000000000..dce7734442d5d716f7125194cc64f4715a853063
--- /dev/null
+++ b/uwp/builder/Core/DependencyProvisioner.cs
@@ -0,0 +1,78 @@
+namespace Horizon.Builder.Core;
+
+public sealed record DependencyProgress(string Id, string Detail, bool Running, bool Complete, double? Percent = null);
+
+/// <summary>Checks and prepares the shared build requirements for every supported target.</summary>
+public static class DependencyProvisioner
+{
+    private static readonly string[] Architectures = ["x86", "x64", "arm", "arm64"];
+
+    public static async Task<IReadOnlyList<string>> MissingAsync(IProbe probe)
+    {
+        SystemProbe.RefreshProcessPath();
+        var missing = new List<string>();
+        if (probe.FindOnPath("winget.exe") is null) missing.Add("Windows Package Manager (WinGet)");
+        if (probe.FindOnPath("git.exe") is null) missing.Add("Git");
+        if (probe.FindOnPath("python.exe") is null) missing.Add("Python");
+        if (probe.FindOnPath("rustup.exe") is null) missing.Add("Rustup");
+        var rust = await LocalRecipe.InspectRustAsync(probe);
+        if (!rust.SourceAvailable || !rust.Version.StartsWith("rustc " + LocalRecipe.RustVersion + " ", StringComparison.Ordinal))
+            missing.Add($"Rust {LocalRecipe.RustVersion} and source");
+        if (!VisualStudioBootstrap.IsReadyForAllTargets(probe)) missing.Add("Visual C++ UWP build tools and Windows SDKs");
+        var llvm = Path.Combine(probe.EnvironmentValue("ProgramFiles") ?? @"C:\Program Files", "LLVM", "bin", "clang.exe");
+        if (!probe.FileExists(llvm)) missing.Add("LLVM for ARM targets");
+        var profile = WinUiBootstrap.PrivateProfile;
+        var winUi = Path.Combine(profile, ".nuget", "packages", "microsoft.ui.xaml", "2.7.3");
+        if (Architectures.Any(arch => !WinUiBootstrap.IsComplete(winUi, arch))) missing.Add("Microsoft UI framework");
+        var programFiles = probe.EnvironmentValue("ProgramFiles(x86)") ?? @"C:\Program Files (x86)";
+        if (Architectures.Any(arch => !FrameworkDependencies.IsAvailable(arch, programFiles, profile))) missing.Add("Microsoft VC runtime frameworks");
+        return missing.AsReadOnly();
+    }
+
+    public static async Task PrepareAsync(IProgress<DependencyProgress> progress)
+    {
+        var probe = new SystemProbe();
+        void Update(string id, string detail, bool running = false, bool complete = false, double? percent = null) => progress.Report(new(id, detail, running, complete, percent));
+        SystemProbe.RefreshProcessPath();
+        foreach (var (id, executable) in new[] { ("git", "git.exe"), ("python", "python.exe"), ("rustup", "rustup.exe") })
+            Update(id, probe.FindOnPath(executable) is null ? "Waiting to install" : "Available", complete: probe.FindOnPath(executable) is not null);
+        await WindowsPackageManager.EnsureBuildBasicsAsync(probe, async tool =>
+        {
+            var id = tool.ToString().ToLowerInvariant();
+            Update(id, "Installing with WinGet…", running: true);
+            await WindowsPackageManager.InstallAsync(probe, tool);
+            SystemProbe.RefreshProcessPath();
+            var executable = tool switch { InstallableTool.Git => "git.exe", InstallableTool.Python => "python.exe", InstallableTool.Rustup => "rustup.exe", _ => "" };
+            if (probe.FindOnPath(executable) is null) throw new InvalidOperationException($"{tool} was installed but could not be found.");
+            Update(id, "Installed", complete: true);
+        }, SystemProbe.RefreshProcessPath, prepareRustup: SystemProbe.UsePrivateRustupForProcess);
+        Update("rust", "Preparing the pinned compiler and Rust source…", running: true);
+        await WindowsPackageManager.EnsureRustToolchainAsync(() => LocalRecipe.InspectRustAsync(probe), () => WindowsPackageManager.InstallRustToolchainAsync(probe));
+        Update("rust", "Ready", complete: true);
+        Update("vs", "Preparing C++ tools and Windows SDKs for all targets…", running: true);
+        await VisualStudioBootstrap.EnsureAllTargetsAsync(probe, () => VisualStudioBootstrap.InstallAllTargetsAsync(probe));
+        Update("vs", "Ready for all four architectures", complete: true);
+        Update("llvm", "Preparing LLVM for ARM targets…", running: true);
+        await WindowsPackageManager.EnsureClangAsync(probe, TargetProfile.SurfaceProX, tool => WindowsPackageManager.InstallAsync(probe, tool));
+        Update("llvm", "Ready", complete: true);
+        var profile = WinUiBootstrap.PrivateProfile;
+        var system = probe.EnvironmentValue("ProgramFiles(x86)") ?? @"C:\Program Files (x86)";
+        var signTool = Path.Combine(system, "Windows Kits", "10", "bin", "10.0.26100.0", "x64", "signtool.exe");
+        var workspace = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData), "MCHorizonUWP", "Setup", Guid.NewGuid().ToString("N"));
+        Directory.CreateDirectory(workspace);
+        for (var i = 0; i < Architectures.Length; i++)
+        {
+            var arch = Architectures[i];
+            Update("ui", $"Checking the {arch} Microsoft UI framework ({i} of 4)…", running: true, percent: i * 25);
+            await WinUiBootstrap.EnsureAsync(profile, workspace, arch);
+        }
+        Update("ui", "Ready for all four architectures", complete: true);
+        for (var i = 0; i < Architectures.Length; i++)
+        {
+            var arch = Architectures[i];
+            Update("vclibs", $"Checking the {arch} Microsoft VC runtime ({i} of 4)…", running: true, percent: i * 25);
+            await FrameworkDependencies.FindAsync(arch, system, profile, signTool, workspace);
+        }
+        Update("vclibs", "Ready for all four architectures", complete: true);
+    }
+}
diff --git a/uwp/builder/Core/FrameworkDependencies.cs b/uwp/builder/Core/FrameworkDependencies.cs
new file mode 100644
index 0000000000000000000000000000000000000000..c2b85e0532368fecc9084af00f52ba72cbf812c3
--- /dev/null
+++ b/uwp/builder/Core/FrameworkDependencies.cs
@@ -0,0 +1,78 @@
+using System.IO.Compression;
+using System.Xml.Linq;
+
+namespace Horizon.Builder.Core;
+
+/// <summary>Locates and verifies the Microsoft framework packages needed when sideloading.</summary>
+internal static class FrameworkDependencies
+{
+    private const string Publisher = "CN=Microsoft Corporation, O=Microsoft Corporation, L=Redmond, S=Washington, C=US";
+    // Microsoft Visual C++ 14.44.35208 framework redistributables. The CAB and
+    // its contained APPX are both Microsoft-signed; the digest pins the payload.
+    private static readonly CatalogArtifact RuntimeCab = new(
+        "https://download.visualstudio.microsoft.com/download/pr/d2fa077f-a814-4fb2-b903-1fca7658d17e/dd4dbe036d235dd902ef41f2cb3ec7ce7ab1ebf93e6cc26fb6d7283301188e5a/cab1.cab",
+        "dd4dbe036d235dd902ef41f2cb3ec7ce7ab1ebf93e6cc26fb6d7283301188e5a");
+    private static readonly CatalogArtifact RuntimeArm64Cab = new(
+        "https://download.visualstudio.microsoft.com/download/pr/d2fa077f-a814-4fb2-b903-1fca7658d17e/7c0c4411e978befc4f2e577ddebdae154798a82214d14b47c63c2c2dc17c2bbd/cab1.cab",
+        "7c0c4411e978befc4f2e577ddebdae154798a82214d14b47c63c2c2dc17c2bbd");
+
+    private static string RuntimeCache(string userProfile, string architecture) =>
+        Path.Combine(userProfile, ".huwp", "frameworks", architecture, $"Microsoft.VCLibs.{architecture}.14.00.appx");
+
+    internal static bool IsAvailable(string architecture, string programFilesX86, string userProfile)
+    {
+        var sdkRuntime = Path.Combine(programFilesX86, "Microsoft SDKs", "Windows Kits", "10", "ExtensionSDKs",
+            "Microsoft.VCLibs", "14.0", "Appx", "Retail", architecture, $"Microsoft.VCLibs.{architecture}.14.00.appx");
+        return File.Exists(sdkRuntime) || File.Exists(RuntimeCache(userProfile, architecture));
+    }
+
+    internal static async Task<IReadOnlyList<string>> FindAsync(string architecture, string programFilesX86,
+        string userProfile, string signTool, string workingDirectory)
+    {
+        if (architecture is not ("x86" or "x64" or "arm" or "arm64")) throw new ArgumentException("Unsupported framework architecture.");
+        var runtime = Path.Combine(programFilesX86, "Microsoft SDKs", "Windows Kits", "10", "ExtensionSDKs",
+            "Microsoft.VCLibs", "14.0", "Appx", "Retail", architecture, $"Microsoft.VCLibs.{architecture}.14.00.appx");
+        var cachedRuntime = RuntimeCache(userProfile, architecture);
+        var downloaded = false;
+        if (!File.Exists(runtime) && File.Exists(cachedRuntime)) runtime = cachedRuntime;
+        if (!File.Exists(runtime)) { runtime = await DownloadRuntimeAsync(architecture, signTool, workingDirectory); downloaded = true; }
+        var xaml = Path.Combine(userProfile, ".nuget", "packages", "microsoft.ui.xaml", "2.7.3", "tools", "AppX", architecture, "Release", "Microsoft.UI.Xaml.2.7.appx");
+        foreach (var (path, name, minimum) in new[] { (runtime, "Microsoft.VCLibs.140.00", "14.0.0.0"), (xaml, "Microsoft.UI.Xaml.2.7", "7.2208.15002.0") })
+        {
+            if (!File.Exists(path)) throw new FileNotFoundException($"The {architecture} Microsoft framework {name} is missing. Install the UWP SDK components and restore Microsoft.UI.Xaml 2.7.3 before building.", path);
+            await LocalBuildRunner.RunProcess(signTool, workingDirectory, ["verify", "/pa", path]);
+            using var zip = ZipFile.OpenRead(path);
+            var manifest = zip.GetEntry("AppxManifest.xml") ?? throw new InvalidDataException("A Microsoft framework manifest is missing.");
+            using var stream = manifest.Open();
+            var document = XDocument.Load(stream);
+            var identity = document.Root?.Element(document.Root.Name.Namespace + "Identity") ?? throw new InvalidDataException("A Microsoft framework identity is missing.");
+            if ((string?)identity.Attribute("Name") != name || (string?)identity.Attribute("Publisher") != Publisher
+                || !string.Equals((string?)identity.Attribute("ProcessorArchitecture"), architecture, StringComparison.OrdinalIgnoreCase)
+                || !Version.TryParse((string?)identity.Attribute("Version"), out var version) || version < new Version(minimum))
+                throw new InvalidDataException($"The {name} package does not match the target architecture and version.");
+        }
+        if (downloaded)
+        {
+            Directory.CreateDirectory(Path.GetDirectoryName(cachedRuntime)!);
+            try { File.Copy(runtime, cachedRuntime, overwrite: false); }
+            catch (IOException) when (File.Exists(cachedRuntime)) { /* A concurrent build populated the cache. */ }
+        }
+        return [runtime, xaml];
+    }
+
+    private static async Task<string> DownloadRuntimeAsync(string architecture, string signTool, string workspace)
+    {
+        var directory = Path.Combine(Path.GetFullPath(workspace), "microsoft-vclibs-" + Guid.NewGuid().ToString("N"));
+        Directory.CreateDirectory(directory);
+        var cab = Path.Combine(directory, "runtime.cab");
+        using (var transport = new CatalogTransport())
+            await transport.DownloadArtifactAsync(architecture == "arm64" ? RuntimeArm64Cab : RuntimeCab, cab);
+        await LocalBuildRunner.RunProcess(signTool, directory, ["verify", "/pa", cab]);
+        var name = $"Microsoft.VCLibs.{architecture}.14.00.appx";
+        var expand = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.System), "expand.exe");
+        await LocalBuildRunner.RunProcess(expand, directory, [cab, "-F:" + name, directory]);
+        var package = Path.Combine(directory, name);
+        if (!File.Exists(package)) throw new InvalidDataException("The Microsoft VC runtime package was missing from its signed payload.");
+        return package;
+    }
+}
