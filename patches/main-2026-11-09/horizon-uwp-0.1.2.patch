+        kind: EvCodeKind::Axis,
+        index: 3,
+    };
+    pub const AXIS_RT2: EvCode = EvCode {
+        kind: EvCodeKind::Axis,
+        index: 4,
+    };
+    pub const AXIS_RSTICKY: EvCode = EvCode {
+        kind: EvCodeKind::Axis,
+        index: 5,
+    };
+    pub const AXIS_RT: EvCode = EvCode {
+        kind: EvCodeKind::Axis,
