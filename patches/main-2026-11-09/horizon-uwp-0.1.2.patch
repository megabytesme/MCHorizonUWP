+                    let delta = LogicalPosition::new(x, y).to_physical(self.scale_factor());
+                    MouseScrollDelta::PixelDelta(delta)
+                } else {
+                    MouseScrollDelta::LineDelta(x as f32, y as f32)
+                }
+            };
