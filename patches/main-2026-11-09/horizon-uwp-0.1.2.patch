--- /dev/null
+++ b/uwp/builder/Core/VisualCppInstallation.cs
@@ -0,0 +1,27 @@
+namespace Horizon.Builder.Core;
+
+/// <summary>Finds a standard Visual Studio installation with the UWP tools needed by a release.</summary>
+public static class VisualCppInstallation
+{
+    public static string? FindForTarget(IProbe probe, TargetProfile target)
+    {
+        var architecture = target switch { TargetProfile.DesktopX64 => "x64", TargetProfile.DesktopX86 => "x86",
+            TargetProfile.SurfaceProX => "arm64", TargetProfile.WindowsMobile => "arm", _ => throw new ArgumentOutOfRangeException(nameof(target)) };
+        var roots = new[] { probe.EnvironmentValue("ProgramFiles(x86)") ?? @"C:\Program Files (x86)",
+            probe.EnvironmentValue("ProgramFiles") ?? @"C:\Program Files" }.Distinct(StringComparer.OrdinalIgnoreCase);
+        foreach (var root in roots)
+            foreach (var release in new[] { "2022", "18" })
+                foreach (var edition in new[] { "BuildTools", "Community", "Professional", "Enterprise" })
+                {
+                    var candidate = Path.Combine(root, "Microsoft Visual Studio", release, edition);
+                    if (!probe.FileExists(Path.Combine(candidate, "VC", "Auxiliary", "Build", "vcvarsall.bat"))) continue;
+                    foreach (var toolset in probe.Directories(Path.Combine(candidate, "VC", "Tools", "MSVC")))
+                    {
+                        bool Has(string arch) => probe.FileExists(Path.Combine(toolset, "bin", "Hostx64", arch, "cl.exe"))
+                            && probe.FileExists(Path.Combine(toolset, "lib", arch, "store", "vcruntime.lib"));
+                        if (Has("x64") && Has(architecture)) return candidate;
+                    }
+                }
+        return null;
+    }
+}
diff --git a/uwp/builder/Core/VisualStudioBootstrap.cs b/uwp/builder/Core/VisualStudioBootstrap.cs
new file mode 100644
index 0000000000000000000000000000000000000000..c186f3f9e0c52cf72540eba0e193ee148d446600
--- /dev/null
+++ b/uwp/builder/Core/VisualStudioBootstrap.cs
@@ -0,0 +1,98 @@
+using System.ComponentModel;
+using System.Diagnostics;
+
+namespace Horizon.Builder.Core;
+
+internal sealed record VisualStudioInstallPlan(string Executable, IReadOnlyList<string> Arguments, bool Elevate);
+
+/// <summary>Installs the supported Visual Studio 2022 UWP build tools when absent.</summary>
+public static class VisualStudioBootstrap
+{
+    public const string PackageId = "Microsoft.VisualStudio.2022.BuildTools";
+    public const string TestedVersion = "17.14.44";
+
+    public static IReadOnlyList<string> Components(TargetProfile target)
+    {
+        if (!Enum.IsDefined(target)) throw new ArgumentOutOfRangeException(nameof(target));
+        var result = new List<string> { "Microsoft.VisualStudio.Workload.VCTools",
+            "Microsoft.VisualStudio.ComponentGroup.UWP.VC.BuildTools",
+            "Microsoft.VisualStudio.Component.VC.Tools.x86.x64",
+            "Microsoft.VisualStudio.Component.Windows11SDK.26100" };
+        if (target != TargetProfile.SurfaceProX) result.Add("Microsoft.VisualStudio.Component.Windows10SDK.19041");
+        if (target == TargetProfile.WindowsMobile) result.Add("Microsoft.VisualStudio.Component.VC.Tools.ARM");
+        if (target == TargetProfile.SurfaceProX) result.AddRange(["Microsoft.VisualStudio.Component.VC.Tools.ARM64", "Microsoft.VisualStudio.Component.UWP.VC.ARM64"]);
+        return result.AsReadOnly();
+    }
+
+    public static bool IsReady(IProbe probe, TargetProfile target) =>
+        VisualCppInstallation.FindForTarget(probe, target) is not null
+        && new SetupChecker(probe).Scan(target, splitRelease: true, unifiedToolchain: true)
+            .Any(check => check.Name == "Windows SDK and packaging tools" && check.Status == CheckStatus.Found);
+
+    public static bool IsReadyForAllTargets(IProbe probe) => Enum.GetValues<TargetProfile>().All(target => IsReady(probe, target));
+
+    public static IReadOnlyList<string> ComponentsForAllTargets() => Enum.GetValues<TargetProfile>()
+        .SelectMany(Components).Distinct(StringComparer.Ordinal).ToArray();
+
+    public static async Task EnsureAllTargetsAsync(IProbe probe, Func<Task> install, IProgress<string>? progress = null)
+    {
+        if (IsReadyForAllTargets(probe)) return;
+        progress?.Report("Installing the Microsoft C++ UWP build tools and SDKs for all four architectures. Windows may ask for administrator approval.");
+        await install();
+        if (!IsReadyForAllTargets(probe))
+            throw new InvalidOperationException("Visual Studio setup finished, but the UWP compiler or SDK tools for one or more targets are missing. Restart Windows and try again.");
+    }
+
+    public static async Task EnsureAsync(IProbe probe, TargetProfile target, Func<TargetProfile, Task> install,
+        IProgress<string>? progress = null)
+    {
+        if (IsReady(probe, target)) return;
+        progress?.Report("Installing the Microsoft C++ UWP build tools and Windows SDKs. Windows may ask for administrator approval; this can take a while.");
+        await install(target);
+        if (!IsReady(probe, target))
+            throw new InvalidOperationException("The Visual Studio installer finished, but the required UWP compiler or Windows SDK tools could not be found. Restart Windows and check setup.");
+    }
+
+    internal static VisualStudioInstallPlan Plan(IProbe probe, TargetProfile target) => Plan(probe, Components(target));
+
+    internal static VisualStudioInstallPlan Plan(IProbe probe, IReadOnlyList<string> components)
+    {
+        var programFiles = probe.EnvironmentValue("ProgramFiles(x86)") ?? @"C:\Program Files (x86)";
+        var parent = Path.Combine(programFiles, "Microsoft Visual Studio", "2022");
+        var root = Path.Combine(parent, "BuildTools");
+        var existing = probe.Directories(parent).Any(path => Path.GetFullPath(path).Equals(Path.GetFullPath(root), StringComparison.OrdinalIgnoreCase));
+        var componentArgs = components.SelectMany(component => new[] { "--add", component }).ToArray();
+        if (existing)
+        {
+            var setup = Path.Combine(programFiles, "Microsoft Visual Studio", "Installer", "setup.exe");
+            if (!probe.FileExists(setup)) throw new FileNotFoundException("The existing Visual Studio Build Tools installation needs repair, but its installer is missing.", setup);
+            return new(setup, new[] { "modify", "--installPath", root, "--quiet", "--wait", "--norestart" }.Concat(componentArgs).ToArray(), true);
+        }
+        var winget = probe.FindOnPath("winget.exe") ?? throw new InvalidOperationException("Windows Package Manager was not found.");
+        var options = string.Join(' ', new[] { "--quiet", "--wait", "--norestart" }.Concat(componentArgs));
+        return new(winget, new[] { "install", "--id", PackageId, "--exact", "--source", "winget", "--version", TestedVersion,
+            "--override", options, "--disable-interactivity", "--accept-package-agreements", "--accept-source-agreements", "--no-upgrade" }, false);
+    }
+
+    public static Task InstallAsync(IProbe probe, TargetProfile target) => InstallPlanAsync(Plan(probe, target));
+
+    public static Task InstallAllTargetsAsync(IProbe probe) => InstallPlanAsync(Plan(probe, ComponentsForAllTargets()));
+
+    private static async Task InstallPlanAsync(VisualStudioInstallPlan plan)
+    {
+        var start = new ProcessStartInfo(plan.Executable) { UseShellExecute = plan.Elevate, CreateNoWindow = false };
+        if (plan.Elevate) start.Verb = "runas";
+        foreach (var argument in plan.Arguments) start.ArgumentList.Add(argument);
+        try
+        {
+            using var process = Process.Start(start) ?? throw new InvalidOperationException("Could not start the Visual Studio installer.");
+            await process.WaitForExitAsync();
+            if (process.ExitCode == 3010) throw new InvalidOperationException("Visual Studio setup requires a Windows restart. Restart the PC and run the builder again.");
+            if (process.ExitCode != 0) throw new InvalidOperationException($"Visual Studio setup did not complete (exit code {process.ExitCode}).");
+        }
+        catch (Win32Exception error) when (error.NativeErrorCode == 1223)
+        {
+            throw new InvalidOperationException("Windows administrator approval is needed to install the C++ build tools.", error);
+        }
+    }
+}
diff --git a/uwp/builder/Core/WinUiBootstrap.cs b/uwp/builder/Core/WinUiBootstrap.cs
new file mode 100644
index 0000000000000000000000000000000000000000..60cbb7f2982012e350092fbb1651fb9a4dbbb53f
--- /dev/null
+++ b/uwp/builder/Core/WinUiBootstrap.cs
@@ -0,0 +1,69 @@
+using System.IO.Compression;
+using System.Security.Cryptography;
+using System.Text.Json;
+
+namespace Horizon.Builder.Core;
+
+/// <summary>Restores the exact WinUI 2 package used by the UWP client without requiring NuGet or the .NET SDK.</summary>
+internal static class WinUiBootstrap
+{
+    internal static string PrivateProfile => Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData), "MCHorizonUWP", "ToolProfile");
+    private const string PackageName = "microsoft.ui.xaml.2.7.3.nupkg";
+    private static readonly CatalogArtifact Package = new(
+        "https://api.nuget.org/v3-flatcontainer/microsoft.ui.xaml/2.7.3/" + PackageName,
+        "9ef3c54aa8c185603ba87d61673efb527062054adc736e27f2c4a033b5f797a8");
+
+    internal static async Task EnsureAsync(string userProfile, string workspace, string architecture, IProgress<string>? progress = null)
+    {
+        if (architecture is not ("x86" or "x64" or "arm" or "arm64")) throw new ArgumentException("Unsupported WinUI architecture.");
+        var parent = Path.Combine(Path.GetFullPath(userProfile), ".nuget", "packages", "microsoft.ui.xaml");
+        var target = Path.Combine(parent, "2.7.3");
+        if (IsComplete(target, architecture)) return;
+        if (Directory.Exists(target) || File.Exists(target))
+            throw new IOException("The existing Microsoft.UI.Xaml 2.7.3 package cache is incomplete; repair it with NuGet before continuing.");
+        var archive = Path.Combine(workspace, PackageName);
+        progress?.Report("Downloading the pinned Microsoft WinUI framework.");
+        using (var transport = new CatalogTransport()) await transport.DownloadArtifactAsync(Package, archive);
+        Directory.CreateDirectory(parent);
+        var staging = Path.Combine(parent, ".horizon-2.7.3-" + Guid.NewGuid().ToString("N"));
+        Directory.CreateDirectory(staging);
+        using (var zip = ZipFile.OpenRead(archive))
+        {
+            long total = 0;
+            foreach (var entry in zip.Entries)
+            {
+                var name = entry.FullName;
+                if (name.Contains('\\') || name.StartsWith('/') || name.Split('/').Any(part => part is "." or "..")
+                    || ((entry.ExternalAttributes >> 16) & 0xF000) is not (0 or 0x8000 or 0x4000))
+                    throw new InvalidDataException("WinUI package contains an unsafe archive entry.");
+                if (entry.Length < 0 || entry.Length > 256L * 1024 * 1024 - total)
+                    throw new InvalidDataException("WinUI package is too large.");
+                total += entry.Length;
+                var destination = Path.GetFullPath(Path.Combine(staging, name));
+                if (!destination.StartsWith(Path.GetFullPath(staging) + Path.DirectorySeparatorChar, StringComparison.OrdinalIgnoreCase))
+                    throw new InvalidDataException("WinUI package entry leaves its cache directory.");
+                if (name.EndsWith('/')) { Directory.CreateDirectory(destination); continue; }
+                Directory.CreateDirectory(Path.GetDirectoryName(destination)!);
+                using var input = entry.Open();
+                using var output = new FileStream(destination, FileMode.CreateNew);
+                input.CopyTo(output);
+            }
+        }
+        if (!IsComplete(staging, architecture)) throw new InvalidDataException("The pinned WinUI package is incomplete.");
+        string digest;
+        await using (var input = File.OpenRead(archive)) digest = Convert.ToBase64String(await SHA512.HashDataAsync(input));
+        File.Copy(archive, Path.Combine(staging, PackageName));
+        await File.WriteAllTextAsync(Path.Combine(staging, PackageName + ".sha512"), digest);
+        await File.WriteAllTextAsync(Path.Combine(staging, ".nupkg.metadata"), JsonSerializer.Serialize(new
+            { version = 2, contentHash = digest, source = "https://api.nuget.org/v3/index.json" }));
+        try { Directory.Move(staging, target); }
+        catch (IOException) when (IsComplete(target, architecture))
+        {
+            // Another NuGet process won the race. Leave our isolated staging folder for later cleanup.
+        }
+    }
+
+    internal static bool IsComplete(string root, string architecture) =>
+        File.Exists(Path.Combine(root, "lib", "uap10.0", "Microsoft.UI.Xaml.winmd"))
+        && File.Exists(Path.Combine(root, "tools", "AppX", architecture, "Release", "Microsoft.UI.Xaml.2.7.appx"));
+}
diff --git a/uwp/builder/Core/WindowsPackageManager.cs b/uwp/builder/Core/WindowsPackageManager.cs
new file mode 100644
index 0000000000000000000000000000000000000000..21cc3ac9b77f2f2963a09456aa8672c4faa50bec
--- /dev/null
+++ b/uwp/builder/Core/WindowsPackageManager.cs
@@ -0,0 +1,97 @@
+using System.Diagnostics;
+
+namespace Horizon.Builder.Core;
+
+public enum InstallableTool { Rustup, Git, Python, Llvm }
+
+/// <summary>Fixed package-manager operations initiated by the user.</summary>
+public static class WindowsPackageManager
+{
+    public static async Task EnsureRustToolchainAsync(Func<Task<RustToolchainFacts>> inspect, Func<Task> install,
+        IProgress<string>? progress = null)
+    {
+        static bool Ready(RustToolchainFacts facts) => facts.SourceAvailable
+            && facts.Version.StartsWith("rustc " + LocalRecipe.RustVersion + " ", StringComparison.Ordinal);
+        if (Ready(await inspect())) return;
+        progress?.Report($"Installing Rust {LocalRecipe.RustVersion} and rust-src without changing your default toolchain…");
+        await install();
+        if (!Ready(await inspect())) throw new InvalidOperationException("The required Rust compiler and source were not available after setup.");
+    }
+
+    public static async Task InstallRustToolchainAsync(IProbe probe)
+    {
+        var rustup = probe.FindOnPath("rustup.exe")
+            ?? throw new InvalidOperationException("Rustup is not installed. Use Install Rustup in setup, then retry.");
+        await LocalBuildRunner.RunProcess(rustup, Environment.GetFolderPath(Environment.SpecialFolder.UserProfile),
+            ["toolchain", "install", LocalRecipe.RustToolchain, "--profile", "minimal", "--component", "rust-src", "--no-self-update"]);
+    }
+
+    public static async Task EnsureBuildBasicsAsync(IProbe probe, Func<InstallableTool, Task> install,
+        Action refreshPath, IProgress<string>? progress = null, Action? prepareRustup = null)
+    {
+        refreshPath();
+        foreach (var (tool, executable) in new[] { (InstallableTool.Git, "git.exe"), (InstallableTool.Python, "python.exe"), (InstallableTool.Rustup, "rustup.exe") })
+        {
+            if (probe.FindOnPath(executable) is not null) continue;
+            if (tool == InstallableTool.Rustup) prepareRustup?.Invoke();
+            progress?.Report($"Installing {tool} with Windows Package Manager…");
+            await install(tool);
+            refreshPath();
+            if (probe.FindOnPath(executable) is null)
+                throw new InvalidOperationException($"{tool} was installed but could not be found. Restart the builder and try again.");
+        }
+    }
+
+    public static async Task EnsureClangAsync(IProbe probe, TargetProfile target, Func<InstallableTool, Task> install,
+        IProgress<string>? progress = null)
+    {
+        if (target is not (TargetProfile.WindowsMobile or TargetProfile.SurfaceProX)) return;
+        var clang = Path.Combine(probe.EnvironmentValue("ProgramFiles") ?? @"C:\Program Files", "LLVM", "bin", "clang.exe");
+        if (probe.FileExists(clang)) return;
+        progress?.Report("Installing LLVM for the ARM target with Windows Package Manager…");
+        await install(InstallableTool.Llvm);
+        if (!probe.FileExists(clang)) throw new InvalidOperationException("LLVM was installed but clang.exe was not found in its standard location.");
+    }
+
+    public static IReadOnlyList<string> Arguments(InstallableTool tool)
+    {
+        var package = tool switch
+        {
+            InstallableTool.Rustup => "Rustlang.Rustup",
+            InstallableTool.Git => "Git.Git",
+            InstallableTool.Python => "Python.Python.3.13",
+            InstallableTool.Llvm => "LLVM.LLVM",
+            _ => throw new ArgumentOutOfRangeException(nameof(tool)),
+        };
+        var args = new List<string> { "install", "--id", package, "--exact", "--source", "winget" };
+        if (tool == InstallableTool.Llvm) args.AddRange(["--version", "23.1.4"]);
+        if (tool == InstallableTool.Rustup)
+            args.AddRange(["--version", "1.29.3", "--override", "-y --no-modify-path --default-toolchain none --profile minimal --no-update-default-toolchain"]);
+        args.AddRange(["--silent", "--disable-interactivity", "--accept-package-agreements", "--accept-source-agreements"]);
+        // A separate Rustup installation can be registered with WinGet while absent
+        // from PATH. Install our private copy without replacing that installation.
+        args.Add(tool == InstallableTool.Rustup ? "--force" : "--no-upgrade");
+        return args.AsReadOnly();
+    }
+
+    public static async Task InstallAsync(IProbe probe, InstallableTool tool)
+    {
+        if (tool == InstallableTool.Rustup)
+        {
+            var cargoHome = probe.EnvironmentValue("CARGO_HOME")
+                ?? Path.Combine(probe.EnvironmentValue("USERPROFILE") ?? Environment.GetFolderPath(Environment.SpecialFolder.UserProfile), ".cargo");
+            var bin = Path.Combine(cargoHome, "bin");
+            if (probe.FileExists(Path.Combine(bin, "cargo.exe")) && !probe.FileExists(Path.Combine(bin, "rustup.exe")))
+                throw new IOException("A Cargo installation already occupies Rustup's intended location. Resolve that installation before continuing.");
+        }
+        var arguments = Arguments(tool);
+        var executable = probe.FindOnPath("winget.exe")
+            ?? throw new InvalidOperationException("Windows Package Manager was not found. Open the publisher instructions or install App Installer first.");
+        var start = new ProcessStartInfo(executable) { UseShellExecute = false, CreateNoWindow = false };
+        foreach (var argument in arguments) start.ArgumentList.Add(argument);
+        using var process = Process.Start(start) ?? throw new InvalidOperationException("Could not start Windows Package Manager.");
+        await process.WaitForExitAsync();
+        if (process.ExitCode != 0)
+            throw new InvalidOperationException($"Windows Package Manager did not complete (exit code {process.ExitCode}).");
+    }
+}
diff --git a/uwp/builder/README.md b/uwp/builder/README.md
new file mode 100644
index 0000000000000000000000000000000000000000..f4c51b167ec3594cc205f985bf4ee72417263529
--- /dev/null
+++ b/uwp/builder/README.md
@@ -0,0 +1,74 @@
+# Horizon UWP Builder preview
+
+The WinUI 3 builder is an in-development wizard for assembling a Horizon UWP
+client package. It selects the current Windows architecture by default and
+supports x86, x64, ARM32 and ARM64 targets. The client probes its packaged
+renderers and selects one on the target device.
+
+The builder fetches its signed compatibility catalog from this repository,
+then verifies the hashes of the selected Horizon source, patch and client
+artifacts before assembling them. The first patch and client are published as
+prereleases. A catalog compatibility rule is not a successful build or device
+test: the wizard labels combinations without recorded build evidence as
+unverified. This preview has one pinned recipe; later patch and client versions
+need compatible recipes and catalog entries.
+
+You can choose bundled Minecraft resources, a new reusable resource framework,
+or an existing framework on the target. Minecraft: Java Edition ownership
+sign-in is required before a build. The Microsoft client ID is the same public
+ID used by the Horizon launcher and UWP client; the builder keeps its sign-in
+tokens in memory. After ownership is confirmed, the development version can
+download and prepare resources privately using Horizon's pinned tooling. You can
+also choose prepared resources or an existing framework. Do not publish packages
+or resource frameworks containing Minecraft files.
+
+The options page can browse Horizon's native-mod registry, select and remove
+mods, and apply verified bundles through Horizon's mixin tool. Native mods run
+code with the player's permissions. A real Zoom bundle has been transformed
+and its x64 UWP game bridge compiled, but other mods and devices have not been
+established compatible. The builder refuses unsupported combinations, including
+mods requiring different mixin revisions, bundled data or post-build steps.
+The built-in touch and vibration options are separate from registry mods.
+
+Packages from the authenticated release recipe are signed with a locally
+created certificate. The output includes the public certificate, an installation
+guide and the target's Microsoft UI and VC runtime framework packages. The
+builder restores the pinned WinUI package automatically when absent. If an SDK
+does not contain the target's VC runtime APPX, the builder downloads a pinned
+Microsoft redistributable, verifies its signature and extracts the signed APPX.
+When the target can run on this PC, the builder offers installation
+and explains that trusting its certificate may require administrator approval.
+Other targets use the included guide. For an existing resource framework, its
+exact identity and publisher must match the client; resource
+frameworks contain private Minecraft files and should not be published.
+
+When you continue from Welcome, the development builder checks its requirements
+and offers to install missing components in the background. The Dependencies
+panel shows setup progress while you continue through the wizard. The builder
+uses WinGet for Git, Python, Rustup, Clang and Visual Studio 2022 Build Tools;
+it also prepares the UWP SDKs and Microsoft framework packages for all four
+targets. A new Rustup installation uses a private builder-owned home; the pinned
+compiler and rust-src are selected without changing an existing default
+toolchain. This setup is under Sandbox validation. Administrator approval may be needed when
+installing development tools or trusting the locally generated certificate.
+A complete build from a clean PC has not passed. See
+[CLEAN-PC-VALIDATION.md](CLEAN-PC-VALIDATION.md) for tested paths and limitations.
+
+## Building the builder
+
+On a development PC with the .NET 8 SDK, Windows App SDK NuGet packages and
+Visual Studio AppxPackage build tasks:
+
+```powershell
+.\build.ps1 -Configuration Release -Publish
+dotnet run --project .\Tests\Horizon.Builder.Tests.csproj -c Release
+```
+
+`-Publish` produces a self-contained x64 builder. Its WinUI application opens
+in Windows Sandbox without a separate .NET runtime. A native ARM64 or x86
+builder distribution has not been established. Builds use private workspaces
+under `%USERPROFILE%\.huwp\b` and parallel jobs limited by available memory. At least
+20 GiB of free space is required for automatic resource preparation; actual
+requirements can be higher.
+See [installation guidance](../../docs/install.md) and
+[builder design](../BUILDER-DESIGN.md) for further details.
