+            PAGE_GENERIC_DESKTOP => f.write_str("GENERIC_DESKTOP")?,
+            PAGE_BUTTON => f.write_str("BUTTON")?,
+            page => f.write_fmt(format_args!("PAGE_{}", page))?,
+        }
+        f.write_fmt(format_args!("({})", self.usage))
+    }
