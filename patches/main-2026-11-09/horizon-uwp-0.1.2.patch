index 0000000000000000000000000000000000000000..2b8c07ae01d730b3cc8b9c18baf68868cdca8754
--- /dev/null
+++ b/uwp/winit-probe/README.md
@@ -0,0 +1,22 @@
+# UWP winit + wgpu presentation probe
+
+This standalone static library drives the vendored UWP winit backend and clears
+a wgpu surface through ANGLE. It does not run Horizon. On x64 the native host
+strict-linked with no retained forbidden API sentinels, and a loose UWP package
+ran and wrote `frame-presented.txt` after its first wgpu presentation. Visual
+output and ARM64 have not yet been verified for this probe.
+
+To build, first prepare the copied Rust standard library as described in
+`../rust-std/README.md`. In a desktop x64 MSVC developer prompt with
+`RUSTC_BOOTSTRAP=1` and `__CARGO_TESTS_ONLY_SRC_ROOT` pointing to that copied
+library, run:
+
+```bat
+cargo +stable build --manifest-path uwp\winit-probe\Cargo.toml -Z build-std=std,panic_abort --target x86_64-uwp-windows-msvc --release --target-dir uwp\window-bridge\rust\target
+```
+
+Then enter an x64 UWP MSVC environment with SDK 15063 and run
+`powershell -ExecutionPolicy Bypass -File uwp\winit-probe\build-host.ps1`.
+Package the resulting executable with compatible UWP ANGLE DLLs and the host
+manifest/assets. The locally used deprecated ANGLE.WindowsStore DLLs are for
+diagnosis only and are not included in the repository.
diff --git a/uwp/winit-probe/build-host.ps1 b/uwp/winit-probe/build-host.ps1
new file mode 100644
index 0000000000000000000000000000000000000000..4acbd87a6d857a611bc90de1cafccbd840f13ca7
--- /dev/null
+++ b/uwp/winit-probe/build-host.ps1
@@ -0,0 +1,17 @@
+# Run from a UWP MSVC developer prompt after building the Rust static library.
+$ErrorActionPreference = 'Stop'
+$repo = (Resolve-Path (Join-Path $PSScriptRoot '../..')).Path
+$out = Join-Path $repo 'uwp/host/build/winit-probe'
+New-Item -ItemType Directory -Force -Path $out | Out-Null
+$metadata = Join-Path ${env:WindowsSdkDir} 'UnionMetadata/10.0.15063.0'
+$sources = @('uwp/host/App.cpp', 'uwp/dx11/Dx11Renderer.cpp', 'uwp/window-bridge/CoreWindowEvents.cpp')
+$objects = @()
+foreach ($source in $sources) {
+    $name = [IO.Path]::GetFileNameWithoutExtension($source)
+    $obj = Join-Path $out "$name.obj"
+    & cl /nologo /EHsc /ZW /std:c++17 /O2 /MD /DHORIZON_UWP_GAME_BRIDGE /DHORIZON_UWP_FRAME_PROBE /DWINAPI_FAMILY=WINAPI_FAMILY_APP /D_WIN32_WINNT=0x0A00 "/AI$metadata" "/I$(Join-Path $repo 'uwp/dx11')" /c (Join-Path $repo $source) "/Fo$obj"
+    if ($LASTEXITCODE -ne 0) { throw "Compiling $source failed ($LASTEXITCODE)" }
+    $objects += $obj
+}
+$lib = Join-Path $repo 'uwp/window-bridge/rust/target/x86_64-uwp-windows-msvc/release/horizon_uwp_winit_probe.lib'
+& (Join-Path $repo 'uwp/rust-std/strict-link.ps1') -Objects $objects -RustLibrary $lib -Output (Join-Path $out 'HorizonUWP.exe') -ExtraLibraries @('d3d11.lib', 'dxgi.lib')
diff --git a/uwp/winit-probe/src/lib.rs b/uwp/winit-probe/src/lib.rs
new file mode 100644
index 0000000000000000000000000000000000000000..bc26f3ab288ac20856992fb522631e40918fc0f7
--- /dev/null
+++ b/uwp/winit-probe/src/lib.rs
@@ -0,0 +1,83 @@
+//! Runs a winit-driven UWP window and clears a wgpu surface through ANGLE.
+use std::sync::Arc;
+use winit::application::ApplicationHandler;
+use winit::event::WindowEvent;
+use winit::event_loop::{ActiveEventLoop, EventLoop};
+use winit::window::{Window, WindowId};
+
+unsafe extern "C" { fn horizon_uwp_frame_presented(); }
+
+struct Probe {
+    window: Option<Arc<Window>>,
+    surface: Option<wgpu::Surface<'static>>,
+    device: Option<wgpu::Device>,
+    queue: Option<wgpu::Queue>,
+}
+impl ApplicationHandler for Probe {
+    fn resumed(&mut self, event_loop: &ActiveEventLoop) {
+        let window = Arc::new(event_loop.create_window(Window::default_attributes()).expect("window"));
+        let mut descriptor = wgpu::InstanceDescriptor::new_without_display_handle();
+        descriptor.backends = wgpu::Backends::GL;
+        let instance = wgpu::Instance::new(descriptor);
+        let surface = instance.create_surface(window.clone()).expect("surface");
+        let adapter = pollster::block_on(instance.request_adapter(&wgpu::RequestAdapterOptions {
+            compatible_surface: Some(&surface), ..Default::default()
+        })).expect("adapter");
+        let (device, queue) = pollster::block_on(adapter.request_device(&wgpu::DeviceDescriptor {
+            required_limits: adapter.limits(), ..Default::default()
+        })).expect("device");
+        let size = window.inner_size();
+        let config = surface.get_default_config(&adapter, size.width.max(1), size.height.max(1)).expect("config");
+        surface.configure(&device, &config);
+        self.window = Some(window);
+        self.surface = Some(surface);
+        self.device = Some(device);
+        self.queue = Some(queue);
+    }
+    fn window_event(&mut self, event_loop: &ActiveEventLoop, _: WindowId, event: WindowEvent) {
+        match event {
+            WindowEvent::CloseRequested => event_loop.exit(),
+            WindowEvent::Resized(size) if size.width > 0 && size.height > 0 => {
+                if let (Some(surface), Some(device)) = (&self.surface, &self.device) {
+                    let mut config = surface.get_configuration().unwrap();
+                    config.width = size.width;
+                    config.height = size.height;
+                    surface.configure(device, &config);
+                }
+            }
+            WindowEvent::RedrawRequested => {
+                let (Some(surface), Some(device), Some(queue)) = (&self.surface, &self.device, &self.queue) else { return; };
+                let frame = match surface.get_current_texture() {
+                    wgpu::CurrentSurfaceTexture::Success(frame) | wgpu::CurrentSurfaceTexture::Suboptimal(frame) => frame,
+                    _ => return,
+                };
+                let view = frame.texture.create_view(&Default::default());
+                let mut encoder = device.create_command_encoder(&Default::default());
+                {
+                    let _pass = encoder.begin_render_pass(&wgpu::RenderPassDescriptor {
+                        color_attachments: &[Some(wgpu::RenderPassColorAttachment {
+                            view: &view, resolve_target: None, depth_slice: None,
+                            ops: wgpu::Operations { load: wgpu::LoadOp::Clear(wgpu::Color { r: 0.2, g: 0.05, b: 0.4, a: 1.0 }), store: wgpu::StoreOp::Store },
+                        })], ..Default::default()
+                    });
+                }
+                queue.submit([encoder.finish()]);
+                queue.present(frame);
+                unsafe { horizon_uwp_frame_presented() };
+            }
+            _ => {}
+        }
+    }
+    fn about_to_wait(&mut self, _: &ActiveEventLoop) {
+        if let Some(window) = &self.window { window.request_redraw(); }
+    }
+}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn horizon_uwp_run(_: *const u16, _: usize, _: *const u16, _: usize) -> i32 {
+    let mut app = Probe { window: None, surface: None, device: None, queue: None };
+    match EventLoop::new().and_then(|event_loop| event_loop.run_app(&mut app)) {
+        Ok(()) => 0,
+        Err(_) => 1,
+    }
+}
