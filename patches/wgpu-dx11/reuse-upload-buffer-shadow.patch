+    #[test]
+    fn upload_mapping_uses_clean_shadow_and_falls_back_when_dirty() -> Result<()> {
+        let adapters = enumerate_native_adapters()?;
+        let Some(adapter) = adapters.iter().find(|adapter| !adapter.identity().software) else {
+            assert!(std::env::var_os("WGPU_DX11_REQUIRE_HARDWARE").is_none_or(|v| v != "1"));
+            return Ok(());
+        };
+        let levels: &[FeatureLevel] =
+            if std::env::var_os("WGPU_DX11_FORCE_FL9_1").is_some_and(|v| v == "1") {
+                &[FeatureLevel::L9_1]
+            } else {
+                &FeatureLevel::ALL_DESCENDING
+            };
+        let device = adapter.open_device(levels)?;
+        std::eprintln!("D3D11 upload mapping: {:?}", device.feature_level());
+        let upload = wgt::BufferUses::MAP_WRITE | wgt::BufferUses::COPY_SRC;
+        for usage in [upload, upload | wgt::BufferUses::COPY_DST] {
+            let buffer = device.create_buffer_with_usage(16, usage)?;
+            let initial: Vec<u8> = (0..16).collect();
+            device.write_byte_buffer(&buffer, 0, &initial)?;
+            let mapping = device.map_buffer_shadow(&buffer, 4..12).unwrap();
+            device.sync_buffer_shadow(&buffer, core::iter::once(0..16), false)?;
+            assert_eq!(
+                unsafe { core::slice::from_raw_parts(mapping.ptr.as_ptr(), 8) },
+                &initial[4..12]
+            );
+            assert_eq!(buffer.last_readback_staging_size(), 0);
+            unsafe {
+                core::ptr::copy_nonoverlapping([99u8, 100].as_ptr(), mapping.ptr.as_ptr().add(2), 2)
+            };
+            device.sync_buffer_shadow(&buffer, core::iter::once(6..8), true)?;
+            device.unmap_buffer_shadow(&buffer)?;
+            let mapping = device.map_buffer_shadow(&buffer, 4..12).unwrap();
+            device.sync_buffer_shadow(&buffer, core::iter::once(4..12), false)?;
+            let mut expected = initial;
+            expected[6..8].copy_from_slice(&[99, 100]);
+            assert_eq!(
+                unsafe { core::slice::from_raw_parts(mapping.ptr.as_ptr(), 8) },
+                &expected[4..12]
+            );
+            assert_eq!(buffer.last_readback_staging_size(), 0);
+            buffer.cpu_shadow().unwrap().mark_dirty_from_gpu();
+            device.sync_buffer_shadow(&buffer, core::iter::once(4..12), false)?;
+            assert_eq!(buffer.last_readback_staging_size(), 8);
+            assert_eq!(
+                unsafe { core::slice::from_raw_parts(mapping.ptr.as_ptr(), 8) },
+                &expected[4..12]
+            );
+            device.unmap_buffer_shadow(&buffer)?;
+        }
+        Ok(())
+    }
