@@ -0,0 +1,70 @@
+//! The current XAML game's display. The host observes its view on the UI thread.
+
+#[cfg(target_vendor = "uwp")]
+unsafe extern "C" {
+    fn horizon_uwp_get_advanced_color(white: *mut f32, peak: *mut f32, min: *mut f32) -> i32;
+}
+
+/// The OS must currently be presenting HDR on the view hosting the game.
+#[cfg(target_vendor = "uwp")]
+pub fn supports_hdr() -> bool {
+    // SAFETY: all three luminance outputs are optional in the host ABI.
+    let mode = unsafe {
+        horizon_uwp_get_advanced_color(
+            std::ptr::null_mut(),
+            std::ptr::null_mut(),
+            std::ptr::null_mut(),
+        )
+    };
+    active_hdr(mode) == Some(true)
+}
+
+/// Translate the view's report into the same display information Horizon uses
+/// on desktop, so all luminance validation and calibration defaults are shared.
+#[cfg(target_vendor = "uwp")]
+pub fn display_info() -> wgpu::DisplayHdrInfo {
+    let (mut white, mut peak) = (0.0, 0.0);
+    // SAFETY: the host takes a synchronized snapshot and writes only the supplied
+    // outputs before returning. Black level is the player's calibration setting.
+    let mode =
+        unsafe { horizon_uwp_get_advanced_color(&mut white, &mut peak, std::ptr::null_mut()) };
+    let hdr = active_hdr(mode);
+    wgpu::DisplayHdrInfo {
+        coarse: hdr.map(|active| wgpu::DisplayCoarseRange {
+            high_dynamic_range: Some(active),
+            ..Default::default()
+        }),
+        luminance: (hdr == Some(true)).then_some(wgpu::DisplayLuminance {
+            sdr_white_nits: Some(white),
+            max_nits: Some(peak),
+            ..Default::default()
+        }),
+        ..Default::default()
+    }
+}
+
+fn active_hdr(mode: i32) -> Option<bool> {
+    match mode {
+        0 | 1 => Some(false), // SDR and wide-gamut SDR
+        2 => Some(true),
+        _ => None,
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::active_hdr;
+
+    #[test]
+    fn only_an_active_hdr_view_reports_hdr() {
+        for (mode, hdr) in [
+            (-1, None),
+            (0, Some(false)),
+            (1, Some(false)),
+            (2, Some(true)),
+            (3, None),
+        ] {
+            assert_eq!(active_hdr(mode), hdr);
+        }
+    }
+}
