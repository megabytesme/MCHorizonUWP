<Window x:Class="Horizon.Builder.App.ActivityLogWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Setup and build log">
  <Window.SystemBackdrop>
    <MicaBackdrop />
  </Window.SystemBackdrop>
  <Grid x:Name="WindowRoot">
    <Grid.RowDefinitions>
      <RowDefinition x:Name="TitleBarRow" Height="48" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid x:Name="AppTitleBar" Background="Transparent" Height="48" Padding="18,0,150,0">
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <Image Source="Assets/Square44x44Logo.png" Width="20" Height="20" />
        <TextBlock Text="Setup and build log" VerticalAlignment="Center" FontWeight="SemiBold" />
      </StackPanel>
    </Grid>
    <Grid Grid.Row="1" RowSpacing="12" Padding="20">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
        <TextBlock Text="Live progress and diagnostic output" VerticalAlignment="Center" />
        <Button Content="Copy log" Click="CopyLog_Click" />
      </StackPanel>
      <ListView x:Name="LogList" Grid.Row="1" ItemsSource="{x:Bind LogEntries}"
                SelectionMode="None" IsTabStop="True"
                ScrollViewer.VerticalScrollMode="Enabled"
                ScrollViewer.VerticalScrollBarVisibility="Auto">
        <ListView.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12"
                       TextWrapping="Wrap" />
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>
    </Grid>
  </Grid>
</Window>
