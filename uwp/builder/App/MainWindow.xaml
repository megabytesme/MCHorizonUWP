<Window x:Class="Horizon.Builder.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Horizon UWP Builder">
  <ScrollViewer><StackPanel Padding="28" Spacing="16" MaxWidth="820" HorizontalAlignment="Stretch">
    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
      <Image Source="Assets/Square150x150Logo.png" Width="44" Height="44" />
      <TextBlock Text="Horizon UWP Builder" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
    </StackPanel>
    <TextBlock x:Name="UpstreamNightly" TextWrapping="Wrap" />
    <TextBlock x:Name="NightlyStatus" Text="Checking for a newer Horizon nightly…" TextWrapping="Wrap" />
    <TextBlock Text="Choose a local Horizon checkout and a resource packaging option, then inspect and run the pinned build recipe. Missing Cargo dependencies are downloaded from configured registries. Packages are unsigned." TextWrapping="Wrap" />
    <Button Content="Choose Horizon source" Click="ChooseSource_Click" />
    <TextBlock x:Name="SourcePath" Text="No source selected" TextWrapping="Wrap" />
    <TextBlock Text="Minecraft resources" Style="{StaticResource BodyStrongTextBlockStyle}" />
    <ComboBox x:Name="ResourceMode" SelectedIndex="0" HorizontalAlignment="Stretch">
      <ComboBoxItem Content="Build a separate reusable resource framework" />
      <ComboBoxItem Content="Use a resource framework already installed on the target" />
      <ComboBoxItem Content="Include resources in the client package" />
    </ComboBox>
    <TextBlock Text="For an existing framework, enter its exact package name. It must already be installed on the target with publisher CN=HorizonUWPPrototype." TextWrapping="Wrap" />
    <TextBox x:Name="ExistingFrameworkName" PlaceholderText="Horizon.Asset.26-3.…" IsEnabled="False" />
    <Button x:Name="ChooseResources" Content="Choose prepared resources" Click="ChooseResources_Click" />
    <TextBlock x:Name="ResourcesPath" Text="No resources selected" TextWrapping="Wrap" />
    <Button x:Name="ChooseMinecraft" Content="Choose Minecraft installation (for missing sounds)" Click="ChooseMinecraft_Click" />
    <TextBlock x:Name="MinecraftPath" Text="No Minecraft installation selected" TextWrapping="Wrap" />
    <CheckBox x:Name="PrepareSounds" Content="Prepare missing sounds from this installation in the build workspace" />
    <TextBlock Text="Target device" Style="{StaticResource BodyStrongTextBlockStyle}" />
    <ComboBox x:Name="Profile" SelectedIndex="0" HorizontalAlignment="Stretch">
      <ComboBoxItem Content="x64 — most Intel and AMD Windows PCs" />
      <ComboBoxItem Content="ARM64 — Snapdragon, Microsoft SQ and Copilot+ PCs" />
      <ComboBoxItem Content="ARM32 — Windows 10 Mobile phones (15063 or newer)" />
      <ComboBoxItem Content="x86 — 32-bit Intel and AMD Windows PCs" />
    </ComboBox>
    <TextBlock Text="Renderer build" Style="{StaticResource BodyStrongTextBlockStyle}" />
    <ComboBox x:Name="Renderer" SelectedIndex="0" HorizontalAlignment="Stretch">
      <ComboBoxItem Content="Native Direct3D 11 (feature level 9_1)" />
      <ComboBoxItem Content="ANGLE (OpenGL ES 3.0)" />
      <ComboBoxItem Content="Direct3D 12 (WGPU)" />
    </ComboBox>
    <TextBlock Text="Renderer build choices reflect the backends and runtime DLLs available for each architecture. The client probes the selected renderer against the live presentation surface on launch and only enables Start game when it opens on that device." TextWrapping="Wrap" />
    <CheckBox x:Name="NativeTouchMod" Content="Include native touch controls (native Direct3D 11 renderer only)" IsChecked="True" />
    <CheckBox x:Name="NativeDeviceVibration" Content="Include device vibration as a separate native mod" IsChecked="True" />
    <TextBlock Text="Microsoft application (client) ID — defaults to Fluent Launcher’s public ID; replace it with yours when approved" TextWrapping="Wrap" />
    <TextBox x:Name="MicrosoftClientId" PlaceholderText="00000000-0000-0000-0000-000000000000" />
    <TextBlock Text="Package version (choose a version newer than the one installed on the target)" TextWrapping="Wrap" />
    <TextBox x:Name="PackageVersion" />
    <TextBlock Text="The selected source mod is compiled into the client using the pinned local recipe." TextWrapping="Wrap" />
    <Button Content="Check setup" Click="CheckSetup_Click" />
    <Button x:Name="CheckRecipe" Content="Validate local build plan" Click="CheckRecipe_Click" />
    <TextBlock Text="The client includes audio, HTTPS, controllers and a native pre-game shell. Microsoft sign-in uses the configured public application ID and device-code flow. Client and resource framework packages use the HorizonUWPPrototype publisher and require a matching signing certificate before installation." TextWrapping="Wrap" />
    <Button x:Name="RunRecipe" Content="Build unsigned client" Click="RunRecipe_Click" />
    <TextBlock x:Name="RecipeStatus" TextWrapping="Wrap" />
    <StackPanel x:Name="RecipeSteps" Spacing="6" />
    <TextBlock Text="This scan reads local tool and SDK locations. It does not install software or verify recipe compatibility." TextWrapping="Wrap" />
    <TextBlock Text="Install tools using Windows Package Manager. Its interactive installers may ask you to review a license or approve elevation; they use your configured winget source." TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button x:Name="InstallRustup" Content="Install Rustup" Click="InstallTool_Click" />
      <Button x:Name="InstallGit" Content="Install Git" Click="InstallTool_Click" />
      <Button x:Name="InstallPython" Content="Install Python" Click="InstallTool_Click" />
    </StackPanel>
    <TextBlock x:Name="InstallStatus" TextWrapping="Wrap" />
    <StackPanel x:Name="Results" Spacing="12" />
  </StackPanel></ScrollViewer>
</Window>
