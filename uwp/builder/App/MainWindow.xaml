<Window x:Class="Horizon.Builder.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Horizon UWP Builder">
  <ScrollViewer><StackPanel Padding="28" Spacing="16" MaxWidth="820" HorizontalAlignment="Stretch">
    <TextBlock Text="Horizon UWP Builder" Style="{StaticResource TitleTextBlockStyle}" />
    <TextBlock Text="Choose a local Horizon checkout and prepared resources, then inspect and run the pinned build recipe. Packages are unsigned." TextWrapping="Wrap" />
    <Button Content="Choose Horizon source" Click="ChooseSource_Click" />
    <TextBlock x:Name="SourcePath" Text="No source selected" TextWrapping="Wrap" />
    <Button Content="Choose prepared resources" Click="ChooseResources_Click" />
    <TextBlock x:Name="ResourcesPath" Text="No resources selected" TextWrapping="Wrap" />
    <TextBlock Text="Target device" Style="{StaticResource BodyStrongTextBlockStyle}" />
    <ComboBox x:Name="Profile" SelectedIndex="0" HorizontalAlignment="Stretch">
      <ComboBoxItem Content="Windows desktop (x64)" />
      <ComboBoxItem Content="Surface Pro X (ARM64)" />
      <ComboBoxItem Content="Windows 10 Mobile (ARM32, 15063)" />
    </ComboBox>
    <CheckBox x:Name="NativeTouchMod" Content="Include native touch controls as a build-time source mod" />
    <TextBlock Text="Package version (choose a version newer than the one installed on the target)" TextWrapping="Wrap" />
    <TextBox x:Name="PackageVersion" Text="1.0.10.0" />
    <TextBlock Text="The selected source mod is compiled into the client using the pinned local recipe." TextWrapping="Wrap" />
    <Button Content="Check setup" Click="CheckSetup_Click" />
    <Button x:Name="CheckRecipe" Content="Validate local build plan" Click="CheckRecipe_Click" />
    <TextBlock Text="The ARM32 recipe is offline: HTTPS and authenticated online services are unavailable. Output uses the prototype publisher and must be signed before installation." TextWrapping="Wrap" />
    <Button x:Name="RunRecipe" Content="Build unsigned client" Click="RunRecipe_Click" />
    <TextBlock x:Name="RecipeStatus" TextWrapping="Wrap" />
    <StackPanel x:Name="RecipeSteps" Spacing="6" />
    <TextBlock Text="This scan reads local tool and SDK locations. It does not install software or verify recipe compatibility." TextWrapping="Wrap" />
    <TextBlock Text="Install tools using Windows Package Manager. Its interactive installers may ask you to review a license or approve elevation; they use your configured winget source." TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button x:Name="InstallRustup" Content="Install Rustup" Click="InstallTool_Click" />
      <Button x:Name="InstallGit" Content="Install Git" Click="InstallTool_Click" />
      <Button x:Name="InstallPython" Content="Install Python" Click="InstallTool_Click" />
    </StackPanel>
    <TextBlock x:Name="InstallStatus" TextWrapping="Wrap" />
    <StackPanel x:Name="Results" Spacing="12" />
  </StackPanel></ScrollViewer>
</Window>
