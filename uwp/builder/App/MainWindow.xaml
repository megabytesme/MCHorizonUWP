<Window x:Class="Horizon.Builder.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Horizon UWP Builder">
  <Window.SystemBackdrop>
    <MicaBackdrop />
  </Window.SystemBackdrop>
  <Grid>
    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1" CornerRadius="18" Padding="32" Margin="24"
            MaxWidth="840" MaxHeight="860" HorizontalAlignment="Stretch" VerticalAlignment="Center">
      <Grid RowSpacing="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Spacing="5">
          <TextBlock Text="HORIZON UWP BUILDER" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
          <TextBlock x:Name="StepLabel" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="16">
            <StackPanel x:Name="WelcomePage" Spacing="14">
              <TextBlock Text="Welcome to Horizon UWP Builder" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" />
              <TextBlock Text="Create a Horizon package for a Windows PC or a Windows 10 Mobile device." TextWrapping="Wrap" />
              <TextBlock Text="This preview still needs prepared Minecraft resources and development tools. Automatic setup, resource preparation and installation are not ready." TextWrapping="Wrap" />
              <TextBlock Text="The builder retrieves compatible releases from the MCHorizonUWP repository." TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel x:Name="TargetPage" Spacing="14" Visibility="Collapsed">
              <TextBlock Text="Choose a target device" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" />
              <TextBlock Text="The architecture of this PC is selected by default. Choose the device that will run the package." TextWrapping="Wrap" />
              <ComboBox x:Name="Profile" SelectedIndex="0" HorizontalAlignment="Stretch">
                <ComboBoxItem Content="x64 — Intel and AMD" />
                <ComboBoxItem Content="ARM64 — Snapdragon and Microsoft SQ" />
                <ComboBoxItem Content="ARM32 — Windows 10 Mobile" />
                <ComboBoxItem Content="x86 — 32-bit Intel and AMD" />
              </ComboBox>
              <TextBlock Text="Common device examples" Style="{StaticResource BodyStrongTextBlockStyle}" />
              <Grid ColumnSpacing="18" RowSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock Grid.Row="0" FontWeight="SemiBold" Text="Architecture" /><TextBlock Grid.Row="0" Grid.Column="1" FontWeight="SemiBold" Text="Examples" />
                <TextBlock Grid.Row="1" Text="x64" /><TextBlock Grid.Row="1" Grid.Column="1" Text="Intel or AMD PCs, many Surface Pro models, Xbox One and Series X|S, Surface Neo prototype" TextWrapping="Wrap" />
                <TextBlock Grid.Row="2" Text="ARM64" /><TextBlock Grid.Row="2" Grid.Column="1" Text="Surface Pro X and SQ devices, Snapdragon Copilot+ PCs, HoloLens 2, Surface Duo running Windows" TextWrapping="Wrap" />
                <TextBlock Grid.Row="3" Text="ARM32" /><TextBlock Grid.Row="3" Grid.Column="1" Text="Lumia 950 and other Windows 10 Mobile phones; HoloLens 2 also accepts ARM32 apps" TextWrapping="Wrap" />
                <TextBlock Grid.Row="4" Text="x86" /><TextBlock Grid.Row="4" Grid.Column="1" Text="32-bit Windows PCs and first-generation HoloLens" TextWrapping="Wrap" />
              </Grid>
              <TextBlock Text="These are architecture examples, not tested device compatibility. Surface Duo normally runs Android and requires a Windows installation to run UWP apps; Surface Neo was a prototype." TextWrapping="Wrap" />
              <TextBlock Text="The client checks graphics support and selects an available renderer on the target device." TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel x:Name="SourcePage" Spacing="14" Visibility="Collapsed">
              <TextBlock Text="Choose your source and resources" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" />
              <TextBlock Text="Horizon UWP release" Style="{StaticResource BodyStrongTextBlockStyle}" />
              <ComboBox x:Name="ReleaseSelection" PlaceholderText="No compatible release loaded" HorizontalAlignment="Stretch" />
              <TextBlock x:Name="ReleaseStatus" Text="Checking the signed release catalog…" TextWrapping="Wrap" />
              <Button x:Name="RefreshReleases" Content="Refresh releases" Click="RefreshReleases_Click" />
              <TextBlock Text="Minecraft resources" Style="{StaticResource BodyStrongTextBlockStyle}" />
              <TextBlock Text="Sign in with a Microsoft account that owns Minecraft: Java Edition. This preview can check ownership; downloading and preparing resources is not available yet." TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="StartMinecraftSignIn" Content="Sign in to Microsoft" Click="StartMinecraftSignIn_Click" />
                <Button x:Name="CancelMinecraftSignIn" Content="Cancel sign-in" Click="CancelMinecraftSignIn_Click" IsEnabled="False" />
              </StackPanel>
              <TextBlock x:Name="MinecraftSignInStatus" TextWrapping="Wrap" />
              <HyperlinkButton x:Name="MinecraftSignInLink" Content="Open the Microsoft sign-in page" Visibility="Collapsed" />
              <ComboBox x:Name="ResourceMode" SelectedIndex="0" HorizontalAlignment="Stretch">
                <ComboBoxItem Content="Build a separate reusable resource framework" />
                <ComboBoxItem Content="Use a resource framework already installed on the target" />
                <ComboBoxItem Content="Include resources in the client package" />
              </ComboBox>
              <TextBlock Text="A separate framework can be reused by compatible client packages. Bundled resources travel with each client package." TextWrapping="Wrap" />
              <TextBlock Text="For an existing framework, enter its exact package name and ensure it is installed on the target." TextWrapping="Wrap" />
              <TextBox x:Name="ExistingFrameworkName" PlaceholderText="Horizon.Asset.26-3.…" IsEnabled="False" />
              <Button x:Name="ChooseResources" Content="Choose prepared resources" Click="ChooseResources_Click" />
              <TextBlock x:Name="ResourcesPath" Text="No resources selected" TextWrapping="Wrap" />
              <Button x:Name="ChooseMinecraft" Content="Choose Minecraft installation (for missing sounds)" Click="ChooseMinecraft_Click" />
              <TextBlock x:Name="MinecraftPath" Text="No Minecraft installation selected" TextWrapping="Wrap" />
              <CheckBox x:Name="PrepareSounds" Content="Prepare missing sounds in the build workspace" />
            </StackPanel>
            <StackPanel x:Name="OptionsPage" Spacing="14" Visibility="Collapsed">
              <TextBlock Text="Choose options" Style="{StaticResource TitleTextBlockStyle}" />
              <TextBlock Text="Native mods" Style="{StaticResource BodyStrongTextBlockStyle}" />
              <CheckBox x:Name="NativeTouchMod" Content="Include native touch controls" IsChecked="True" />
              <TextBlock Text="The included touch controls currently work with the native Direct3D 11 backend." TextWrapping="Wrap" />
              <CheckBox x:Name="NativeDeviceVibration" Content="Include device vibration" IsChecked="True" />
              <Button x:Name="BrowseNativeMods" Content="Browse Horizon native mods" Click="BrowseNativeMods_Click" />
              <TextBlock x:Name="NativeModsStatus" Text="Browse and select native mods from Horizon's registry. Native mods run code with the player's permissions; select only mods you trust." TextWrapping="Wrap" />
              <TextBox x:Name="NativeModSearch" PlaceholderText="Search native mods" IsEnabled="False" TextChanged="NativeModSearch_TextChanged" />
              <StackPanel x:Name="NativeModsResults" Spacing="12" />
              <TextBlock Text="The client uses Horizon’s public Microsoft sign-in application." TextWrapping="Wrap" />
              <TextBlock Text="Package version" TextWrapping="Wrap" />
              <TextBox x:Name="PackageVersion" />
            </StackPanel>
            <StackPanel x:Name="SetupPage" Spacing="14" Visibility="Collapsed">
              <TextBlock Text="Check your setup" Style="{StaticResource TitleTextBlockStyle}" />
              <TextBlock Text="The builder installs missing Git and Python when you start a build. This accepts their package and source agreements; Windows may request administrator approval. Rustup is still interactive, and other development tools are not yet installed automatically." TextWrapping="Wrap" />
              <Button Content="Check setup" Click="CheckSetup_Click" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="InstallRustup" Content="Install Rustup" Click="InstallTool_Click" />
                <Button x:Name="InstallGit" Content="Install Git" Click="InstallTool_Click" />
                <Button x:Name="InstallPython" Content="Install Python" Click="InstallTool_Click" />
              </StackPanel>
              <TextBlock x:Name="InstallStatus" TextWrapping="Wrap" />
              <StackPanel x:Name="Results" Spacing="12" />
            </StackPanel>
            <StackPanel x:Name="BuildPage" Spacing="14" Visibility="Collapsed">
              <TextBlock Text="Build your package" Style="{StaticResource TitleTextBlockStyle}" />
              <TextBlock Text="Sign in with an account that owns Minecraft: Java Edition, validate the plan, then build. The client package and its reusable resources are signed with your local certificate." TextWrapping="Wrap" />
              <Button x:Name="CheckRecipe" Content="Validate local build plan" Click="CheckRecipe_Click" />
              <Button x:Name="RunRecipe" Content="Build client" Click="RunRecipe_Click" />
              <TextBlock x:Name="RecipeStatus" TextWrapping="Wrap" />
              <StackPanel x:Name="RecipeSteps" Spacing="6" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="2" ColumnSpacing="10">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <Button x:Name="BackButton" Grid.Column="1" Content="Back" Click="Back_Click" />
          <Button x:Name="NextButton" Grid.Column="2" Content="Next" Click="Next_Click" />
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
