+//! Process-local environment for AppContainer applications. UWP does not
+//! provide the desktop environment block APIs.
+use crate::collections::BTreeMap;
+use crate::ffi::{OsStr, OsString};
+use crate::os::windows::ffi::OsStrExt;
+use crate::sync::{LazyLock, RwLock};
+use crate::{fmt, io};
+
+type Variables = BTreeMap<Vec<u16>, (OsString, OsString)>;
+static VARIABLES: LazyLock<RwLock<Variables>> = LazyLock::new(|| RwLock::new(BTreeMap::new()));
+
+// Windows environment names are case insensitive. Preserve UTF-16 and fold
+// ASCII names, which includes the conventional variables consumed by Horizon.
+fn key(name: &OsStr) -> Vec<u16> {
+    name.encode_wide().map(|c| if (b'a' as u16..=b'z' as u16).contains(&c) { c - 32 } else { c }).collect()
+}
+
+pub struct Env(crate::vec::IntoIter<(OsString, OsString)>);
+impl fmt::Debug for Env {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result { f.debug_list().entries(self.0.clone()).finish() }
+}
+impl Iterator for Env {
+    type Item = (OsString, OsString);
+    fn next(&mut self) -> Option<Self::Item> { self.0.next() }
+}
+pub fn env() -> Env {
+    let vars = VARIABLES.read().unwrap_or_else(|e| e.into_inner());
+    Env(vars.values().cloned().collect::<Vec<_>>().into_iter())
+}
+pub fn getenv(name: &OsStr) -> Option<OsString> {
+    VARIABLES.read().unwrap_or_else(|e| e.into_inner()).get(&key(name)).map(|(_, value)| value.clone())
+}
+pub unsafe fn setenv(name: &OsStr, value: &OsStr) -> io::Result<()> {
+    VARIABLES.write().unwrap_or_else(|e| e.into_inner()).insert(key(name), (name.to_owned(), value.to_owned()));
+    Ok(())
+}
+pub unsafe fn unsetenv(name: &OsStr) -> io::Result<()> {
+    VARIABLES.write().unwrap_or_else(|e| e.into_inner()).remove(&key(name));
+    Ok(())
+}
