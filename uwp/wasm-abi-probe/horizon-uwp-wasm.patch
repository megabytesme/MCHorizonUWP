+fn windows_stack_sufficient(required: usize) -> bool {
+    let mut low = 0;
+    let mut high = 0;
+    // SAFETY: both pointers refer to writable stack bounds.
+    unsafe { get_current_thread_stack_limits(&mut low, &mut high) };
+    high.saturating_sub(low) >= required
+}
