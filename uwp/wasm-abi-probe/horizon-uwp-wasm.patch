+fn install_dispatch(
+    native: &Runtime,
+    launch: &LaunchArguments,
+    entries: Vec<ModEntry>,
+    wasm: &[horizon_mod_package::Manifest],
+) -> std::io::Result<Vec<&'static str>> {
+    if entries.is_empty() {
+        mod_api::__private::install(Vec::new().into());
+        return Ok(Vec::new());
+    }
+    let count = entries.len();
+    let mut entries: std::collections::BTreeMap<_, _> = entries
+        .into_iter()
+        .map(|entry| (entry.fields().id, entry))
+        .collect();
+    let code: Vec<_> = native
+        .packages()
+        .iter()
+        .map(|package| &package.manifest)
+        .chain(wasm)
+        .filter(|manifest| entries.contains_key(manifest.id.as_str()))
+        .collect();
+    if entries.len() != count || code.len() != count {
+        return Err(std::io::Error::other(
+            "ambiguous or missing installed code manifest",
+        ));
+    }
+    let side = launch.installation_side();
+    let declared: Vec<_> = code
+        .iter()
+        .map(|manifest| dependencies::from_manifest(&manifest.dependencies, side))
+        .collect();
+    let links: Vec<_> = code
+        .iter()
+        .zip(&declared)
+        .map(|(manifest, dependencies)| dependencies::Mod {
+            id: &manifest.id,
+            version: &manifest.version,
+            has_api: true,
+            code: true,
+            dependencies,
+        })
+        .collect();
+    dependencies::resolve_links(&links)
+        .map_err(|error| std::io::Error::other(error.to_string()))?;
+
+    let context = &launch.context;
+    let settings = ModList::load(&context.game_dir);
+    let selected: Vec<_> =
+        content_packages(&context.game_dir, &settings.enabled, &context.dev_mods).collect();
+    let overrides = Overrides::read(&context.game_dir.join(DIR)).map_err(std::io::Error::other)?;
+    let selected: Vec<_> = selected
+        .iter()
+        .map(|source| &source.package.manifest)
+        .collect();
+    let unavailable =
+        horizon_mod_package::unavailable::from_seed(&selected, side, &overrides, |manifest| {
+            manifest.wasm.is_some() && !entries.contains_key(manifest.id.as_str())
+        });
+    let code_count = code.len();
+    let manifests: Vec<_> = code
+        .into_iter()
+        .chain(selected.into_iter().filter(|manifest| {
+            manifest.wasm.is_none()
+                && manifest.native.is_none()
+                && !unavailable.contains_key(&manifest.id)
+        }))
+        .collect();
+    let order = dependencies::resolve_manifests(&manifests, side, &overrides)
+        .map_err(|error| std::io::Error::other(error.to_string()))?;
+    for warning in order.warnings {
+        log::warn!("Horizon: {warning}");
+    }
+    let mut ordered = Vec::with_capacity(count);
+    let mut saved = Vec::with_capacity(count);
+    for index in order.order.into_iter().filter(|&index| index < code_count) {
+        let manifest = manifests[index];
+        let entry = entries
+            .remove(manifest.id.as_str())
+            .ok_or_else(|| std::io::Error::other("duplicate installed code manifest"))?;
+        ordered.push(entry);
+        saved.push(horizon_client::save::level_mods::ModRecord {
+            id: manifest.id.clone(),
+            version: manifest.version.clone(),
+        });
+    }
+    let ids = ordered.iter().map(|entry| entry.fields().id).collect();
+    horizon_client::save::level_mods::set_loaded(Some(saved));
+    mod_api::__private::install(ordered.into());
+    Ok(ids)
+}
