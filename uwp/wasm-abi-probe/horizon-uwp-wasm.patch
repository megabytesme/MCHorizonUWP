+/// Pulley keeps its own guest stack. Synchronous host calls still need host headroom.
+#[cfg(target_vendor = "uwp")]
+pub fn check_current_uwp_host() -> Result<(), &'static str> {
+    thread_local! {
+        static SUFFICIENT: bool = windows_stack_sufficient(HOST_HEADROOM);
+    }
+    SUFFICIENT.with(|sufficient| {
+        sufficient
+            .then_some(())
+            .ok_or("GuestStackUnavailable: calling thread needs 8 MiB of host stack")
+    })
+}
