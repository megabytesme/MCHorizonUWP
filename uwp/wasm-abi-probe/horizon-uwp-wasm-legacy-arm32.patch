-#[cfg(windows)]
+// The 15063 ARM Store library exposes VirtualQuery. Inspect the reservation
+// that contains a stack local.
+#[cfg(all(target_vendor = "uwp", target_arch = "arm"))]
+fn windows_stack_sufficient(required: usize) -> bool {
+    const MEM_FREE: u32 = 0x10000;
+
+    fn query(address: usize) -> Option<MemoryRegion> {
+        let mut region = std::mem::MaybeUninit::<MemoryRegion>::zeroed();
+        // SAFETY: the address is queried as a number, not dereferenced.
+        // region has the 15063 ARM SDK layout and is writable.
+        let size = unsafe { VirtualQuery(address, region.as_mut_ptr(), size_of::<MemoryRegion>()) };
+        // SAFETY: the output buffer started initialized and contains only integer fields.
+        (size == size_of::<MemoryRegion>()).then(|| unsafe { region.assume_init() })
+    }
+
+    let stack_local = 0_u8;
+    let mut address = std::ptr::from_ref(&stack_local).addr();
+    let Some(mut region) = query(address) else {
+        return false;
+    };
+    let low = region.allocation_base;
+    if low == 0 || low > address {
+        return false;
+    }
+    loop {
+        if region.state == MEM_FREE || region.allocation_base != low {
+            return false;
+        }
+        let Some(end) = region.base_address.checked_add(region.size) else {
+            return false;
+        };
+        if region.base_address > address || end <= address {
+            return false;
+        }
+        if end - low >= required {
+            return true;
+        }
+        address = end;
+        let Some(next) = query(address) else {
+            return false;
+        };
+        region = next;
+    }
+}
